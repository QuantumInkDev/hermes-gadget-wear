<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/home_widget_cell" android:layout_width="0dp" android:layout_height="match_parent"
    android:layout_weight="1" android:minWidth="48dp" android:minHeight="48dp" android:padding="2dp"
    android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
    android:theme="@style/HomeWidgetTheme" android:foreground="?android:attr/selectableItemBackground">
    <FrameLayout android:id="@id/home_widget_portrait" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="noHideDescendants">
        <ImageView android:id="@+id/home_widget_picture" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@null" />
        <TextView android:id="@+id/home_widget_initials" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:textSize="28sp"
            android:textColor="?android:attr/colorAccent" android:fontFamily="sans-serif-medium" />
    </FrameLayout>
    <TextView android:id="@id/home_widget_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
        android:textSize="12sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
        android:textColor="?android:attr/textColorPrimary" android:maxLines="2" android:ellipsize="end"
        android:importantForAccessibility="no" />
</LinearLayout>
