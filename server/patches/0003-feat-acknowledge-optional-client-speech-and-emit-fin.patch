diff --git a/tests/test_client_tts.py b/tests/test_client_tts.py
new file mode 100644
index 0000000..81016d6
--- /dev/null
+++ b/tests/test_client_tts.py
@@ -0,0 +1,76 @@
+"""Opt-in client speech, stock behavior, once-only final events and live negotiation."""
+import asyncio
+import base64
+import json
+import secrets
+
+from hermes_gadget_plugin import protocol
+from hermes_gadget_plugin.hub import DeviceHub, DeviceSession, HubDelegate
+from hermes_gadget_plugin.store import DeviceStore
+
+
+def test_extensions_off_unpaired_interim_and_duplicate_finals(tmp_path):
+    class WS:
+        def __init__(self): self.sent = []
+        async def send(self, value): self.sent.append(json.loads(value))
+    async def run():
+        ws = WS()
+        hub = DeviceHub(DeviceStore(tmp_path), HubDelegate())
+        session = DeviceSession(hub, ws, {'device_id': 'hg-0123456789abcdef', 'caps': {'tts': 'client'}})
+        session.paired = True
+        await session.send_reply('Original text', turn='first')
+        assert [item['type'] for item in ws.sent] == ['reply']
+        hub.enable_client_tts = True
+        session.paired = False
+        await session.send_reply('Original text', turn='first')
+        session.paired = True
+        await session.send_reply('Interim', turn='first', interim=True)
+        assert not any(item['type'] == 'tts.speak' for item in ws.sent)
+        session.tts_voice = 'syntheticVoice'
+        await session.send_reply('Final', turn='first')
+        await session.send_reply('Final', turn='first')
+        await session.send_reply('Final', turn='second')
+        spoken = [item for item in ws.sent if item['type'] == 'tts.speak']
+        assert len(spoken) == 2 and spoken[0]['id'] != spoken[1]['id']
+        assert spoken[0]['voice'] == 'syntheticVoice'
+        hub.delegate.client_speech_allowed = lambda session: False
+        await session.send_reply('Voice off', turn='third')
+        assert len([item for item in ws.sent if item['type'] == 'tts.speak']) == 2
+        session.caps = {}
+        assert not session.client_tts
+    asyncio.run(run())
+
+
+def test_live_negotiation_requires_both_sides_and_preserves_readable_reply(tmp_path):
+    from websockets.asyncio.client import connect
+    class Delegate(HubDelegate):
+        async def is_paired(self, session): return True
+        async def voice_hint(self, session): return 'syntheticVoice'
+        async def on_text(self, session, msg_id, text):
+            await session.turn_start('synthetic-turn')
+            await session.send_delta('Original', turn='synthetic-turn')
+            await session.send_reply('Original reply', turn='synthetic-turn')
+            await session.turn_end('synthetic-turn')
+    async def run():
+        for enabled, offered in ((False, True), (True, False), (True, True)):
+            hub = DeviceHub(DeviceStore(tmp_path / f'{enabled}-{offered}'), Delegate(), host='localhost', port=0, enable_client_tts=enabled)
+            await hub.start()
+            try:
+                async with connect(f'ws://localhost:{hub.bound_port}/gadget', subprotocols=[protocol.SUBPROTOCOL]) as ws:
+                    key = secrets.token_bytes(32); device = protocol.device_id_for_key(key)
+                    await ws.send(json.dumps({'type': 'hello', 'proto': 1, 'device_id': device, 'caps': {'tts': 'client'} if offered else {}}))
+                    await ws.recv()
+                    await ws.send(json.dumps({'type': 'auth', 'key': base64.b64encode(key).decode()}))
+                    welcome = json.loads(await ws.recv())
+                    assert ('tts' in welcome) == (enabled and offered)
+                    await ws.send(json.dumps({'type': 'text', 'id': 'synthetic', 'text': 'Original text'}))
+                    values = []
+                    while True:
+                        item = json.loads(await asyncio.wait_for(ws.recv(), 5)); values.append(item)
+                        if item['type'] == 'turn.end': break
+                    assert any(item['type'] == 'reply' and item['text'] == 'Original reply' for item in values)
+                    spoken = [item for item in values if item['type'] == 'tts.speak']
+                    assert len(spoken) == (1 if enabled and offered else 0)
+                    if spoken: assert spoken[0]['voice'] == 'syntheticVoice'
+            finally: await hub.stop()
+    asyncio.run(run())
