diff --git a/tests/test_pets.py b/tests/test_pets.py
new file mode 100644
index 0000000..f622aac
--- /dev/null
+++ b/tests/test_pets.py
@@ -0,0 +1,110 @@
+"""Original synthetic sprites only: alpha, taxonomy, paths, and authenticated delivery."""
+import asyncio
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+from PIL import Image, ImageDraw
+from hermes_gadget_plugin import pets, protocol
+from hermes_gadget_plugin.hub import DeviceHub, DeviceSession, HubDelegate
+from hermes_gadget_plugin.store import DeviceStore
+
+
+def sheet(path, legacy=False):
+    image = Image.new('RGBA', (1728, 1664) if legacy else (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(image.height // 208):
+        for col in range(4 if row == 3 else 6):
+            x, y = col * 192 + 72, row * 208 + 80
+            draw.rectangle((x, y, x + 47, y + 99), fill=(255, 190, 90, 255))
+    image.save(path, 'WEBP', lossless=True)
+
+
+@pytest.mark.parametrize('legacy', [False, True])
+def test_alpha_transcode_geometry_taxonomy_and_trim(tmp_path, legacy):
+    path = tmp_path / 'sheet.webp'; sheet(path, legacy)
+    manifest, assets = pets.package(tmp_path, path, 'Original sample', 'sample')
+    meta, data = assets[0]
+    assert data.startswith(b'\x89PNG\r\n\x1a\n')
+    assert meta['sha256'] == hashlib.sha256(data).hexdigest()
+    assert meta['rows'][3]['frames'] == 4
+    assert meta['rows'][1]['name'] == ('wave' if legacy else 'running-right')
+    assert manifest['cell_width'] == 192
+
+
+def test_companion_is_separate_and_untrusted_paths_are_rejected(tmp_path):
+    path = tmp_path / 'sheet.webp'; sheet(path)
+    before = path.read_bytes()
+    image = Image.new('RGBA', (1152, 624)); draw = ImageDraw.Draw(image)
+    for col in range(3): draw.rectangle((col * 192 + 72, 80, col * 192 + 119, 179), fill=(255, 190, 90, 255))
+    image.save(tmp_path / 'gadget-sheet.png')
+    metadata = {'gadgetSheet': {'spritesheetPath': 'gadget-sheet.png', 'rows': [{'name': 'talking', 'index': 0, 'frames': 3}]}}
+    (tmp_path / 'pet.json').write_text(json.dumps(metadata))
+    assert len(pets.package(tmp_path, path, 'Sample', 'sample')[1]) == 2
+    assert path.read_bytes() == before
+    metadata['gadgetSheet']['spritesheetPath'] = '../outside.png'
+    (tmp_path / 'pet.json').write_text(json.dumps(metadata))
+    with pytest.raises(ValueError): pets.package(tmp_path, path, 'Sample', 'sample')
+    (tmp_path / 'link.png').symlink_to(tmp_path.parent / 'outside.png')
+    with pytest.raises(ValueError): pets.confined(tmp_path, 'link.png')
+
+
+def test_opaque_bad_geometry_and_empty_idle_are_rejected(tmp_path):
+    path = tmp_path / 'sheet.png'
+    for image in [Image.new('RGB', (1536, 1872)), Image.new('RGBA', (100, 100)), Image.new('RGBA', (1536, 1872))]:
+        image.save(path)
+        with pytest.raises(ValueError): pets.package(tmp_path, path, 'Sample', 'sample')
+
+
+def test_authenticated_opt_in_delivery_bounds_and_duplicate_request(tmp_path):
+    path = tmp_path / 'sheet.webp'; sheet(path)
+    value = pets.package(tmp_path, path, 'Sample', 'sample')
+    class WS:
+        def __init__(self): self.sent = []
+        async def send(self, data): self.sent.append(data)
+    class Delegate(HubDelegate):
+        def __init__(self): self.calls = 0
+        async def pet_package(self, session):
+            self.calls += 1
+            return value
+    async def run():
+        delegate, ws = Delegate(), WS()
+        hub = DeviceHub(DeviceStore(tmp_path / 'store'), delegate, enable_pets=True)
+        session = DeviceSession(hub, ws, {'device_id': 'hg-0123456789abcdef', 'caps': {'pet': {'asset_channel': 4}}})
+        await hub._h_pet_request(session, {})
+        assert not ws.sent and delegate.calls == 0
+        session.paired = True
+        hub.enable_pets = False
+        await hub._h_pet_request(session, {})
+        assert not ws.sent and delegate.calls == 0
+        hub.enable_pets = True
+        await hub._h_pet_request(session, {})
+        await hub._h_pet_request(session, {})
+        await asyncio.gather(*session._tasks)
+        assert delegate.calls == 1
+        texts = [json.loads(item) for item in ws.sent if isinstance(item, str)]
+        assert [item['type'] for item in texts] == ['pet.manifest', 'asset.start', 'asset.end']
+        frames = [protocol.parse_binary(item, additional_channels=(4,)) for item in ws.sent if isinstance(item, bytes)]
+        assert all(item.channel == 4 and len(item.payload) <= 4096 for item in frames)
+        assert [item.seq for item in frames] == list(range(len(frames)))
+        assert b''.join(item.payload for item in frames) == value[1][0][1]
+    asyncio.run(run())
+
+
+def test_profile_selection_and_disabled_setting_are_respected(tmp_path, monkeypatch):
+    import sys
+    import types
+    path = tmp_path / 'sheet.webp'; sheet(path)
+    selected = []
+    config = {'display': {'pet': {'enabled': True, 'slug': 'selected-profile-pet'}}}
+    def resolve(slug):
+        selected.append(slug)
+        return types.SimpleNamespace(directory=tmp_path, spritesheet=path, display_name='Original sample', slug='sample')
+    monkeypatch.setitem(sys.modules, 'agent.pet.store', types.SimpleNamespace(resolve_active_pet=resolve))
+    monkeypatch.setitem(sys.modules, 'hermes_cli.config', types.SimpleNamespace(load_config_readonly=lambda: config))
+    assert pets.active_package()[0]['name'] == 'Original sample'
+    assert selected == ['selected-profile-pet']
+    config['display']['pet']['enabled'] = False
+    assert pets.active_package() is None
+    assert len(selected) == 1
