diff --git a/plugin/pets.py b/plugin/pets.py
new file mode 100644
index 0000000..940a139
--- /dev/null
+++ b/plugin/pets.py
@@ -0,0 +1,113 @@
+"""Optional alpha-preserving pet assets. No metadata path escapes its profile pet directory."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import io
+import json
+from pathlib import Path
+
+CURRENT = ['idle', 'running-right', 'running-left', 'waving', 'jumping', 'failed', 'waiting', 'running', 'review']
+LEGACY = ['idle', 'wave', 'run', 'failed', 'review', 'jump']
+MAX_PNG = 2 * 1024 * 1024
+MAX_PIXELS = 3200000
+
+
+def confined(directory: Path, path: str) -> Path:
+    result = (directory / path).resolve()
+    result.relative_to(directory.resolve())
+    if not result.is_file() or result.stat().st_size > 8 * 1024 * 1024:
+        raise ValueError('Invalid pet asset')
+    return result
+
+
+def _sheet(path: Path, kind: str, rows=None):
+    from PIL import Image
+    with Image.open(path) as source:
+        width, height = source.size
+        if not (192 <= width <= 1728 and 208 <= height <= 2496 and width % 192 == 0 and height % 208 == 0 and width * height <= MAX_PIXELS):
+            raise ValueError('Invalid pet geometry')
+        if source.mode not in ('RGBA', 'LA', 'P') or (source.mode == 'P' and 'transparency' not in source.info):
+            raise ValueError('Pet requires alpha')
+        image = source.convert('RGBA')
+    if kind == 'base':
+        names = CURRENT if height // 208 >= 9 else LEGACY
+        rows = [{'name': name, 'index': index, 'frames': min(6, width // 192)} for index, name in enumerate(names) if index < height // 208]
+    if not isinstance(rows, list) or not 1 <= len(rows) <= 12:
+        raise ValueError('Invalid pet rows')
+    occupied, labels, indices = [], set(), set()
+    for row in rows:
+        name, index, count = row['name'], row['index'], row['frames']
+        if name in labels or index in indices or type(index) is not int or type(count) is not int or not (0 <= index < height // 208 and 1 <= count <= min(6, width // 192)):
+            raise ValueError('Invalid pet row')
+        if kind == 'companion' and (name not in ('listening', 'talking', 'sleeping') or (name == 'talking' and count != 3)):
+            raise ValueError('Invalid companion row')
+        labels.add(name); indices.add(index)
+        frames = 0
+        for column in range(count):
+            alpha = image.getchannel('A').crop((column * 192, index * 208, (column + 1) * 192, (index + 1) * 208))
+            if not alpha.point(lambda value: 255 if value > 16 else 0).getbbox():
+                break
+            if alpha.getextrema()[0] == 255:
+                raise ValueError("Opaque pet frame")
+            frames += 1
+        if frames:
+            if name == 'talking' and frames != 3:
+                raise ValueError('Talking needs three occupied poses')
+            occupied.append({'name': name, 'index': index, 'frames': frames})
+    if not occupied or (kind == 'base' and 'idle' not in [row['name'] for row in occupied]):
+        raise ValueError('Empty pet')
+    output = io.BytesIO()
+    image.save(output, 'PNG')
+    data = output.getvalue()
+    if len(data) > MAX_PNG:
+        raise ValueError('Pet PNG exceeds limit')
+    return {'kind': kind, 'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data), 'width': width, 'height': height, 'rows': occupied}, data
+
+
+def package(directory: Path, spritesheet: Path, name: str, slug: str):
+    # Both base path and companion metadata are confined, including symlinks.
+    base = confined(directory, str(spritesheet.resolve().relative_to(directory.resolve())))
+    metadata_path = directory / 'pet.json'
+    metadata = {}
+    if metadata_path.exists():
+        metadata_path = confined(directory, 'pet.json')
+        if metadata_path.stat().st_size > 65536:
+            raise ValueError('Pet metadata exceeds limit')
+        metadata = json.loads(metadata_path.read_text())
+    assets = [_sheet(base, 'base')]
+    companion = metadata.get('gadgetSheet')
+    if companion is not None:
+        if not isinstance(companion, dict):
+            raise ValueError('Invalid companion metadata')
+        assets.append(_sheet(confined(directory, companion['spritesheetPath']), 'companion', companion['rows']))
+    manifest = {'type': 'pet.manifest', 'slug': str(slug)[:64], 'name': str(name).strip()[:64] or 'Pet', 'cell_width': 192, 'cell_height': 208, 'loop_ms': 1100, 'sheets': [sheet for sheet, _ in assets]}
+    return manifest, assets
+
+
+def active_package():
+    from agent.pet.store import resolve_active_pet
+    from hermes_cli.config import load_config_readonly
+    config = load_config_readonly()
+    display = config.get('display') or {}
+    settings = display.get('pet') or {}
+    if settings.get('enabled') is False:
+        return None
+    pet = resolve_active_pet(settings.get('slug'))
+    return package(pet.directory, pet.spritesheet, pet.display_name, pet.slug) if pet else None
+
+
+async def send_package(session, value):
+    from .protocol import binary
+    manifest, assets = value
+    await session.send_json(manifest)
+    for stream, (sheet, data) in enumerate(assets, 1):
+        if not session.paired or session.closed:
+            return
+        await session.send_json({'type': 'asset.start', 'stream': stream, 'sha256': sheet['sha256'], 'bytes': len(data), 'format': 'png'})
+        for seq, offset in enumerate(range(0, len(data), 4096)):
+            if not session.paired or session.closed:
+                return
+            await session.send_binary(binary(4, stream, seq, data[offset:offset + 4096]))
+            await asyncio.sleep(0.02)
+        await session.send_json({'type': 'asset.end', 'stream': stream})
