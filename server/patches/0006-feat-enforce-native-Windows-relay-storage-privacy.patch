@@ -0,0 +1,219 @@
+"""Pure parser / API doubles only; no native Windows acceptance on other OSes."""
+from contextlib import contextmanager
+import ctypes as C
+import struct
+from types import SimpleNamespace
+
+import pytest
+from hermes_gadget_plugin import windows_privacy as w
+
+USER = w.SYSTEM[:-4] + struct.pack('<I', 1001)
+OUTSIDER = w.SYSTEM[:-4] + struct.pack('<I', 1002)
+
+
+def ace(sid=USER, mask=w.FILE_ALL_ACCESS, flags=0, kind=0):
+    return struct.pack('<BBHI', kind, flags, 8 + len(sid), mask) + sid
+
+
+def descriptor(*entries, owner=USER, control=0x8004):
+    acl = struct.pack('<BBHHH', 2, 0, 8 + sum(map(len, entries)), len(entries), 0) + b''.join(entries)
+    return struct.pack('<BBHIIII', 1, 0, control, 20, 0, 0, 20 + len(owner)) + owner + acl
+
+
+def check(data, *, leaf=True, directory=True):
+    w.validate_descriptor(data, USER, leaf=leaf, directory=directory)
+
+
+@pytest.mark.parametrize('flags', [0, 1, 2, 3, 8 | 1, 8 | 2, 16, 16 | 3])
+def test_broad_effective_and_future_grants_denied(flags):
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), ace(OUTSIDER, mask=1, flags=flags)))
+
+
+@pytest.mark.parametrize('identity', [USER, w.SYSTEM, w.ADMINISTRATORS])
+def test_only_leaf_trusted_grantees(identity):
+    check(descriptor(ace(identity, flags=3)))
+
+
+@pytest.mark.parametrize('mask', [w.DELETE, w.WRITE_DAC, w.WRITE_OWNER, 0x40, 0x10, 0x100,
+                                  0x40000000, 0x10000000, 0x02000000, 0x01000000, 0x200])
+def test_ancestor_replacement_and_unknown_rights_denied(mask):
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), ace(OUTSIDER, mask)), leaf=False)
+
+
+@pytest.mark.parametrize('mask', [1, 2, 4, 8, 0x20, 0x80, w.READ_CONTROL, w.SYNCHRONIZE,
+                                  0x80000000, 0x20000000])
+def test_ancestor_traversal_and_sibling_creation_allowed(mask):
+    check(descriptor(ace(), ace(OUTSIDER, mask)), leaf=False)
+
+
+def test_ancestor_inheritance_separate_from_leaf():
+    data = descriptor(ace(), ace(OUTSIDER, flags=11))
+    check(data, leaf=False)
+    with pytest.raises(w.PrivacyError):
+        check(data)
+
+
+def test_leaf_unknown_owner_denied():
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), owner=OUTSIDER))
+
+
+def test_ancestor_owner_can_rewrite_dacl():
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), owner=OUTSIDER), leaf=False)
+
+
+@pytest.mark.parametrize('kind', [2, 3, 4, 5, 6, 9, 10, 17, 18, 255])
+def test_unknown_aces_even_inherit_only_denied(kind):
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), ace(kind=kind, flags=11)))
+
+
+def test_deny_does_not_certify_broad_allow():
+    check(descriptor(ace(OUTSIDER, kind=1), ace()))
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(OUTSIDER, kind=1), ace(OUTSIDER)))
+
+
+@pytest.mark.parametrize('damage', ['missing', 'null', 'short', 'oversized', 'revision', 'control',
+    'offset', 'acl_size', 'acl_count', 'ace_size', 'sid_count', 'sid_revision', 'flags', 'slack'])
+def test_malformed_descriptors(damage):
+    data = bytearray(descriptor(ace()))
+    start = 20 + len(USER)
+    if damage == 'missing': struct.pack_into('<H', data, 2, 0x8000)
+    elif damage == 'null': struct.pack_into('<I', data, 16, 0)
+    elif damage == 'short': data = data[:19]
+    elif damage == 'oversized': data = b'x' * (w.MAX_DESCRIPTOR + 1)
+    elif damage == 'revision': data[0] = 2
+    elif damage == 'control': struct.pack_into('<H', data, 2, 4)
+    elif damage == 'offset': struct.pack_into('<I', data, 16, len(data) + 4)
+    elif damage == 'acl_size': struct.pack_into('<H', data, start + 2, 65532)
+    elif damage == 'acl_count': struct.pack_into('<H', data, start + 4, 4097)
+    elif damage == 'ace_size': struct.pack_into('<H', data, start + 10, 65532)
+    elif damage == 'sid_count': data[start + 17] = 255
+    elif damage == 'sid_revision': data[start + 16] = 2
+    elif damage == 'flags': data[start + 9] = 0x80
+    elif damage == 'slack':
+        data += b'ABCD'; struct.pack_into('<H', data, start + 2, len(data) - start)
+    with pytest.raises(w.PrivacyError): check(bytes(data))
+
+
+@pytest.mark.parametrize('path', ['x', 'C:x', r'\\server\share\file', r'\\?\C:\x',
+    'C:\\x:stream', 'C:\\x\\..\\y', 'C:\\x.\\y', 'C:\\x \\y', 'C:\\CON',
+    'C:\\COM1.txt', 'C:\\x\x00', 'C:\\x\\', 'C:\\x?'])
+def test_stream_remote_and_alias_paths_denied(path):
+    with pytest.raises(w.PrivacyError): w._path(path)
+
+
+class FakeNative:
+    def __init__(self):
+        self.opened_paths, self.closed, self.inspected = [], [], []
+        self.fail = None
+    @contextmanager
+    def opened(self, path, **kwargs):
+        handle = object()
+        self.opened_paths.append((path, kwargs, handle))
+        try: yield handle
+        finally: self.closed.append(handle)
+    def inspect(self, handle, path, **kwargs):
+        self.inspected.append((handle, path, kwargs))
+        if path == self.fail: raise w.PrivacyError()
+        return SimpleNamespace(size_high=0, size_low=4)
+    def read_bytes(self, handle, maximum):
+        assert handle is self.opened_paths[-1][2]
+        assert len(self.closed) == 0  # all ancestors still pinned
+        self.read_handle = handle
+        return b'safe'
+
+
+@pytest.mark.parametrize('failure', [None, 'C:\\', 'C:\\parent', 'C:\\parent\\private',
+                                    'C:\\parent\\private\\grants.json'])
+def test_same_handle_read_and_all_handles_closed(monkeypatch, failure):
+    native = FakeNative(); native.fail = failure
+    monkeypatch.setattr(w, '_Native', lambda: native)
+    if failure:
+        with pytest.raises(w.PrivacyError):
+            w.read_private_file(r'C:\parent\private\grants.json', 100)
+    else:
+        assert w.read_private_file(r'C:\parent\private\grants.json', 100) == b'safe'
+        assert native.read_handle is native.inspected[-1][0]
+        assert native.opened_paths[-1][1] == {'read': True}
+    assert native.closed == [x[2] for x in reversed(native.opened_paths)]
+
+
+@pytest.mark.parametrize('damage', ['reparse', 'hardlink', 'directory', 'type', 'api', 'volume', 'remote'])
+def test_native_object_metadata_denial_with_api_doubles(damage):
+    native = w._Native.__new__(w._Native)
+    def info(h, p):
+        obj = C.cast(p, C.POINTER(w._Info)).contents
+        obj.attributes = 0x400 if damage == 'reparse' else (0x10 if damage == 'directory' else 0)
+        obj.links = 2 if damage == 'hardlink' else 1
+        return damage != 'api'
+    def volume(h, a, b, c, d, flags, fs, size):
+        C.cast(flags, C.POINTER(w.DWORD)).contents.value = 8
+        fs.value = 'FAT32' if damage == 'volume' else 'NTFS'
+        return True
+    native.info, native.volume = info, volume
+    native.type = lambda _: 2 if damage == 'type' else 1
+    native.drive = lambda _: 4 if damage == 'remote' else 3
+    native.final = lambda *a: (_ for _ in ()).throw(AssertionError('should reject before final path'))
+    with pytest.raises(w.PrivacyError): native.inspect(1, r'C:\private\file', leaf=True, directory=False)
+
+
+@pytest.mark.parametrize('failure', ['get', 'invalid', 'size'])
+def test_security_allocation_freed_on_api_failure(failure):
+    native = w._Native.__new__(w._Native)
+    allocation = C.create_string_buffer(32)
+    freed = []
+    def security(*args):
+        C.cast(args[-1], C.POINTER(w.PTR)).contents.value = C.addressof(allocation)
+        return 5 if failure == 'get' else 0
+    native.security = security
+    native.valid_sd = lambda _: failure != 'invalid'
+    native.sd_size = lambda _: w.MAX_DESCRIPTOR + 1
+    native.free = lambda p: freed.append(p.value)
+    with pytest.raises(w.PrivacyError): native.descriptor(1)
+    assert freed == [C.addressof(allocation)]
+
+
+@pytest.mark.parametrize('failure', ['size', 'get', 'pointer', 'sid', None])
+def test_token_handle_closed_and_sid_pointer_bounded(monkeypatch, failure):
+    native = w._Native.__new__(w._Native)
+    closed = []
+    native.process = lambda: 50
+    def token(process, access, output):
+        C.cast(output, C.POINTER(w.HANDLE)).contents.value = 51
+        return True
+    native.token = token
+    native.close = lambda h: closed.append(h.value)
+    monkeypatch.setattr(C, 'get_last_error', lambda: 122, raising=False)
+    def info(token, kind, buf, size, required):
+        amount = C.cast(required, C.POINTER(w.DWORD))
+        amount.contents.value = 65537 if failure == 'size' else C.sizeof(w._SidAttributes) + len(USER)
+        if buf is None: return False
+        if failure == 'get': return False
+        record = w._SidAttributes.from_buffer(buf)
+        record.sid = C.addressof(buf) + (len(buf) + 1 if failure == 'pointer' else C.sizeof(w._SidAttributes))
+        if failure != 'pointer':
+            C.memmove(record.sid, b'x' * len(USER) if failure == 'sid' else USER, len(USER))
+        return True
+    native.token_info = info
+    if failure:
+        with pytest.raises(w.PrivacyError): native._user()
+    else: assert native._user() == USER
+    assert closed == [51]
+
+
+def test_native_abi_widths_are_explicit():
+    assert C.sizeof(w.DWORD) == C.sizeof(w.BOOL) == 4
+    assert C.sizeof(w._Info) == 52
+    assert C.sizeof(w._SidAttributes) == (16 if C.sizeof(w.PTR) == 8 else 8)
+
+
+def test_overlapping_owner_and_acl_is_malformed():
+    data = bytearray(descriptor(ace()))
+    # Header of ACL also resembles a short SID; it must not share SID storage.
+    struct.pack_into('<I', data, 16, 20)
+    with pytest.raises(w.PrivacyError): check(bytes(data))
