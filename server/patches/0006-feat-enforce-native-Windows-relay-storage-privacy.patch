+"""Actual core/adapter control flow with simulated Windows denial; not ACL proof."""
+import asyncio
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from test_relay_adapter import rig
+from gateway.platforms.base import SendResult
+from hermes_gadget_plugin import adapter as adapter_module, relay_grants
+from hermes_gadget_plugin import windows_privacy
+
+
+@pytest.mark.parametrize('enabled', [False, True])
+def test_windows_failed_privacy_keeps_stock_socket_and_speech(rig, monkeypatch, enabled):
+    calls = []
+    def deny(path):
+        calls.append(path)
+        raise windows_privacy.PrivacyError()
+    windows_os = SimpleNamespace(**{**vars(os), 'name': 'nt'})
+    monkeypatch.setattr(adapter_module, 'os', windows_os)
+    monkeypatch.setattr(relay_grants, 'os', windows_os)
+    monkeypatch.setattr(windows_privacy, 'private_directory', deny)
+    async def run():
+        adapter = await rig.start(enabled=enabled)
+        ws, welcome = await rig.socket()
+        assert welcome['paired'] and 'relay' not in welcome
+        assert adapter._relay_service is None
+        assert len(calls) == int(enabled)
+        send = AsyncMock(return_value=SendResult(success=True))
+        monkeypatch.setattr(adapter, '_send_with_retry', send)
+        event = adapter._event(adapter.hub.get(rig.device), 'stock-input', 'question')
+        result, owner = await adapter.send_final_ledgered(event, 'session', 'stock final', {}, reply_to=None)
+        assert result.success and owner is adapter
+        send.assert_awaited_once()
+        await ws.close()
+        await rig.close()
+    asyncio.run(run())
