@@ -0,0 +1,118 @@
+"""Platform-neutral routing regressions. Doubles are NOT Windows ACL evidence."""
+import json
+import os
+import sys
+from contextlib import contextmanager
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_gadget_plugin import relay_grants, relay_outbox, store
+from test_relay_grants import fixture_grants
+
+
+def native_double(monkeypatch, **members):
+    module = SimpleNamespace(**members)
+    monkeypatch.setitem(sys.modules, 'hermes_gadget_plugin.windows_privacy', module)
+    return module
+
+
+def test_windows_grant_reads_inspected_bytes_not_reopened_path(tmp_path, monkeypatch):
+    path, _, _, _, data, _, grants = fixture_grants(tmp_path)
+    trusted = json.dumps(data).encode()
+    def read(p, maximum):
+        assert p == path and maximum == 65536
+        path.write_text('{"devices":{}}')  # substitution after inspection
+        return trusted
+    native_double(monkeypatch, read_private_file=read)
+    monkeypatch.setattr(relay_grants, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    assert grants.snapshot()['phone']['generation'] == 1
+
+
+def test_windows_enrollment_privacy_failure_is_not_empty_authority(tmp_path, monkeypatch):
+    path = tmp_path / 'devices.json'
+    path.write_text('{"devices":{},"pairing":{}}')
+    devices = store.DeviceStore(tmp_path)
+    def deny(*a):
+        raise OSError('synthetic native failure')
+    native_double(monkeypatch, read_private_file=deny)
+    monkeypatch.setattr(store, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    with pytest.raises(OSError):
+        devices.enrollment_snapshot()
+    assert devices._enrollment_complete
+    assert path.read_text() == '{"devices":{},"pairing":{}}'
+
+
+def test_windows_enrollment_reads_inspected_bytes(tmp_path, monkeypatch):
+    path = tmp_path / 'devices.json'
+    raw = b'{"devices":{},"pairing":{}}'
+    path.write_bytes(raw)
+    devices = store.DeviceStore(tmp_path)
+    inspected = []
+    def read(p, maximum):
+        inspected.append(p)
+        assert p == path and maximum == 1048576
+        path.write_text('{broken')
+        return raw
+    native_double(monkeypatch, read_private_file=read)
+    monkeypatch.setattr(store, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    assert devices.enrollment_snapshot() == {}
+    assert inspected == [path]
+
+
+@pytest.mark.parametrize('failure_at', [1, 2])
+def test_windows_outbox_checks_new_journal_and_rolls_back_on_failure(tmp_path, monkeypatch, failure_at):
+    box = relay_outbox.Outbox(tmp_path / 'outbox.db', lambda: 1000)
+    box.put('owner', 'old', 'conversation', 'retained')
+    seen = []
+    @contextmanager
+    def guard(path):
+        def check():
+            journal = path.with_name(path.name + '-journal')
+            assert journal.is_file()  # actual SQLite journal, double ACL inspection
+            seen.append(journal)
+            if len(seen) == failure_at:
+                raise OSError('synthetic journal ACL failure')
+        yield check
+    native_double(monkeypatch, guarded_database=guard)
+    monkeypatch.setattr(relay_outbox, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    with pytest.raises(relay_outbox.OutboxError, match='permission_denied'):
+        box.put('owner', 'new', 'conversation', 'not committed')
+    monkeypatch.undo()
+    assert seen
+    assert [x['event_id'] for x in box.read('owner', 50)['items']] == ['old']
+
+
+def test_windows_constructor_new_database_and_journal_are_checked(tmp_path, monkeypatch):
+    checks = []
+    @contextmanager
+    def guard(path):
+        path.touch(exist_ok=True)
+        def check():
+            assert path.is_file()
+            assert path.with_name(path.name + '-journal').is_file()
+            checks.append(True)
+        yield check
+    native_double(monkeypatch, guarded_database=guard)
+    monkeypatch.setattr(relay_outbox, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    box = relay_outbox.Outbox(tmp_path / 'new.db', lambda: 1000)
+    assert len(checks) == 2
+    item = box.put('owner', 'event', 'conversation', 'text')
+    assert box.read('owner', 50)['items'] == [item]
+    assert len(checks) == 6
+
+
+def test_windows_unsafe_database_is_never_chmodded_or_opened_by_sqlite(tmp_path, monkeypatch):
+    path = tmp_path / 'unsafe.db'
+    path.write_bytes(b'retain unsafe bytes')
+    path.chmod(0o644)
+    @contextmanager
+    def guard(path):
+        raise OSError('native refusal')
+        yield
+    native_double(monkeypatch, guarded_database=guard)
+    monkeypatch.setattr(relay_outbox, 'os', SimpleNamespace(**{**vars(os), 'name': 'nt'}))
+    with pytest.raises(relay_outbox.OutboxError, match='permission_denied'):
+        relay_outbox.Outbox(path, lambda: 1000)
+    assert path.read_bytes() == b'retain unsafe bytes'
