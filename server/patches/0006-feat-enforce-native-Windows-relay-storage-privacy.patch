+        path = self.data()
+        original = w._Native.descriptor
+        def unavailable(*args): raise w.PrivacyError()
+        w._Native.descriptor = unavailable
+        try:
+            with self.assertRaises(w.PrivacyError): w.read_private_file(path, 1024)
+        finally: w._Native.descriptor = original
+        # Rename succeeds after the error: no pinned handle escaped cleanup.
+        renamed = path.with_name('renamed')
+        path.rename(renamed)
+        self.assertEqual(w.read_private_file(renamed, 1024), b'synthetic-private')
+
+    def test_restricted_native_read_denial_with_readable_control(self):
+        # These siblings live in the already-traversable NEW fixture root.
+        # No existing parent or private directory/file ACL is relaxed. Its WD
+        # traversal ACE is non-inheriting; the private file inherits only U/SY/BA.
+        private = self.fixture.root / 'probe-private'; private.write_bytes(b'synthetic-private')
+        control = self.fixture.root / 'probe-control'; control.write_bytes(b'public-control')
+        w.inspect_private_file(self.data())  # production private-directory gate
+        n = self.fixture.native
+        with n.opened(str(private), read=True) as handle:
+            n.inspect(handle, str(private), leaf=True, directory=False)
+            self.assertEqual(n.read_bytes(handle, 64), b'synthetic-private')
+        self.fixture.acl(control, 'D:P' + self.fixture.full + '(A;;GR;;;WD)')
+        result = subprocess.run([sys.executable, '-I', '-W', 'error', str(Path(__file__).resolve()),
+            '--restricted-probe', str(private), str(control)], capture_output=True, text=True, timeout=30)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.evidence.append(json.loads(result.stdout))
+
+
+def source_hashes():
+    paths = sorted((REPO / 'plugin').glob('*.py')) + [Path(__file__).resolve()]
+    return {str(p.relative_to(REPO)).replace('\\', '/'): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--parent', type=Path)
+    parser.add_argument('--receipt', type=Path)
+    parser.add_argument('--restricted-probe', nargs=2)
+    args = parser.parse_args()
+    if args.restricted_probe:
+        restricted_probe(*args.restricted_probe)
+        return 0
+    if not args.parent or not args.receipt: parser.error('--parent and --receipt are required')
+    if os.name != 'nt': parser.error('actual Windows required; POSIX is not native evidence')
+    if not args.parent.is_dir(): parser.error('parent must already exist; no existing ACLs will be changed')
+    if args.receipt.exists(): parser.error('receipt must be a new path')
+    receipt = {'os': platform.platform(), 'machine': platform.machine(), 'python': sys.version,
+               'pointer_bits': C.sizeof(C.c_void_p) * 8, 'sources': source_hashes(),
+               'native': True, 'evidence': NativeTests.evidence, 'cleanup': False}
+    fixture, result = None, None
+    try:
+        fixture = Fixture(args.parent)
+        NativeTests.fixture = fixture
+        receipt['process_user_sid'] = fixture.user
+        receipt['fixture'] = str(fixture.root)
+        receipt['fixture_parent_owner'] = owner_evidence(
+            fixture.native, fixture.root.parent, directory=True, leaf=False)
+        receipt['fixture_root_owner'] = owner_evidence(
+            fixture.native, fixture.root, directory=True, leaf=False)
+        result = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(NativeTests))
+        receipt.update(tests=result.testsRun, failures=len(result.failures), errors=len(result.errors),
+                       skips=[(str(test), reason) for test, reason in result.skipped])
+    except BaseException:
+        receipt['fatal'] = traceback.format_exc()
+        traceback.print_exc()
+    finally:
+        try:
+            if fixture: fixture.close(); receipt['cleanup'] = True
+        except BaseException: receipt['cleanup_error'] = traceback.format_exc()
+        with args.receipt.open('x', encoding='utf-8') as stream:
+            json.dump(receipt, stream, indent=2)
+    return 0 if result is not None and result.wasSuccessful() and receipt['cleanup'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
