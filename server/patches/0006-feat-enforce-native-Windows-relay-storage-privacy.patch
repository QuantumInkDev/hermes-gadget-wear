+"""Observed-policy shapes, with personal SIDs replaced by synthetic identities.
+
+Both controller inventories have the same standard root/Users ACL shape. These
+are parser regressions, never Windows ACL evidence. Root masks/flags and the
+well-known TrustedInstaller owner are preserved; capability/account SIDs are
+synthetic while preserving outsider identity classes.
+"""
+import struct
+
+import pytest
+from hermes_gadget_plugin import windows_privacy as w
+from test_windows_privacy import USER, OUTSIDER, ace, descriptor, check
+
+
+def sid(authority, *parts):
+    return bytes([1, len(parts)]) + authority.to_bytes(6, 'big') + struct.pack('<' + 'I' * len(parts), *parts)
+
+
+TI = sid(5, 80, 956008885, 3418522649, 1831038044, 1853292631, 2271478464)
+AU, BU, WD = sid(5, 11), sid(5, 32, 545), sid(1, 0)
+CAPABILITY = sid(15, 3, 65536, 1, 2, 3, 4, 5, 6, 7, 8)
+
+
+def observed_root(*extra, owner=TI, auth_flags=0x0B):
+    return descriptor(ace(AU, 4), ace(AU, 0xE0010000, flags=auth_flags),
+        ace(w.SYSTEM, flags=3), ace(w.ADMINISTRATORS, flags=3),
+        ace(BU, 0x1200A9, flags=3), ace(CAPABILITY, 0x1000A1), *extra,
+        owner=owner, control=0x9404)
+
+
+def test_observed_drive_root_owner_and_inherit_only_ace_allowed():
+    check(observed_root(), leaf=False)
+
+
+def test_trustedinstaller_is_exact_ancestor_owner_only():
+    check(descriptor(ace(), owner=TI), leaf=False)
+    for data in (descriptor(ace(), owner=TI), descriptor(ace(TI)), descriptor(ace(TI, flags=11))):
+        with pytest.raises(w.PrivacyError): check(data)
+    # The exception changes ownership only, not effective ACE authorization.
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(TI), owner=TI), leaf=False)
+
+
+@pytest.mark.parametrize('owner', [OUTSIDER, sid(5, 80, 1, 2, 3, 4, 5),
+                                    TI[:-4] + struct.pack('<I', 2271478465)])
+def test_unknown_and_nearby_service_owners_remain_denied(owner):
+    with pytest.raises(w.PrivacyError): check(observed_root(owner=owner), leaf=False)
+
+
+@pytest.mark.parametrize('mask', [w.DELETE, w.WRITE_DAC, w.WRITE_OWNER, 0x40, 0x10, 0x100, 0x40000000])
+def test_observed_root_still_refuses_effective_outsider_replacement(mask):
+    with pytest.raises(w.PrivacyError): check(observed_root(ace(WD, mask)), leaf=False)
+
+
+def test_inherit_only_bit_is_not_an_ancestor_permission_waiver():
+    # Same observed AU mask, now effective on the pinned existing root: deny.
+    with pytest.raises(w.PrivacyError): check(observed_root(auth_flags=3), leaf=False)
+    # User ownership must not make inheritable broad permissions private.
+    with pytest.raises(w.PrivacyError): check(observed_root(owner=USER))
+
+
+def test_observed_users_profile_and_appdata_ancestors():
+    users = descriptor(ace(WD, 0xA0000000, flags=11), ace(WD, 0x1200A9),
+        ace(w.SYSTEM, flags=3), ace(w.ADMINISTRATORS, flags=3),
+        ace(BU, 0x1200A9), ace(BU, 0xA0000000, flags=11), ace(CAPABILITY, 0x100021),
+        owner=w.SYSTEM, control=0x9404)
+    profile = descriptor(ace(w.SYSTEM, flags=3), ace(w.ADMINISTRATORS, flags=3),
+        ace(USER, flags=3), ace(CAPABILITY, 0x100020), owner=w.SYSTEM, control=0x9004)
+    appdata = descriptor(ace(w.SYSTEM, flags=19), ace(w.ADMINISTRATORS, flags=19), ace(USER, flags=19))
+    for data in (users, profile, appdata): check(data, leaf=False)
+    check(appdata)
+
+
+def test_observed_temp_outsider_write_mask_stays_denied():
+    data = descriptor(ace(OUTSIDER, 0x1301BF, flags=3), ace(w.SYSTEM, flags=19),
+                      ace(w.ADMINISTRATORS, flags=19), ace(USER, flags=19), control=0x8404)
+    for leaf in (False, True):
+        with pytest.raises(w.PrivacyError): check(data, leaf=leaf)
