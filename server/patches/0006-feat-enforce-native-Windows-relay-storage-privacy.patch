+"""Controller-only stdlib native fixture runner; all content is synthetic.
+
+Invoke on Windows with --parent EXISTING_DIRECTORY --receipt NEW_JSON_PATH.
+Creates a fresh owned child, mutates ACLs only there, cleans it in finally.
+Never imports an installed SDK. Restriction/impersonation runs only in a child
+process; no account creation or privilege enabling. Exit 0 requires all mandatory
+native assertions. Unsupported symlinks are reported separately from a pass.
+"""
+import argparse
+from contextlib import contextmanager
+import ctypes as C
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import traceback
+import unittest
