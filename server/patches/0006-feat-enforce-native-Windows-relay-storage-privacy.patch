+def sid_text(sid):
+    return 'S-1-' + str(int.from_bytes(sid[2:8], 'big')) + ''.join(
+        '-' + str(n) for n in struct.unpack('<' + 'I' * sid[1], sid[8:]))
+
+
+def owner_evidence(native, path, *, directory, leaf=True):
+    """Record the queried object's owner; no assumed/default-token ownership."""
+    with native.opened(str(path), writable=True) as handle:
+        native.inspect(handle, str(path), leaf=leaf, directory=directory)
+        data = native.descriptor(handle)
+        w.validate_descriptor(data, native.user, leaf=leaf, directory=directory)
+        owner = w._sid(data, struct.unpack_from('<I', data, 4)[0], len(data))
+        owner_class = {native.user: 'TokenUser', w.SYSTEM: 'LocalSystem',
+                       w.ADMINISTRATORS: 'Administrators',
+                       w.TRUSTED_INSTALLER: 'TrustedInstaller'}.get(owner, 'Other')
+        return {'owner_sid': sid_text(owner), 'owner_class': owner_class}
+
+
+def bind(lib, name, args, result):
+    fn = getattr(lib, name); fn.argtypes, fn.restype = args, result
+    return fn
+
+
+class Fixture:
+    def __init__(self, parent):
+        self.native = w._Native()
+        self.user = sid_text(self.native.user)
+        self.root = Path(tempfile.mkdtemp(prefix='relay-native-', dir=parent)).resolve()
+        self.full = f'(A;OICI;FA;;;{self.user})(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)'
+        self.convert = bind(self.native.a, 'ConvertStringSecurityDescriptorToSecurityDescriptorW',
+                            [C.c_wchar_p, w.DWORD, C.POINTER(w.PTR), C.POINTER(w.DWORD)], w.BOOL)
+        self.set_security = bind(self.native.a, 'SetFileSecurityW', [C.c_wchar_p, w.DWORD, w.PTR], w.BOOL)
+        try:
+            self.acl(self.root, 'D:P' + self.full + '(A;;GRGX;;;WD)')
+        except BaseException:
+            shutil.rmtree(self.root)
+            raise
+
+    def acl(self, path, sddl):
+        # Test-only mutation; reject anything outside the newly created tree,
+        # including symlink/junction escape before SetFileSecurity follows it.
+        path = Path(path)
+        if path != self.root and self.root not in path.resolve().parents:
+            raise AssertionError('ACL mutation outside owned fixture')
+        if path.lstat().st_file_attributes & 0x400:
+            raise AssertionError('ACL mutation on reparse object')
+        descriptor = w.PTR()
+        try:
+            if not self.convert(sddl, 1, C.byref(descriptor), None):
+                raise C.WinError(C.get_last_error())
+            if not self.set_security(str(path), 0x80000004, descriptor):  # protected DACL only
+                raise C.WinError(C.get_last_error())
+        finally:
+            if descriptor: self.native.free(descriptor)
+
+    def private(self, path):
+        self.acl(path, 'D:P' + self.full)
+
+    def directory(self, name):
+        directory = self.root / name
+        directory.mkdir()
+        self.private(directory)
+        return directory
+
+    def close(self):
+        shutil.rmtree(self.root)
+
+
+class _UnicodeString(C.Structure):
+    _fields_ = [('length', C.c_uint16), ('maximum', C.c_uint16), ('buffer', w.PTR)]
+
+
+class _ObjectAttributes(C.Structure):
+    _fields_ = [('length', w.DWORD), ('root', w.HANDLE),
+                ('name', C.POINTER(_UnicodeString)), ('attributes', w.DWORD),
+                ('security', w.PTR), ('qos', w.PTR)]
+
+
+class _StatusUnion(C.Union):
+    _fields_ = [('status', C.c_int32), ('pointer', w.PTR)]
+
+
+class _IoStatus(C.Structure):
+    _fields_ = [('value', _StatusUnion), ('information', C.c_size_t)]
+
+
+# Prepare only fixed-name bytes while the ordinary process token is active.
+# A cold codec import can fail under impersonation before either kernel open.
+# No leaf is opened here; both NtCreateFile calls still use the reduced token.
+_PROBE_NAMES = {name: name.encode('utf-16-le')
+                for name in ('probe-control', 'probe-private')}
+
+
+class _RelativeOpenError(OSError):
+    def __init__(self, status):
+        self.status = status & 0xFFFFFFFF
+        super().__init__(f'NtCreateFile status 0x{self.status:08X}')
+
+
+@contextmanager
+def _probe_anchor(native, directory):
+    # Preopen ONLY an owned directory, never either leaf. Grant no mutation
+    # rights; deny DELETE sharing so the scoped namespace cannot be renamed.
+    handle = native.open(str(directory), w.FILE_GENERIC_EXECUTE, 3, None, 3, 0x02200000, None)
+    if handle in (None, C.c_void_p(-1).value):
+        raise C.WinError(C.get_last_error())
+    try:
+        native.inspect(handle, str(directory), leaf=False, directory=True)
+        yield handle
+    finally:
+        native.close(handle)
+
+
+def _relative_read(native, create_file, anchor, name):
+    """Fresh kernel open under the CURRENT token, rooted at one directory handle.
+
+    Single-component names cannot traverse existing private ancestors. This
+    isolates file DACL enforcement; it does not establish full-path reachability
+    for a second account. No backup intent, privileges or preopened leaf handles.
+    """
+    if name not in _PROBE_NAMES:
+        raise ValueError('probe leaf name outside fixed fixture namespace')
+    encoded = _PROBE_NAMES[name]
+    buffer = C.create_string_buffer(encoded + b'\0\0')
+    name_info = _UnicodeString(len(encoded), len(encoded) + 2, C.addressof(buffer))
+    attributes = _ObjectAttributes(C.sizeof(_ObjectAttributes), anchor, C.pointer(name_info),
+                                   0x40, None, None)  # OBJ_CASE_INSENSITIVE
+    handle, io = w.HANDLE(), _IoStatus()
+    try:
+        status = create_file(C.byref(handle), w.FILE_GENERIC_READ, C.byref(attributes),
+            C.byref(io), None, 0, 1, 1, 0x00200060, None, 0)
+        # FILE_OPEN, SHARE_READ, NON_DIRECTORY | SYNCHRONOUS_IO_NONALERT |
+        # OPEN_REPARSE_POINT. STATUS_PENDING is not a synchronous success.
+        if status != 0:
+            raise _RelativeOpenError(status)
+        if handle.value in (None, C.c_void_p(-1).value):
+            raise AssertionError('native success without a file handle')
+        info = w._Info()
+        if (not native.info(handle, C.byref(info)) or native.type(handle) != 1
+                or info.attributes & 0x410 or info.links != 1):
+            raise AssertionError('probe opened nonordinary file')
+        return native.read_bytes(handle, 64)
+    finally:
+        if handle.value not in (None, C.c_void_p(-1).value):
+            native.close(handle)
+
+
+def _probe_reads(native, create_file, anchor):
+    # The SAME anchor/token/access/options are used for both fresh opens.
+    if _relative_read(native, create_file, anchor, 'probe-control') != b'public-control':
+        raise AssertionError('readable control content mismatch')
+    try:
+        _relative_read(native, create_file, anchor, 'probe-private')
+    except _RelativeOpenError as exc:
+        if exc.status != 0xC0000022:  # STATUS_ACCESS_DENIED, not a path/I/O error
+            raise
+    else:
+        raise AssertionError('restricted token read private data')
+
+
+def restricted_probe(private, control):
+    """Disposable-process restricted token: Everyone-only restricting SID set.
+
+    Access must pass BOTH normal and restricting-SID ACL evaluation. Built-in
+    Administrators is deny-only; every token privilege is disabled explicitly.
+    This is a constrained token for the SAME user, not a second user account.
+    """
+    private, control = Path(private), Path(control)
+    if (private.parent != control.parent or private.name != 'probe-private'
+            or control.name != 'probe-control'):
+        raise ValueError('probe requires fixed sibling files')
+    n = w._Native()
+    # NtCreateFile is test-only; production uses the existing Win32 verifier.
+    nt = C.WinDLL('ntdll', use_last_error=True)
+    create_file = bind(nt, 'NtCreateFile', [C.POINTER(w.HANDLE), w.DWORD,
+        C.POINTER(_ObjectAttributes), C.POINTER(_IoStatus), C.POINTER(C.c_int64),
+        w.DWORD, w.DWORD, w.DWORD, w.DWORD, w.PTR, w.DWORD], C.c_int32)
+    ptr = C.POINTER(w.PTR)
+    create = bind(n.a, 'CreateRestrictedToken', [w.HANDLE, w.DWORD, w.DWORD, C.POINTER(w._SidAttributes),
+        w.DWORD, w.PTR, w.DWORD, C.POINTER(w._SidAttributes), ptr], w.BOOL)
+    adjust = bind(n.a, 'AdjustTokenPrivileges', [w.HANDLE, w.BOOL, w.PTR, w.DWORD, w.PTR, w.PTR], w.BOOL)
+    impersonate = bind(n.a, 'ImpersonateLoggedOnUser', [w.HANDLE], w.BOOL)
+    revert = bind(n.a, 'RevertToSelf', [], w.BOOL)
+    original, restricted = w.HANDLE(), w.HANDLE()
+    admin = C.create_string_buffer(w.ADMINISTRATORS)
+    everyone = C.create_string_buffer(bytes.fromhex('010100000000000100000000'))
+    disabled = w._SidAttributes(C.addressof(admin), 0)
+    restricting = w._SidAttributes(C.addressof(everyone), 0)
+    active = False
+    try:
+        if not n.token(n.process(), 0x2E, C.byref(original)): raise C.WinError(C.get_last_error())
+        if not create(original, 1, 1, C.byref(disabled), 0, None, 1, C.byref(restricting), C.byref(restricted)):
+            raise C.WinError(C.get_last_error())
+        if not adjust(restricted, True, None, 0, None, None): raise C.WinError(C.get_last_error())
+        # Assert no enabled privileges remain, including SeChangeNotifyPrivilege.
+        needed = w.DWORD()
+        n.token_info(restricted, 3, None, 0, C.byref(needed))
+        if not 4 <= needed.value <= 65536: raise AssertionError('token privilege bound')
+        buf = C.create_string_buffer(needed.value)
+        if not n.token_info(restricted, 3, buf, len(buf), C.byref(needed)): raise C.WinError(C.get_last_error())
+        count = struct.unpack_from('<I', buf.raw)[0]
+        if 4 + 12 * count > len(buf): raise AssertionError('token privilege shape')
+        for i in range(count):
+            assert not struct.unpack_from('<I', buf.raw, 4 + i * 12 + 8)[0] & 2
+        with _probe_anchor(n, private.parent) as anchor:
+            if not impersonate(restricted): raise C.WinError(C.get_last_error())
+            active = True
+            try:
+                _probe_reads(n, create_file, anchor)
+            finally:
+                if not revert():
+                    os._exit(91)  # never continue or close namespace impersonated
+                active = False
+    finally:
+        if active and not revert():
+            os._exit(91)  # disposable process; never continue impersonated
+        if restricted: n.close(restricted)
+        if original: n.close(original)
+    print(json.dumps({'control_read': True, 'private_access_denied': True,
+                      'enabled_privileges': 0, 'restricting_sid': 'Everyone',
+                      'administrators': 'deny-only', 'reverted': True,
+                      'open_boundary': 'fresh sibling NtCreateFile opens relative to pinned owned directory',
+                      'private_status': '0xC0000022', 'full_path_other_user_access': 'not tested'}))
+
