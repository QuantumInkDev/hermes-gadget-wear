@@ -0,0 +1,250 @@
+"""Test-only NT open marshalling/error paths. Doubles are not kernel evidence."""
+import ctypes as C
+
+import pytest
+import windows_privacy_native as probe
+from hermes_gadget_plugin import windows_privacy as w
+
+
+class NativeDouble:
+    def __init__(self):
+        self.closed = []
+        self.leaves = {}
+    def close(self, handle):
+        self.closed.append(handle.value if isinstance(handle, w.HANDLE) else handle)
+    def info(self, handle, result):
+        info = C.cast(result, C.POINTER(w._Info)).contents
+        info.attributes, info.links = 0, 1
+        return True
+    def type(self, handle): return 1
+    def read_bytes(self, handle, maximum):
+        assert maximum == 64
+        return b'public-control' if self.leaves[handle.value] == 'probe-control' else b'synthetic-private'
+
+
+def syscall(native, statuses):
+    calls = []
+    def create(output, access, attributes, io, allocation, flags, share, disposition, options, ea, ea_size):
+        obj = C.cast(attributes, C.POINTER(probe._ObjectAttributes)).contents
+        name_info = obj.name.contents
+        name = C.string_at(name_info.buffer, name_info.length).decode('utf-16-le')
+        assert obj.length == C.sizeof(probe._ObjectAttributes)
+        assert obj.root == 101 and obj.attributes == 0x40
+        assert not obj.security and not obj.qos
+        assert name_info.maximum == name_info.length + 2
+        assert C.string_at(name_info.buffer + name_info.length, 2) == b'\0\0'
+        assert access == w.FILE_GENERIC_READ
+        assert (allocation, flags, share, disposition, options, ea, ea_size) == (None, 0, 1, 1, 0x00200060, None, 0)
+        calls.append(name)
+        status = statuses.get(name, 0)
+        if status == 0:
+            handle = 200 + len(calls)
+            C.cast(output, C.POINTER(w.HANDLE)).contents.value = handle
+            native.leaves[handle] = name
+        return C.c_int32(status).value
+    return create, calls
+
+
+def test_relative_native_control_read_then_exact_private_denial():
+    native = NativeDouble()
+    create, calls = syscall(native, {'probe-private': 0xC0000022})
+    probe._probe_reads(native, create, 101)
+    assert calls == ['probe-control', 'probe-private']
+    assert native.closed == [201]
+
+
+@pytest.mark.parametrize('status', [0xC0000022, 0xC0000034, 0xC000000D, 0x103])
+def test_failed_control_never_counts_as_private_denial(status):
+    native = NativeDouble(); create, calls = syscall(native, {'probe-control': status})
+    with pytest.raises(probe._RelativeOpenError): probe._probe_reads(native, create, 101)
+    assert calls == ['probe-control']
+    assert not native.closed
+
+
+@pytest.mark.parametrize('status', [0xC0000034, 0xC000000D, 0x103])
+def test_private_path_io_and_pending_errors_are_not_access_denial(status):
+    native = NativeDouble(); create, calls = syscall(native, {'probe-private': status})
+    with pytest.raises(probe._RelativeOpenError): probe._probe_reads(native, create, 101)
+    assert native.closed == [201]
+
+
+def test_private_read_success_fails_probe_and_closes_both_files():
+    native = NativeDouble(); create, calls = syscall(native, {})
+    with pytest.raises(AssertionError, match='read private'): probe._probe_reads(native, create, 101)
+    assert native.closed == [201, 202]
+
+
+@pytest.mark.parametrize('damage', ['bytes', 'read-error', 'reparse', 'directory', 'hardlink'])
+def test_bad_control_metadata_content_or_read_cannot_certify_denial(damage):
+    native = NativeDouble(); create, calls = syscall(native, {})
+    if damage == 'bytes': native.read_bytes = lambda *a: b'wrong'
+    elif damage == 'read-error':
+        def fail(*args): raise OSError('synthetic read failure')
+        native.read_bytes = fail
+    else:
+        def info(handle, result):
+            data = C.cast(result, C.POINTER(w._Info)).contents
+            data.links = 2 if damage == 'hardlink' else 1
+            data.attributes = 0x400 if damage == 'reparse' else (0x10 if damage == 'directory' else 0)
+            return True
+        native.info = info
+    with pytest.raises((OSError, AssertionError)): probe._probe_reads(native, create, 101)
+    assert calls == ['probe-control'] and native.closed == [201]
+
+
+@pytest.mark.parametrize('name', ['../probe-private', 'probe-private:stream', 'C:\\data', '', 'other'])
+def test_probe_namespace_is_fixed_single_component(name):
+    native = NativeDouble(); create, calls = syscall(native, {})
+    with pytest.raises(ValueError): probe._relative_read(native, create, 101, name)
+    assert not calls
+
+
+@pytest.mark.parametrize('failure', [False, True])
+def test_anchor_is_directory_only_and_closed_on_inspection_failure(failure):
+    native = NativeDouble()
+    def opened(path, access, share, security, disposition, flags, template):
+        assert access == w.FILE_GENERIC_EXECUTE
+        assert (share, disposition, flags, template) == (3, 3, 0x02200000, None)
+        return 101
+    native.open = opened
+    def inspect(handle, path, **kw):
+        assert kw == {'leaf': False, 'directory': True}
+        if failure: raise w.PrivacyError()
+    native.inspect = inspect
+    if failure:
+        with pytest.raises(w.PrivacyError):
+            with probe._probe_anchor(native, 'fixture'): pass
+    else:
+        with probe._probe_anchor(native, 'fixture') as handle: assert handle == 101
+    assert native.closed == [101]
+
+
+def test_native_test_abi_sizes_and_offsets():
+    pointer = C.sizeof(w.PTR)
+    assert C.sizeof(probe._UnicodeString) == (16 if pointer == 8 else 8)
+    assert probe._UnicodeString.buffer.offset == (8 if pointer == 8 else 4)
+    assert C.sizeof(probe._ObjectAttributes) == (48 if pointer == 8 else 24)
+    assert probe._ObjectAttributes.root.offset == pointer
+    assert probe._ObjectAttributes.name.offset == pointer * 2
+    assert C.sizeof(probe._IoStatus) == pointer * 2
+    assert probe._IoStatus.information.offset == pointer
+
+
+@pytest.mark.parametrize('failure', [None, 'read', 'impersonate'])
+def test_probe_reverts_before_anchor_close_and_closes_tokens(monkeypatch, tmp_path, failure):
+    from contextlib import contextmanager
+    import struct
+    events = []
+    native = NativeDouble()
+    native.a = object()
+    native.process = lambda: 1
+    native.close = lambda h: events.append(('close', h.value))
+    def token(process, access, output):
+        assert access == 0x2E
+        C.cast(output, C.POINTER(w.HANDLE)).contents.value = 501
+        return True
+    def token_info(handle, kind, buf, size, output):
+        assert kind == 3 and handle.value == 502
+        C.cast(output, C.POINTER(w.DWORD)).contents.value = 16
+        if buf is None: return False
+        # One disabled privilege; enabling it would fail before impersonation.
+        C.memmove(buf, struct.pack('<IIII', 1, 0, 0, 0), 16)
+        return True
+    native.token, native.token_info = token, token_info
+    def restrict(handle, flags, count, disabled, deletes, privileges, restricted_count, restricting, output):
+        assert flags == 1 and count == restricted_count == 1
+        C.cast(output, C.POINTER(w.HANDLE)).contents.value = 502
+        events.append('restrict')
+        return True
+    def disable(handle, all_privileges, *args):
+        assert all_privileges is True
+        events.append('disable_all')
+        return True
+    def impersonate(handle):
+        events.append('impersonate')
+        return failure != 'impersonate'
+    def revert(): events.append('revert'); return True
+    funcs = {'CreateRestrictedToken': restrict, 'AdjustTokenPrivileges': disable,
+             'ImpersonateLoggedOnUser': impersonate, 'RevertToSelf': revert,
+             'NtCreateFile': object()}
+    monkeypatch.setattr(probe, 'bind', lambda lib, name, args, result: funcs[name])
+    monkeypatch.setattr(w, '_Native', lambda: native)
+    monkeypatch.setattr(C, 'WinDLL', lambda *a, **kw: object(), raising=False)
+    monkeypatch.setattr(C, 'get_last_error', lambda: 5, raising=False)
+    monkeypatch.setattr(C, 'WinError', lambda err: OSError('native impersonation failed'), raising=False)
+    @contextmanager
+    def anchor(n, directory):
+        events.append('anchor.open')
+        try: yield 101
+        finally: events.append('anchor.close')
+    def reads(n, create, handle):
+        assert events[-1] == 'impersonate'
+        events.append('reads')
+        if failure == 'read': raise ValueError('read failed')
+    monkeypatch.setattr(probe, '_probe_anchor', anchor)
+    monkeypatch.setattr(probe, '_probe_reads', reads)
+    private, control = tmp_path / 'probe-private', tmp_path / 'probe-control'
+    if failure:
+        with pytest.raises((OSError, ValueError)): probe.restricted_probe(private, control)
+    else: probe.restricted_probe(private, control)
+    middle = ['impersonate'] if failure == 'impersonate' else ['impersonate', 'reads', 'revert']
+    assert events == ['restrict', 'disable_all', 'anchor.open', *middle,
+                      'anchor.close', ('close', 502), ('close', 501)]
+
+
+def test_fixed_names_are_encoded_before_native_token_setup_in_fresh_process():
+    # A fresh isolated interpreter avoids pytest's already-warmed codec cache.
+    # Stop before any native API: this is runtime preparation evidence only.
+    import subprocess
+    import sys
+    script = '''
+import runpy, sys
+encoded = []
+def profile(frame, event, function):
+    if (event == 'c_call' and getattr(function, '__name__', None) == 'encode'
+            and getattr(function, '__self__', None) in ('probe-control', 'probe-private')):
+        encoded.append(function.__self__)
+sys.setprofile(profile)
+probe = runpy.run_path(sys.argv[1], run_name='probe_preparation_test')
+class BeforeNativeTokenSetup(Exception): pass
+def stop(): raise BeforeNativeTokenSetup()
+probe['w']._Native = stop
+try:
+    probe['restricted_probe']('fixture/probe-private', 'fixture/probe-control')
+except BeforeNativeTokenSetup:
+    pass
+else:
+    raise AssertionError('native boundary was not reached')
+sys.setprofile(None)
+assert sorted(encoded) == ['probe-control', 'probe-private'], encoded
+'''
+    result = subprocess.run([sys.executable, '-I', '-S', '-W', 'error', '-c',
+                             script, str(probe.Path(probe.__file__).resolve())],
+                            capture_output=True, text=True, timeout=10)
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+@pytest.mark.parametrize('private_status', [0xC0000022, 0xC0000034, 0])
+def test_prepared_names_still_require_fresh_control_and_exact_denial(monkeypatch, private_status):
+    # Model the actual cold-codec failure if an encode is attempted in the
+    # restricted interval, while running the real relative-read/status logic.
+    class NoLateEncode(str):
+        def encode(self, *args, **kwargs):
+            raise LookupError('unknown encoding: utf-16-le')
+    original = probe._relative_read
+    def restricted_read(native, create, anchor, name):
+        return original(native, create, anchor, NoLateEncode(name))
+    monkeypatch.setattr(probe, '_relative_read', restricted_read)
+    native = NativeDouble()
+    create, calls = syscall(native, {'probe-private': private_status})
+    if private_status == 0xC0000022:
+        probe._probe_reads(native, create, 101)
+    elif private_status:
+        with pytest.raises(probe._RelativeOpenError) as failure:
+            probe._probe_reads(native, create, 101)
+        assert failure.value.status == private_status
+    else:
+        with pytest.raises(AssertionError, match='restricted token read private data'):
+            probe._probe_reads(native, create, 101)
+    assert calls == ['probe-control', 'probe-private']
+    assert native.closed == ([201, 202] if private_status == 0 else [201])
