+"""Trusted-owner policy regressions; synthetic descriptors, not kernel evidence."""
+import struct
+
+import pytest
+from hermes_gadget_plugin import windows_privacy as w
+from test_windows_privacy import USER, OUTSIDER, ace, check, descriptor
+
+TRUSTED = [USER, w.SYSTEM, w.ADMINISTRATORS]
+OTHER_GROUP = w.ADMINISTRATORS[:-4] + struct.pack('<I', 545)
+OTHER_SERVICE = w.TRUSTED_INSTALLER[:-4] + struct.pack('<I', 2271478465)
+
+
+@pytest.mark.parametrize('owner', TRUSTED)
+@pytest.mark.parametrize('directory', [True, False])
+def test_trusted_owner_and_three_identity_dacl(owner, directory):
+    # Synthetic form of protected OICI directories / inherited ordinary files.
+    # Owner comes from the descriptor; the caller remains actual TokenUser.
+    flags = 3 if directory else 16
+    check(descriptor(*(ace(sid, flags=flags) for sid in TRUSTED), owner=owner),
+          directory=directory)
+
+
+@pytest.mark.parametrize('owner', [OUTSIDER, OTHER_GROUP, OTHER_SERVICE, w.TRUSTED_INSTALLER])
+@pytest.mark.parametrize('directory', [True, False])
+def test_other_owner_denied_even_with_private_dacl(owner, directory):
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(*(ace(sid, flags=3) for sid in TRUSTED), owner=owner),
+              directory=directory)
+
+
+@pytest.mark.parametrize('owner', TRUSTED)
+@pytest.mark.parametrize('flags', [0, 16, 11])
+def test_trusted_owner_does_not_excuse_outsider_effective_or_future_access(owner, flags):
+    with pytest.raises(w.PrivacyError):
+        check(descriptor(ace(), ace(OUTSIDER, mask=1, flags=flags), owner=owner))
+
+
+@pytest.mark.parametrize('owner', TRUSTED)
+@pytest.mark.parametrize('damage', ['null', 'missing'])
+def test_trusted_owner_does_not_excuse_absent_dacl(owner, damage):
+    data = bytearray(descriptor(ace(), owner=owner))
+    if damage == 'null':
+        struct.pack_into('<I', data, 16, 0)
+    else:
+        struct.pack_into('<H', data, 2, 0x8000)
+    with pytest.raises(w.PrivacyError):
+        check(bytes(data))
+
+
+@pytest.mark.parametrize('owner,leaf,expected', [
+    (USER, True, 'TokenUser'), (w.SYSTEM, True, 'LocalSystem'),
+    (w.ADMINISTRATORS, True, 'Administrators'),
+    (w.TRUSTED_INSTALLER, False, 'TrustedInstaller'),
+    (OUTSIDER, True, None), (w.TRUSTED_INSTALLER, True, None),
+])
+def test_native_owner_receipt_uses_queried_descriptor_and_closes_handle(owner, leaf, expected):
+    from contextlib import contextmanager
+    from types import SimpleNamespace
+    import windows_privacy_native as probe
+
+    calls = []
+    @contextmanager
+    def opened(path, **options):
+        assert path == 'synthetic-path' and options == {'writable': True}
+        calls.append('open')
+        try:
+            yield 123
+        finally:
+            calls.append('close')
+    def inspect(handle, path, **options):
+        assert handle == 123 and path == 'synthetic-path'
+        assert options == {'leaf': leaf, 'directory': True}
+        calls.append('inspect')
+    def queried(handle):
+        assert handle == 123
+        calls.append('descriptor')
+        return descriptor(ace(), owner=owner)
+    native = SimpleNamespace(user=USER, opened=opened, inspect=inspect, descriptor=queried)
+    if expected is None:
+        with pytest.raises(w.PrivacyError):
+            probe.owner_evidence(native, 'synthetic-path', directory=True, leaf=leaf)
+    else:
+        assert probe.owner_evidence(native, 'synthetic-path', directory=True, leaf=leaf) == {
+            'owner_sid': probe.sid_text(owner), 'owner_class': expected}
+    assert calls == ['open', 'inspect', 'descriptor', 'close']
