diff --git a/plugin/windows_privacy.py b/plugin/windows_privacy.py
new file mode 100644
index 0000000..eaf576a
--- /dev/null
+++ b/plugin/windows_privacy.py
@@ -0,0 +1,346 @@
+"""Fail-closed, local NTFS privacy for the optional relay only.
+
+No permission mutation or account lookup. Ancestors are pinned against rename
+while an object is used; authority is read from that very inspected handle.
+Only ordinary allow/deny ACEs are supported. Denies are never credited to make
+an otherwise broad allow safe. Pure byte parsing is testable off Windows, but
+only native host runs can establish the kernel/ABI and inheritance contract.
+"""
+from contextlib import contextmanager, ExitStack
+import ctypes as C
+import ntpath
+import os
+import struct
+
+
+class PrivacyError(OSError):
+    def __init__(self):
+        super().__init__('private relay storage unavailable')
+
+
+# WinNT.h: standard/file rights and generic mappings (directories share bits).
+DELETE = 0x00010000
+READ_CONTROL = 0x00020000
+WRITE_DAC = 0x00040000
+WRITE_OWNER = 0x00080000
+SYNCHRONIZE = 0x00100000
+FILE_ALL_ACCESS = 0x001F01FF
+FILE_GENERIC_READ = READ_CONTROL | SYNCHRONIZE | 0x89
+FILE_GENERIC_WRITE = READ_CONTROL | SYNCHRONIZE | 0x116
+FILE_GENERIC_EXECUTE = READ_CONTROL | SYNCHRONIZE | 0xA0
+# Creating siblings (0x2/0x4) is not replacement of an existing protected name.
+ANCESTOR_CHANGE = DELETE | WRITE_DAC | WRITE_OWNER | 0x40 | 0x10 | 0x100
+INHERIT_ONLY = 0x08
+INHERIT = 0x03
+SYSTEM = b'\x01\x01\x00\x00\x00\x00\x00\x05' + struct.pack('<I', 18)
+ADMINISTRATORS = b'\x01\x02\x00\x00\x00\x00\x00\x05' + struct.pack('<II', 32, 544)
+# Windows Modules Installer's exact service SID. Ancestor OWNER only: no
+# wildcard service trust, no leaf ownership/grants, no effective ACE exemption.
+TRUSTED_INSTALLER = b'\x01\x06\x00\x00\x00\x00\x00\x05' + struct.pack(
+    '<6I', 80, 956008885, 3418522649, 1831038044, 1853292631, 2271478464)
+MAX_DESCRIPTOR = 131072
+
+
+def _sid(data, offset, end):
+    if offset < 0 or offset + 8 > end or data[offset] != 1:
+        raise PrivacyError()
+    count = data[offset + 1]
+    size = 8 + count * 4
+    if count > 15 or offset + size > end:
+        raise PrivacyError()
+    return data[offset:offset + size]
+
+
+def _mask(mask):
+    for generic, specific in ((0x80000000, FILE_GENERIC_READ),
+                              (0x40000000, FILE_GENERIC_WRITE),
+                              (0x20000000, FILE_GENERIC_EXECUTE),
+                              (0x10000000, FILE_ALL_ACCESS)):
+        if mask & generic:
+            mask = (mask & ~generic) | specific
+    # ACCESS_SYSTEM_SECURITY, MAXIMUM_ALLOWED, reserved bits: cannot establish
+    # their effect with this intentionally small verifier.
+    if mask & ~FILE_ALL_ACCESS:
+        raise PrivacyError()
+    return mask
+
+
+def validate_descriptor(data, user_sid, *, leaf, directory):
+    """Validate a bounded self-relative owner/DACL descriptor, not account names."""
+    if not 20 <= len(data) <= MAX_DESCRIPTOR or data[0:2] != b'\x01\x00':
+        raise PrivacyError()
+    control, owner, group, sacl, dacl = struct.unpack_from('<HIIII', data, 2)
+    # Only owner/group defaulting, DACL presence/defaulting/inheritance/protection
+    # and SELF_RELATIVE. Unexpected SACL/RM/control forms fail closed.
+    if (control & ~0x950F or not control & 0x8000 or not control & 4
+            or sacl or owner < 20 or not dacl or dacl < 20
+            or owner % 4 or dacl % 4):
+        raise PrivacyError()
+    allowed = {user_sid, SYSTEM, ADMINISTRATORS}
+    actual_owner = _sid(data, owner, len(data))
+    ancestor_owners = allowed | {TRUSTED_INSTALLER}
+    # Leaf ownership uses the same explicit local trust boundary as grants.
+    if actual_owner not in (allowed if leaf else ancestor_owners):
+        raise PrivacyError()
+    sid_spans = [(owner, owner + len(actual_owner))]
+    if group:
+        if group < 20 or group % 4:
+            raise PrivacyError()
+        group_sid = _sid(data, group, len(data))
+        sid_spans.append((group, group + len(group_sid)))
+    if dacl + 8 > len(data):
+        raise PrivacyError()
+    revision, reserved, size, count, reserved2 = struct.unpack_from('<BBHHH', data, dacl)
+    if (revision not in (2, 4) or reserved or reserved2 or size < 8
+            or size % 4 or dacl + size > len(data) or count > 4096):
+        raise PrivacyError()
+    if any(start < dacl + size and end > dacl for start, end in sid_spans):
+        raise PrivacyError()
+    pos, end = dacl + 8, dacl + size
+    for _ in range(count):
+        if pos + 8 > end:
+            raise PrivacyError()
+        kind, flags, length, access = struct.unpack_from('<BBHI', data, pos)
+        if length < 16 or length % 4 or pos + length > end or flags & ~0x1F:
+            raise PrivacyError()
+        # Callback/object/compound/conditional ACEs are unsupported, even if
+        # inherit-only: they can become effective on a newly created child.
+        if kind not in (0, 1):
+            raise PrivacyError()
+        identity = _sid(data, pos + 8, pos + length)
+        if len(identity) + 8 != length:
+            raise PrivacyError()
+        access = _mask(access)
+        effective = not flags & INHERIT_ONLY
+        future = directory and flags & INHERIT
+        if kind == 0 and identity not in allowed and access:
+            if (leaf and (effective or future)) or (not leaf and effective and access & ANCESTOR_CHANGE):
+                raise PrivacyError()
+        pos += length
+    # ACLs may reserve zeroed slack; nonzero trailing material is unsupported.
+    if any(data[pos:end]):
+        raise PrivacyError()
+
+
+def _path(value):
+    """Reject streams, device/UNC aliases, relative paths and Win32 trimming."""
+    value = os.fspath(value)
+    if not isinstance(value, str) or not value or '\x00' in value or len(value) > 240:
+        raise PrivacyError()
+    value = value.replace('/', '\\')
+    drive, tail = ntpath.splitdrive(value)
+    if len(drive) != 2 or drive[1] != ':' or not drive[0].isascii() or not drive[0].isalpha() or not tail.startswith('\\'):
+        raise PrivacyError()
+    parts = tail[1:].split('\\') if tail != '\\' else []
+    for part in parts:
+        base = part.split('.')[0].upper()
+        if (not part or part in ('.', '..') or part.endswith((' ', '.'))
+                or any(c in part for c in ':<>"|?*') or any(ord(c) < 32 for c in part)
+                or base in {'CON', 'PRN', 'AUX', 'NUL', 'CONIN$', 'CONOUT$'}
+                or base in {f'{p}{n}' for p in ('COM', 'LPT') for n in range(1, 10)}):
+            raise PrivacyError()
+    return drive.upper() + tail
+
+
+DWORD, BOOL, HANDLE, PTR = C.c_uint32, C.c_int32, C.c_void_p, C.c_void_p
+
+
+class _Info(C.Structure):
+    _fields_ = [(name, DWORD) for name in (
+        'attributes', 'created_low', 'created_high', 'access_low', 'access_high',
+        'written_low', 'written_high', 'volume', 'size_high', 'size_low',
+        'links', 'index_high', 'index_low')]
+
+
+class _SidAttributes(C.Structure):
+    _fields_ = [('sid', PTR), ('attributes', DWORD)]
+
+
+class _Native:
+    def __init__(self):
+        if os.name != 'nt' or not hasattr(C, 'WinDLL'):
+            raise PrivacyError()
+        self.k = C.WinDLL('kernel32', use_last_error=True)
+        self.a = C.WinDLL('advapi32', use_last_error=True)
+        def bind(lib, name, args, result):
+            fn = getattr(lib, name)
+            fn.argtypes, fn.restype = args, result
+            return fn
+        p32 = C.POINTER(DWORD)
+        pp = C.POINTER(PTR)
+        self.open = bind(self.k, 'CreateFileW', [C.c_wchar_p, DWORD, DWORD, PTR, DWORD, DWORD, HANDLE], HANDLE)
+        self.close = bind(self.k, 'CloseHandle', [HANDLE], BOOL)
+        self.info = bind(self.k, 'GetFileInformationByHandle', [HANDLE, C.POINTER(_Info)], BOOL)
+        self.type = bind(self.k, 'GetFileType', [HANDLE], DWORD)
+        self.volume = bind(self.k, 'GetVolumeInformationByHandleW', [HANDLE, C.c_wchar_p, DWORD, p32, p32, p32, C.c_wchar_p, DWORD], BOOL)
+        self.final = bind(self.k, 'GetFinalPathNameByHandleW', [HANDLE, C.c_wchar_p, DWORD, DWORD], DWORD)
+        self.drive = bind(self.k, 'GetDriveTypeW', [C.c_wchar_p], DWORD)
+        self.read = bind(self.k, 'ReadFile', [HANDLE, PTR, DWORD, p32, PTR], BOOL)
+        self.process = bind(self.k, 'GetCurrentProcess', [], HANDLE)
+        self.token = bind(self.a, 'OpenProcessToken', [HANDLE, DWORD, pp], BOOL)
+        self.token_info = bind(self.a, 'GetTokenInformation', [HANDLE, C.c_int32, PTR, DWORD, p32], BOOL)
+        self.security = bind(self.a, 'GetSecurityInfo', [HANDLE, C.c_int32, DWORD, pp, pp, pp, pp, pp], DWORD)
+        self.valid_sd = bind(self.a, 'IsValidSecurityDescriptor', [PTR], BOOL)
+        self.sd_size = bind(self.a, 'GetSecurityDescriptorLength', [PTR], DWORD)
+        self.free = bind(self.k, 'LocalFree', [PTR], PTR)
+        self.user = self._user()
+
+    def _user(self):
+        token = HANDLE()
+        if not self.token(self.process(), 0x0008, C.byref(token)):  # TOKEN_QUERY
+            raise PrivacyError()
+        try:
+            required = DWORD()
+            if self.token_info(token, 1, None, 0, C.byref(required)) or C.get_last_error() != 122:
+                raise PrivacyError()
+            if not C.sizeof(_SidAttributes) <= required.value <= 65536:
+                raise PrivacyError()
+            data = C.create_string_buffer(required.value)
+            if not self.token_info(token, 1, data, len(data), C.byref(required)) or required.value > len(data):
+                raise PrivacyError()
+            record = _SidAttributes.from_buffer(data)
+            offset = (record.sid or 0) - C.addressof(data)
+            if offset < C.sizeof(_SidAttributes):
+                raise PrivacyError()
+            return _sid(data.raw, offset, required.value)
+        finally:
+            self.close(token)
+
+    def descriptor(self, handle):
+        descriptor = PTR()
+        try:
+            if self.security(handle, 1, 0x00000005, None, None, None, None, C.byref(descriptor)):
+                raise PrivacyError()
+            if not descriptor or not self.valid_sd(descriptor):
+                raise PrivacyError()
+            length = self.sd_size(descriptor)
+            if not 20 <= length <= MAX_DESCRIPTOR:
+                raise PrivacyError()
+            return C.string_at(descriptor, length)
+        finally:
+            if descriptor:
+                self.free(descriptor)
+
+    @contextmanager
+    def opened(self, path, *, read=False, writable=False, deletable=False):
+        # No DELETE sharing pins every ancestor/DB against rename. Authority
+        # reads also deny WRITE sharing, excluding preexisting writer handles.
+        share = 1 | (2 if writable else 0) | (4 if deletable else 0)
+        access = READ_CONTROL | 0x80 | (0x80000000 if read else 0)
+        handle = self.open(path, access, share, None, 3, 0x02200000, None)
+        if handle in (None, C.c_void_p(-1).value):
+            error = C.get_last_error()
+            if error in (2, 3):
+                raise FileNotFoundError(error, 'private object missing')
+            raise PrivacyError()
+        try:
+            yield handle
+        finally:
+            self.close(handle)
+
+    def inspect(self, handle, path, *, leaf, directory):
+        info = _Info()
+        if not self.info(handle, C.byref(info)) or self.type(handle) != 1:
+            raise PrivacyError()
+        if (info.attributes & 0x400 or bool(info.attributes & 0x10) != directory
+                or (not directory and info.links != 1)):
+            raise PrivacyError()
+        flags, fs = DWORD(), C.create_unicode_buffer(32)
+        if (not self.volume(handle, None, 0, None, None, C.byref(flags), fs, len(fs))
+                or fs.value != 'NTFS' or not flags.value & 8
+                or self.drive(path[:3]) != 3):
+            raise PrivacyError()
+        final = C.create_unicode_buffer(32768)
+        length = self.final(handle, final, len(final), 0)  # normalized DOS volume
+        if not 0 < length < len(final) or not final.value.startswith('\\\\?\\'):
+            raise PrivacyError()
+        if ntpath.normcase(final.value[4:]) != ntpath.normcase(path):
+            raise PrivacyError()  # remote redirect, SUBST, alias or changed ancestor
+        validate_descriptor(self.descriptor(handle), self.user, leaf=leaf, directory=directory)
+        return info
+
+    def read_bytes(self, handle, maximum):
+        raw, read = C.create_string_buffer(maximum + 1), DWORD()
+        if not self.read(handle, raw, len(raw), C.byref(read), None) or read.value > maximum:
+            raise PrivacyError()
+        return raw.raw[:read.value]
+
+
+@contextmanager
+def _directory(native, path):
+    path = _path(path)
+    components = [path[:3]]
+    for component in path[3:].split('\\') if len(path) > 3 else []:
+        components.append(ntpath.join(components[-1], component))
+    with ExitStack() as stack:
+        for i, component in enumerate(components):
+            handle = stack.enter_context(native.opened(component, writable=True))
+            native.inspect(handle, component, leaf=i == len(components) - 1, directory=True)
+        yield path
+
+
+def private_directory(path):
+    native = _Native()
+    with _directory(native, path):
+        pass
+
+
+def read_private_file(path, maximum):
+    if type(maximum) is not int or not 0 < maximum <= 1048576:
+        raise PrivacyError()
+    path, native = _path(path), _Native()
+    with _directory(native, ntpath.dirname(path)):
+        with native.opened(path, read=True) as handle:
+            info = native.inspect(handle, path, leaf=True, directory=False)
+            if (info.size_high << 32 | info.size_low) > maximum:
+                raise PrivacyError()
+            raw = native.read_bytes(handle, maximum)
+            native.inspect(handle, path, leaf=True, directory=False)
+            return raw
+
+
+def _file(native, path, *, optional=False, deletable=False):
+    try:
+        with native.opened(path, writable=True, deletable=deletable) as handle:
+            native.inspect(handle, path, leaf=True, directory=False)
+    except FileNotFoundError:
+        if not optional:
+            raise
+
+
+def inspect_private_file(path):
+    path, native = _path(path), _Native()
+    with _directory(native, ntpath.dirname(path)):
+        _file(native, path)
+
+
+@contextmanager
+def guarded_database(path):
+    """Pin directory + database; caller closes SQLite before this guard exits.
+
+    Creation inherits a previously checked private directory DACL. The native
+    descriptor of the actual created object is still mandatory. No ACL repair.
+    """
+    path, native = _path(path), _Native()
+    with _directory(native, ntpath.dirname(path)):
+        # WAL/SHM are unsupported, even when private. Never let SQLite consume
+        # unchecked recovery state while switching back to DELETE journaling.
+        for suffix in ('-wal', '-shm'):
+            try:
+                _file(native, path + suffix)
+            except FileNotFoundError:
+                continue
+            raise PrivacyError()
+        _file(native, path + '-journal', optional=True, deletable=True)
+        try:
+            descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        except FileExistsError:
+            pass
+        else:
+            os.close(descriptor)
+        with native.opened(path, writable=True) as handle:
+            native.inspect(handle, path, leaf=True, directory=False)
+            def check_journal():
+                native.inspect(handle, path, leaf=True, directory=False)
+                _file(native, path + '-journal', deletable=True)
+            yield check_journal
