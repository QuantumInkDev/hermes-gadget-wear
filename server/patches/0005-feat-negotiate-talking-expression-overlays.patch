+@pytest.mark.parametrize('occupied', [1, 2])
+def test_unmasked_partial_talking_still_rejected(tmp_path, occupied):
+    path, rows = overlay_package(tmp_path)
+    del rows[1]['overlay']
+    with Image.open(tmp_path / 'companion.png') as source:
+        image = source.copy()
+    ImageDraw.Draw(image).rectangle((occupied * 192, 208, 1151, 415), fill=(0, 0, 0, 0))
+    image.save(tmp_path / 'companion.png')
+    with pytest.raises(ValueError, match='three occupied'):
+        pets._sheet(tmp_path / 'companion.png', 'companion', rows)
