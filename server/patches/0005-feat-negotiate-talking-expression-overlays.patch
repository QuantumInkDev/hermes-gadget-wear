+def test_old_client_omits_an_overlay_only_companion_asset(tmp_path):
+    path, rows = overlay_package(tmp_path)
+    companion = pets._sheet(tmp_path / 'companion.png', 'companion', [rows[1]])
+    manifest, assets = pets.package(tmp_path, path, 'Synthetic', 'synthetic')
+    value = ({**manifest, 'sheets': [assets[0][0], companion[0]]}, [assets[0], companion])
+    class Session:
+        paired, closed, caps = True, False, {'pet': {'asset_channel': 4}}
+        def __init__(self): self.sent = []
+        async def send_json(self, data): self.sent.append(data)
+        async def send_binary(self, data): pass
+    session = Session()
+    asyncio.run(pets.send_package(session, value))
+    assert session.sent[0]['sheets'] == [assets[0][0]]
+    assert sum(m['type'] == 'asset.start' for m in session.sent) == 1
+
