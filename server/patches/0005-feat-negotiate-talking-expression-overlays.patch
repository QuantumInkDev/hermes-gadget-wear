+def overlay_package(tmp_path):
+    path = tmp_path / 'base.webp'; sheet(path)
+    image = Image.new('RGBA', (1152, 624)); draw = ImageDraw.Draw(image)
+    for row, count in enumerate((6, 3, 6)):
+        for col in range(count):
+            x, y = col * 192, row * 208
+            draw.rectangle((x + 60, y + 60, x + 132, y + 180), fill=(100 + col * 20, 90, 40, 255))
+            draw.rectangle((x + 88, y + 100, x + 104, y + 102 + col * 3), fill='black')
+    image.save(tmp_path / 'companion.png')
+    rows = [{'name': n, 'index': i, 'frames': c} for i, (n, c) in enumerate((('listening', 6), ('talking', 3), ('sleeping', 6)))]
+    rows[1]['overlay'] = {'anchor_frame': 0, 'rect': [80, 96, 112, 128]}
+    (tmp_path / 'pet.json').write_text(json.dumps({'gadgetSheet': {'spritesheetPath': 'companion.png', 'rows': rows}}))
+    return path, rows
+
+
+def test_overlay_descriptor_preserved_and_source_unchanged(tmp_path):
+    path, rows = overlay_package(tmp_path)
+    before = [(tmp_path / name).read_bytes() for name in ('base.webp', 'companion.png', 'pet.json')]
+    manifest, assets = pets.package(tmp_path, path, 'Synthetic', 'synthetic')
+    assert manifest['sheets'][1]['rows'][1]['overlay'] == rows[1]['overlay']
+    assert assets[1][0] == manifest['sheets'][1]
+    assert before == [(tmp_path / name).read_bytes() for name in ('base.webp', 'companion.png', 'pet.json')]
+
+
+@pytest.mark.parametrize('descriptor', [None, True, [], {},
+    {'anchor_frame': True, 'rect': [80, 96, 112, 128]},
+    {'anchor_frame': 1, 'rect': [80, 96, 112, 128]},
+    {'anchor_frame': 0, 'rect': [True, 96, 112, 128]},
+    {'anchor_frame': 0, 'rect': [80.0, 96, 112, 128]},
+    {'anchor_frame': 0, 'rect': [80, 96, 112]},
+    {'anchor_frame': 0, 'rect': [80, 96, 112, 128, 140]},
+    {'anchor_frame': 0, 'rect': [-1, 96, 112, 128]},
+    {'anchor_frame': 0, 'rect': [80, 96, 193, 128]},
+    {'anchor_frame': 0, 'rect': [80, 96, 112, 209]},
+    {'anchor_frame': 0, 'rect': [80, 96, 80, 128]},
+    {'anchor_frame': 0, 'rect': [0, 0, 97, 104]},
+    {'anchor_frame': 0, 'rect': [0, 0, 96, 105]},
+    {'anchor_frame': 0, 'rect': [80, 96, 112, 128], 'mask': 'no'}])
+def test_malformed_overlays_fail_closed(tmp_path, descriptor):
+    path, rows = overlay_package(tmp_path)
+    rows[1]['overlay'] = descriptor
+    with pytest.raises(ValueError): pets._sheet(tmp_path / 'companion.png', 'companion', rows)
+
+
+@pytest.mark.parametrize('capability', [None, False, True, 0, 2, '1', 1.0, 1])
+def test_delivery_negotiates_exact_overlay_version_without_mutating_package(tmp_path, capability):
+    path, rows = overlay_package(tmp_path)
+    value = pets.package(tmp_path, path, 'Synthetic', 'synthetic')
+    original = json.dumps(value[0], sort_keys=True)
+    class Session:
+        paired, closed = True, False
+        caps = {'pet': {'asset_channel': 4, 'expression_overlays': capability}}
+        def __init__(self): self.sent = []
+        async def send_json(self, data): self.sent.append(data)
+        async def send_binary(self, data): pass
+    session = Session()
+    asyncio.run(pets.send_package(session, value))
+    sent = session.sent[0]['sheets']
+    received = {r['name']: r for r in sent[1]['rows']}
+    assert ('talking' in received) == (type(capability) is int and capability == 1)
+    assert 'listening' in received and 'sleeping' in received
+    assert sent[0] == value[0]['sheets'][0]
+    assert json.dumps(value[0], sort_keys=True) == original
+
+
+@pytest.mark.parametrize('change', ['listening', 'sleeping', 'frames', 'empty', 'partial'])
+def test_overlay_requires_talking_and_three_occupied_poses(tmp_path, change):
+    path, rows = overlay_package(tmp_path)
+    if change in ('listening', 'sleeping'):
+        rows = [dict(rows[1], name=change)]
+    elif change == 'frames': rows[1]['frames'] = 2
+    else:
+        image = Image.open(tmp_path / 'companion.png')
+        draw = ImageDraw.Draw(image)
+        draw.rectangle((0 if change == 'empty' else 384, 208, 1151, 415), fill=(0, 0, 0, 0))
+        image.save(tmp_path / 'companion.png')
+    with pytest.raises(ValueError): pets._sheet(tmp_path / 'companion.png', 'companion', rows)
+
