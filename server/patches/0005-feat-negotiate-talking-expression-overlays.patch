+@pytest.mark.parametrize('capability', [None, 1])
+def test_packaging_omits_unmasked_empty_talking_but_delivers_supported_rows(tmp_path, capability):
+    path, rows = overlay_package(tmp_path)
+    del rows[1]['overlay']
+    with Image.open(tmp_path / 'companion.png') as source:
+        image = source.copy()
+    ImageDraw.Draw(image).rectangle((0, 208, 1151, 415), fill=(0, 0, 0, 0))
+    image.save(tmp_path / 'companion.png')
+    (tmp_path / 'pet.json').write_text(json.dumps({'gadgetSheet': {'spritesheetPath': 'companion.png', 'rows': rows}}))
+    originals = [(tmp_path / name).read_bytes() for name in ('base.webp', 'companion.png', 'pet.json')]
+    value = pets.package(tmp_path, path, 'Ordinary synthetic', 'ordinary')
+    assert [r['name'] for r in value[0]['sheets'][1]['rows']] == ['listening', 'sleeping']
+    class Session:
+        paired, closed = True, False
+        caps = {'pet': {'asset_channel': 4, 'expression_overlays': capability}}
+        def __init__(self): self.sent = []
+        async def send_json(self, data): self.sent.append(data)
+        async def send_binary(self, data): pass
+    session = Session()
+    asyncio.run(pets.send_package(session, value))
+    assert [s['kind'] for s in session.sent[0]['sheets']] == ['base', 'companion']
+    assert [r['name'] for r in session.sent[0]['sheets'][1]['rows']] == ['listening', 'sleeping']
+    assert sum(m['type'] == 'asset.end' for m in session.sent) == 2
+    assert originals == [(tmp_path / name).read_bytes() for name in ('base.webp', 'companion.png', 'pet.json')]
+
