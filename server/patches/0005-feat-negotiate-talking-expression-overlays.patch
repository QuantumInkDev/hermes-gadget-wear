+def _overlay(value, kind, name, count):
+    if kind != 'companion' or name != 'talking' or count != 3:
+        raise ValueError('Overlay requires companion talking with three poses')
+    if not isinstance(value, dict) or set(value) != {'anchor_frame', 'rect'}:
+        raise ValueError('Invalid overlay descriptor')
+    anchor, rect = value['anchor_frame'], value['rect']
+    if type(anchor) is not int or anchor != 0 or not isinstance(rect, list) or len(rect) != 4 or any(type(n) is not int for n in rect):
+        raise ValueError('Invalid overlay anchor or rectangle')
+    left, top, right, bottom = rect
+    if not (0 <= left < right <= 192 and 0 <= top < bottom <= 208 and right - left <= 96 and bottom - top <= 104):
+        raise ValueError('Overlay rectangle exceeds cell or region limits')
+    return {'anchor_frame': 0, 'rect': list(rect)}
+
