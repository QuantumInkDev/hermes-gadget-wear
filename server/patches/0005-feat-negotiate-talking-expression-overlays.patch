+@pytest.mark.parametrize('descriptor', [
+    '{"anchor_frame":0e0,"rect":[80,100,112,124]}',
+    '{"anchor_frame":0,"rect":[8e1,100,112,124]}',
+    '{"anchor_frame":0,"rect":[2147483647,100,-2147483648,124]}',
+    '{"anchor_frame":0,"rect":[80,2147483647,112,-2147483648]}'
+])
+def test_json_numeric_tokens_and_extrema_are_rejected(tmp_path, descriptor):
+    path, rows = overlay_package(tmp_path)
+    rows[1]['overlay'] = json.loads(descriptor)
+    metadata = json.dumps({'gadgetSheet': {'spritesheetPath': 'companion.png', 'rows': rows}})
+    # Preserve exponent tokens through the actual package metadata reader, rather
+    # than normalizing them to decimal floats in this fixture's JSON round trip.
+    metadata = metadata.replace(json.dumps(rows[1]['overlay']), descriptor)
+    assert descriptor in metadata
+    (tmp_path / 'pet.json').write_text(metadata)
+    with pytest.raises(ValueError): pets.package(tmp_path, path, 'Synthetic', 'synthetic')
