+                    # out-of-band legacy insert must not silently wedge the queue.
+                    if not result['items']:
+                        probe = await _blocking(self.outbox.read, ctx['owner'], 1)
+                        if probe['items']:
+                            raise OutboxError('temporarily_unavailable')
+                else:
+                    result = {'acknowledged': await _blocking(
+                        self.outbox.ack, ctx['owner'], params['delivery_ids'])}
+                await self._recheck(ctx, self.context, session)
+                reply['result'] = result
+        except OutboxError as exc:
+            code = str(exc)
+            reply['error'] = {'code': code if code in _ERRORS else 'temporarily_unavailable'}
+        except (OSError, sqlite3.Error):
+            reply['error'] = {'code': 'temporarily_unavailable'}
+        await session.send_json(reply)
+
+    async def capture(self, event, session_key, text, ephemeral):
+        if (ephemeral or not text or str(event.text or '').lstrip().startswith(('/', '!'))
+                or event.source.chat_id != event.source.user_id):
+            return None
+        if self.lock.locked():
+            raise OutboxError('busy')
+        async with self.lock:
+            try:
+                ctx = await _blocking(self._device_context, event.source.user_id)
+            except OutboxError as exc:
+                from .relay_grants import AuthorityUnavailable
+                if isinstance(exc, AuthorityUnavailable):
+                    raise
+                if str(exc) == 'permission_denied' and not self.require_provenance:
+                    return None
+                raise
+            identity = getattr(event, 'ledger_message_id', None) or event.message_id
+            if self.require_provenance:
+                stamp = parse_identity(event.message_id)
+                key = self.grants.devices.key_for(event.source.user_id)
+                if (stamp is None or key is None or stamp[0] != hashlib.sha256(key).hexdigest()
+                        or stamp[1] != ctx['generation']):
+                    raise OutboxError('permission_denied')
+            if not await _blocking(self.outbox.is_opted_in, ctx['owner'], ctx['generation']):
+                if self.require_provenance:
+                    raise OutboxError('permission_denied')
+                return None
+            if (not isinstance(session_key, str) or not session_key or not identity
+                    or not isinstance(text, str)):
+                raise OutboxError('invalid_request')
+            try:
+                if not 1 <= len(text.encode('utf-8')) <= 16384:
+                    raise OutboxError('invalid_request')
+                # A worst-size real envelope is checked before any body commit.
+                prototype = dict(delivery_id='0' * 36, conversation_id='0' * 36, event_id='0' * 36,
+                                 created_at_ms=9223372036854775807, expires_at_ms=9223372036854775807,
+                                 payload={'kind': 'final_text', 'text': text})
+                envelope = dict(type='relay.response', v=1, id='x' * 64,
+                                result=dict(items=[prototype], next_cursor=None,
+                                            gap_generation=9223372036854775807))
+                if wire_bytes(envelope) > 65536:
+                    raise OutboxError('invalid_request')
+                digest = hashlib.sha256(json.dumps(
+                    ([session_key, event.message_id, str(identity)] if self.require_provenance
+                     else [session_key, str(identity)]), separators=(',', ':')).encode()).hexdigest()
+                event_id = str(uuid.uuid5(uuid.UUID(ctx['profile_id']), digest))
+                conversation_id = str(uuid.uuid5(uuid.UUID(ctx['profile_id']), session_key))
+            except (ValueError, TypeError, UnicodeError):
+                raise OutboxError('invalid_request') from None
+            if self.require_provenance:
+                item, created = await _blocking(self.outbox.put, ctx['owner'], event_id, conversation_id, text, True)
+                event._relay_capture_created = created
+            else:
+                item = await _blocking(self.outbox.put, ctx['owner'], event_id, conversation_id, text)
+            await self._recheck(ctx, self._device_context, event.source.user_id)
+            return item
+
+    async def maintain(self):
+        """Bounded idle sweep; invalid grants do not prevent normal TTL cleanup."""
+        if self.lock.locked():
+            return False
+        async with self.lock:
+            try:
+                await _blocking(self.outbox.cleanup)
+                await _blocking(self._snapshot)
+                return True
+            except (OutboxError, OSError, sqlite3.Error):
+                return False
+
+    async def _cleanup_loop(self):
+        while True:
+            await asyncio.sleep(self.cleanup_interval_s)
+            await self.maintain()
+
+    async def start(self):
+        if self._cleanup_task is None:
+            self._cleanup_task = asyncio.create_task(self._cleanup_loop())
+            await self.maintain()
+
+    async def stop(self):
+        if self._cleanup_task is not None:
+            self._cleanup_task.cancel()
+            with suppress(asyncio.CancelledError):
+                await self._cleanup_task
+            self._cleanup_task = None
