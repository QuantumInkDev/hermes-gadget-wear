+@pytest.mark.parametrize('failure', ['locked', 'disk-full', 'ledger', 'ledger-rotate'])
+def test_failed_final_survives_actual_core_finalizer_and_reconstructs(rig, monkeypatch, failure):
+    async def run():
+        import sqlite3
+        import time
+        from contextlib import closing
+        adapter = await rig.start()
+        ws, _ = await rig.socket()
+        event = adapter._event(adapter.hub.get(rig.device), 'failed-input', 'question')
+        await ws.close()
+        store = attach_store(rig)
+        entry = store.get_or_create_session(event.source)
+        key = entry.session_key
+        executed = []
+        async def handler(received):
+            assert await rig.runner._mark_durable_active_turn(received, key)
+            executed.append(received.message_id)
+            store.append_to_transcript(entry.session_id, {'role': 'user', 'content': 'question', 'timestamp': time.time()})
+            store.append_to_transcript(entry.session_id, {'role': 'assistant', 'content': 'durable final', 'timestamp': time.time()})
+            return 'durable final'
+        adapter.set_message_handler(handler)
+        lock = None
+        with monkeypatch.context() as patch:
+            if failure == 'locked':
+                lock = sqlite3.connect(adapter._relay_service.outbox.path)
+                lock.execute('BEGIN IMMEDIATE')
+            elif failure == 'disk-full':
+                def full(*args):
+                    error = sqlite3.OperationalError('database or disk is full')
+                    error.sqlite_errorcode = sqlite3.SQLITE_FULL
+                    raise error
+                patch.setattr(adapter._relay_service.outbox, 'put', full)
+            else:
+                def broken(**kwargs):
+                    raise sqlite3.OperationalError('database is locked')
+                patch.setattr(rig.ledger, 'record_obligation', broken)
+            try:
+                await adapter._process_message_background(event, key)
+            finally:
+                if lock:
+                    lock.rollback()
+                    lock.close()
+        assert executed == [event.message_id]
+        assert event._final_delivery_pending
+        assert store._entries[key].active_turn_token
+        assert store._entries[key].active_turn_delivery_context == adapter.final_delivery_context(event, key)
+        assert store.recover_interrupted_turns() == 0
+        assert store.discard_active_turn_markers() == 0
+        # Close adapter/SQLite handles, reconstruct marker and transcript using
+        # actual store read code. Neither model nor ingress recording is replayed.
+        store._db.close()
+        store.close_all_db_handles()
+        await rig.close()
+        adapter = await rig.start()
+        store = attach_store(rig)
+        store._ensure_loaded()
+        assert store._entries[key].active_turn_token
+        assert await rig.runner._ledger_crash_left_replies(3600) == 1
+        assert store._entries[key].active_turn_token is None
+        # Simulate dead writer ownership for ledger rows made by this test's
+        # prior adapter process; actual sweep CAS and recovery dispatch run below.
+        with closing(rig.ledger._connect()) as db:
+            db.execute('UPDATE delivery_obligations SET owner_pid=NULL,owner_started_at=NULL')
+            db.commit()
+        rows = rig.ledger.sweep_recoverable()
+        assert len(rows) == 1
+        if failure == 'ledger-rotate':
+            new_key = b'rotated-reconstruction-owner-key'
+            adapter._store.enroll(rig.device, new_key)
+            rig.grant['devices'][rig.device]['key_sha256'] = hashlib.sha256(new_key).hexdigest()
+            rig.grant['generation'] = 2
+            rig.save_grant()
+            ws, welcome = await rig.socket(key=new_key)
+            assert welcome['relay'] == {'version': 1}
+            assert await rig.runner._redeliver_claimed_obligations(rows) == 0
+            assert (await rig.request(ws, 'relay.outbox.read'))['result']['items'] == []
+            with closing(rig.ledger._connect()) as db:
+                assert db.execute('SELECT state FROM delivery_obligations').fetchone()[0] == 'failed'
+            assert executed == [event.message_id]
+            await ws.close()
+            store._db.close()
+            store.close_all_db_handles()
+            await rig.close()
+            return
+        ws, _ = await rig.socket(caps={'tts': 'client', 'speaker': {'rate': 16000}})
+        assert await rig.runner._redeliver_claimed_obligations(rows) == 1
+        assert executed == [event.message_id]
+        items = (await rig.request(ws, 'relay.outbox.read'))['result']['items']
+        assert len(items) == 1 and items[0]['payload']['text'] == 'durable final'
+        # Even another recovered callback reaches the exact row and emits no
+        # tts.speak or binary/audio frame before the response.
+        context = rig.ledger.get_delivery_context(rows[0]['obligation_id'])
+        recovered = await adapter.send_recovered_final(dict(rows[0], delivery_context=context), 'prefix ignored', None)
+        assert recovered.message_id == items[0]['delivery_id']
+        assert (await rig.request(ws, 'relay.outbox.ack', delivery_ids=[recovered.message_id]))['result']
+        await ws.close()
+        store._db.close()
+        store.close_all_db_handles()
+        await rig.close()
+    asyncio.run(run())
+
