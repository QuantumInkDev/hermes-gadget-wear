+@pytest.mark.parametrize('cancellations', [1, 3])
+def test_slow_io_is_off_loop_serial_and_cancel_keeps_lock_until_thread_finishes(
+        rig, monkeypatch, cancellations):
+    started, release = threading.Event(), threading.Event()
+    main = threading.get_ident()
+    original = rig.box.read
+    def blocked(*args):
+        assert threading.get_ident() != main
+        started.set()
+        assert release.wait(3)
+        return original(*args)
+    monkeypatch.setattr(rig.box, 'read', blocked)
+    async def scenario():
+        first = asyncio.create_task(rig.request('relay.outbox.read'))
+        try:
+            for _ in range(1000):
+                if started.is_set():
+                    break
+                await asyncio.sleep(0.001)
+            assert started.is_set()
+            assert_code(await rig.request(session=Session()), 'busy')
+            assert await rig.service.welcome(Session()) is None
+            for _ in range(cancellations):
+                first.cancel()
+                await asyncio.sleep(0)
+                assert not first.done()
+                assert_code(await rig.request(session=Session()), 'busy')
+        finally:
+            release.set()
+            try:
+                await first
+            except asyncio.CancelledError:
+                pass
+        assert 'result' in await rig.request()
+    run(scenario())
