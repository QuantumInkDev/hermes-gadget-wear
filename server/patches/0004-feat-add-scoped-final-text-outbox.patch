index 0000000000000000000000000000000000000000..4fb6dacf5bc22f314f64a2bbae9582fcd7e30c8e
--- /dev/null
+++ b/plugin/relay_service.py
@@ -0,0 +1,320 @@
+"""Optional pull-only final-text service; no provider or live speech interface.
+
+The owning adapter must await start()/stop() for idle retention/revocation sweeps.
+Successful storage reads enforce exact expiry; physical idle cleanup runs within
+60 seconds plus I/O/scheduling time while the owning process is healthy. Invalid
+configuration denies access but never authorizes wholesale owner deletion.
+"""
+
+import asyncio
+from contextlib import suppress
+import hashlib
+import json
+import math
+import re
+import sqlite3
+from time import monotonic
+import uuid
+
+from .relay_outbox import OutboxError
+
+
+_ID = re.compile(r'[A-Za-z0-9_-]{1,64}\Z')
+_ERRORS = frozenset({'invalid_request', 'unsupported', 'permission_denied', 'not_found',
+                     'conflict', 'expired', 'busy', 'rate_limited', 'temporarily_unavailable'})
+_METHODS = ['relay.info', 'relay.outbox.read', 'relay.outbox.ack']
+
+
+def parse_identity(identity):
+    if not isinstance(identity, str):
+        return None
+    match = re.fullmatch(r'relay1:([0-9a-f]{64}):([1-9][0-9]{0,9}):([0-9a-f]{64})', identity)
+    return (match[1], int(match[2])) if match else None
+
+
+def negotiated(session):
+    caps = getattr(session, 'caps', None)
+    cap = caps.get('relay') if isinstance(caps, dict) else None
+    return (isinstance(cap, dict) and set(cap) == {'version'}
+            and type(cap['version']) is int and cap['version'] == 1)
+
+
+def wire_bytes(value):
+    """Bound the actual SDK ASCII sender and the proposed UTF-8 sender alike."""
+    return max(len(json.dumps(value, ensure_ascii=ascii_only, allow_nan=False,
+                              separators=(',', ':')).encode('utf-8'))
+               for ascii_only in (True, False))
+
+
+def _bounded(value):
+    # Check depth iteratively before JSON encoding, including pathological direct
+    # callers. The hub separately bounds raw incoming UTF-8 and parser recursion.
+    pending = [(value, 1)]
+    count = 0
+    while pending:
+        item, depth = pending.pop()
+        count += 1
+        if depth > 8 or count > 65536:
+            raise OutboxError('invalid_request')
+        if isinstance(item, dict):
+            if not all(isinstance(key, str) for key in item):
+                raise OutboxError('invalid_request')
+            pending.extend((child, depth + 1) for child in item.values())
+        elif isinstance(item, list):
+            pending.extend((child, depth + 1) for child in item)
+        elif item is not None and type(item) not in (str, int, float, bool):
+            raise OutboxError('invalid_request')
+    try:
+        if len(json.dumps(value, ensure_ascii=False, allow_nan=False,
+                          separators=(',', ':')).encode('utf-8')) > 65536:
+            raise OutboxError('invalid_request')
+    except (ValueError, TypeError, UnicodeError, RecursionError):
+        raise OutboxError('invalid_request') from None
+
+
+async def _blocking(function, *args):
+    """Cancellation cannot release the serial lock while its worker still runs."""
+    task = asyncio.create_task(asyncio.to_thread(function, *args))
+    try:
+        # wait() cancels only its own waiter, never the worker. Unlike shield(),
+        # it also installs no log-on-failure callback after caller cancellation.
+        await asyncio.wait({task})
+    except asyncio.CancelledError:
+        while not task.done():
+            with suppress(asyncio.CancelledError):
+                await asyncio.wait({task})
+        # Retrieve an exception even if our caller is cancelled, avoiding an
+        # unobserved task warning. The original cancellation still propagates.
+        if not task.cancelled():
+            task.exception()
+        raise
+    return task.result()
+
+
+class RelayService:
+    def __init__(self, grants, outbox, cleanup_interval_s=60, *, require_provenance=False):
+        if (type(cleanup_interval_s) not in (int, float)
+                or not math.isfinite(cleanup_interval_s) or not 0 < cleanup_interval_s <= 60):
+            raise ValueError('invalid cleanup interval')
+        self.grants, self.outbox = grants, outbox
+        self.require_provenance = require_provenance
+        self.lock = asyncio.Lock()
+        self.cleanup_interval_s = cleanup_interval_s
+        self._cleanup_task = None
+
+    def _snapshot(self):
+        snapshot = self.grants.snapshot()
+        self.outbox.reconcile_owners([ctx['owner'] for ctx in snapshot.values()])
+        return snapshot
+
+    def _device_context(self, device_id):
+        try:
+            return self._snapshot()[device_id]
+        except (KeyError, TypeError):
+            raise OutboxError('permission_denied') from None
+
+    def context(self, session):
+        # Even a denial from a valid snapshot reconciles removed enrollment keys.
+        ctx = self._device_context(session.device_id)
+        if not session.paired or not negotiated(session):
+            raise OutboxError('permission_denied')
+        if self.require_provenance:
+            key = self.grants.devices.key_for(session.device_id)
+            if (key is None or getattr(session, 'auth_key_sha256', None)
+                    != hashlib.sha256(key).hexdigest()):
+                raise OutboxError('permission_denied')
+        return ctx
+
+    async def _recheck(self, ctx, function, *args):
+        # Invalid/unreadable bytes deny delivery but do not opt_out: only a valid
+        # snapshot is authority to clear bodies. Valid revoked snapshots already
+        # reconciled all obsolete owners before this function can raise.
+        fresh = await _blocking(function, *args)
+        if fresh != ctx:
+            await _blocking(self.outbox.opt_out, ctx['owner'])
+            raise OutboxError('permission_denied')
+
+    async def welcome(self, session):
+        session._relay_generation = None
+        if self.lock.locked():
+            return None
+        async with self.lock:
+            try:
+                ctx = await _blocking(self._device_context, session.device_id)
+                if not session.paired or not negotiated(session):
+                    if session.paired:
+                        await _blocking(self.outbox.opt_out, ctx['owner'])
+                    return None
+                ctx = await _blocking(self.context, session)
+                await _blocking(self.outbox.opt_in, ctx['owner'], ctx['generation'])
+                await self._recheck(ctx, self.context, session)
+                session._relay_generation = ctx['generation']
+                return {'version': 1}
+            except (OutboxError, OSError, sqlite3.Error):
+                return None
+
+    def _rate(self, session):
+        now = monotonic()
+        tokens, when = getattr(session, '_relay_rate', (20.0, now))
+        tokens = min(20.0, tokens + max(0, now - when) * 10)
+        if tokens < 1 - 1e-9:
+            session._relay_rate = (tokens, now)
+            raise OutboxError('rate_limited')
+        session._relay_rate = (max(0, tokens - 1), now)
+
+    @staticmethod
+    def _params(method, params):
+        if method == 'relay.info':
+            valid = not params
+        elif method == 'relay.outbox.read':
+            valid = (set(params) <= {'limit'} and type(params.get('limit', 25)) is int
+                     and 1 <= params.get('limit', 25) <= 50)
+        elif method == 'relay.outbox.ack':
+            ids = params.get('delivery_ids')
+            valid = (set(params) == {'delivery_ids'} and isinstance(ids, list)
+                     and 1 <= len(ids) <= 50)
+            if valid:
+                try:
+                    valid = all(isinstance(x, str) and len(x) == 36
+                                and str(uuid.UUID(x)) == x for x in ids)
+                except ValueError:
+                    valid = False
+        else:
+            raise OutboxError('unsupported')
+        if not valid:
+            raise OutboxError('invalid_request')
+
+    async def request(self, session, msg):
+        identifier = msg.get('id') if isinstance(msg, dict) else None
+        if not isinstance(identifier, str) or not _ID.fullmatch(identifier):
+            identifier = None
+        reply = {'type': 'relay.response', 'v': 1}
+        if identifier is not None:
+            reply['id'] = identifier
+        try:
+            self._rate(session)
+            _bounded(msg)
+            if (identifier is None or not isinstance(msg, dict)
+                    or set(msg) != {'type', 'v', 'id', 'method', 'params'}
