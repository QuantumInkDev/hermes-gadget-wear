+async def handoff(rig, event, key, incoming, mode, patch):
+    """Exercise the real run_turn queue branch / run_busy redirect branch, no model."""
+    from types import SimpleNamespace
+    from unittest.mock import AsyncMock
+    runner = rig.runner
+    if mode == 'redirect':
+        receiver = SimpleNamespace(redirect=lambda text: True)
+        turn = runner._session_state(key).turn
+        turn.agent, turn.event, turn.ctx = receiver, event, None
+        assert runner._redirect_active_turn(receiver, incoming.text, key, incoming)
+        return
+    entry = runner.session_store._entries[key]
+    prepared = runner._PreparedTurn([], '', event.text, event.text, None, None)
+    patch.setattr(runner, '_hmwa_resolve_session', AsyncMock(return_value=(event.source, entry, key)))
+    patch.setattr(runner, '_hmwa_prepare_turn', AsyncMock(return_value=(prepared, [])))
+    runner.hooks = SimpleNamespace(emit=AsyncMock())
+    patch.setattr(runner, '_pinned_channel_inputs', lambda *a, **kw: ('', event.source))
+    patch.setattr(runner, '_persist_prompt_pins', AsyncMock())
+    patch.setattr(runner, '_run_agent', AsyncMock(return_value={'queued_terminal_inbound_id': incoming.message_id}))
+    patch.setattr(runner, '_hmwa_stop_typing_for_turn', AsyncMock())
+    patch.setattr(runner, '_is_session_run_current', lambda *a: True)
+    patch.setattr(runner, '_hmwa_shape_agent_response', AsyncMock(return_value=('handoff final', False, [])))
+    patch.setattr(runner, '_hmwa_prepend_reasoning', lambda result, response, *a: response)
+    patch.setattr(runner, '_hmwa_runtime_footer_line', lambda *a: '')
+    patch.setattr(runner, '_hmwa_post_turn_hooks', AsyncMock())
+    patch.setattr(runner, '_hmwa_classify_turn_failure', lambda *a: (False, False, False))
+    patch.setattr(runner, '_hmwa_compression_exhaustion_reset', AsyncMock(return_value=('handoff final', entry)))
+    patch.setattr(runner, '_hmwa_persist_turn_transcript', AsyncMock())
+    patch.setattr(runner, '_hmwa_deliver_turn_response', AsyncMock(return_value='handoff final'))
+    patch.setattr(runner, '_hmwa_agent_error_reply', AsyncMock(side_effect=AssertionError('unexpected turn failure')))
+    patch.setattr(runner, '_clear_session_env', lambda tokens: None)
+    assert await runner._handle_message_with_agent(event, event.source, key, 1) == 'handoff final'
