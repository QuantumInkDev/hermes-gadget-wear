+                # Authorization must precede method discovery, including unknown
+                # methods; a cached capability never grants authority.
+                ctx = await _blocking(self.context, session)
+                method, params = msg['method'], msg['params']
+                self._params(method, params)
+                if method == 'relay.info':
+                    result = dict(profile_id=ctx['profile_id'], grant_generation=ctx['generation'],
+                                  expires_at_ms=ctx['expires_at_ms'], methods=list(_METHODS),
+                                  limits={'outbox_cursor': False, 'page_items': 50, 'text_bytes': 16384})
+                elif method == 'relay.outbox.read':
+                    result = await _blocking(self.outbox.read, ctx['owner'], params.get('limit', 25))
+                    while result['items'] and wire_bytes({**reply, 'result': result}) > 65536:
+                        result['items'].pop()
