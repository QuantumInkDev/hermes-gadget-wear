+++ b/plugin/relay_outbox.py
@@ -0,0 +1,274 @@
+"""Private, durable final-text recovery; never a source for rerunning model turns.
+
+One database belongs to one profile. Owners are private enrollment-bound hashes
+provided by the grant layer, never included in returned DTOs. Pending records are
+read oldest-first until ACK. Eviction/expiry removes payloads, not retry identities.
+ACK DTOs remain subject to both byte quotas. Identities retire seven days after
+payload expiry; older recovery must use canonical history, not fresh capture.
+
+The deployment budget is 36 MiB including SQLite's active rollback journal:
+4096 x 4096-byte DB pages (16 MiB), at most one original-page journal (under
+17 MiB with headers), plus filesystem metadata headroom. DELETE journaling leaves
+no WAL; a 1 MiB journal_size_limit controls finalized journals, not active ones.
+Incremental vacuum reclaims up to 128 free pages on each successful transaction.
+Metadata, owners, identities and configuration are bounded; SQLITE_FULL refuses
+new work atomically instead of discarding unexpired deduplication evidence.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import uuid
+
+
+class OutboxError(ValueError):
+    """A stable error code suitable for the private service boundary."""
+
+
+class Outbox:
+    MAX_IDENTITIES = 4096
+    MAX_OWNERS = 128
+    IDENTITY_RETENTION_MS = 604800000
+
+    def __init__(self, path, now_ms, max_rows=256, max_device_bytes=1048576,
+                 max_profile_bytes=8388608, ttl_ms=86400000):
+        for value, maximum in ((max_rows, 256), (max_device_bytes, 1048576),
+                               (max_profile_bytes, 8388608), (ttl_ms, 86400000)):
+            if type(value) is not int or not 1 <= value <= maximum:
+                raise OutboxError('invalid_request')
+        self.path, self.now_ms = Path(path), now_ms
+        self.max_rows, self.max_device_bytes = max_rows, max_device_bytes
+        self.max_profile_bytes, self.ttl_ms = max_profile_bytes, ttl_ms
+        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        try:
+            descriptor = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+        except FileExistsError:
+            pass
+        else:
+            os.close(descriptor)
+        os.chmod(self.path, 0o600)
+        with self.tx() as db:
+            db.execute('CREATE TABLE IF NOT EXISTS deliveries ('
+                       'seq INTEGER PRIMARY KEY, owner TEXT NOT NULL, event TEXT NOT NULL, '
+                       'id TEXT UNIQUE NOT NULL, digest TEXT NOT NULL, body TEXT, size INTEGER NOT NULL, '
+                       'expires INTEGER NOT NULL, retire INTEGER NOT NULL, ack INTEGER NOT NULL DEFAULT 0, '
+                       'UNIQUE(owner,event))')
+            db.execute('CREATE TABLE IF NOT EXISTS gaps (owner TEXT PRIMARY KEY, generation INTEGER NOT NULL)')
+            db.execute('CREATE TABLE IF NOT EXISTS optins (owner TEXT PRIMARY KEY, generation INTEGER NOT NULL)')
+
+    @contextmanager
+    def tx(self):
+        db = None
+        try:
+            db = sqlite3.connect(self.path, timeout=5)
+            db.row_factory = sqlite3.Row
+            db.execute('PRAGMA page_size=4096')
+            db.execute('PRAGMA auto_vacuum=INCREMENTAL')
+            if db.execute('PRAGMA page_size').fetchone()[0] != 4096:
+                raise OutboxError('temporarily_unavailable')
+            if db.execute('PRAGMA max_page_count=4096').fetchone()[0] > 4096:
+                raise OutboxError('busy')
+            db.execute('PRAGMA journal_mode=DELETE')
+            db.execute('PRAGMA journal_size_limit=1048576')
+            # Keep a single journal segment: no mid-transaction cache-spill headers.
+            db.execute('PRAGMA cache_spill=OFF')
+            db.execute('PRAGMA synchronous=FULL')
+            db.execute('PRAGMA secure_delete=ON')
+            db.execute('PRAGMA fullfsync=ON')
+            db.execute('BEGIN IMMEDIATE')
+            yield db
+            db.execute('PRAGMA incremental_vacuum(128)').fetchall()
+            db.commit()
+        except sqlite3.Error as exc:
+            if db is not None:
+                db.rollback()
+            code = getattr(exc, 'sqlite_errorcode', 0) & 0xff
+            if code in (sqlite3.SQLITE_FULL, sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED):
+                raise OutboxError('busy') from exc
+            raise OutboxError('temporarily_unavailable') from exc
+        except BaseException:
+            if db is not None:
+                db.rollback()
+            raise
+        finally:
+            if db is not None:
+                db.close()
+
+    @staticmethod
+    def _string(value, maximum):
+        if not isinstance(value, str) or not value:
+            raise OutboxError('invalid_request')
+        try:
+            size = len(value.encode('utf-8'))
+        except UnicodeEncodeError as exc:
+            raise OutboxError('invalid_request') from exc
+        if size > maximum:
+            raise OutboxError('invalid_request')
+
+    def _time(self):
+        now = self.now_ms()
+        if type(now) is not int or not 0 <= now <= 9223372036854775807 - 691200000:
+            raise OutboxError('invalid_request')
+        return now
+
+    def _ensure_owner(self, db, owner):
+        if db.execute('SELECT 1 FROM gaps WHERE owner=?', (owner,)).fetchone():
+            return
+        if db.execute('SELECT count(*) FROM gaps').fetchone()[0] >= self.MAX_OWNERS:
+            raise OutboxError('busy')
+        db.execute('INSERT INTO gaps VALUES (?,0)', (owner,))
+
+    @staticmethod
+    def _gap(db, owner):
+        # Owner admission and reconciliation bound the table independently of rows.
+        db.execute('UPDATE gaps SET generation=min(generation+1,9223372036854775807) '
+                   'WHERE owner=?', (owner,))
+
+    def _purge(self, db, now):
+        for row in db.execute('SELECT owner,count(*) AS n FROM deliveries '
+                              'WHERE body IS NOT NULL AND ack=0 AND expires<=? '
+                              'GROUP BY owner', (now,)).fetchall():
+            db.execute('UPDATE gaps SET generation=min(generation+?,9223372036854775807) '
+                       'WHERE owner=?', (row['n'], row['owner']))
+        db.execute('UPDATE deliveries SET body=NULL,size=0 WHERE body IS NOT NULL AND expires<=?', (now,))
+        db.execute('DELETE FROM deliveries WHERE retire<=?', (now,))
+
+    def _trim(self, db, owner):
+        while True:
+            own = db.execute('SELECT coalesce(sum(ack=0),0),coalesce(sum(size),0) '
+                             'FROM deliveries WHERE owner=? AND body IS NOT NULL', (owner,)).fetchone()
+            total = db.execute('SELECT coalesce(sum(size),0) FROM deliveries').fetchone()[0]
+            if own[0] > self.max_rows:
+                row = db.execute('SELECT seq,owner,ack FROM deliveries WHERE owner=? '
+                                 'AND body IS NOT NULL AND ack=0 ORDER BY seq LIMIT 1', (owner,)).fetchone()
+            elif own[1] > self.max_device_bytes:
+                row = db.execute('SELECT seq,owner,ack FROM deliveries WHERE owner=? '
+                                 'AND body IS NOT NULL ORDER BY seq LIMIT 1', (owner,)).fetchone()
+            elif total > self.max_profile_bytes:
+                row = db.execute('SELECT seq,owner,ack FROM deliveries WHERE body IS NOT NULL '
+                                 'ORDER BY seq LIMIT 1').fetchone()
+            else:
+                return
+            if not row['ack']:
+                self._gap(db, row['owner'])
+            db.execute('UPDATE deliveries SET body=NULL,size=0 WHERE seq=?', (row['seq'],))
+
+    def put(self, owner, event_id, conversation_id, text, include_created=False):
+        self._string(owner, 128)
+        self._string(event_id, 256)
+        self._string(conversation_id, 128)
+        self._string(text, 16384)
+        digest = hashlib.sha256(json.dumps([conversation_id, text], ensure_ascii=False).encode()).hexdigest()
+        with self.tx() as db:
+            now = self._time()
+            self._purge(db, now)
+            old = db.execute('SELECT digest,body FROM deliveries WHERE owner=? AND event=?',
+                             (owner, event_id)).fetchone()
+            if old:
+                if old['digest'] != digest:
+                    raise OutboxError('conflict')
+                if old['body'] is None:
+                    raise OutboxError('expired')
+                item = json.loads(old['body'])
+                return (item, False) if include_created else item
+            if db.execute('SELECT count(*) FROM deliveries').fetchone()[0] >= self.MAX_IDENTITIES:
+                raise OutboxError('busy')
+            self._ensure_owner(db, owner)
+            item = dict(delivery_id=str(uuid.uuid4()), conversation_id=conversation_id,
+                        event_id=event_id, created_at_ms=now, expires_at_ms=now+self.ttl_ms,
+                        payload={'kind': 'final_text', 'text': text})
+            body = json.dumps(item, separators=(',', ':'), ensure_ascii=False)
+            if len(body.encode()) > min(self.max_device_bytes, self.max_profile_bytes):
+                raise OutboxError('busy')
+            db.execute('INSERT INTO deliveries(owner,event,id,digest,body,size,expires,retire) '
+                       'VALUES (?,?,?,?,?,?,?,?)', (owner, event_id, item['delivery_id'], digest, body,
+                       len(body.encode()), item['expires_at_ms'], item['expires_at_ms']+self.IDENTITY_RETENTION_MS))
+            self._trim(db, owner)
+            return (item, True) if include_created else item
+
+    def read(self, owner, limit):
+        self._string(owner, 128)
+        if type(limit) is not int or not 1 <= limit <= 50:
+            raise OutboxError('invalid_request')
+        with self.tx() as db:
+            self._purge(db, self._time())
+            rows = db.execute('SELECT body FROM deliveries WHERE owner=? AND ack=0 '
+                              'AND body IS NOT NULL ORDER BY seq LIMIT ?', (owner, limit)).fetchall()
+            gap = db.execute('SELECT generation FROM gaps WHERE owner=?', (owner,)).fetchone()
+            return dict(items=[json.loads(row[0]) for row in rows], next_cursor=None,
+                        gap_generation=gap[0] if gap else 0)
+
+    def ack(self, owner, ids):
+        self._string(owner, 128)
+        if not isinstance(ids, list) or not 1 <= len(ids) <= 50:
+            raise OutboxError('invalid_request')
+        for identifier in ids:
+            self._string(identifier, 128)
+        with self.tx() as db:
+            self._purge(db, self._time())
+            for identifier in ids:
+                row = db.execute('SELECT owner FROM deliveries WHERE id=?', (identifier,)).fetchone()
+                if row is None or row[0] != owner:
+                    raise OutboxError('not_found')
+            db.executemany('UPDATE deliveries SET ack=1 WHERE owner=? AND id=?', [(owner, x) for x in ids])
+        return list(ids)
+
+    def opt_in(self, owner, generation):
+        self._string(owner, 128)
+        if type(generation) is not int or not 1 <= generation <= 9223372036854775807:
+            raise OutboxError('invalid_request')
+        with self.tx() as db:
+            self._ensure_owner(db, owner)
+            db.execute('INSERT INTO optins VALUES (?,?) ON CONFLICT(owner) '
+                       'DO UPDATE SET generation=excluded.generation', (owner, generation))
+
+    def opt_out(self, owner):
+        self._string(owner, 128)
+        with self.tx() as db:
+            db.execute('DELETE FROM optins WHERE owner=?', (owner,))
+            db.execute('UPDATE deliveries SET body=NULL,size=0 WHERE owner=?', (owner,))
+            db.execute('DELETE FROM gaps WHERE owner=?', (owner,))
+
+    def is_opted_in(self, owner, generation):
+        self._string(owner, 128)
+        if type(generation) is not int or not 1 <= generation <= 9223372036854775807:
+            raise OutboxError('invalid_request')
+        with self.tx() as db:
+            row = db.execute('SELECT generation FROM optins WHERE owner=?', (owner,)).fetchone()
+            return row is not None and row[0] == generation
+
+    def cleanup(self):
+        """Expire payloads/identities without interpreting grant authority.
+
+        The service's idle sweep must still honor configured retention when a
+        grant file is temporarily unreadable. No owner or opt-in is revoked.
+        """
+        with self.tx() as db:
+            self._purge(db, self._time())
+
+    def reconcile_owners(self, owners):
+        """Grant integration supplies the current enrollment-bound owner allowlist.
+
+        Removed owners lose bodies/opt-in/gaps atomically. Retry identities remain
+        until their original retirement, so key rotation cannot refill old work.
+        This method grants no authority and does not opt in newly allowed owners.
+        """
+        if not isinstance(owners, (list, tuple, set, frozenset)) or len(owners) > self.MAX_OWNERS:
+            raise OutboxError('invalid_request')
+        for owner in owners:
+            self._string(owner, 128)
+        with self.tx() as db:
+            self._purge(db, self._time())
+            active = set(owners)
+            # Python selection avoids interpolating caller strings into SQL.
+            stale = [row[0] for row in db.execute('SELECT owner FROM gaps UNION SELECT owner FROM optins')
+                     if row[0] not in active]
+            for owner in stale:
+                db.execute('DELETE FROM optins WHERE owner=?', (owner,))
+                db.execute('DELETE FROM gaps WHERE owner=?', (owner,))
+                db.execute('UPDATE deliveries SET body=NULL,size=0 WHERE owner=?', (owner,))
