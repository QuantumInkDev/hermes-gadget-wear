+def test_real_subprocess_restart_loopback_trace(tmp_path, record_testsuite_property):
+    async def run():
+        import subprocess
+        from websockets.asyncio.client import connect
+        from hermes_gadget_plugin import protocol
+        root = tmp_path.resolve()
+        trace = []
+        processes = []
+        async def start():
+            process = subprocess.Popen([sys.executable, str(Path(__file__).with_name('relay_process_fixture.py')),
+                                        str(root), str(core)], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                       stderr=subprocess.PIPE, text=True)
+            processes.append(process)
+            line = await asyncio.wait_for(asyncio.to_thread(process.stdout.readline), 30)
+            assert line, process.stderr.read()
+            return process, json.loads(line)
+        async def socket(info):
+            ws = await connect(f'ws://127.0.0.1:{info["port"]}/gadget', subprotocols=['hermes-gadget.v1'])
+            await ws.send(json.dumps(dict(type='hello', proto=1, device_id=info['device_id'],
+                                          caps={'relay': {'version': 1}})))
+            challenge = json.loads(await ws.recv())
+            trace.append({'type': 'challenge', 'enrolled': challenge['enrolled']})
+            await ws.send(json.dumps(dict(type='auth', mac=protocol.auth_mac(
+                b'synthetic-loopback-device-key-01', info['device_id'], challenge['nonce']))))
+            welcome = json.loads(await ws.recv())
+            assert welcome['paired'] and welcome['relay'] == {'version': 1}
+            trace.append(welcome)
+            return ws
+        async def request(ws, method, **params):
+            await ws.send(json.dumps(dict(type='relay.request', v=1, id='process', method=method, params=params)))
+            raw = await asyncio.wait_for(ws.recv(), 5)
+            assert isinstance(raw, str)
+            result = json.loads(raw)
+            assert result['type'] == 'relay.response'
+            trace.append(result)
+            return result
+        async def stop(process):
+            process.stdin.write('stop\n')
+            process.stdin.flush()
+            assert await asyncio.to_thread(process.wait, 15) == 0
+            for stream in (process.stdin, process.stdout, process.stderr):
+                stream.close()
+            processes.remove(process)
+        try:
+            process, info = await start()
+            ws = await socket(info)
+            assert (await request(ws, 'relay.info'))['result']['profile_id'] == PROFILE
+            await ws.send(json.dumps(dict(type='text', id='process-input', text='synthetic question')))
+            assert json.loads(await ws.recv())['type'] == 'turn.start'
+            await ws.close()
+            trace.append({'type': 'socket.interrupted'})
+            process.stdin.write('finish\n')
+            process.stdin.flush()
+            saved = json.loads(await asyncio.wait_for(asyncio.to_thread(process.stdout.readline), 15))
+            assert saved['success']
+            await stop(process)
+            process, info = await start()
+            trace.append({'type': 'process.restarted'})
+            ws = await socket(info)
+            items = (await request(ws, 'relay.outbox.read'))['result']['items']
+            assert len(items) == 1 and items[0]['delivery_id'] == saved['delivery_id']
+            assert items[0]['payload']['text'] == 'synthetic process final'
+            for _ in range(2):
+                assert (await request(ws, 'relay.outbox.ack', delivery_ids=[saved['delivery_id']]))['result']['acknowledged'] == [saved['delivery_id']]
+            assert (await request(ws, 'relay.outbox.read'))['result']['items'] == []
+            await ws.close()
+            await stop(process)
+            assert all(x['type'] not in {'tts.speak', 'audio.start', 'audio.end', 'text', 'action', 'prompt'} for x in trace)
+            record_testsuite_property('relay_restart_trace', json.dumps(trace))
+        finally:
+            for process in processes:
+                process.kill()
+                process.wait()
+                for stream in (process.stdin, process.stdout, process.stderr):
+                    stream.close()
+    asyncio.run(run())
+
+
+def test_native_snapshot_restore_keeps_original_enrollment_identity(rig):
+    async def run():
+        from gateway.session_envelope import snapshot_native, restore_native
+        from gateway.session_ingress_context import register_transport_home, native_callback
+        from gateway.session_ingress import deliver_response
+        adapter = await rig.start()
+        ws, _ = await rig.socket()
+        event = adapter._event(adapter.hub.get(rig.device), 'native-restored', 'question')
+        store = attach_store(rig)
+        key = store.get_or_create_session(event.source).session_key
+        from gateway.session_authority import SessionAuthority
+        from hermes_state_runtime import begin_runtime_epoch
+        rig.runner.session_authority = SessionAuthority(
+            rig.runner, profile_id=str(rig.root), instance_id='synthetic', db=store._db,
+            epoch=begin_runtime_epoch(store._db, instance_id='synthetic'))
+        register_transport_home(rig.runner, None, rig.root)
+        with native_callback(rig.runner, event, rig.root):
+            payload = snapshot_native(rig.runner, event)
+        restored = restore_native(json.loads(json.dumps(payload)), rig.runner)
+        assert restored.message_id == event.message_id
+        assert adapter.final_delivery_context(restored, key) == adapter.final_delivery_context(event, key)
+        await deliver_response(adapter, restored, key, 'native recovered text')
+        items = (await rig.request(ws, 'relay.outbox.read'))['result']['items']
+        assert len(items) == 1 and items[0]['payload']['text'] == 'native recovered text'
+        await ws.close()
+        store._db.close()
+        store.close_all_db_handles()
+        await rig.close()
+    asyncio.run(run())
