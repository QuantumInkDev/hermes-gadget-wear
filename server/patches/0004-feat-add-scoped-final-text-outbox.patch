+@pytest.mark.parametrize('mode', ['queue', 'redirect'])
+def test_terminal_handoff_ledger_failure_real_process_restart(tmp_path, mode):
+    async def run():
+        import subprocess
+        import sys
+        from websockets.asyncio.client import connect
+        from hermes_gadget_plugin.protocol import auth_mac
+        from test_relay_adapter import core
+        processes = []
+        async def start():
+            p = subprocess.Popen([sys.executable, '-W', 'error', str(Path(__file__).with_name('relay_recovery_process_fixture.py')),
+                                  str(tmp_path), str(core), mode], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                 stderr=subprocess.PIPE, text=True)
+            processes.append(p)
+            line = await asyncio.wait_for(asyncio.to_thread(p.stdout.readline), 15)
+            assert line, p.stderr.read()
+            return p, json.loads(line)
+        async def socket(info):
+            ws = await connect(f'ws://127.0.0.1:{info["port"]}/gadget', subprotocols=['hermes-gadget.v1'])
+            await ws.send(json.dumps({'type': 'hello', 'proto': 1, 'device_id': info['device_id'], 'caps': {'relay': {'version': 1}}}))
+            challenge = json.loads(await ws.recv())
+            await ws.send(json.dumps({'type': 'auth', 'mac': auth_mac(b'synthetic-loopback-device-key-01', info['device_id'], challenge['nonce'])}))
+            assert json.loads(await ws.recv())['relay'] == {'version': 1}
+            return ws
+        async def stop(p):
+            p.stdin.write('stop\n')
+            p.stdin.flush()
+            assert await asyncio.to_thread(p.wait, 15) == 0
+            for stream in (p.stdin, p.stdout, p.stderr):
+                stream.close()
+            processes.remove(p)
+        async def read(ws):
+            await ws.send(json.dumps({'type': 'relay.request', 'v': 1, 'id': 'read', 'method': 'relay.outbox.read', 'params': {}}))
+            result = json.loads(await ws.recv())
+            assert result['type'] == 'relay.response'
+            return result['result']['items']
+        try:
+            p, info = await start()
+            ws = await socket(info)
+            await ws.send(json.dumps({'type': 'text', 'id': 'opening-A', 'text': 'question'}))
+            assert json.loads(await ws.recv())['type'] == 'turn.start'
+            assert json.loads(await asyncio.wait_for(asyncio.to_thread(p.stdout.readline), 15)) == {'failed': True}
+            await ws.close()
+            await stop(p)
+            p, info = await start()
+            assert (info['reconstructed'], info['redelivered']) == (1, 1)
+            ws = await socket(info)
+            items = await read(ws)
+            assert len(items) == 1 and items[0]['payload']['text'] == 'process handoff final'
+            first = items[0]['delivery_id']
+            await ws.close()
+            await stop(p)
+            p, info = await start()
+            assert (info['reconstructed'], info['redelivered']) == (0, 0)
+            ws = await socket(info)
+            assert [item['delivery_id'] for item in await read(ws)] == [first]
+            await ws.close()
+            await stop(p)
+        finally:
+            for p in processes:
+                p.kill()
+                p.wait()
+                for stream in (p.stdin, p.stdout, p.stderr):
+                    stream.close()
+    asyncio.run(run())
