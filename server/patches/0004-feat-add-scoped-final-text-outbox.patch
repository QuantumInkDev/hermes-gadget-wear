+def test_utf8_input_frame_budget_does_not_expand_into_sender_encoding(rig):
+    # Incoming UTF-8 and outgoing ASCII-escaped bytes are separate budgets.
+    async def scenario():
+        msg = dict(type='relay.request', v=1, id='a', method='', params={})
+        remaining = 65536 - len(json.dumps(msg, ensure_ascii=False, separators=(',', ':')).encode())
+        msg['method'] = 'é' * (remaining // 2) + 'x' * (remaining % 2)
+        assert len(json.dumps(msg, ensure_ascii=False, separators=(',', ':')).encode()) == 65536
+        await rig.service.request(rig.session, msg)
+        assert_code(rig.session.sent[-1], 'unsupported')
+        msg['method'] += 'x'
+        await rig.service.request(rig.session, msg)
+        assert_code(rig.session.sent[-1], 'invalid_request')
+    run(scenario())
