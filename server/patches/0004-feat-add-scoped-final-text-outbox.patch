+"""Private configuration is authority only after a complete valid read."""
+
+import copy
+import hashlib
+import json
+import os
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_gadget_plugin.relay_grants import Grants
+from hermes_gadget_plugin.relay_outbox import OutboxError
+
+
+PROFILE = '9e8af651-47eb-411f-b28c-ed292bbfd305'
+
+
+def fixture_grants(tmp_path):
+    path = tmp_path / 'relay-grants.json'
+    key = [b'first-key']
+    verdict = [True]
+    clock = [1000]
+    data = {'schema': 1, 'profile_id': PROFILE, 'generation': 1,
+            'devices': {'phone': {'key_sha256': hashlib.sha256(key[0]).hexdigest(),
+                                  'expires_at_ms': 5000, 'outbox': True}}}
+    def save():
+        path.write_text(json.dumps(data))
+        os.chmod(path, 0o600)
+    save()
+    grants = Grants(path, SimpleNamespace(key_for=lambda _: key[0]),
+                    lambda _: verdict[0], lambda: clock[0])
+    return path, key, verdict, clock, data, save, grants
+
+
+def test_recheck_key_and_revocation(tmp_path):
+    path, key, verdict, clock, data, save, grants = fixture_grants(tmp_path)
+    initial = grants.get('phone')
+    assert initial == {'profile_id': PROFILE, 'owner': hashlib.sha256(json.dumps(
+        [PROFILE, 'phone', hashlib.sha256(key[0]).hexdigest()]).encode()).hexdigest(),
+        'generation': 1, 'expires_at_ms': 5000}
+    key[0] = b'replacement-key'
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.get('phone')
+    key[0] = b'first-key'
+    data['devices'] = {}
+    save()
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.get('phone')
+    assert grants.snapshot() == {}
+
+
+@pytest.mark.parametrize('refusal', ['expired', 'missing', 'invalid', 'false', 'none',
+                                    'no-key', 'key-mismatch', 'outbox-off', 'public'])
+def test_refusals(tmp_path, refusal):
+    path, key, verdict, clock, data, save, grants = fixture_grants(tmp_path)
+    if refusal == 'expired':
+        clock[0] = 5000
+    elif refusal in ('false', 'none'):
+        verdict[0] = False if refusal == 'false' else None
+    elif refusal == 'no-key':
+        key[0] = None
+    elif refusal == 'key-mismatch':
+        key[0] = b'other'
+    elif refusal == 'outbox-off':
+        data['devices']['phone']['outbox'] = False
+        save()
+    elif refusal == 'missing':
+        path.unlink()
+    elif refusal == 'invalid':
+        path.write_bytes(b'{broken private bytes')
+    elif refusal == 'public':
+        os.chmod(path, 0o644)
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.get('phone')
+
+
+@pytest.mark.parametrize('field,value', [('schema', True), ('schema', 2),
+    ('profile_id', 'private/path'), ('profile_id', 3), ('generation', True),
+    ('generation', 0), ('generation', 2147483648), ('devices', []),
+    ('devices', {'x' * 129: {}}), ('unknown', 'field')])
+def test_invalid_top_level(tmp_path, field, value):
+    path, _, _, _, data, save, grants = fixture_grants(tmp_path)
+    data[field] = value
+    save()
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.snapshot()
+
+
+@pytest.mark.parametrize('field,value', [('key_sha256', 'f' * 63),
+    ('key_sha256', 'G' * 64), ('key_sha256', 3), ('expires_at_ms', True),
+    ('expires_at_ms', -1), ('expires_at_ms', 2**63), ('outbox', 1),
+    ('extra', 'secret')])
+def test_malformed_other_grant_invalidates_whole_snapshot(tmp_path, field, value):
+    path, _, _, _, data, save, grants = fixture_grants(tmp_path)
+    other = copy.deepcopy(data['devices']['phone'])
+    other[field] = value
+    data['devices']['other'] = other
+    save()
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.get('phone')
+
+
+def test_bounded_complete_snapshot_and_file_replacement(tmp_path):
+    path, _, verdict, _, data, save, grants = fixture_grants(tmp_path)
+    grant = data['devices']['phone']
+    data['devices'] = {str(i): grant for i in range(128)}
+    save()
+    assert len(grants.snapshot()) == 128
+    data['devices']['129'] = grant
+    save()
+    with pytest.raises(OutboxError, match='permission_denied'):
+        grants.snapshot()
+    data['devices'] = {'phone': grant}
+    data['generation'] = 2
+    replacement = path.with_suffix('.new')
+    replacement.write_text(json.dumps(data))
+    os.chmod(replacement, 0o600)
+    os.replace(replacement, path)
+    assert grants.get('phone')['generation'] == 2
+    verdict[0] = None
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.snapshot()
+
+
+@pytest.mark.parametrize('raw', [b'x' * 65537, b'[]', b'null', b'\xff',
+    b'{"schema":1,"schema":1}', b'[' * 2000 + b']' * 2000])
+def test_bad_or_oversized_bytes(tmp_path, raw):
+    path, *_, grants = fixture_grants(tmp_path)
+    path.write_bytes(raw)
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.snapshot()
+
+
+def test_symlink_and_nonregular_state_refused(tmp_path):
+    path, *_, grants = fixture_grants(tmp_path)
+    target = path.with_suffix('.real')
+    path.rename(target)
+    path.symlink_to(target)
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.snapshot()
+    path.unlink()
+    path.mkdir()
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.snapshot()
+
+
+def test_windows_activation_refused_without_actual_host_acl_preflight(tmp_path, monkeypatch):
+    _, *_, grants = fixture_grants(tmp_path)
+    import hermes_gadget_plugin.relay_grants as module
+    monkeypatch.setattr(module, 'os', SimpleNamespace(name='nt'))
+    with pytest.raises(OutboxError, match='^permission_denied$'):
+        grants.get('phone')
