+        # Root depth 1, params depth 2, leaf depth 8 is the inclusive bound.
+        reply = await rig.request('relay.unknown', nested)
+        assert_code(reply, 'unsupported')
+        reply = await rig.request('relay.unknown', {'x': nested})
+        assert_code(reply, 'invalid_request')
+    run(scenario())
