+"""Offline integration with actual Hermes core and loopback Gadget sockets.
+
+Run via the core's scripts/run_tests.sh with this absolute test path. No core
+skip: a missing/incompatible import is a failure. The canonical runner strips
+caller environment; its cwd is the explicitly selected isolated core fixture.
+"""
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+os.environ.setdefault('HERMES_HOME', tempfile.mkdtemp(prefix='gadget-relay-core-'))
+core = Path(os.environ.get('HERMES_AGENT_DIR', Path.cwd()))
+if (core / 'gateway/platforms/base.py').is_file():
+    sys.path.insert(0, str(core))
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.config import PlatformConfig
+from gateway.platform_registry import PlatformEntry, platform_registry
+from hermes_gadget_plugin.adapter import GadgetAdapter
+from hermes_gadget_plugin.store import DeviceStore
+from hermes_gadget_plugin.relay_grants import Grants
+from hermes_gadget_plugin.relay_outbox import Outbox
+from hermes_gadget_plugin.relay_service import RelayService
+
+platform_registry.register(PlatformEntry(name='gadget', label='Gadget',
+    adapter_factory=lambda c: GadgetAdapter(c), check_fn=lambda: True, source='builtin'))
+
+
+def test_actual_core_contract_and_stock_fallback(monkeypatch):
+    async def run():
+        assert GadgetAdapter.__mro__[1] is BasePlatformAdapter
+        adapter = GadgetAdapter(PlatformConfig(enabled=True, extra={}))
+        inherited = BasePlatformAdapter.send_final_ledgered
+        calls = []
+        async def spy(owner, *args, **kwargs):
+            calls.append(args)
+            return await inherited(owner, *args, **kwargs)
+        monkeypatch.setattr(BasePlatformAdapter, 'send_final_ledgered', spy)
+        monkeypatch.setattr(adapter, '_send_with_retry', AsyncMock(return_value=SendResult(success=True)))
+        event = SimpleNamespace(source=SimpleNamespace(chat_id='phone', user_id='phone'),
+                                message_id='input', ledger_message_id=None, text='question')
+        result, owner = await adapter.send_final_ledgered(event, 'session', 'answer', {}, reply_to=None)
+        assert result.success and owner is adapter
+        assert len(calls) == 1
+        assert adapter._relay_service is None
+        assert BasePlatformAdapter.FINAL_DELIVERY_CONTEXT_VERSION == 2
+    asyncio.run(run())
+
+
+def test_unhealthy_enrollment_is_not_revocation(tmp_path):
+    store = DeviceStore(tmp_path)
+    store.enroll('phone', b'x' * 32)
+    store.path.write_text('{broken')
+    with pytest.raises(ValueError):
+        store.enrollment_snapshot()
+
+
+PROFILE = '9e8af651-47eb-411f-b28c-ed292bbfd305'
+
+class SocketRig:
+    def __init__(self, root, monkeypatch):
+        from gateway import delivery_ledger as ledger
+        self.root = root.resolve()
+        self.key = b'synthetic-loopback-device-key-01'
+        from hermes_gadget_plugin.protocol import device_id_for_key
+        self.device = device_id_for_key(self.key)
+        self.directory = self.root / 'plugin-data/gadget'
+        self.directory.mkdir(parents=True, exist_ok=True)
+        self.grant = {'schema': 1, 'profile_id': PROFILE, 'generation': 1,
+                      'devices': {self.device: {'key_sha256': hashlib.sha256(self.key).hexdigest(),
+                                              'expires_at_ms': 9223372036854775807, 'outbox': True}}}
+        self.save_grant()
+        device_path = self.directory / DeviceStore.FILENAME
+        if not device_path.exists():
+            device_path.write_text('{"devices":{},"pairing":{}}')
+        self.devices = DeviceStore(self.directory)
+        self.devices.enroll(self.device, self.key)
+        import plugins.plugin_storage as storage
+        monkeypatch.setattr(storage, 'plugin_data_dir', lambda name: self.directory)
+        monkeypatch.setattr(ledger, '_db_path', lambda: self.root / 'state.db')
+        monkeypatch.setattr(ledger, 'ledger_enabled', lambda: True)
+        self.ledger = ledger
+        self.adapters = []
+        self.trace = []
+
+    def save_grant(self):
+        path = self.directory / 'relay-grants.json'
+        path.write_text(json.dumps(self.grant))
+        path.chmod(0o600)
+
+    async def start(self, *, enabled=True, auth=True, **extra):
+        from gateway.run import GatewayRunner
+        from gateway.config import GatewayConfig
+        adapter = GadgetAdapter(PlatformConfig(enabled=True, extra={
+            'host': '127.0.0.1', 'port': 0, 'auto_home': False,
+            'enable_relay_outbox': enabled, 'allow_from': [self.device], **extra}))
+        # Real runner class, its real callback constructor and actual allowlist
+        # implementation. No __init__ (which starts unrelated providers/services).
+        runner = GatewayRunner.__new__(GatewayRunner)
+        runner.config = GatewayConfig()
+        runner.adapters = {adapter.platform: adapter}
+        runner._profile_adapters = {}
+        runner.pairing_store = None
+        runner._background_tasks = set()
+        runner._running = False
+        if auth:
+            adapter.set_authorization_check(runner._make_adapter_auth_check(adapter.platform))
+        assert await adapter.connect()
+        self.adapters.append(adapter)
+        self.adapter, self.runner = adapter, runner
+        return adapter
+
+    async def close(self, adapter=None):
+        adapter = adapter or self.adapter
+        await adapter.cancel_background_tasks()
+        tasks = [x for x in (adapter._watch_task, adapter._update_task) if x]
+        await adapter.disconnect()
+        await asyncio.gather(*tasks, return_exceptions=True)
+        self.adapters.remove(adapter)
+
+    async def socket(self, *, relay=True, key=None, **hello_fields):
+        from websockets.asyncio.client import connect
+        from hermes_gadget_plugin import protocol
+        ws = await connect(f'ws://127.0.0.1:{self.adapter.hub.bound_port}/gadget',
+                           subprotocols=['hermes-gadget.v1'])
+        caps = {'relay': {'version': 1}} if relay else {}
+        caps.update(hello_fields.pop('caps', {}))
+        await ws.send(json.dumps(dict(type='hello', proto=1, device_id=self.device,
+                                      caps=caps, **hello_fields)))
+        challenge = json.loads(await ws.recv())
+        assert challenge['type'] == 'challenge'
+        self.trace.append({'type': 'challenge', 'enrolled': challenge['enrolled']})
+        key = key or self.key
+        auth = dict(type='auth', mac=protocol.auth_mac(key, self.device, challenge['nonce']))
+        if not challenge['enrolled']:
+            import base64
+            auth = dict(type='auth', key=base64.b64encode(key).decode())
+        await ws.send(json.dumps(auth))
+        welcome = json.loads(await ws.recv())
+        self.trace.append(welcome)
+        return ws, welcome
+
+    async def request(self, ws, method='relay.info', **params):
+        await ws.send(json.dumps(dict(type='relay.request', v=1, id='r1', method=method, params=params)))
+        response = json.loads(await asyncio.wait_for(ws.recv(), 3))
+        self.trace.append(response)
+        return response
+
+
+@pytest.fixture
+def rig(tmp_path, monkeypatch):
+    return SocketRig(tmp_path, monkeypatch)
+
+
+def test_socket_disconnected_final_restart_read_ack_and_identity(rig):
+    async def run():
+        adapter = await rig.start()
+        ws, welcome = await rig.socket(auth_key_sha256='forged-client-field')
+        assert welcome['paired'] is True and welcome['relay'] == {'version': 1}
+        session = adapter.hub.get(rig.device)
+        assert session.auth_key_sha256 == hashlib.sha256(rig.key).hexdigest()
+        assert (await rig.request(ws))['result']['profile_id'] == PROFILE
+        first = adapter._event(session, 'input-1', 'question')
+        second = adapter._event(session, 'input-2', 'question')
+        await ws.close()
+        result, _ = await adapter.send_final_ledgered(first, 'synthetic-session', 'answer', {}, reply_to=None)
+        assert result.success
+        again, _ = await adapter.send_final_ledgered(first, 'synthetic-session', 'answer', {}, reply_to=None)
+        assert again.message_id == result.message_id
