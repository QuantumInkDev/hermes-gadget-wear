+"""Synthetic subprocess server for test_relay_adapter; no provider/model calls."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import sys
+
+# Set home/source BEFORE conftest probes or any core import.
+root = Path(sys.argv[1]).resolve()
+os.environ['HERMES_HOME'] = str(root / 'hermes-home')
+os.environ['HERMES_AGENT_DIR'] = sys.argv[2]
+Path(os.environ['HERMES_HOME']).mkdir(parents=True, exist_ok=True)
+import conftest  # noqa: E402,F401
+import pytest  # noqa: E402
+from test_relay_adapter import SocketRig  # noqa: E402
+
+
+async def main():
+    patch = pytest.MonkeyPatch()
+    rig = SocketRig(root, patch)
+    adapter = await rig.start()
+    finish, committed = asyncio.Event(), asyncio.Event()
+    async def handler(event):
+        (root / 'accepted.json').write_text(json.dumps({'identity': event.message_id}))
+        await finish.wait()
+        return 'synthetic process final'
+    adapter.set_message_handler(handler)
+    original = adapter.send_final_ledgered
+    async def record(*args, **kwargs):
+        result = await original(*args, **kwargs)
+        (root / 'committed.json').write_text(json.dumps({'delivery_id': result[0].message_id,
+                                                       'success': result[0].success}))
+        committed.set()
+        return result
+    adapter.send_final_ledgered = record
+    print(json.dumps({'port': adapter.hub.bound_port, 'device_id': rig.device}), flush=True)
+    try:
+        while True:
+            command = await asyncio.to_thread(sys.stdin.readline)
+            if not command or command.strip() == 'stop':
+                break
+            if command.strip() == 'finish':
+                finish.set()
+                await asyncio.wait_for(committed.wait(), 10)
+                print((root / 'committed.json').read_text(), flush=True)
+    finally:
+        await rig.close()
+        patch.undo()
+
+
+asyncio.run(main())
