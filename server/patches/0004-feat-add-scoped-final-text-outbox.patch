+class Session:
+    def __init__(self, device='phone'):
+        self.device_id, self.paired = device, True
+        self.caps, self.sent, self.frames = {'relay': {'version': 1}}, [], []
+
+    async def send_json(self, obj):
+        # Actual current SDK sender is ASCII-escaped; budget this too until Task 3.
+        frame = json.dumps({k: v for k, v in obj.items() if v is not None}, separators=(',', ':'))
+        assert len(frame.encode('utf-8')) <= 65536
+        assert obj['type'] == 'relay.response'
+        self.frames.append(frame)
+        self.sent.append(copy.deepcopy(obj))
+
+    def __getattr__(self, name):
+        if name.startswith(('send_', 'tts', 'provider')):
+            raise AssertionError('service attempted non-relay side effect: ' + name)
+        raise AttributeError(name)
