@@ -0,0 +1,342 @@
+"""Durable outbox: retry identity, bounded storage and real commit crash boundaries."""
+
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import closing, contextmanager
+import json
+import queue
+import sqlite3
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from hermes_gadget_plugin.relay_outbox import Outbox, OutboxError
+
+
+def stored_bytes(path):
+    with closing(sqlite3.connect(path)) as db:
+        return db.execute('SELECT coalesce(sum(size),0) FROM deliveries').fetchone()[0]
+
+
+def test_restart_lost_ack_and_no_cross_device_ack(tmp_path):
+    path = tmp_path / 'outbox.sqlite3'
+    box = Outbox(path, lambda: 1000)
+    first = box.put('phone', 'event-a', 'conversation-a', 'finished')
+    restarted = Outbox(path, lambda: 1001)
+    assert restarted.read('phone', 25) == {
+        'items': [first], 'next_cursor': None, 'gap_generation': 0}
+    assert restarted.put('phone', 'event-a', 'conversation-a', 'finished') == first
+    with pytest.raises(OutboxError, match='not_found'):
+        restarted.ack('watch', [first['delivery_id']])
+    assert restarted.ack('phone', [first['delivery_id']]) == [first['delivery_id']]
+    assert Outbox(path, lambda: 1002).ack('phone', [first['delivery_id']]) == [first['delivery_id']]
+    assert restarted.read('phone', 25)['items'] == []
+    assert restarted.put('phone', 'event-a', 'conversation-a', 'finished') == first
+    assert restarted.read('phone', 25)['items'] == []
+    assert Outbox(tmp_path / 'other-profile.db', lambda: 1000).read('phone', 25)['items'] == []
+
+
+def test_expiry_eviction_and_duplicate_conflict(tmp_path):
+    clock = [1000]
+    box = Outbox(tmp_path / 'o.db', lambda: clock[0], max_rows=1, ttl_ms=100)
+    first = box.put('p', 'a', 'c', 'one')
+    with pytest.raises(OutboxError, match='conflict'):
+        box.put('p', 'a', 'c', 'changed')
+    with pytest.raises(OutboxError, match='conflict'):
+        box.put('p', 'a', 'different', 'one')
+    box.put('p', 'b', 'c', 'two')
+    assert [x['payload']['text'] for x in box.read('p', 25)['items']] == ['two']
+    assert box.read('p', 25)['gap_generation'] == 1
+    clock[0] = 1100
+    assert box.read('p', 25)['items'] == []
+    assert box.read('p', 25)['gap_generation'] == 2
+    with pytest.raises(OutboxError, match='expired'):
+        box.put('p', 'a', 'c', 'one')
+    assert box.ack('p', [first['delivery_id']]) == [first['delivery_id']]
+    assert first['expires_at_ms'] == 1100
+
+
+def test_profile_quota_includes_ack_dtos_and_keeps_retry_identity(tmp_path):
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: 1000, max_profile_bytes=500)
+    a = box.put('a', 'a', 'c', 'a' * 80)
+    assert box.ack('a', [a['delivery_id']]) == [a['delivery_id']]
+    b = box.put('b', 'b', 'c', 'b' * 80)
+    assert box.read('b', 25)['items'] == [b]
+    assert stored_bytes(path) <= 500
+    assert stored_bytes(path) == 259  # Measured compact UTF-8 DTO; quota retains exactly one.
+    assert box.ack('a', [a['delivery_id']]) == [a['delivery_id']]
+    with pytest.raises(OutboxError, match='expired'):
+        box.put('a', 'a', 'c', 'a' * 80)
+    assert box.read('a', 25)['gap_generation'] == 0
+
+
+def test_device_bytes_include_ack_dtos_and_pending_eviction_signals_gap(tmp_path):
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: 1000, max_device_bytes=500)
+    a = box.put('p', 'a', 'c', 'a' * 80)
+    box.ack('p', [a['delivery_id']])
+    b = box.put('p', 'b', 'c', 'b' * 80)
+    assert stored_bytes(path) <= 500
+    assert box.read('p', 25)['items'] == [b]
+    assert box.read('p', 25)['gap_generation'] == 0
+    box.put('p', 'c', 'c', 'c' * 80)
+    assert box.read('p', 25)['gap_generation'] == 1
+
+
+def test_profile_eviction_signals_owner_and_ack_batch_is_atomic(tmp_path):
+    box = Outbox(tmp_path / 'o.db', lambda: 1000, max_profile_bytes=500)
+    a = box.put('a', 'a', 'c', 'a' * 80)
+    b = box.put('b', 'b', 'c', 'b' * 80)
+    assert box.read('a', 25)['gap_generation'] == 1
+    for ids in ([b['delivery_id'], 'absent'], [b['delivery_id'], a['delivery_id']]):
+        with pytest.raises(OutboxError, match='not_found'):
+            box.ack('b', ids)
+        assert box.read('b', 25)['items'] == [b]
+
+
+def test_acked_body_expires_but_identity_survives_seven_more_days(tmp_path):
+    clock = [1000]
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: clock[0], ttl_ms=100)
+    item = box.put('p', 'e', 'c', 'done')
+    box.ack('p', [item['delivery_id']])
+    clock[0] = 1100
+    assert box.read('p', 25)['gap_generation'] == 0
+    assert stored_bytes(path) == 0
+    clock[0] = 1100 + 604800000 - 1
+    with pytest.raises(OutboxError, match='expired'):
+        box.put('p', 'e', 'c', 'done')
+    assert box.ack('p', [item['delivery_id']]) == [item['delivery_id']]
+    clock[0] += 1
+    assert box.read('p', 25)['items'] == []
+    with closing(sqlite3.connect(path)) as db:
+        assert db.execute('SELECT count(*) FROM deliveries').fetchone()[0] == 0
+    with pytest.raises(OutboxError, match='not_found'):
+        box.ack('p', [item['delivery_id']])
+
+
+def test_identity_cap_refuses_without_destroying_retry_evidence(tmp_path):
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: 1000, max_rows=1)
+    first = box.put('p', '0', 'c', 'done')
+    for index in range(1, 4096):
+        box.put('p', str(index), 'c', 'done')
+    with pytest.raises(OutboxError, match='busy'):
+        box.put('p', '4096', 'c', 'done')
+    with closing(sqlite3.connect(path)) as db:
+        assert db.execute('SELECT count(*) FROM deliveries').fetchone()[0] == 4096
+    assert box.ack('p', [first['delivery_id']]) == [first['delivery_id']]
+    with pytest.raises(OutboxError, match='expired'):
+        box.put('p', '0', 'c', 'done')
+    assert box.read('p', 25)['items'][0]['event_id'] == '4095'
+
+
+def test_owner_cap_opt_out_and_reconciliation_preserve_dedup(tmp_path):
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: 1000)
+    old = box.put('old', 'e', 'c', 'private')
+    box.opt_in('old', 1)
+    assert box.is_opted_in('old', 1)
+    assert not box.is_opted_in('old', 2)
+    for index in range(127):
+        box.opt_in(f'owner-{index}', 1)
+    box.opt_in('old', 2)
+    assert box.is_opted_in('old', 2)
+    with pytest.raises(OutboxError, match='busy'):
+        box.opt_in('new', 1)
+    with pytest.raises(OutboxError, match='busy'):
+        box.put('new', 'e', 'c', 'done')
+    box.reconcile_owners(['owner-0'])
+    assert not box.is_opted_in('old', 2)
+    assert box.read('old', 25)['items'] == []
+    assert box.ack('old', [old['delivery_id']]) == [old['delivery_id']]
+    with pytest.raises(OutboxError, match='expired'):
+        box.put('old', 'e', 'c', 'private')
+    box.opt_in('new', 3)
+    item = box.put('new', 'e', 'c', 'done')
+    box.opt_out('new')
+    assert not box.is_opted_in('new', 3)
+    assert box.read('new', 25)['items'] == []
+    assert box.ack('new', [item['delivery_id']]) == [item['delivery_id']]
+    with closing(sqlite3.connect(path)) as db:
+        assert db.execute('SELECT count(*) FROM gaps').fetchone()[0] == 1
+        assert db.execute('SELECT count(*) FROM optins').fetchone()[0] == 1
+
+
+@pytest.mark.parametrize('operation', [
+    lambda b: b.put('', 'e', 'c', 'x'),
+    lambda b: b.put('p' * 129, 'e', 'c', 'x'),
+    lambda b: b.put('p', 'e' * 257, 'c', 'x'),
+    lambda b: b.put('p', 'e', 'c' * 129, 'x'),
+    lambda b: b.put('p', [], 'c', 'x'),
+    lambda b: b.put('p', 'e', {}, 'x'),
+    lambda b: b.put('p', 'e', 'c', '\ud800'),
+    lambda b: b.put('p', 'e', 'c', ''),
+    lambda b: b.put('p', 'e', 'c', 'é' * 8193),
+    lambda b: b.read('p', True),
+    lambda b: b.read('p', 51),
+    lambda b: b.ack('p', []),
+    lambda b: b.ack('p', ['a' * 129]),
+    lambda b: b.ack('p', [1]),
+    lambda b: b.opt_in('p', True),
+    lambda b: b.opt_in('p', 0),
+    lambda b: b.reconcile_owners(['x'] * 129),
+])
+def test_invalid_requests_do_not_write_metadata(tmp_path, operation):
+    path = tmp_path / 'o.db'
+    box = Outbox(path, lambda: 1000)
+    with pytest.raises(OutboxError, match='invalid_request'):
+        operation(box)
+    with closing(sqlite3.connect(path)) as db:
+        for table in ('deliveries', 'gaps', 'optins'):
+            assert db.execute(f'SELECT count(*) FROM {table}').fetchone()[0] == 0
+
+
+def test_concurrent_connections_put_and_ack_exactly_one_delivery(tmp_path):
+    path = tmp_path / 'o.db'
+    a, b = Outbox(path, lambda: 1000), Outbox(path, lambda: 1000)
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        results = list(pool.map(lambda i: (a if i % 2 else b).put('p', 'e', 'c', 'done'), range(32)))
+        assert all(item == results[0] for item in results)
+        identifier = results[0]['delivery_id']
+        def put_or_ack(index):
+            if index % 2:
+                assert a.put('p', 'e', 'c', 'done') == results[0]
+            else:
+                assert b.ack('p', [identifier]) == [identifier]
+        list(pool.map(put_or_ack, range(32)))
+    assert Outbox(path, lambda: 1001).read('p', 25)['items'] == []
+    with closing(sqlite3.connect(path)) as db:
+        assert db.execute('SELECT count(*) FROM deliveries').fetchone()[0] == 1
+
+
+@pytest.mark.parametrize('boundary,visible', [('before', 0), ('after', 1)])
+def test_killed_writer_at_real_commit_boundary(tmp_path, boundary, visible):
+    path = tmp_path / 'o.db'
+    Outbox(path, lambda: 1000)
+    script = '''
+from contextlib import contextmanager
+import sys
+from hermes_gadget_plugin.relay_outbox import Outbox
+class Writer(Outbox):
+    armed = False
+    @contextmanager
+    def tx(self):
+        with super().tx() as db:
+            yield db
+            if self.armed and sys.argv[2] == 'before':
+                print('ready', flush=True)
+                sys.stdin.read()
+        if self.armed and sys.argv[2] == 'after':
+            print('ready', flush=True)
+            sys.stdin.read()
+b = Writer(sys.argv[1], lambda: 1000)
+b.armed = True
+b.put('p', 'e', 'c', 'done')
+'''
+    proc = subprocess.Popen([sys.executable, '-c', script, str(path), boundary],
+                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    try:
+        ready = queue.Queue()
+        reader = threading.Thread(target=lambda: ready.put(proc.stdout.readline()), daemon=True)
+        reader.start()
+        assert ready.get(timeout=10) == 'ready\n'
+        reader.join(timeout=10)
+        with closing(sqlite3.connect(path)) as db:
+            assert db.execute('SELECT count(*) FROM deliveries').fetchone()[0] == visible
+        proc.kill()
+        proc.wait(timeout=10)
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+        proc.communicate(timeout=10)
+    restarted = Outbox(path, lambda: 1001)
+    assert len(restarted.read('p', 25)['items']) == visible
+    first = restarted.put('p', 'e', 'c', 'done')
+    assert restarted.put('p', 'e', 'c', 'done') == first
+    assert len(restarted.read('p', 25)['items']) == 1
+
+
+def test_payload_churn_bounds_database_and_active_rollback_journal(tmp_path):
+    path = tmp_path / 'o.db'
+    clock = [1000]
+    peak = {'total': 0, 'journal': 0}
+
+    class MeasuredOutbox(Outbox):
+        @contextmanager
+        def tx(self):
+            with super().tx() as db:
+                yield db
+                sizes = {p.name: p.stat().st_size for p in tmp_path.iterdir() if p.is_file()}
+                peak['total'] = max(peak['total'], sum(sizes.values()))
+                peak['journal'] = max(peak['journal'], sizes.get('o.db-journal', 0))
+
+    box = MeasuredOutbox(path, lambda: clock[0])
+    for cycle in range(3):
+        for index in range(520):
+            box.put(f'owner-{index % 32}', f'{cycle}-{index}', 'c', 'x' * 16384)
+        assert stored_bytes(path) <= 8388608
+        clock[0] += 86400000 + 604800000
+        box.read('owner-0', 25)
+        assert stored_bytes(path) == 0
+    assert peak['journal'] > 8388608  # Real populated-db purge, not just tiny inserts.
