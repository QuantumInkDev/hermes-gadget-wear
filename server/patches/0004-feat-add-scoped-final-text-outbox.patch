+def test_concurrent_start_is_idempotent_and_stop_joins_owned_sweep(rig, monkeypatch):
+    entered, release = asyncio.Event(), asyncio.Event()
+    original = rig.service.maintain
+    async def slow_maintenance():
+        entered.set()
+        await release.wait()
+        return await original()
+    monkeypatch.setattr(rig.service, 'maintain', slow_maintenance)
+    async def scenario():
+        first = asyncio.create_task(rig.service.start())
+        await entered.wait()
+        second = asyncio.create_task(rig.service.start())
+        await asyncio.sleep(0)
+        release.set()
+        await asyncio.gather(first, second)
+        tasks = [task for task in asyncio.all_tasks()
+                 if task is not asyncio.current_task() and task.get_coro().__name__ == '_cleanup_loop']
+        try:
+            assert len(tasks) == 1
+        finally:
+            await rig.service.stop()
+            # Clean up a leaked loop on the RED implementation as well.
+            for task in tasks:
+                task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+    run(scenario())
+
