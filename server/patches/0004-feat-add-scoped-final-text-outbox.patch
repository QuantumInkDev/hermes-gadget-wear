+"""Real-process queue/redirect ledger-failure recovery fixture; synthetic inference only."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+import time
+
+root = Path(sys.argv[1]).resolve()
+os.environ['HERMES_HOME'] = str(root / 'hermes-home')
+os.environ['HERMES_AGENT_DIR'] = sys.argv[2]
+Path(os.environ['HERMES_HOME']).mkdir(parents=True, exist_ok=True)
+import conftest  # noqa: E402,F401
+import pytest  # noqa: E402
+from test_relay_adapter import SocketRig, attach_store  # noqa: E402
+from test_relay_review_fixes import handoff  # noqa: E402
+
+
+async def main():
+    patch = pytest.MonkeyPatch()
+    rig = SocketRig(root, patch)
+    adapter = await rig.start()
+    store = attach_store(rig)
+    reconstructed = await rig.runner._ledger_crash_left_replies(3600)
+    redelivered = await rig.runner._redeliver_claimed_obligations(rig.ledger.sweep_recoverable())
+    async def handler(event):
+        entry = store.get_or_create_session(event.source)
+        key = entry.session_key
+        assert await rig.runner._mark_durable_active_turn(event, key)
+        incoming = adapter._event(adapter.hub.get(rig.device), 'terminal-B', 'followup')
+        with pytest.MonkeyPatch.context() as turn_patch:
+            await handoff(rig, event, key, incoming, sys.argv[3], turn_patch)
+        store.append_to_transcript(entry.session_id, {'role': 'user', 'content': 'question', 'timestamp': time.time()})
+        store.append_to_transcript(entry.session_id, {'role': 'assistant', 'content': 'process handoff final', 'timestamp': time.time()})
+        return 'process handoff final'
+    adapter.set_message_handler(handler)
+    original = adapter.send_final_ledgered
+    async def fail_final(*args, **kwargs):
+        with pytest.MonkeyPatch.context() as write_patch:
+            def unavailable(**kw):
+                raise sqlite3.OperationalError('synthetic final ledger unavailable')
+            write_patch.setattr(rig.ledger, 'record_obligation', unavailable)
+            result = await original(*args, **kwargs)
+        assert not result[0].success
+        print(json.dumps({'failed': True}), flush=True)
+        return result
+    adapter.send_final_ledgered = fail_final
+    print(json.dumps({'port': adapter.hub.bound_port, 'device_id': rig.device,
+                      'reconstructed': reconstructed, 'redelivered': redelivered}), flush=True)
+    try:
+        await asyncio.to_thread(sys.stdin.readline)
+    finally:
+        await rig.close()
+        store._db.close()
+        store.close_all_db_handles()
+        patch.undo()
+
+
+asyncio.run(main())
