+class Rig:
+    def __init__(self, root, **options):
+        self.clock, self.authorized = [1000], {'phone': True, 'watch': True}
+        self.path = root / 'relay-grants.json'
+        directory = root / 'devices'
+        directory.mkdir()
+        (directory / DeviceStore.FILENAME).write_text('{"devices":{},"pairing":{}}')
+        self.devices = DeviceStore(directory)
+        self.data = {'schema': 1, 'profile_id': PROFILE, 'generation': 1, 'devices': {}}
+        for device in ('phone', 'watch'):
+            key = device.encode() * 8
+            self.devices.enroll(device, key)
+            self.data['devices'][device] = {'key_sha256': hashlib.sha256(key).hexdigest(),
+                                            'expires_at_ms': 5000, 'outbox': True}
+        self.save()
+        self.grants = Grants(self.path, self.devices, self.authorized.get, lambda: self.clock[0])
+        self.box = Outbox(root / 'outbox.db', lambda: self.clock[0], **options)
+        self.service = RelayService(self.grants, self.box)
+        self.session = Session()
+
+    def save(self):
+        self.path.write_text(json.dumps(self.data))
+        os.chmod(self.path, 0o600)
+
+    def event(self, device='phone', identity='final-1', text='hello'):
+        return SimpleNamespace(source=SimpleNamespace(user_id=device, chat_id=device),
+                               message_id='transport-id', ledger_message_id=identity, text=text)
+
+    async def request(self, method='relay.info', params=None, session=None, **changes):
+        session = session or self.session
+        msg = dict(type='relay.request', v=1, id='r1', method=method,
+                   params={} if params is None else params)
+        msg.update(changes)
+        await self.service.request(session, msg)
+        return session.sent[-1]
