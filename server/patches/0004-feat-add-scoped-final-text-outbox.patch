diff --git a/plugin/relay_grants.py b/plugin/relay_grants.py
new file mode 100644
index 0000000000000000000000000000000000000000..b731777fe0c12a00f365051461cae0240dcd78df
--- /dev/null
+++ b/plugin/relay_grants.py
@@ -0,0 +1,153 @@
+"""Read-only enrollment-bound authority in a profile's plugin data directory.
+
+A snapshot is authoritative only after every entry passes validation. Missing,
+malformed or unreadable files must never be interpreted as an empty allowlist.
+The caller must supply a DeviceStore whose enrollment load was validated: the
+stock store's silent empty fallback on malformed input is not revocation authority.
+Windows activation is deliberately refused until real-host private ACL preflight
+is implemented; POSIX fixture success supplies no Windows privacy evidence.
+"""
+
+import hashlib
+import json
+import os
+import re
+import stat
+import uuid
+
+from .relay_outbox import OutboxError
+
+
+_HASH = re.compile(r'[0-9a-f]{64}\Z')
+
+
+def _unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError()
+        result[key] = value
+    return result
+
+
+class AuthorityUnavailable(OutboxError):
+    """No authoritative snapshot; this denial must not erase retained bodies."""
+
+
+class Grants:
+    def __init__(self, path, devices, authorized, now_ms):
+        self.path, self.devices = path, devices
+        self.authorized, self.now_ms = authorized, now_ms
+
+    def snapshot(self):
+        """Return up to 128 currently authorized enrollment contexts, or deny.
+
+        Disconnected devices remain eligible: transport presence is not authority.
+        All synchronous file, enrollment and runner reads belong off the event loop.
+        """
+        try:
+            if os.name == 'nt':
+                raise ValueError()
+            flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0)
+            descriptor = os.open(self.path, flags)
+            with os.fdopen(descriptor, 'rb') as stream:
+                info = os.fstat(stream.fileno())
+                if (not stat.S_ISREG(info.st_mode) or info.st_size > 65536
+                        or info.st_mode & 0o077 or info.st_uid != os.getuid()):
+                    raise ValueError()
+                raw = stream.read(65537)
+            if len(raw) > 65536:
+                raise ValueError()
+            data = json.loads(raw, object_pairs_hook=_unique)
+            if (not isinstance(data, dict)
+                    or set(data) != {'schema', 'profile_id', 'generation', 'devices'}
+                    or type(data['schema']) is not int or data['schema'] != 1
+                    or not isinstance(data['profile_id'], str)):
+                raise ValueError()
+            profile = str(uuid.UUID(data['profile_id']))
+            generation = data['generation']
+            if type(generation) is not int or not 1 <= generation <= 2147483647:
+                raise ValueError()
+            entries = data['devices']
+            if not isinstance(entries, dict) or len(entries) > 128:
+                raise ValueError()
+            # Validate the entire configuration before consulting live enrollment.
+            for device, grant in entries.items():
+                if (not isinstance(device, str) or not 1 <= len(device.encode('utf-8')) <= 128
+                        or not isinstance(grant, dict)
+                        or set(grant) != {'key_sha256', 'expires_at_ms', 'outbox'}
+                        or not isinstance(grant['key_sha256'], str)
+                        or not _HASH.fullmatch(grant['key_sha256'])
+                        or type(grant['expires_at_ms']) is not int
+                        or not 0 <= grant['expires_at_ms'] <= 9223372036854775807
+                        or type(grant['outbox']) is not bool):
+                    raise ValueError()
+            now = self.now_ms()
+            if type(now) is not int or not 0 <= now <= 9223372036854775807:
+                raise ValueError()
+            validate_enrollment = getattr(self.devices, 'enrollment_snapshot', None)
+            enrollment = validate_enrollment() if callable(validate_enrollment) else None
+            active = {}
+            for device, grant in entries.items():
+                if not grant['outbox'] or grant['expires_at_ms'] <= now:
+                    continue
+                try:
+                    authorized = self.authorized(device)
+                except Exception:
+                    raise ValueError() from None
+                if authorized is False:
+                    continue
+                # Core returns None when no runner check exists or a check
+                # failed. Unknown authority denies access but cannot revoke.
+                if authorized is not True:
+                    raise ValueError()
+                key = enrollment.get(device) if enrollment is not None else self.devices.key_for(device)
+                if key is None:
+                    continue
+                if not isinstance(key, bytes):
+                    raise ValueError()
+                if hashlib.sha256(key).hexdigest() != grant['key_sha256']:
+                    continue
+                owner = hashlib.sha256(json.dumps(
+                    [profile, device, grant['key_sha256']]).encode()).hexdigest()
+                active[device] = dict(profile_id=profile, owner=owner, generation=generation,
+                                      expires_at_ms=grant['expires_at_ms'])
+            return active
+        except (OSError, ValueError, TypeError, KeyError, AttributeError, RecursionError):
+            raise AuthorityUnavailable('permission_denied') from None
+
+    def get(self, device_id):
+        try:
+            return self.snapshot()[device_id]
+        except (KeyError, TypeError):
+            raise OutboxError('permission_denied') from None
+
+
+def private_directory(directory):
+    """POSIX-only activation preflight; Windows requires an actual ACL verifier.
+
+    The caller supplies plugin_data_dir('gadget'), never a configured override.
+    Existing symlinks/reparse layouts cannot be made private by chmod of a target.
+    """
+    from pathlib import Path
+    directory = Path(directory).absolute()
+    if os.name == 'nt':
+        raise OutboxError('permission_denied')
+    for parent in (directory, *directory.parents):
+        info = parent.lstat()
+        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
+            raise OutboxError('permission_denied')
+    info = directory.stat()
+    if info.st_uid != os.getuid():
+        raise OutboxError('permission_denied')
+    os.chmod(directory, 0o700)
+    for name in ('relay-grants.json', 'relay-outbox.sqlite3', 'relay-outbox.sqlite3-journal'):
+        path = directory / name
+        try:
+            info = path.lstat()
+        except FileNotFoundError:
+            continue
+        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
+                or info.st_uid != os.getuid() or info.st_mode & 0o077):
+            raise OutboxError('permission_denied')
+    return directory
