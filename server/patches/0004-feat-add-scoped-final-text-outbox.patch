+@pytest.mark.parametrize('failure', [OutboxError('temporarily_unavailable'),
+                                    OSError('private worker failure'),
+                                    RuntimeError('unexpected worker failure')])
+@pytest.mark.parametrize('cancellations', [1, 3])
+def test_cancelled_failing_worker_is_joined_without_response_or_loop_diagnostic(
+        rig, monkeypatch, failure, cancellations):
+    started, release, finished = threading.Event(), threading.Event(), threading.Event()
+    overlaps, diagnostics = [], []
+    original_reconcile = rig.box.reconcile_owners
+    def reconcile(*args):
+        if started.is_set() and not finished.is_set():
+            overlaps.append(True)
+        return original_reconcile(*args)
+    def blocked(*args):
+        started.set()
+        try:
+            assert release.wait(3)
+            raise failure
+        finally:
+            finished.set()
+    monkeypatch.setattr(rig.box, 'read', blocked)
+    monkeypatch.setattr(rig.box, 'reconcile_owners', reconcile)
+    async def scenario():
+        loop = asyncio.get_running_loop()
+        previous_handler = loop.get_exception_handler()
+        loop.set_exception_handler(lambda _loop, context: diagnostics.append(context))
+        first = asyncio.create_task(rig.request('relay.outbox.read'))
+        try:
+            for _ in range(1000):
+                if started.is_set():
+                    break
+                await asyncio.sleep(0.001)
+            assert started.is_set()
+            for index in range(cancellations):
+                first.cancel('cancel-' + str(index))
+                await asyncio.sleep(0)
+                assert not first.done()
+                assert_code(await rig.request(session=Session()), 'busy')
+                assert not finished.is_set()
+            release.set()
+            with pytest.raises(asyncio.CancelledError) as caught:
+                await first
+            assert caught.value.args == ('cancel-0',)
+            assert first.cancelled()
+            assert finished.is_set()
+            assert rig.session.sent == []
+            assert not overlaps
+            # Drain completion callbacks too: asyncio diagnostics are not pytest
+            # warnings, so -W error alone cannot establish this invariant.
+            await asyncio.sleep(0)
+            await asyncio.sleep(0)
+            assert diagnostics == []
+            assert 'result' in await rig.request()
+        finally:
+            release.set()
+            await asyncio.gather(first, return_exceptions=True)
+            loop.set_exception_handler(previous_handler)
+    run(scenario())
