diff --git a/plugin/opus.py b/plugin/opus.py
new file mode 100644
index 0000000..b978fc5
--- /dev/null
+++ b/plugin/opus.py
@@ -0,0 +1,151 @@
+"""Optional raw-packet Opus bridge through ffmpeg; no Python native codec dependency."""
+from __future__ import annotations
+import asyncio
+import shutil
+import struct
+import subprocess
+from functools import lru_cache
+
+MAX_PACKET = 1275
+
+@lru_cache(maxsize=1)
+def available() -> bool:
+    exe = shutil.which("ffmpeg")
+    if not exe:
+        return False
+    try:
+        result = subprocess.run([exe, "-v", "error", "-encoders"], capture_output=True, timeout=5)
+        decoder = subprocess.run([exe, "-v", "error", "-decoders"], capture_output=True, timeout=5)
+        return result.returncode == 0 and decoder.returncode == 0 and b"libopus" in result.stdout and b"opus" in decoder.stdout
+    except (OSError, subprocess.TimeoutExpired):
+        return False
+
+def header(value: bytes) -> bytes:
+    if len(value) != 19 or value[:8] != b"OpusHead" or value[8:10] != b"\x01\x01" or value[18] != 0:
+        raise ValueError("Unsupported mono Opus header")
+    return value
+
+def packet(value: bytes) -> bytes:
+    if not 1 <= len(value) <= MAX_PACKET:
+        raise ValueError("Invalid Opus packet size")
+    toc = value[0]
+    if toc & 128:
+        samples = 120 << ((toc >> 3) & 3)
+    elif toc & 96 == 96:
+        samples = 960 if toc & 8 else 480
+    else:
+        config = (toc >> 3) & 3
+        samples = 2880 if config == 3 else 480 << config
+    frames = 1 if toc & 3 == 0 else 2 if toc & 3 in (1, 2) else (value[1] & 63 if len(value) > 1 else 0)
+    if samples * frames != 960:
+        raise ValueError("Only 20 ms Opus packets are supported")
+    return value
+
+def _crc(value: bytes) -> int:
+    crc = 0
+    for byte in value:
+        crc ^= byte << 24
+        for _ in range(8):
+            crc = ((crc << 1) ^ (0x04C11DB7 if crc & 0x80000000 else 0)) & 0xffffffff
+    return crc
+
+def page(data: bytes, sequence: int, granule: int, flags: int = 0) -> bytes:
+    lace = bytes([255] * (len(data) // 255) + [len(data) % 255])
+    if len(lace) > 255:
+        raise ValueError("Ogg page too large")
+    raw = bytearray(b"OggS\0" + bytes([flags]) + struct.pack("<QII", granule, 1, sequence) + b"\0" * 4 + bytes([len(lace)]) + lace + data)
+    struct.pack_into("<I", raw, 22, _crc(raw))
+    return bytes(raw)
+
+def wrap(head: bytes, packets: list[bytes]) -> bytes:
+    header(head)
+    if not 1 <= len(packets) <= 3001:
+        raise ValueError("Opus upload outside limit")
+    tags = b"OpusTags" + struct.pack("<II", 0, 0)
+    output = bytearray(page(head, 0, 0, 2) + page(tags, 1, 0))
+    for i, data in enumerate(packets):
+        output += page(packet(data), i + 2, (i + 1) * 960, 4 if i == len(packets) - 1 else 0)
+    return bytes(output)
+
+def decode(head: bytes, packets: list[bytes], rate: int = 16000) -> bytes:
+    if rate != 16000 or not available():
+        raise ValueError("Opus is unavailable")
+    try:
+        proc = subprocess.run([shutil.which("ffmpeg"), "-nostdin", "-v", "error", "-f", "ogg", "-i", "pipe:0",
+        "-f", "s16le", "-ac", "1", "-ar", str(rate), "pipe:1"], input=wrap(head, packets),
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=15)
+    except subprocess.TimeoutExpired:
+        raise ValueError("Opus decode timed out") from None
+    if proc.returncode or len(proc.stdout) > 16000 * 2 * 61:
+        raise ValueError("Opus decode failed")
+    return proc.stdout
+
+async def _packets(reader):
+    pending = bytearray()
+    while True:
+        try:
+            raw = await reader.readexactly(27)
+        except asyncio.IncompleteReadError as exc:
+            if exc.partial or pending:
+                raise ValueError("Truncated Ogg stream") from None
+            return
+        if raw[:5] != b"OggS\0":
+            raise ValueError("Malformed Ogg page")
+        lace = await reader.readexactly(raw[26])
+        data = await reader.readexactly(sum(lace))
+        offset = 0
+        for length in lace:
+            pending += data[offset:offset + length]
+            offset += length
+            if len(pending) > 8192:
+                raise ValueError("Ogg packet too large")
+            if length < 255:
+                yield bytes(pending)
+                pending.clear()
+
+async def encode_stream(queue, rate: int, on_header, on_packet) -> None:
+    if rate != 16000 or not available():
+        raise ValueError("Opus is unavailable")
+    proc = await asyncio.create_subprocess_exec(shutil.which("ffmpeg"), "-nostdin", "-v", "error",
+        "-f", "s16le", "-ar", str(rate), "-ac", "1", "-i", "pipe:0", "-c:a", "libopus",
+        "-application", "voip", "-b:a", "24000", "-frame_duration", "20", "-page_duration", "20000",
+        "-flush_packets", "1", "-f", "ogg", "pipe:1", stdin=asyncio.subprocess.PIPE,
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, limit=65536)
+    async def write():
+        total = 0
+        try:
+            while True:
+                pcm = await queue.get()
+                if pcm is None:
+                    break
+                total += len(pcm)
+                if total > 16000 * 2 * 60:
+                    raise ValueError("Opus output outside limit")
+                proc.stdin.write(pcm)
+                await proc.stdin.drain()
+        finally:
+            proc.stdin.close()
+    writer = asyncio.create_task(write())
+    async def read():
+        count = 0
+        async for data in _packets(proc.stdout):
+            if count == 0:
+                await on_header(header(data))
+            elif count != 1:
+                await on_packet(packet(data))
+            elif not data.startswith(b"OpusTags"):
+                raise ValueError("Missing Opus tags")
+            count += 1
+            if count > 3003:
+                raise ValueError("Opus output outside limit")
+        await writer
+        if await proc.wait() != 0 or count < 3:
+            raise ValueError("Opus encode failed")
+    try:
+        await asyncio.wait_for(read(), timeout=75)
+    finally:
+        writer.cancel()
+        await asyncio.gather(writer, return_exceptions=True)
+        if proc.returncode is None:
+            proc.kill()
+        await proc.wait()
diff --git a/tests/test_opus.py b/tests/test_opus.py
new file mode 100644
index 0000000..613e2a9
--- /dev/null
+++ b/tests/test_opus.py
@@ -0,0 +1,137 @@
+"""Real ffmpeg round trips plus opt-in/stock negotiation and malformed upload checks."""
+import asyncio
+import base64
+import json
+import math
+import struct
+import io
+import wave
+import time
+import pytest
+from hermes_gadget_plugin import opus, protocol
+from hermes_gadget_plugin.hub import DeviceHub, DeviceSession, HubDelegate
+from hermes_gadget_plugin.store import DeviceStore
+
+async def encoded():
+    pcm = b"".join(struct.pack("<h", int(8000 * math.sin(2 * math.pi * 440 * i / 16000))) for i in range(48000))
+    queue = asyncio.Queue()
+    await queue.put(pcm)
+    await queue.put(None)
+    heads, packets = [], []
+    async def head(value): heads.append(value)
+    async def packet(value): packets.append(value)
+    await opus.encode_stream(queue, 16000, head, packet)
+    return pcm, heads[0], packets
+
+def test_real_ffmpeg_packet_round_trip_and_bitrate():
+    assert opus.available(), "ffmpeg with libopus required for extension tests"
+    pcm, head, packets = asyncio.run(encoded())
+    decoded = opus.decode(head, packets)
+    assert 95000 <= len(decoded) <= 98000
+    assert sum(map(len, packets)) < len(pcm) // 4
+    assert len(packets) in (150, 151)
+    assert opus.wrap(head, packets).startswith(b"OggS")
+
+def test_invalid_header_packets_and_limits():
+    for data in [b"", b"OpusHead", b"x" * 19]:
+        with pytest.raises(ValueError): opus.header(data)
+    for data in [b"", b"x" * 1276, b"\x83\0", b"\x00"]:
+        with pytest.raises(ValueError): opus.packet(data)
+
+def test_hub_opt_in_pacing_and_decode_and_sequence_rejection(tmp_path):
+    class WS:
+        def __init__(self): self.sent = []
+        async def send(self, value): self.sent.append(value)
+    class Delegate(HubDelegate):
+        def __init__(self): self.wav = None
+        async def on_utterance(self, session, msg_id, wav, seconds): self.wav = wav
+    async def run():
+        delegate, ws = Delegate(), WS()
+        caps = {name: {"rate": 16000, "formats": ["opus", "pcm16"]} for name in ("mic", "speaker")}
+        hub = DeviceHub(DeviceStore(tmp_path), delegate, enable_opus=True)
+        session = DeviceSession(hub, ws, {"device_id": "hg-0123456789abcdef", "caps": caps})
+        session.paired = True
+        assert session.audio_format("mic") == "opus"
+        stock = DeviceHub(DeviceStore(tmp_path / "stock"), delegate)
+        assert DeviceSession(stock, ws, {"device_id": session.device_id, "caps": caps}).audio_format("mic") == "pcm16"
+        session.caps["mic"]["formats"] = None
+        assert session.audio_format("mic") == "pcm16"
+        session.caps["mic"]["formats"] = ["opus", "pcm16"]
+        pcm, head, packets = await encoded()
+        start = {"format": "opus", "frame_ms": 20, "rate": 16000, "stream": 1, "id": "synthetic"}
+        await hub._h_audio_start(session, start)
+        await hub._h_audio_codec(session, {"stream": 1, "opus_header": base64.b64encode(head).decode()})
+        for seq, data in enumerate(packets): hub._on_binary(session, protocol.binary(1, 1, seq, data))
+        await hub._h_audio_end(session, {"stream": 1})
+        await asyncio.gather(*session._tasks)
+        with wave.open(io.BytesIO(delegate.wav)) as wav: assert wav.getframerate() == 16000
+        delegate.wav = None
+        await hub._h_audio_start(session, start)
+        await hub._h_audio_codec(session, {"stream": 1, "opus_header": base64.b64encode(head).decode()})
+        hub._on_binary(session, protocol.binary(1, 1, 2, packets[0]))
+        await hub._h_audio_end(session, {"stream": 1})
+        assert delegate.wav is None
+        started = time.monotonic()
+        output = await session.open_audio(16000)
+        output.write(pcm)
+        output.finish()
+        await asyncio.wait_for(output.done.wait(), 10)
+        messages = [json.loads(value) for value in ws.sent if isinstance(value, str)]
+        assert any(value.get("type") == "audio.start" and value.get("format") == "opus" for value in messages)
+        assert any(value.get("type") == "audio.end" for value in messages)
+        assert output.sent_seconds >= 3
+        assert time.monotonic() - started >= 2.4
+        session.paired = False
+        await hub._h_audio_start(session, start)
+        assert session._upload is None
+    asyncio.run(run())
