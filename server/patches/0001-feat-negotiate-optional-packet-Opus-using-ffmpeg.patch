+def test_live_websocket_negotiation_and_stock_fallback(tmp_path):
+    import secrets
+    from websockets.asyncio.client import connect
+    class Delegate(HubDelegate):
+        def __init__(self): self.received = asyncio.Event()
+        async def on_utterance(self, session, msg_id, wav, seconds):
+            output = await session.open_audio(16000)
+            with wave.open(io.BytesIO(wav)) as source: output.write(source.readframes(source.getnframes()))
+            output.finish()
+            self.received.set()
+    async def run():
+        for enabled in (False, True):
+            delegate = Delegate()
+            hub = DeviceHub(DeviceStore(tmp_path / str(enabled)), delegate, host="127.0.0.1", port=0, enable_opus=enabled)
+            await hub.start()
+            key = secrets.token_bytes(32)
+            device_id = protocol.device_id_for_key(key)
+            caps = {name: {"rate": 16000, "formats": ["opus", "pcm16"]} for name in ("mic", "speaker")}
+            try:
+                async with connect("ws://127.0.0.1:" + str(hub.bound_port) + "/gadget", subprotocols=[protocol.SUBPROTOCOL]) as ws:
+                    await ws.send(json.dumps({"type": "hello", "proto": 1, "device_id": device_id, "caps": caps}))
+                    assert json.loads(await ws.recv())["type"] == "challenge"
+                    await ws.send(json.dumps({"type": "auth", "key": base64.b64encode(key).decode()}))
+                    welcome = json.loads(await ws.recv())
+                    if not enabled:
+                        assert "audio" not in welcome
+                        continue
+                    assert welcome["audio"] == {"mic": "opus", "speaker": "opus"}
+                    pcm, head, packets = await encoded()
+                    await ws.send(json.dumps({"type": "audio.start", "stream": 1, "id": "synthetic", "rate": 16000, "format": "opus", "frame_ms": 20}))
+                    await ws.send(json.dumps({"type": "audio.codec", "stream": 1, "opus_header": base64.b64encode(head).decode()}))
+                    for seq, data in enumerate(packets): await ws.send(protocol.binary(1, 1, seq, data))
+                    await ws.send(json.dumps({"type": "audio.end", "stream": 1}))
+                    output_head, output_packets = None, []
+                    while True:
+                        value = await asyncio.wait_for(ws.recv(), 10)
+                        if isinstance(value, bytes):
+                            output_packets.append(protocol.parse_binary(value).payload)
+                        else:
+                            value = json.loads(value)
+                            if value["type"] == "audio.start":
+                                assert value["format"] == "opus"
+                                output_head = base64.b64decode(value["opus_header"])
+                            if value["type"] == "audio.end": break
+                    assert delegate.received.is_set()
+                    assert len(opus.decode(output_head, output_packets)) in range(94000, 98001)
+            finally: await hub.stop()
+    asyncio.run(run())
