+@pytest.mark.asyncio
+@pytest.mark.parametrize('backend', BACKENDS)
+async def test_an_ignored_identity_request_is_refused_before_any_decoder_or_parser_sees_the_body(monkeypatch, clip, backend):
+    """A deterministic ignored-identity control: the peer answers gzip although identity was requested. The small valid
+    transcript inside would be returned if the body were decoded; the native route refuses without reading a byte."""
+    backend.profile()
+    wire = backend.answer(200, {'Content-Encoding': 'gzip'}, compressed(backend.small))
+    with backend.context(monkeypatch, wire):
+        result, cb = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1  # the send was counted; nothing was resent
+    assert backend.pulled(wire) == 0 and backend.closed(wire)  # refused on the headers: the compressed bytes were never read
+    assert backend.request(wire).headers['accept-encoding'] == 'identity'
