+def _profile(provider, env_var, **section):
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'tts': {'provider': provider, provider: section}})
+    (get_hermes_home() / '.env').write_text(f'{env_var}={KEY}\n')
+    invalidate_env_cache()
+
+
+def xai_profile(**section):
+    _profile('xai', 'XAI_API_KEY', **section)
+
+
+def minimax_profile(**section):
+    _profile('minimax', 'MINIMAX_API_KEY', **section)
+
+
+def gemini_profile(**section):
+    _profile('gemini', 'GEMINI_API_KEY', **section)
+
