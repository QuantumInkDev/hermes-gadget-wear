+@pytest.mark.asyncio
+async def test_real_ffmpeg_trims_before_the_one_send_and_never_after_an_answer(monkeypatch, tmp_path, configured):
+    """AUX-audio: the trim children are now launcher-wrapped (a HARNESS pass-through stand-in, NOT a sandbox); the observation moved from the
+    stock runner to the recorded wrapped spawns. Same outcome tuple as before."""
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'openai', 'openai': {'api_key': KEY, 'model': 'whisper-1'}}})
+    monkeypatch.setattr('tools.transcription_audio.COMMON_LOCAL_BIN_DIRS', ())  # the PATH (owned) ffmpeg/ffprobe
+    support.qualify(monkeypatch)
+    events = []
+    from tools import transcription_audio
+    stock = []
+    monkeypatch.setattr(transcription_audio, '_run_quiet', lambda command, **kw: stock.append(command) or (_ for _ in ()).throw(AssertionError))
+    spawns = support.record_spawns(monkeypatch, events)
+    clip = support.tone_and_silence_wav(tmp_path / 'long.wav')
+    cb = support.Callbacks(events)
+    wire = support.Wire([words()], tap=lambda request: events.append(('request', b'ftyp' in request.read())))
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.provider, wire.count) == ('transcribed', 'completed', 1)
+    assert events[-2:] == [('request', True), 'authorize']  # the upload is the REAL ffmpeg's m4a, sent once
+    audio = support.audio_spawns(spawns)
+    names = [os.path.basename(support.program_of(spawn)) for spawn in audio]
+    assert names.count('ffmpeg') == 1 and names.count('ffprobe') >= 2, names  # probe, ONE trim-encode, probes
+    assert stock == []  # nothing reached the stock unwrapped runner
+    assert max(i for i, e in enumerate(events) if e == 'spawn') < events.index(('request', True))  # all pre-send
+    assert all(os.sep + 'task4-runtime' + os.sep + 'ffmpeg' + os.sep in support.program_of(spawn) for spawn in audio), names
+    wire = support.Wire([('status', 500)] * 4)
+    with support.provider_wire(monkeypatch, wire):
+        failed = await hear(clip, support.Callbacks())
+    assert (failed.state, wire.count) == ('failed', 1)  # no post-answer transcode retry with the real tool present
+
