+@pytest.mark.asyncio
+async def test_a_fresh_bearer_is_sent_once_with_no_oauth_traffic(monkeypatch, out):
+    token = fresh_token()
+    tts_profile()
+    rest.write_oauth_store(token)
+    oauth = rest.OAuthWire()
+    events = []
+    cb = support.Callbacks(events)
+    wire = rest.RestWire([('audio', b'ID3x')], tap=lambda request: events.append('request'))
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count, oauth.requests) == ('synthesized', 'completed', 1, [])
+    assert bearer(wire) == f'Bearer {token}' and wire.requests[0][0].url == 'https://api.x.ai/v1/tts'
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
