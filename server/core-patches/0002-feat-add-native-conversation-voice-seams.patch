+def require_native_fresh_bearer(creds: dict[str, str]) -> None:
+    """Inside a native voice call, refuse UNSENT unless an xAI OAuth bearer is provably fresh for the whole request window.
+
+    The resolver above refreshes an expiring or expired OAuth token before returning it and does not return one whose
+    refresh failed; what it cannot vouch for is a bearer without a decodable JWT ``exp``. Stock STT covers that case by
+    refreshing after a 401 and resending, which a native call must never do (one paid send), so freshness has to be
+    established BEFORE the send. An explicit ``XAI_API_KEY`` has no expiry and passes. Outside a native call: nothing."""
+    policy = native_send_policy.current()
+    if policy is None or creds.get("provider") != "xai-oauth":
+        return
+    native_send_policy.require_open()
+    from hermes_cli.auth_xai import _xai_jwt_exp
+    expires_at = _xai_jwt_exp(creds.get("api_key"))
+    if expires_at is None or expires_at <= time.time() + policy.timeout_s:
+        raise native_send_policy.refuse("credentials")
