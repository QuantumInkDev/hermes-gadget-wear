+"""Native voice seam, xAI OAuth: the credential phase is authorization-gated at every actual OAuth request.
+
+Pre-review correction C2. An authorization checked at the start of the call is not enough for a LATER credential boundary:
+discovery and the refresh POST belong to the call's deadline / Stop / authority lifetime even though they are not a paid
+send. The REAL stock resolver, credential pool, auth module and token store run over a synthetic OAuth authority below the
+real ``httpx`` client (``OAuthWire``); audio goes through the real ``requests`` stack over ``RestWire``.
+
+Contract under test: before EACH actual OAuth HTTP request the consumer's ``authorize`` is asked, on the consumer's own loop
+(never by the worker), under the same close/abandon/deadline fence as the paid gate; that phase never calls ``before_send``,
+never commits and never counts as a send; a refusal, Stop or deadline stops the next OAuth request and every audio send,
+without benching the account or falling back; a POST that was already admitted may finish and persist its rotated token
+(this is NOT remote cancellation) but nothing is sent afterwards; stock calls are untouched.
+
+Authorize numbering of a refreshed call: 1 call check, 2 probe before discovery, 3 probe before the refresh POST, 4 paid
+gate, 5 post-call check.
+
+Review I1: the refusal must also be terminal when xAI is only PROBED by the stock STT auto-detect (no explicit ``stt.provider``),
+whose quiet availability function swallows exceptions. The auto-detect tests use the real ``_get_provider``, resolver, pool and
+token store over the synthetic OAuth authority, a usable synthetic ElevenLabs key and a counting stand-in only for the cached local
+fallback entry, so a substituted provider or a fallback would show as a count.
+"""
+import asyncio
+import os
+import threading
+import time
+
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+from tests.gateway.mistral_voice_support import watch_worker
+
+TEXT = 'Hello there, friend.'
+KINDS = ['tts', 'stt']
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def local_fallback(monkeypatch):
+    calls = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: calls.append(path) or {'success': True, 'transcript': 'local words'})
+    return calls
+
+
+class Call:
+    """One native xAI call of either kind over an EXPIRED OAuth bearer (so the credential phase must run)."""
+
+    def __init__(self, monkeypatch, kind, out, clip, **callbacks):
+        from hermes_cli.config import invalidate_env_cache
+        self.kind, self.out, self.clip = kind, out, clip
+        section = {'tts': {'provider': 'xai', 'xai': {}}} if kind == 'tts' else {'stt': {'provider': 'xai', 'cloud_trim_silence': False}}
+        support.write_config(get_hermes_home(), section)
+        (get_hermes_home() / '.env').write_text('')
+        invalidate_env_cache()
+        self.access = rest.jwt(time.time() - 60, 'expired')
+        rest.write_oauth_store(self.access, refresh='rt-singleton')
+        self.cb = rest.ThreadedCallbacks(**callbacks)
+        self.audio = rest.RestWire([('audio', b'ID3x')] if kind == 'tts' else [('json', {'text': 'hello world'})])
+        from gateway import session_native_voice_stt as stt_module
+        from gateway import session_native_voice_tts as tts_module
+        self.finished = (watch_worker(monkeypatch, tts_module, '_synthesize') if kind == 'tts'
+                         else watch_worker(monkeypatch, stt_module, '_configured'))
+
+    def start(self, deadline_s=60):
+        if self.kind == 'tts':
+            return synthesize_native_once(TEXT, output_dir=self.out, authorize=self.cb.authorize,
+                                          before_send=self.cb.before_send, deadline_s=deadline_s)
+        return transcribe_native_once(self.clip, authorize=self.cb.authorize, before_send=self.cb.before_send,
+                                      deadline_s=deadline_s)
+
+    def unsent(self, result):
+        """The truthful unsent vocabulary: never a provider send, a file or a fallback transcript."""
+        assert result.provider == 'not_started'
+        assert (result.path if self.kind == 'tts' else (result.transcript, result.source)) in (None, (None, None))
+        assert self.audio.count == 0 and self.cb.before_send_calls == 0
+        assert self.kind == 'stt' or os.listdir(self.out) == []
+
+
+# --- authority lost BEFORE discovery -----------------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind', KINDS)
+async def test_lost_authority_before_discovery_sends_no_oauth_request_audio_or_fallback(monkeypatch, out, clip, local_fallback, kind):
+    call = Call(monkeypatch, kind, out, clip, refuse_authorize_at=2)  # the probe before discovery
+    oauth = rest.OAuthWire()
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.audio):
+        result = await call.start()
+    assert result.state == 'refused'
+    call.unsent(result)
+    assert (len(oauth.gets), len(oauth.posts)) == (0, 0)  # OAuth GET 0 / POST 0 / audio 0 / paid callback 0
+    assert local_fallback == [] and call.cb.authorize_calls == 3  # call check, the refused probe, the post-call check
+    assert support.SECRET not in repr(result)
+    assert rest.read_oauth_store()['providers']['xai-oauth']['tokens']['access_token'] == call.access  # tokens untouched
+
+
+# --- authority / Stop / deadline AFTER a held discovery, BEFORE the refresh --------------------------------------------
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind', KINDS)
+async def test_lost_authority_after_a_held_discovery_sends_no_refresh_or_audio(monkeypatch, out, clip, local_fallback, kind):
+    call = Call(monkeypatch, kind, out, clip, refuse_authorize_at=3)  # the probe before the refresh POST
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold_discovery=release)
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.audio):
+            task = asyncio.create_task(call.start())
+            assert await asyncio.to_thread(oauth.discovery_entered.wait, 10)  # discovery is in flight, held
+            release.set()
+            result = await task
+            assert await asyncio.to_thread(call.finished.wait, 10)
+    finally:
+        release.set()
+    assert result.state == 'refused'
+    call.unsent(result)
+    assert (len(oauth.gets), len(oauth.posts)) == (1, 0)  # the admitted discovery finished; no refresh POST followed
+    assert local_fallback == [] and call.cb.authorize_calls == 4  # call check, two probes (the 2nd refused), post-call check
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline'])
+@pytest.mark.parametrize('kind', KINDS)
+async def test_stop_or_deadline_after_a_held_discovery_sends_no_refresh_audio_or_late_callback(monkeypatch, out, clip, kind, how):
+    call = Call(monkeypatch, kind, out, clip)
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold_discovery=release)
+    deadline = rest.EventDeadline(monkeypatch)
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.audio):
+            task = asyncio.create_task(call.start(deadline_s=30))
+            assert await asyncio.to_thread(oauth.discovery_entered.wait, 10)
+            if how == 'cancel':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            else:
+                deadline.fire()
+                result = await task
+                assert (result.state, result.provider) == ('timeout', 'not_started')
+            seen = (call.cb.authorize_calls, call.cb.before_send_calls)
+            release.set()  # the late discovery answer arrives
+            assert await asyncio.to_thread(call.finished.wait, 10)
+    finally:
+        release.set()
+    assert (len(oauth.gets), len(oauth.posts)) == (1, 0)
+    assert call.audio.count == 0 and (call.cb.authorize_calls, call.cb.before_send_calls) == seen  # no late callback
+    assert call.cb.before_send_calls == 0 and (kind == 'stt' or os.listdir(out) == [])
+
