@@ -0,0 +1,660 @@
+"""Native voice seam: configured custom (plugin) STT/TTS providers, and terminal credential refusals.
+
+The plugins below are ordinary registered ``TranscriptionProvider``/``TTSProvider`` subclasses. A plugin that
+overrides ``*_native_once_v1`` sends its one request through the ``NativeTransport`` the seam hands it: a real httpx
+client whose network bytes are replaced by ``native_voice_support.Wire`` (the same synthetic transport the built-in
+provider tests use), so ``wire.count`` is the number of requests that would have left the process. No provider,
+network or plugin discovery is involved; the profile configuration is the real ``config.yaml`` read at call time.
+
+Also: O1, a credential-phase refusal recorded as ``closed``/``timeout`` while the deadline has NOT expired is terminal
+(no local fallback, no re-selection), so the deadline fence cannot mask the result.
+"""
+import asyncio
+import os
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from agent.transcription_provider import TranscriptionProvider
+from agent.tts_provider import TTSProvider
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tools import native_send_policy
+
+NAME = 'relay-custom'
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+class Discovery:
+    """Counting spies in place of the two discovery entries only (provider lookup ``_ensure_plugins_discovered`` and
+    hook delivery ``PluginManager.discover_and_load``); the real resolvers, manager snapshot and routes still run."""
+
+    def __init__(self):
+        self.ensure, self.delivery = [], []
+
+    @property
+    def none(self):
+        return self.ensure == [] and self.delivery == []
+
+
+@pytest.fixture(autouse=True)
+def registries(monkeypatch):
+    """Clean provider registries and discovery spies, so no real plugin code is ever loaded in this file."""
+    from agent import transcription_registry, tts_registry
+    transcription_registry._reset_for_tests()
+    tts_registry._reset_for_tests()
+    seen = Discovery()
+    from hermes_cli import plugins
+    monkeypatch.setattr(plugins, '_ensure_plugins_discovered', lambda force=False: seen.ensure.append(force))
+    monkeypatch.setattr(plugins.PluginManager, 'discover_and_load', lambda self, force=False: seen.delivery.append(force))
+    yield seen
+    transcription_registry._reset_for_tests()
+    tts_registry._reset_for_tests()
+
+
+def stt_config(**extra):
+    return {'stt': {'provider': NAME, NAME: {'model': 'custom-model-1', 'language': 'fr'}, **extra}}
+
+
+def tts_config(**extra):
+    return {'tts': {'provider': NAME, 'voice': 'custom-voice', 'model': 'custom-tts-1', 'speed': 1.25, **extra}}
+
+
+async def hear(clip, callbacks, deadline_s=30):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+async def speak(out, callbacks, text='Hello there, friend.', deadline_s=30):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+class Recorder:
+    def __init__(self):
+        self.available = 0
+        self.legacy = []
+        self.native = []
+        self.refusals = []
+
+
+class LegacySTT(TranscriptionProvider):
+    """A plugin with only the legacy ABC surface (no native-once opt-in)."""
+
+    def __init__(self, plan='one', label='A'):
+        self.plan, self.label, self.rec = plan, label, Recorder()
+        self.entered, self.finished = threading.Event(), threading.Event()
+
+    @property
+    def name(self):
+        return NAME
+
+    def is_available(self):
+        self.rec.available += 1
+        return True
+
+    def transcribe(self, file_path, *, model=None, language=None, **extra):
+        self.rec.legacy.append((file_path, model, language, extra))
+        return {'success': True, 'transcript': 'legacy words', 'provider': NAME}
+
+    def _post(self, transport, request):
+        try:
+            return transport.client.post('https://stt.custom.invalid/v1/transcribe', content=b'audio',
+                                         headers={'x-model': str(request.model), 'x-label': self.label})
+        except native_send_policy.NativeSendRefused as exc:
+            self.rec.refusals.append(exc.reason)
+            return None
+
+
+
+class CustomSTT(LegacySTT):
+    """Opted in. ``plan``: 'one' (one send), 'two' (tries a second send), 'none' (no send), 'raise' (raises with no
+    send), 'fail' (one send, then answers failed), 'wait' (waits for Stop/deadline, then tries to send)."""
+
+    def transcribe_native_once_v1(self, request, transport):
+        from agent.native_once import NativeSttAnswer
+        self.rec.native.append(request)
+        assert os.path.isfile(request.file_path)
+        self.entered.set()
+        try:
+            if self.plan == 'none':
+                return NativeSttAnswer('ok', 'words from nowhere')
+            if self.plan == 'raise':
+                raise RuntimeError('SECRET plugin failure text')
+            if self.plan == 'wait':
+                for _ in range(2000):  # bounded poll: waits for Stop or the deadline to close the call
+                    if request.cancelled():
+                        break
+                    time.sleep(0.01)
+                self._post(transport, request)
+                return NativeSttAnswer('failed')
+            answer = self._post(transport, request)
+            if self.plan == 'two':
+                self._post(transport, request)
+            if self.plan == 'fail' or answer is None or answer.status_code != 200:
+                return NativeSttAnswer('failed')
+            return NativeSttAnswer('ok', answer.json()['text'])
+        finally:
+            self.finished.set()
+
+
+class LegacyTTS(TTSProvider):
+    """A TTS plugin with only the legacy ABC surface (no native-once opt-in)."""
+
+    def __init__(self, plan='one', label='A'):
+        self.plan, self.label, self.rec = plan, label, Recorder()
+        self.entered, self.finished = threading.Event(), threading.Event()
+
+    @property
+    def name(self):
+        return NAME
+
+    def is_available(self):
+        self.rec.available += 1
+        return True
+
+    def synthesize(self, text, output_path, *, voice=None, model=None, speed=None, format='mp3', **extra):
+        self.rec.legacy.append((text, voice, model, speed, format))
+        with open(output_path, 'wb') as handle:
+            handle.write(b'ID3legacy-audio')
+        return output_path
+
+
+
+class CustomTTS(LegacyTTS):
+    """Opted in. ``plan``: 'one' (one send per chunk), 'two' (tries a second send), 'none' (audio with no send),
+    'wait' (waits for Stop/deadline, then tries to send and write audio)."""
+
+    def synthesize_native_once_v1(self, request, transport):
+        from agent.native_once import NativeTtsAnswer
+        self.rec.native.append(request)
+        self.entered.set()
+        try:
+            return self._answer(request, transport, NativeTtsAnswer)
+        finally:
+            self.finished.set()
+
+    def _answer(self, request, transport, NativeTtsAnswer):
+        if self.plan == 'none':
+            with open(request.output_path, 'wb') as handle:
+                handle.write(b'ID3unsent-audio')
+            return NativeTtsAnswer('ok')
+        if self.plan == 'wait':
+            for _ in range(2000):  # bounded poll: waits for Stop or the deadline to close the call
+                if request.cancelled():
+                    break
+                time.sleep(0.01)
+            try:
+                transport.client.post('https://tts.custom.invalid/v1/speech', json={'text': request.text})
+            except native_send_policy.NativeSendRefused as exc:
+                self.rec.refusals.append(exc.reason)
+            with open(request.output_path, 'wb') as handle:  # a late write after the close: must never surface
+                handle.write(b'ID3late-audio')
+            return NativeTtsAnswer('ok')
+        response = transport.client.post('https://tts.custom.invalid/v1/speech', json={'text': request.text},
+                                         headers={'x-label': self.label, 'x-voice': str(request.voice)})
+        if self.plan == 'two':
+            try:
+                transport.client.post('https://tts.custom.invalid/v1/speech', json={'text': request.text})
+            except native_send_policy.NativeSendRefused as exc:
+                self.rec.refusals.append(exc.reason)
+        with open(request.output_path, 'wb') as handle:
+            handle.write(response.content)
+        return NativeTtsAnswer('ok')
+
+
