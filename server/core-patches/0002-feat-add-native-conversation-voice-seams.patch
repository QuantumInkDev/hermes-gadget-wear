+        if output is None:
+            shutil.rmtree(cwd, ignore_errors=True)
+    if watch() is not None:  # the child finished between two watch polls with an oversized file
+        raise native_send_policy.refuse("too_long")
+    return result
+
+
+def _require_real_output(path: str) -> None:
+    """An ordinary failure unless the preparation child left a non-empty regular file (a bound violation is checked by the runner)."""
+    if os.path.islink(path) or not os.path.isfile(path) or os.path.getsize(path) <= 0:
+        raise subprocess.CalledProcessError(1, "native preparation")
+
+
+def _probe_audio_duration_native(ffprobe: Optional[str], file_path: str) -> Optional[float]:
+    """Native: the finite positive duration, or None (capability skip or any ordinary failure); refusals propagate."""
