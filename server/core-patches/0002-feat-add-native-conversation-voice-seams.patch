--- /dev/null
+++ b/tools/native_local_launcher.py
@@ -0,0 +1,69 @@
+"""Qualified OS network-deny launcher for native (Relay) local execution: command adapters, managed whisper.cpp and the
+local TTS engine helper.
+
+A native call runs local code only inside a launcher that THIS host has been qualified for: the exact platform,
+architecture, kernel release, launcher binary identity (sha256, regular executable file, not a symlink) and fixed
+profile recorded in :data:`QUALIFIED`. The single entry comes from a controller host probe (Darwin 27.0.0 arm64,
+``/usr/bin/sandbox-exec`` with ``(deny network*)``) that showed a wrapped child AND a wrapped ``setsid`` descendant were
+denied a loopback connection. That proves only those host cases. It is not a hostile-code sandbox, says nothing about
+process lifetime (a process-group kill does NOT reach a detached descendant), and every other host, architecture,
+release or binary is unqualified: a native local route is then refused unsent. The argv prefix is built here from the
+table, never accepted from a caller or configuration, and the binary is re-hashed on every use, so a changed OS binary
+invalidates the qualification at once.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import platform
+import stat
+import sys
+from dataclasses import dataclass
+from typing import Optional
+
+PROFILE = "(version 1) (allow default) (deny network*)"
+
+
+@dataclass(frozen=True, slots=True)
+class LauncherQualification:
+    system: str  # sys.platform
+    machine: str  # platform.machine()
+    release: str  # os.uname().release
+    path: str  # absolute launcher binary
+    sha256: str  # the probed binary's identity
+    argv_prefix: tuple[str, ...]  # the exact wrapping argv, ending with the fixed profile
+
+
+QUALIFIED: tuple[LauncherQualification, ...] = (
+    LauncherQualification(
+        system="darwin", machine="arm64", release="27.0.0", path="/usr/bin/sandbox-exec",
+        sha256="58839ef01b4eef8aac0d2aa8f9d1c074ae45aafe3533965b030672450064acc8",
+        argv_prefix=("/usr/bin/sandbox-exec", "-p", PROFILE)),
+)
+
+
+def _binary_sha256(path: str) -> Optional[str]:
+    """sha256 of a regular, executable, non-symlink file; None when it is anything else or unreadable."""
+    try:
+        info = os.lstat(path)
+        if not stat.S_ISREG(info.st_mode) or not os.access(path, os.X_OK):
+            return None
+        digest = hashlib.sha256()
+        with open(path, "rb") as handle:
+            for block in iter(lambda: handle.read(1 << 20), b""):
+                digest.update(block)
+        return digest.hexdigest()
+    except OSError:
+        return None
+
+
+def qualified_prefix() -> Optional[tuple[str, ...]]:
+    """The launcher argv prefix qualified for THIS host, or None (fail closed). Recomputed on every call."""
+    try:
+        host = (sys.platform, platform.machine(), os.uname().release)
+    except (AttributeError, OSError):
+        return None
+    for entry in QUALIFIED:
+        if host == (entry.system, entry.machine, entry.release) and _binary_sha256(entry.path) == entry.sha256:
+            return entry.argv_prefix
+    return None
