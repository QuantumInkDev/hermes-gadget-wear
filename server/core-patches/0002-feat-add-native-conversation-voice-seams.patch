+    db = rig.authority.db
+
+    def forbidden():
+        raise AssertionError('canonical read must not start')
+    monkeypatch.setattr(db, '_read_ctx', forbidden)
+    blind = replace(reader(), capabilities=frozenset())
+    calls = (
+        lambda a: rig.authority.read_native_display(blind, ref, authorize=a, identity=first.row_id, max_bytes=-1),
+        lambda a: rig.authority.locate_native_display(blind, ref, authorize=a, matches=None, max_rows=0),
+    )
+    for call in calls:
+        with pytest.raises(RuntimeStoreError, match='permission_denied'):
+            await call(lambda: None)
+    with pytest.raises(RuntimeStoreError, match='permission_denied'):
+        rig.authority.check_native_display(blind, ref, authorize=lambda: None, identity='')
+
+    def revoked():
+        raise RuntimeStoreError('permission_denied')
+    with pytest.raises(RuntimeStoreError, match='permission_denied'):
+        await rig.authority.read_native_display(reader(), ref, authorize=revoked, identity=first.row_id)
+    with pytest.raises(RuntimeStoreError, match='permission_denied'):
+        await rig.authority.locate_native_display(reader(), ref, authorize=revoked, matches=lambda i: True)
+    foreign = replace(reader(), profile_id='another-profile')
+    with pytest.raises(RuntimeStoreError, match='profile_mismatch'):
+        await rig.authority.read_native_display(foreign, ref, authorize=lambda: None, identity=first.row_id)
