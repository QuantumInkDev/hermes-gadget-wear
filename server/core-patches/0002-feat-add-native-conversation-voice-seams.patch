+@pytest.mark.asyncio
+async def test_stop_ends_an_engine_and_leaves_nothing(launcher, engine, spawns, out):
+    task = asyncio.create_task(speak('MODE:hang words', out))
+    for _ in range(100):  # bounded poll for the child
+        if engine_spawns(spawns):
+            break
+        await asyncio.sleep(0.05)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    for _ in range(100):  # bounded poll: the fenced worker removes its files once the killed child is gone
+        if not os.listdir(out):
+            break
+        await asyncio.sleep(0.05)
+    assert os.listdir(out) == []
