+@pytest.mark.asyncio
+async def test_origin_pinning_an_override_cannot_redirect_the_bearer(monkeypatch, out):
+    token = fresh_token()
+    from hermes_cli.config import invalidate_env_cache
+    tts_profile(base_url='https://proxy.example/v1')  # a config base_url is for API keys only
+    rest.write_oauth_store(token)
