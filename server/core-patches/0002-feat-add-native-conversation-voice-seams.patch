+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['stop', 'deadline'])
+@pytest.mark.parametrize('backend', HELD)
+async def test_stop_or_the_deadline_while_the_body_read_is_held_leaves_no_late_result_callback_send_or_fallback(
+        monkeypatch, clip, fallback, backend, how):
+    """LABELLED stand-in: the peer sends one chunk and stalls the next. Readiness = the client is blocked INSIDE the body read.
+    Stop/expiry is armed from it (the controlled clock only advances after readiness). The caller is released at once; the
+    already-blocked vendor read is NOT preempted (it ends when the stand-in releases, or at its IO timeout); when it resumes
+    the reader sees the closed call and stops at the next chunk: nothing late is produced."""
+    from gateway import session_native_voice_stt as stt_module
+    from tests.gateway.mistral_voice_support import watch_worker
+    backend.profile()
+    release = threading.Event()
+    finished = watch_worker(monkeypatch, stt_module, '_configured')
+    chunks = [b'a' * CHUNK] * 4
+    if backend.family == 'sdk':
+        wire = HeldBodyWire({'Content-Type': backend.kind}, chunks, release)
+        held = wire.body
+    else:
+        held = HeldBytes(b''.join(chunks), release)
+        wire = RawWire(200, {'Content-Type': backend.kind}, held)
+    clock = ReadinessClock(monkeypatch)
+    cb = support.Callbacks()
+    try:
+        with backend.context(monkeypatch, wire):
+            task = asyncio.create_task(transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send,
+                                                              deadline_s=300 if how == 'deadline' else 30))
+            assert await asyncio.to_thread(held.entered.wait, 15)  # READINESS: inside the body read
+            if how == 'stop':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            else:
+                clock.advance()  # expiry only AFTER the hold is confirmed
+                result = await task
+                assert (result.state, result.transcript, result.source, result.provider) == ('timeout', None, None, 'unknown')
+            calls = (cb.authorize_calls, cb.before_send_calls, wire.count)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 15)  # the worker completed after the release
+    finally:
+        release.set()
+    assert (cb.authorize_calls, cb.before_send_calls, wire.count) == calls == (cb.authorize_calls, 1, 1)  # no late callback/send
+    assert fallback == []  # no fallback after Stop/expiry
+    pulled = held.pulled if hasattr(held, 'pulled') else wire.body.pulled
+    assert pulled <= 2 * CHUNK < 4 * CHUNK  # stopped at the first boundary after the release
+    if backend.family == 'sdk':
+        assert wire.body.closed
