@@ -0,0 +1,220 @@
+"""Native voice seam against the REAL pinned SDK clients and the real Edge stack.
+
+``elevenlabs==1.59.0`` and ``edge-tts==7.2.7`` are the lock-pinned wheels of the owned offline
+overlay (hash-verified, never installed, imported under the unchanged guard); ``openai``/``httpx``
+come from the owned environment. Only the network bytes are synthetic: the httpx transport, and for
+Edge the socket (an in-process aiohttp WebSocket server behind a ``socketpair``; no DNS, TLS or
+service connection). Stand-ins appear ONLY where a test needs an SDK that misbehaves on purpose
+(bypasses the injected client) and are labelled as such.
+"""
+import os
+import threading
+from pathlib import Path
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+TEXT = 'Hello there, friend.'
+
+
+async def speak(out, callbacks, text=TEXT, deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def elevenlabs(monkeypatch):
+    """The REAL SDK class, observed (not replaced): every client the seam builds is recorded."""
+    pytest.importorskip('elevenlabs')
+    from elevenlabs.client import ElevenLabs
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs', 'elevenlabs': {
+        'voice_id': 'voice-profile-1', 'model_id': 'eleven_flash_v2_5'}}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+    built = []
+
+    class Observed(ElevenLabs):
+        def __init__(self, *args, **kwargs):
+            built.append(kwargs)
+            super().__init__(*args, **kwargs)
+    monkeypatch.setattr('tools.tts_tool._import_elevenlabs', lambda: Observed)
+    return built
+
+
+def sender_of(client):
+    """The httpx.Client the SDK endpoint actually sends through."""
+    return client.text_to_speech._client_wrapper.httpx_client.httpx_client
+
+
+@pytest.mark.asyncio
+async def test_real_elevenlabs_sends_once_through_the_injected_client(monkeypatch, out, elevenlabs):
+    events = []
+    cb = support.Callbacks(events)
+    wire = support.Wire([('ok', {'audio': b'ID3real'})], tap=lambda request: events.append('request'))
+    sdk_clients = []
+    from elevenlabs.client import ElevenLabs
+    original = ElevenLabs.__init__
+
+    def record(self, *a, **k):
+        original(self, *a, **k)
+        sdk_clients.append(self)
+    monkeypatch.setattr(ElevenLabs, '__init__', record)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, deadline_s=90)
+    assert (result.state, result.provider, result.source, wire.count) == ('synthesized', 'completed', 'configured', 1)
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    (built,) = elevenlabs
+    assert built['httpx_client'] is sender_of(sdk_clients[0]) and built['timeout'] == 60.0  # injected identity proven
+    assert {t['read'] for t in wire.timeouts()} == {60.0}
+    assert wire.requests[0].url.path.endswith('/voice-profile-1')
+    assert wire.requests[0].headers['xi-api-key'] == 'el-synthetic-key'
+    assert Path(result.path).read_bytes() == b'ID3real'
+
+
+@pytest.mark.asyncio
+async def test_real_elevenlabs_failures_are_not_resent_and_its_client_is_closed(monkeypatch, out, elevenlabs):
+    for script in ([('status', 500)] * 4, [('status', 429)] * 4, [('raise', httpx.ReadTimeout('synthetic'))] * 4,
+                   [('redirect', 'https://api.elevenlabs.io/elsewhere')] * 4):
+        cb = support.Callbacks()
+        wire = support.Wire(script)
+        with support.provider_wire(monkeypatch, wire):
+            result = await speak(out, cb)
+        assert (result.state, result.path, result.provider, wire.count) == ('failed', None, 'failed_after_send', 1), script[0]
+        assert cb.before_send_calls == 1 and os.listdir(out) == []
+    assert elevenlabs and all(k['httpx_client'].is_closed for k in elevenlabs)  # M4: no pool leaks per chunk
+
+
+@pytest.mark.asyncio
+async def test_real_elevenlabs_held_transport_ends_our_wait_at_the_deadline_only(monkeypatch, out, elevenlabs):
+    release = threading.Event()
+    wire = support.Wire([('ok', {'audio': b'ID3late'})], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            result = await speak(out, support.Callbacks(), deadline_s=0.5)
+    finally:
+        release.set()
+    assert (result.state, result.path, result.provider, wire.count) == ('timeout', None, 'unknown', 1)
+    assert {t['read'] for t in wire.timeouts()} == {0.5}  # the policy timeout never exceeds the deadline
+
+
+class IgnoresInjectedClient:
+    """Labelled stand-in: an SDK that builds and uses its OWN client whatever it is handed."""
+
+    def __init__(self, api_key=None, timeout=None, httpx_client=None, environment=None):
+        self.http = httpx.Client()
+        self.text_to_speech = self
+        self._client_wrapper = type('W', (), {'httpx_client': type('H', (), {'httpx_client': self.http})()})()
+
+    def convert(self, voice_id, *, text, model_id=None, output_format=None, request_options=None):
+        yield self.http.post('https://api.elevenlabs.io/v1/x', json={'text': text}).content
+
+
+class ProvesButBypasses(IgnoresInjectedClient):
+    """Labelled stand-in: reports the injected client as its sender but really sends through another."""
+
+    def __init__(self, api_key=None, timeout=None, httpx_client=None, environment=None):
+        super().__init__()
+        self._client_wrapper = type('W', (), {'httpx_client': type('H', (), {'httpx_client': httpx_client})()})()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('sdk, state, provider, requests, callbacks', [
+    (IgnoresInjectedClient, 'unavailable', 'not_started', 0, 0),   # identity not proven: refused UNSENT
+    (ProvesButBypasses, 'failed', 'unknown', 1, 0),                # a send nobody gated: never "not_started"
+], ids=['ignores-injected', 'proves-then-bypasses'])
+async def test_a_hooked_engine_that_bypasses_the_gate_cannot_be_synthesized_or_not_started(
+        monkeypatch, out, sdk, state, provider, requests, callbacks):
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs'}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+    monkeypatch.setattr('tools.tts_tool._import_elevenlabs', lambda: sdk)
+    cb = support.Callbacks()
+    wire = support.Wire([('ok', {'audio': b'ID3bypass'})] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == (state, None, provider)
+    assert wire.count == requests and cb.before_send_calls == callbacks and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_an_openai_client_that_ignores_the_injected_http_client_is_refused_unsent(monkeypatch, out, tmp_path):
+    import openai
+
+    class Ignoring(openai.OpenAI):
+        def __init__(self, *args, http_client=None, **kwargs):
+            super().__init__(*args, **kwargs)
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'openai', 'openai': {'api_key': 'sk-x'}},
+                                             'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                                                     'openai': {'api_key': 'sk-x'}}})
+    monkeypatch.setattr('tools.tts_tool._import_openai_client', lambda: Ignoring)
+    monkeypatch.setattr(openai, 'OpenAI', Ignoring)
+    cb = support.Callbacks()
+    wire = support.Wire([('ok', {'audio': b'ID3x'}), ('ok', {'text': 'hi', 'json': False})])
+    clip = support.write_wav(tmp_path / 'clip.wav')
+    with support.provider_wire(monkeypatch, wire):
+        speech = await speak(out, cb)
+        text = await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=30)
+    assert (speech.state, speech.provider) == ('unavailable', 'not_started')
+    assert (text.state, text.provider) == ('unavailable', 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0
+
+
+# --- the real Edge stack over a synthetic socket -------------------------------------------------
+
+@pytest.fixture
+def edge(monkeypatch):
+    pytest.importorskip('edge_tts')
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'edge'}})
+
+
+@pytest.mark.asyncio
+async def test_real_edge_stack_one_gated_handshake_per_chunk(monkeypatch, out, edge):
+    boundary = await support.EdgeBoundary().start(monkeypatch)
+    cb = support.Callbacks()
+    try:
+        result = await speak(out, cb)
+    finally:
+        await boundary.stop()
+    assert (result.state, result.provider, result.source) == ('synthesized', 'completed', 'configured')
+    assert boundary.handshakes == 1 and cb.before_send_calls == 1 and len(boundary.texts) == 1
+    assert Path(result.path).read_bytes() == b'ID3edge-audio'
+
+
+@pytest.mark.asyncio
+async def test_real_edge_stack_403_handshake_is_not_resent(monkeypatch, out, edge):
+    """Stock ``edge_tts`` re-handshakes after a 403 (2 handshakes, tests/tools stock transport). Native: 1."""
+    boundary = await support.EdgeBoundary([403, 'ok']).start(monkeypatch)
+    cb = support.Callbacks()
+    try:
+        result = await speak(out, cb)
+    finally:
+        await boundary.stop()
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert boundary.handshakes == 1 and cb.before_send_calls == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_real_edge_stack_multi_chunk_join_with_the_real_ffmpeg(monkeypatch, out, edge, tmp_path):
+    mp3 = support.synth_mp3(tmp_path / 'sine.mp3', seconds=1.0)
+    boundary = await support.EdgeBoundary(audio=mp3).start(monkeypatch)
+    sentence = 'This sentence is deliberately padded so that three of them need three Edge chunks. ' * 4
+    text = (sentence.strip() + ' ') * 3
+    cb = support.Callbacks()
+    try:
+        result = await speak(out, cb, text=text)
+    finally:
+        await boundary.stop()
+    assert (result.state, result.provider) == ('synthesized', 'completed')
+    chunks = cb.before_send_calls
+    assert chunks >= 2 and boundary.handshakes == chunks and len(boundary.texts) == chunks  # one send, one text per chunk
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert abs(support.media_seconds(result.path) - chunks * 1.0) < 0.5  # the REAL ffmpeg joined real MP3 chunks
