+# ---- remote route: working media ----------------------------------------------------------------------------------------
+@pytest.mark.asyncio
+async def test_a_multi_chunk_join_is_proved_first_then_runs_wrapped_and_yields_valid_ordered_media(
+        monkeypatch, tmp_path, out, scratch, launcher):
+    support.ffmpeg_path()
+    support.write_config(get_hermes_home(), openai_config())
+    count = chunk_total(LONG_TEXT, 60)
+    assert count >= 3
+    mp3, spans = real_chunks(tmp_path, count)
+    events = []
+    cb = support.Callbacks(events)
+    spawns = support.record_spawns(monkeypatch, events)
+    from tools import tts_command_provider
+    timeouts = []
+    real = tts_command_provider.run_native_argv
+
+    def recording(argv, **kw):
+        timeouts.append((os.path.basename(argv[0]), kw['timeout']))
+        return real(argv, **kw)
+    monkeypatch.setattr(tts_command_provider, 'run_native_argv', recording)
+    wire = support.Wire([('ok', {'audio': audio}) for audio in mp3], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, deadline_s=50.5)
+    assert (result.state, result.provider, result.source) == ('synthesized', 'completed', 'configured')
+    assert wire.count == count and cb.before_send_calls == count
+    # the join capability was proved BEFORE the first paid request, and the real join ran AFTER the last one
+    first, last = events.index('request'), len(events) - 1 - events[::-1].index('request')
+    assert events[:first].count('spawn') >= 4  # converter, concat and the ffprobe packet counts of the capability probe
+    after = [s for s in support.audio_spawns(spawns)][len(support.audio_spawns(spawns)) - (1 + count + 1):]
+    assert events[last:].count('spawn') == 1 + count + 1  # the join, then one packet count per chunk and one for the joined file
+    kinds = [support.program_of(s).rsplit('/', 1)[-1] + (':concat' if 'concat' in s['args'] else '') for s in after]
+    assert kinds == ['ffmpeg:concat'] + ['ffprobe'] * (count + 1), kinds
+    join = after[0]
+    argv = join['args']
+    assert argv[:4] == [sys.executable, str(support.PASSTHROUGH), '-p', launcher.PROFILE]  # inside the (stand-in) launcher
+    flags = argv[argv.index('-nostdin'):]
+    assert flags[:2] == ['-nostdin', '-hide_banner'] and ['-protocol_whitelist', 'file'] == flags[flags.index('-protocol_whitelist'):][:2]
+    assert ['-f', 'concat'] == flags[flags.index('-f'):][:2] and not any('://' in word or word.startswith('concat:') for word in argv)
+    assert join['stdin'] == subprocess.DEVNULL  # no stdin
+    listed = [line.split("'")[1] for line in join['concat_list'].splitlines()]
+    assert [os.path.basename(path)[-12:] for path in listed] == [f'chunk{i:03d}.mp3' for i in range(1, count + 1)]
+    assert all(os.path.dirname(path) == out for path in listed) and argv[-1] != result.path  # staged, then renamed
+    ffmpeg_timeouts = [t for name, t in timeouts if name == 'ffmpeg']
+    assert len(ffmpeg_timeouts) >= 3 and all(0 < t <= 50.5 and t != int(t) for t in ffmpeg_timeouts)  # exact float remainder
+    # the final media is real: a valid MP3 whose length is the sum of the chunks and whose tones are in chunk order
+    assert Path(result.path).read_bytes()[:3] == b'ID3' or Path(result.path).read_bytes()[0] == 0xFF
+    assert support.media_seconds(result.path) == pytest.approx(sum(spans), abs=0.4)
+    assert [abs(f - 440 * (i + 1)) < 40 for i, f in enumerate(support.tone_sequence(result.path, spans))] == [True] * count
+    assert os.listdir(out) == [os.path.basename(result.path)] and os.listdir(scratch) == []
