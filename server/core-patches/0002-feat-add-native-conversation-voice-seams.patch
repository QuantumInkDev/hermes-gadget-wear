+def unfenced_bounded(monkeypatch):
+    """LABELLED STAND-IN for the outer fence being slower than the worker's own refusal: the call waits for its worker
+    without the outer timeout, so a worker-side Stop/deadline refusal is what decides the state."""
+    from gateway import session_native_voice_gate as gate
+
+    async def unfenced(work, deadline, on_expiry):
+        return await asyncio.to_thread(work), False
+    monkeypatch.setattr(gate, 'bounded', unfenced)
