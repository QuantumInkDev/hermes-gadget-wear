+@pytest.mark.parametrize('engine,name', [(e, n) for e in CHAINS for n in CHAINS[e] if DISTS[n] in VERSIONS])
+def test_each_other_source_backed_version_is_unsupported(engine, name):
+    with pytest.raises(helper.Unavailable) as refused:
+        helper.require_packages(CHAINS[engine], *supported(wrong={DISTS[name]}))
+    assert refused.value.reason == 'unsupported_version'
