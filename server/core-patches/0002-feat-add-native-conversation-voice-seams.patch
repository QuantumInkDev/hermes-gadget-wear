@@ -0,0 +1,87 @@
+"""Native-once v1: the opt-in contract between the native (Relay) voice seam and a plugin STT/TTS provider.
+
+A plugin opts in by overriding :meth:`agent.transcription_provider.TranscriptionProvider.transcribe_native_once_v1`
+or :meth:`agent.tts_provider.TTSProvider.synthesize_native_once_v1`. The override is checked statically
+(:func:`overrides_native_once`) before ANY plugin code runs, ``is_available`` included; plugins that keep only the
+legacy ``transcribe``/``synthesize`` are refused unsent by a native call and behave exactly as before everywhere else.
+
+Trust boundary, stated plainly: an installed plugin is trusted code running with this process's privileges. The
+override is the plugin author's opt-in to trusted execution under this contract; it is NOT proof of one send, of no
+network and of no download, and nothing here contains hostile code. What the seam does prove is limited to the one
+boundary it owns: every request sent through ``NativeTransport.client`` passes the native send gate immediately
+before it leaves (the consumer's ``authorize``/``before_send`` run first, the send is counted, a second one is refused
+before the wire). A provider must send its single request through that client and nowhere else; a result that comes
+back without exactly one gated send is accounted ``unknown``, never ``not_started``. The response hook bounds what is
+kept per decoded chunk; it is not a strict heap bound.
+"""
+from __future__ import annotations
+
+import inspect
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Callable, Literal, Optional
+
+if TYPE_CHECKING:
+    import httpx
+
+NATIVE_ONCE_API = 1  # documentation constant; dispatch keys on the method NAME, never on this value
+
+
+@dataclass(frozen=True, slots=True)
+class NativeOnceLimits:
+    deadline_monotonic: float  # the native call's absolute ``time.monotonic()`` deadline in this process
+    request_timeout_s: float  # the call's per-request bound (min of the seam's request timeout and the deadline)
+    max_output_bytes: int  # the seam's existing answer cap (STT response / TTS chunk audio)
+
+
+@dataclass(frozen=True, slots=True)
+class NativeSttRequest:
+    file_path: str  # the validated, stock-prepared audio; read-only, owned and cleaned up by the caller
+    model: Optional[str]
+    language: Optional[str]
+    prompt: Optional[str]
+    limits: NativeOnceLimits
+    cancelled: Callable[[], bool]  # True once Stop/deadline closed the call; cooperative only
+
+
+@dataclass(frozen=True, slots=True)
+class NativeSttAnswer:
+    status: Literal['ok', 'no_speech', 'failed']
+    transcript: str = ''
+
+
+@dataclass(frozen=True, slots=True)
+class NativeTtsRequest:
+    text: str  # one seam chunk, already normalized and split
+    output_path: str  # the seam-owned chunk path; write the audio here and nowhere else
+    voice: Optional[str]
+    model: Optional[str]
+    speed: Optional[float]
+    format: Literal['mp3']
+    limits: NativeOnceLimits
+    cancelled: Callable[[], bool]
+
+
+@dataclass(frozen=True, slots=True)
+class NativeTtsAnswer:
+    status: Literal['ok', 'failed']
+
+
+@dataclass(frozen=True, slots=True)
+class NativeTransport:
+    """Constructed only by the seam (``tools.native_send_policy.native_transport``), which owns and closes ``client``:
+    zero automatic retries, redirects disabled, the call's timeout, and the policy's request (send gate) and response
+    (decoded-size bound) hooks."""
+    client: httpx.Client
+
+
+def overrides_native_once(provider: Any, base: type, method: str) -> bool:
+    """Static opt-in check that runs no plugin code: ``inspect.getattr_static`` on the instance's real type resolves
+    no descriptor, ``__getattr__`` or ``__getattribute__``. Only a plain function that differs from the ABC default
+    counts; anything else (property, staticmethod, callable object) is not an opt-in."""
+    impl = inspect.getattr_static(type(provider), method, None)
+    return inspect.isfunction(impl) and impl is not base.__dict__.get(method)
+
+
+def native_once_impl(provider: Any, method: str) -> Callable[..., Any]:
+    """The statically resolved override, called as ``impl(provider, request, transport)`` (no attribute hook runs)."""
+    return inspect.getattr_static(type(provider), method)
