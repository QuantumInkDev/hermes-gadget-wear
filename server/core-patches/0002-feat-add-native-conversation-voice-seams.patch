+"""Native voice seam: local engines, launcher-wrapped command adapters and managed whisper.cpp ``local_command``.
+
+HARNESS, stated plainly: no engine package, model or host sandbox exists or runs here. The qualification table is
+pointed at a hashed pass-through stand-in for the launcher, and engine chunks run a hashed protocol stand-in for the
+helper (``native_command_fixtures/``). What runs for real: the seam, the policy, the real runner/process group/pipes,
+the real child interpreter, the real ffmpeg (WAV -> MP3) and the real cleanup. This proves process IO, bounds,
+accounting and cleanup, never engine, library, network-denial or audio-quality behaviour.
+"""
+import asyncio
+import hashlib
+import os
+import platform
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+FIXTURES = Path(__file__).resolve().parents[1] / 'tools' / 'native_command_fixtures'
+STAND_IN = FIXTURES / 'launcher_passthrough.py'
+
+
+@pytest.fixture
+def launcher(monkeypatch):
+    try:
+        from tools import native_local_launcher as qualification
+    except ImportError:  # a tree without the launcher (Phase1A BASE): the seam's own behaviour is then what is measured
+        from types import SimpleNamespace
+        return SimpleNamespace(PROFILE='(version 1) (allow default) (deny network*)', QUALIFIED=())
+    monkeypatch.setattr(qualification, 'QUALIFIED', (qualification.LauncherQualification(
+        sys.platform, platform.machine(), os.uname().release, str(STAND_IN),
+        hashlib.sha256(STAND_IN.read_bytes()).hexdigest(), (sys.executable, str(STAND_IN), '-p', qualification.PROFILE)),))
+    return qualification
+
+
+@pytest.fixture
+def spawns(monkeypatch):
+    """Records every Popen argv/env/cwd (then really spawns)."""
+    seen = []
+    real = subprocess.Popen
+
+    class Recording(real):
+        def __init__(self, args, *a, **k):
+            seen.append({'args': list(args) if isinstance(args, (list, tuple)) else args, 'env': k.get('env'),
+                         'cwd': k.get('cwd')})
+            super().__init__(args, *a, **k)
+    monkeypatch.setattr(subprocess, 'Popen', Recording)
+    return seen
+
+
+@pytest.fixture
+def engine(monkeypatch, tmp_path):
+    """HARNESS: the engine stand-in replaces the helper path, and the parent's package probe sees a cached voice."""
+    from tools import tts_tool_local
+    model = tmp_path / 'voice.onnx'
+    model.write_bytes(b'onnx')
+    monkeypatch.setattr(tts_tool_local, 'NATIVE_ENGINE_HELPER', str(FIXTURES / 'engine_fixture.py'))
+    monkeypatch.setattr(tts_tool_local, 'native_engine_options', lambda engine, config: {
+        'model_path': str(model), 'config_path': f'{model}.json', 'use_cuda': False, 'speaker_id': 0, 'knobs': None})
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'piper'}})
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+async def speak(text, out, cb=None, deadline_s=30):
+    cb = cb or support.Callbacks()
+    return await synthesize_native_once(text, output_dir=out, authorize=cb.authorize, before_send=cb.before_send,
+                                        deadline_s=deadline_s)
+
+
+async def hear(clip, cb=None, deadline_s=30):
+    cb = cb or support.Callbacks()
+    return await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=deadline_s)
+
+
+def engine_spawns(spawns):
+    return [s for s in spawns if isinstance(s['args'], list) and str(FIXTURES / 'engine_fixture.py') in s['args']]
+
+
+# ---- local engines ---------------------------------------------------------------------------------------------------
+@pytest.mark.asyncio
+@pytest.mark.parametrize('mode', ['ok', 'noise'])
+async def test_a_local_engine_chunk_runs_wrapped_and_converts_real_audio(launcher, engine, spawns, out, mode):
+    support.ffmpeg_path()
+    cb = support.Callbacks()
+    result = await speak(f'MODE:{mode} hello local voice', out, cb)
+    assert (result.state, result.source, result.provider) == ('synthesized', 'configured', 'not_started')
+    assert cb.before_send_calls == 0 and os.listdir(out) == [os.path.basename(result.path)]  # no WAV sidecar left
+    audio = Path(result.path).read_bytes()
+    assert audio[:3] == b'ID3' or audio[0] == 0xFF  # a real MP3 from the real ffmpeg, not renamed WAV bytes
+    assert audio[:4] != b'RIFF'
+    (spawn,) = engine_spawns(spawns)
+    assert spawn['args'][:4] == [sys.executable, str(STAND_IN), '-p', launcher.PROFILE]
+    assert spawn['env']['HF_HUB_OFFLINE'] == spawn['env']['TRANSFORMERS_OFFLINE'] == '1'
+    joined = repr(spawn['args']) + repr(spawn['env']) + repr(spawn['cwd'])
+    assert 'hello local voice' not in joined and not os.path.exists(spawn['cwd'])  # text on stdin only; cwd removed
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('mode,state', [('unavailable', 'unavailable'), ('failed', 'failed'), ('noreply', 'failed'),
+                                        ('badwav', 'failed'), ('flood', 'too_long'), ('big', 'too_long')])
+async def test_local_engine_failures_are_truthful_and_leave_nothing(launcher, engine, out, mode, state):
+    result = await speak(f'MODE:{mode} words', out)
+    assert (result.state, result.path, result.provider) == (state, None, 'not_started')
+    assert os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_the_deadline_ends_a_stalled_engine_and_its_late_files_are_removed(launcher, engine, out):
+    started = time.monotonic()
+    for mode in ('hang', 'late'):
+        result = await speak(f'MODE:{mode} words', out, deadline_s=0.8)
+        assert (result.state, result.provider) == ('timeout', 'not_started')
+    assert time.monotonic() - started < 6
+    await asyncio.sleep(2.5)  # health: allow HX013 -- the window past the late writer's finish IS the behaviour under test
+    assert os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_stop_ends_an_engine_and_leaves_nothing(launcher, engine, spawns, out):
+    task = asyncio.create_task(speak('MODE:hang words', out))
+    for _ in range(100):  # bounded poll for the child
+        if engine_spawns(spawns):
+            break
+        await asyncio.sleep(0.05)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+    for _ in range(100):  # bounded poll: the fenced worker removes its files once the killed child is gone
+        if not os.listdir(out):
+            break
+        await asyncio.sleep(0.05)
+    assert os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_no_usable_ffmpeg_refuses_before_any_engine_even_for_one_chunk(monkeypatch, launcher, engine, spawns, out):
+    import shutil
+    real = shutil.which
+    monkeypatch.setattr(shutil, 'which', lambda name, *a, **k: None if name == 'ffmpeg' else real(name, *a, **k))
+    result = await speak('MODE:ok words', out)
+    assert (result.state, result.provider) == ('unavailable', 'not_started')
+    assert engine_spawns(spawns) == [] and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_an_unqualified_launcher_refuses_before_any_engine(monkeypatch, launcher, engine, spawns, out):
+    monkeypatch.setattr(launcher, 'QUALIFIED', ())
+    result = await speak('MODE:ok words', out)
+    assert (result.state, result.provider) == ('unavailable', 'not_started')
+    assert engine_spawns(spawns) == [] and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('provider', ['piper', 'kittentts', 'neutts'])
+async def test_absent_engine_runtimes_are_unavailable_without_a_child(launcher, spawns, out, provider):
+    support.write_config(get_hermes_home(), {'tts': {'provider': provider}})
+    result = await speak('words', out)
+    assert (result.state, result.path, result.provider) == ('unavailable', None, 'not_started')
+    assert spawns == [] and os.listdir(out) == []
+
+
+# ---- command adapters ------------------------------------------------------------------------------------------------
+def stt_command(native='local-sandboxed'):
+    import shlex
+    command = shlex.join([sys.executable, str(FIXTURES / 'native_transcriber.py')]) + ' {input_path} {output_path}'
+    entry = {'type': 'command', 'command': command, **({'native': native} if native else {})}
+    return {'stt': {'provider': 'local-cli', 'providers': {'local-cli': entry}}}
+
+
+@pytest.mark.asyncio
+async def test_an_opted_in_stt_command_runs_inside_the_launcher_and_is_local(launcher, spawns, clip):
+    support.write_config(get_hermes_home(), stt_command())
+    cb = support.Callbacks()
+    result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'native local words', 'configured', 'not_started')
+    (spawn,) = [s for s in spawns if isinstance(s['args'], list) and s['args'][:2] == [sys.executable, str(STAND_IN)]]
+    assert spawn['args'][2:6] == ['-p', launcher.PROFILE, '/bin/sh', '-c'] and cb.before_send_calls == 0
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('case', ['not-opted-in', 'other-native-value', 'no-launcher'])
+async def test_an_stt_command_without_opt_in_or_launcher_never_spawns(monkeypatch, launcher, spawns, clip, case):
+    support.write_config(get_hermes_home(), stt_command(native={'not-opted-in': None, 'other-native-value': 'true',
+                                                               'no-launcher': 'local-sandboxed'}[case]))
+    if case == 'no-launcher':
+        monkeypatch.setattr(launcher, 'QUALIFIED', ())
+    result = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('unavailable', None, 'not_started')
+    assert spawns == []
+
+
+@pytest.mark.asyncio
+async def test_authority_lost_before_the_spawn_refuses_it(launcher, spawns, clip):
+    support.write_config(get_hermes_home(), stt_command())
+    cb = support.Callbacks(refuse_authorize_at=2)  # 1: seam entry; 2: the pre-spawn authorization probe
+    result = await hear(clip, cb)
+    assert (result.state, result.provider) == ('refused', 'not_started') and spawns == []
+    assert cb.authorize_calls == 3  # entry, the pre-spawn probe that refused, and the end-of-call check
+
+
+@pytest.mark.asyncio
+async def test_an_opted_in_tts_command_runs_inside_the_launcher(launcher, spawns, out):
+    command = (f'"{sys.executable}" -c "import shutil, sys; shutil.copyfile(sys.argv[1], sys.argv[2])" '
+               '{input_path} {output_path}')
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'local-voice', 'providers': {'local-voice': {
+        'type': 'command', 'command': command, 'native': 'local-sandboxed'}}}})
+    result = await speak('Hello there, friend.', out)
+    assert (result.state, result.source, result.provider) == ('synthesized', 'configured', 'not_started')
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert [s for s in spawns if isinstance(s['args'], list) and s['args'][:2] == [sys.executable, str(STAND_IN)]]
+
+
+# ---- managed whisper.cpp local_command -------------------------------------------------------------------------------
+@pytest.fixture
+def managed(monkeypatch, tmp_path):
+    """HARNESS: a PM install record pointing at the whisper.cpp stand-in and two synthetic pinned models."""
+    import shlex
+    from tools import transcription_whisper_cpp as wcpp
+    models = tmp_path / 'models'
+    models.mkdir()
+    pinned = []
+    for name in ('ggml-base.bin', 'ggml-silero-v6.2.0.bin'):
+        (models / name).write_bytes(name.encode() * 10)
+        pinned.append((name, f'https://example.invalid/{name}', hashlib.sha256((models / name).read_bytes()).hexdigest()))
+    monkeypatch.setattr(wcpp, '_MODEL_FILES', tuple(pinned))
+    monkeypatch.setattr(wcpp, '_model_dir', lambda: models)
+    quote = lambda p: shlex.quote(str(p))
+    template = (f"{quote(sys.executable)} {quote(FIXTURES / 'whisper_fixture.py')} -m {quote(models / 'ggml-base.bin')} "
+                "-f {input_path} -l {language} -t 4 -otxt -of {output_dir}/transcript --vad "
+                f"-vm {quote(models / 'ggml-silero-v6.2.0.bin')}")
+    monkeypatch.setattr(wcpp, 'whisper_cpp_command', lambda: template)
+    monkeypatch.setattr('tools.transcription_local._find_whisper_binary', lambda: None)
+    ensured = []
+    monkeypatch.setattr(wcpp, 'ensure_whisper_cpp_models', lambda *a: ensured.append(a))
+    monkeypatch.delenv('HERMES_LOCAL_STT_COMMAND', raising=False)
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', False)
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'local_command'}})
+    return models, ensured
+
+
+@pytest.mark.asyncio
+async def test_managed_whisper_cpp_runs_inside_the_launcher_with_verified_models(launcher, managed, spawns, clip):
+    result = await hear(clip)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'managed whisper words', 'configured', 'not_started')
+    assert managed[1] == []  # never the downloader
+    assert [s for s in spawns if isinstance(s['args'], list) and s['args'][:2] == [sys.executable, str(STAND_IN)]]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('case', ['env-template', 'model-changed', 'no-launcher', 'not-base'])
+async def test_managed_whisper_cpp_refuses_unsent_without_its_prerequisites(monkeypatch, launcher, managed, spawns, clip,
+                                                                            case):
+    models, ensured = managed
+    if case == 'env-template':
+        monkeypatch.setenv('HERMES_LOCAL_STT_COMMAND', 'whisper {input_path}')
+    elif case == 'model-changed':
+        (models / 'ggml-base.bin').write_bytes(b'tampered')
+    elif case == 'no-launcher':
+        monkeypatch.setattr(launcher, 'QUALIFIED', ())
+    else:
+        support.write_config(get_hermes_home(), {'stt': {'provider': 'local_command', 'local': {'model': 'small'}}})
+    result = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('unavailable', None, 'not_started')
+    assert ensured == [] and [s for s in spawns if isinstance(s['args'], list) and str(STAND_IN) in s['args']] == []
