+def test_stock_elevenlabs_request_count_and_timeout_are_measured_not_assumed(monkeypatch):
+    """The REAL pinned ``elevenlabs`` SDK (overlay wheel 1.59.0) builds its own httpx client and, with no
+    ``request_options``, does not retry: observed, not assumed (the design assumed unpinned defaults)."""
