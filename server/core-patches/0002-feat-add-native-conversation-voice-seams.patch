+async def test_rows_the_canonical_projection_hides_are_not_found(rig):
+    ref = await route(rig)
+    db = rig.authority.db
+    ids = {
+        'visible': db.append_message(ref.session_id, 'assistant', 'visible answer'),
+        'model-only': db.append_message(ref.session_id, 'assistant', 'model only text',
+                                        display_metadata={MODEL_ONLY_DISPLAY_METADATA_KEY: True}),
+        'internal': db.append_message(ref.session_id, 'assistant', 'internal note', display_kind='internal_notification'),
+        'tool': db.append_message(ref.session_id, 'assistant', 'tool output', tool_call_id='call-1'),
+        'summary': db.append_message(ref.session_id, 'assistant', 'compaction summary', _compressed_summary=True),
+        'rewound': db.append_message(ref.session_id, 'assistant', 'rewound away'),
+        'deleted': db.append_message(ref.session_id, 'assistant', 'deleted soon'),
+    }
+    with db._read_ctx() as conn:
+        uids = {name: conn.execute('SELECT message_uid FROM messages WHERE id=?', (row_id,)).fetchone()[0]
+                for name, row_id in ids.items()}
+    db._execute_write(lambda c: c.execute('UPDATE messages SET active=0, compacted=0 WHERE id=?', (ids['rewound'],)))
+    db._execute_write(lambda c: c.execute('DELETE FROM messages WHERE id=?', (ids['deleted'],)))
+    seen = []
+    for name in ids:
+        try:
+            fragment = await rig.authority.read_native_display(
+                reader(), ref, authorize=lambda: None, identity=uids[name])
+            seen.append((name, fragment.text))
+        except RuntimeStoreError as exc:
+            assert exc.reason == 'not_found', name
+            if name != 'summary':  # outside the visible-row projection: the scalar fence refuses it too
+                with pytest.raises(RuntimeStoreError, match='not_found'):
+                    rig.authority.check_native_display(reader(), ref, authorize=lambda: None, identity=uids[name])
+    assert seen == [('visible', 'visible answer')]
+    token = rig.authority.check_native_display(reader(), ref, authorize=lambda: None, identity=uids['visible'])
+    assert (token.identity, token.physical_id, token.revision) == (uids['visible'], ids['visible'], 0)
+    # A carrier the canonical normalizer hides is still a projection row: only a READ can refuse it (the
+    # scalar fence reads no content by design); a consumer reads before it fences, so it never plays one.
+    assert rig.authority.check_native_display(reader(), ref, authorize=lambda: None, identity=uids['summary'])
