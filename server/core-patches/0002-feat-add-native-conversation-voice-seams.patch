index 0000000000000000000000000000000000000000..d19830a52f92973329d654337576e93454d5b94d
--- /dev/null
+++ b/tests/gateway/mistral_voice_support.py
@@ -0,0 +1,138 @@
+"""Synthetic Mistral provider bytes and shared profile helpers for the native voice Mistral tests.
+
+Only the network bytes are replaced (the shared ``Wire`` / ``provider_wire`` transport of
+``native_voice_support``): the REAL pinned ``mistralai`` SDK builds, sends and parses every request.
+Answers are valid SDK envelopes, so the SDK's own response parser runs on them.
+"""
+from __future__ import annotations
+
+import asyncio
+import base64
+import functools
+import threading
+
+import httpx
+
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'mi-synthetic-key'
+TRANSCRIPTION_URL = 'https://api.mistral.ai/v1/audio/transcriptions'
+SPEECH_URL = 'https://api.mistral.ai/v1/audio/speech'
+LONG_TEXT = ('The first sentence is deliberately rather long. The second sentence is also fairly long here. '
+             'The third sentence closes out the whole text.')
+
+
+class MistralWire(support.Wire):
+    """Scripted Mistral answers. 'ok' values: ``text`` (STT), ``audio`` (TTS bytes, base64-wrapped),
+    ``content`` (raw body bytes) or ``chunks`` (a body of unknown length)."""
+
+    def respond(self, request, value):
+        if 'content' in value:
+            return httpx.Response(200, content=value['content'], headers={'content-type': 'application/json'},
+                                  request=request)
+        if 'chunks' in value:
+            return httpx.Response(200, content=iter(value['chunks']), headers={'content-type': 'application/json'},
+                                  request=request)
+        if request.url.path.endswith('/audio/speech'):
+            audio = base64.b64encode(value.get('audio', b'ID3mistral-audio')).decode()
+            return httpx.Response(200, json={'audio_data': audio}, request=request)
+        return httpx.Response(200, request=request, json={
+            'model': 'voxtral-mini-latest', 'text': value.get('text', 'hello world'), 'language': 'en',
+            'usage': {'prompt_tokens': 1, 'completion_tokens': 1, 'total_tokens': 2, 'prompt_audio_seconds': 1}})
+
+
+def stt_profile(**section):
+    """The profile's real ``config.yaml`` and ``.env`` for a Mistral STT (``section`` is ``stt.mistral``)."""
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'mistral', 'cloud_trim_silence': False,
+                                                     'mistral': section}})
+    (get_hermes_home() / '.env').write_text(f'MISTRAL_API_KEY={KEY}\n')
+
+
+def tts_profile(**section):
+    """The same for a Mistral TTS (``section`` is ``tts.mistral``)."""
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'mistral', 'mistral': section}})
+    (get_hermes_home() / '.env').write_text(f'MISTRAL_API_KEY={KEY}\n')
+
+
+async def hear(path, callbacks, deadline_s=30):
+    from gateway.session_native_voice import transcribe_native_once
+    return await transcribe_native_once(path, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+async def speak(out, callbacks, text='Hello there, friend.', deadline_s=60):
+    from gateway.session_native_voice import synthesize_native_once
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+class HeldGate:
+    """Holds the loop callback the worker enqueues for the consumer's callbacks until the test releases it."""
+
+    def __init__(self, monkeypatch):
+        self.loop = asyncio.get_running_loop()
+        self.enqueued = threading.Event()
+        self.held = None
+        self.real = self.loop.call_soon_threadsafe
+
+        def intercept(callback, *args, **kwargs):
+            if 'loop_gate' in getattr(callback, '__qualname__', ''):
+                self.held = callback
+                self.enqueued.set()
+                return None
+            return self.real(callback, *args, **kwargs)
+        monkeypatch.setattr(self.loop, 'call_soon_threadsafe', intercept)
+
+    async def wait_enqueued(self):
+        assert await asyncio.to_thread(self.enqueued.wait, 10)
+
+    async def release(self):
+        done = asyncio.Event()
+
+        def run():
+            self.held()
+            done.set()
+        self.real(run)
+        await done.wait()
+
+
+def watch_worker(monkeypatch, module, name):
+    """An Event set when the worker function has fully returned (the late path has finished)."""
+    finished = threading.Event()
+    original = getattr(module, name)
+
+    def watched(*args, **kwargs):
+        try:
+            return original(*args, **kwargs)
+        finally:
+            finished.set()
+    monkeypatch.setattr(module, name, watched)
+    return finished
+
+
+def record_calls(real, calls):
+    """``real`` with the options of each call noted; ``wraps`` keeps the signature the seam inspects."""
+    @functools.wraps(real)
+    def observed(*args, **kwargs):
+        calls.append({name: value for name, value in kwargs.items() if name not in ('file', 'input')})
+        return real(*args, **kwargs)
+    return observed
+
+
+def observe_sdk(monkeypatch):
+    """The REAL SDK class, observed (not replaced): what each client was built with, what it sends through and
+    which per-call options each real endpoint invocation received (the call itself still runs the real SDK)."""
+    from mistralai.client import Mistral
+    seen = []
+
+    class Observed(Mistral):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            record = {'kwargs': kwargs, 'sender': self.sdk_configuration.client, 'calls': []}
+            seen.append(record)
+            for endpoint in (self.audio.transcriptions, self.audio.speech):
+                endpoint.complete = record_calls(endpoint.complete, record['calls'])
+    monkeypatch.setattr('mistralai.client.Mistral', Observed)
+    monkeypatch.setattr('tools.tts_tool._import_mistral_client', lambda: Observed)
+    return seen
