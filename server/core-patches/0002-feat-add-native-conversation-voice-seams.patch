+# ---- probe: default short clip, trim disabled, nonfinite / malformed ------------------------------------------------------
+@pytest.mark.asyncio
+async def test_a_default_short_clip_probes_before_the_12_second_gate_as_a_wrapped_bounded_child(
+        monkeypatch, tmp_path, scratch, stock_runner):
