+"""Shared fixtures for the native display seam tests: real core rows, the existing reader as oracle."""
+from contextlib import contextmanager
+import json
+import time
+
+from gateway.session_contract import Principal
+
+
+def reader():
+    return Principal('viewer', 'default', frozenset({'session:read'}), 'test')
+
+
+async def fragments(authority, actor, ref):
+    """Every fragment the EXISTING position reader yields, in order (the oracle the seam must equal)."""
+    found, position = [], None
+    while True:
+        page = await authority.read_native_history_fragment(actor, ref, authorize=lambda: None, position=position)
+        if page.row is not None:
+            found.append(page.row)
+        position = page.position
+        if not page.more:
+            return found
+
+
+def by_identity(frags):
+    grouped = {}
+    for frag in frags:
+        grouped.setdefault(frag.row_id, []).append(frag)
+    return grouped
+
+
+def whole_text(parts):
+    return ''.join(f.text for f in sorted(parts, key=lambda f: f.segment_index))
+
+
+@contextmanager
+def traced_reads(db, statements):
+    """Record every SQL statement the reads under test execute (to prove what they never hydrate)."""
+    original = db._read_ctx
+
+    @contextmanager
+    def traced():
+        with original() as conn:
+            conn.set_trace_callback(statements.append)
+            try:
+                yield conn
+            finally:
+                conn.set_trace_callback(None)
+    db._read_ctx = traced
+    try:
+        yield statements
+    finally:
+        db._read_ctx = original
+
+
+def hydrated_ids(statements):
+    """Physical ids whose body columns a statement fetched by id."""
+    import re
+    ids = set()
+    for statement in statements:
+        if 'FROM messages WHERE id=' in statement and 'content' in statement:
+            ids.update(int(n) for n in re.findall(r'WHERE id=(\d+)', statement))
+    return ids
+
+
+def bulk_rows(db, session_id, count, *, start=0, role='assistant', text=lambda i: f'row {i}'):
+    """``count`` visible display rows in one write transaction (a large lineage without 65k commits)."""
+    stamp = time.time() - count - 10
+    rows = [(session_id, role, text(start + i), stamp + i, f'bulk-{start + i}') for i in range(count)]
+    db._execute_write(lambda conn: conn.executemany(
+        'INSERT INTO messages (session_id, role, content, timestamp, active, message_uid) VALUES (?,?,?,?,1,?)', rows))
+    return [r[4] for r in rows]
+
+
+def measured(label, **values):
+    print('NATIVE_VOICE_MEASURE ' + json.dumps({'label': label, **values}, sort_keys=True))
