+    xai = next(p.values[0] for p in BACKENDS if p.values[0].name == 'xai')
+    xai.profile()
+    seen = []
+    import requests
+    real = requests.post
+
+    def recording(*args, **kwargs):
+        seen.append(dict(kwargs))
+        return real(*args, **kwargs)
+    monkeypatch.setattr(requests, 'post', recording)
+    wire = RawWire(200, {'Content-Type': 'application/json'}, b'{"text":"hello world"}')
+    with xai.context(monkeypatch, wire):
+        native, _ = await hear(clip)
+    wire = RawWire(200, {'Content-Type': 'application/json'}, b'{"text":"hello world"}')  # a fresh body: the first is spent
+    with xai.context(monkeypatch, wire):
