+def test_the_seam_contract_the_consumer_validates():
+    assert voice.NATIVE_VOICE_VERSION == 1 and SessionAuthority.NATIVE_VOICE_VERSION == 1
+    assert [f.name for f in fields(voice.NativeDisplayToken)] == ['identity', 'physical_id', 'revision']
+    assert [f.name for f in fields(voice.NativeTranscription)] == ['state', 'transcript', 'source', 'provider']
+    assert [f.name for f in fields(voice.NativeSpeech)] == ['state', 'path', 'code_points', 'source', 'provider']
+    assert [f.name for f in fields(voice.NativeDisplayLocation)] == [
+        'identity', 'physical_id', 'role', 'created_at_ms', 'segment_count', 'size_bytes']
+    assert voice.NativeDisplayLocation.__dataclass_fields__['physical_id'].type in (int, 'int')
+    with pytest.raises(FrozenInstanceError):
+        voice.NativeTranscription('transcribed', 'x', 'configured', 'completed').state = 'failed'
+
+    def keyword_only(function, *names):
+        parameters = inspect.signature(function).parameters
+        assert [n for n in parameters if parameters[n].kind is inspect.Parameter.KEYWORD_ONLY][:len(names)] == list(names)
+    keyword_only(voice.transcribe_native_once, 'authorize', 'before_send', 'deadline_s')
+    keyword_only(voice.synthesize_native_once, 'output_dir', 'authorize', 'before_send', 'deadline_s')
+    keyword_only(SessionAuthority.locate_native_display, 'authorize', 'matches', 'max_rows')
+    keyword_only(SessionAuthority.read_native_display, 'authorize', 'identity', 'segment', 'max_bytes')
+    keyword_only(SessionAuthority.check_native_display, 'authorize', 'identity')
+    keyword_only(SessionAuthority.check_existing_display, 'adapter', 'source', 'authorize', 'row_id')
+    keyword_only(SessionAuthority.locate_existing_display, 'adapter', 'source', 'authorize', 'matches', 'max_rows')
+    keyword_only(SessionAuthority.read_existing_display, 'adapter', 'source', 'authorize', 'row_id', 'segment', 'max_bytes')
