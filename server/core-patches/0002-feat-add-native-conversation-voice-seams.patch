+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('€' * 3000 + '😀' * 1000)])  # 4,000 code points, 13,000 bytes: fine
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 3999 + '€' * 1)])  # 4,000 code points, 15,999 bytes: fine
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 3999 + '€€')])  # 4,001 code points
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'too_long'
