+# ---- fix1 M5: the existing native command-STT ``normalize`` caller of the shared transcode ---------------------------------------------
+# A named ``native: local-sandboxed`` command provider with ``normalize: true`` reaches ``_transcode_audio_for_stt`` through the real native
+# entry (transcription_tools -> _transcribe_command_stt -> _normalize_command_stt_input). The finite owned command fixture is
+# ``native_transcriber.py`` (guard-admitted shape). Prerequisite and cost: normalization now needs the qualified converter and counts as a
+# local launch (required work, probe=False).
+def command_stt(normalize=True):
+    import shlex
+    command = shlex.join([sys.executable, str(support.FIXTURES / 'native_transcriber.py')]) + ' {input_path} {output_path}'
+    entry = {'type': 'command', 'command': command, 'native': 'local-sandboxed', 'normalize': normalize}
+    return {'stt': {'provider': 'local-cli', 'providers': {'local-cli': entry}}}
+
+
+def command_work_dirs():
+    """The command-STT work directories in the runner temp root (the guard binds TMPDIR, so these tests cannot rebind it as ``scratch`` does)."""
+    import tempfile
+    return sorted(Path(tempfile.gettempdir()).glob('hermes-cmd-stt-*'))
