+class LegacySTT(TranscriptionProvider):
+    """A plugin with only the legacy ABC surface (no native-once opt-in)."""
+
+    def __init__(self, plan='one', label='A'):
+        self.plan, self.label, self.rec = plan, label, Recorder()
+        self.entered, self.finished = threading.Event(), threading.Event()
+
+    @property
+    def name(self):
+        return NAME
+
+    def is_available(self):
+        self.rec.available += 1
+        return True
+
+    def transcribe(self, file_path, *, model=None, language=None, **extra):
+        self.rec.legacy.append((file_path, model, language, extra))
+        return {'success': True, 'transcript': 'legacy words', 'provider': NAME}
+
+    def _post(self, transport, request):
+        try:
+            return transport.client.post('https://stt.custom.invalid/v1/transcribe', content=b'audio',
+                                         headers={'x-model': str(request.model), 'x-label': self.label})
+        except native_send_policy.NativeSendRefused as exc:
+            self.rec.refusals.append(exc.reason)
+            return None
+
+
+
+class CustomSTT(LegacySTT):
+    """Opted in. ``plan``: 'one' (one send), 'two' (tries a second send), 'none' (no send), 'raise' (raises with no
+    send), 'fail' (one send, then answers failed), 'wait' (waits for Stop/deadline, then tries to send)."""
+
+    def transcribe_native_once_v1(self, request, transport):
+        from agent.native_once import NativeSttAnswer
+        self.rec.native.append(request)
+        assert os.path.isfile(request.file_path)
+        self.entered.set()
+        try:
+            if self.plan == 'none':
+                return NativeSttAnswer('ok', 'words from nowhere')
+            if self.plan == 'raise':
+                raise RuntimeError('SECRET plugin failure text')
+            if self.plan == 'wait':
+                for _ in range(2000):  # bounded poll: waits for Stop or the deadline to close the call
+                    if request.cancelled():
+                        break
+                    time.sleep(0.01)
+                self._post(transport, request)
+                return NativeSttAnswer('failed')
+            answer = self._post(transport, request)
+            if self.plan == 'two':
+                self._post(transport, request)
+            if self.plan == 'fail' or answer is None or answer.status_code != 200:
+                return NativeSttAnswer('failed')
+            return NativeSttAnswer('ok', answer.json()['text'])
+        finally:
+            self.finished.set()
+
+
+class LegacyTTS(TTSProvider):
+    """A TTS plugin with only the legacy ABC surface (no native-once opt-in)."""
+
+    def __init__(self, plan='one'):
+        self.plan, self.rec = plan, Recorder()
+
+    @property
+    def name(self):
+        return NAME
+
+    def is_available(self):
+        self.rec.available += 1
+        return True
+
+    def synthesize(self, text, output_path, *, voice=None, model=None, speed=None, format='mp3', **extra):
+        self.rec.legacy.append((text, voice, model, speed, format))
+        with open(output_path, 'wb') as handle:
+            handle.write(b'ID3legacy-audio')
+        return output_path
+
+
+
+class CustomTTS(LegacyTTS):
+    def synthesize_native_once_v1(self, request, transport):
+        from agent.native_once import NativeTtsAnswer
+        self.rec.native.append(request)
+        if self.plan == 'none':
+            with open(request.output_path, 'wb') as handle:
+                handle.write(b'ID3unsent-audio')
+            return NativeTtsAnswer('ok')
+        response = transport.client.post('https://tts.custom.invalid/v1/speech', json={'text': request.text})
+        if self.plan == 'two':
+            try:
+                transport.client.post('https://tts.custom.invalid/v1/speech', json={'text': request.text})
+            except native_send_policy.NativeSendRefused as exc:
+                self.rec.refusals.append(exc.reason)
+        with open(request.output_path, 'wb') as handle:
+            handle.write(response.content)
+        return NativeTtsAnswer('ok')
+
