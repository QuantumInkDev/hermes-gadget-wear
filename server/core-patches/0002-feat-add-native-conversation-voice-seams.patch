+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['stop', 'deadline'])
+async def test_stop_or_the_deadline_while_a_rest_tts_body_read_is_held_leaves_no_late_result_send_or_file(
+        monkeypatch, out, how):
+    """LABELLED stand-in peer that stalls after the first body chunk (see the STT twin). The caller is released at once; the
+    blocked vendor read is not preempted; when it resumes the reader stops at the next chunk."""
+    import asyncio
+    import threading
+    import requests
+    from gateway import session_native_voice_tts as tts_module
+    from tests.gateway.mistral_voice_support import watch_worker
+    from tests.gateway.native_voice_support import CHUNK, HeldBytes, RawWire, ReadinessClock
+    xai_profile()
+    release = threading.Event()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    held = HeldBytes(b'ID3' + b'\0' * (4 * CHUNK), release)
+    wire = RawWire(200, {'Content-Type': 'audio/mpeg'}, held)
+    adapter = wire.adapter()
+    monkeypatch.setattr(requests.Session, 'get_adapter', lambda self, url: adapter)
+    clock = ReadinessClock(monkeypatch)
+    cb = support.Callbacks()
+    try:
+        task = asyncio.create_task(speak(out, cb, deadline_s=300 if how == 'deadline' else 60))
+        assert await asyncio.to_thread(held.entered.wait, 15)  # READINESS: inside the body read
+        if how == 'stop':
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            clock.advance()
+            result = await task
+            assert (outcome(result), result.provider) == (('timeout', None, 'unknown'), 'unknown')
+        calls = (cb.authorize_calls, cb.before_send_calls, wire.count)
+        release.set()
+        assert await asyncio.to_thread(finished.wait, 15)
+    finally:
+        release.set()
+    assert (cb.authorize_calls, cb.before_send_calls, wire.count) == calls and calls[1:] == (1, 1)
+    assert held.pulled <= 2 * CHUNK and held.closed and os.listdir(out) == []
