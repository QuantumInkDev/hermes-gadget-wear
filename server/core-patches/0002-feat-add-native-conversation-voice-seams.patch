+    wire = support.Wire([words()])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, support.Callbacks())
+    assert (result.state, result.provider, wire.count, catalog) == ('unavailable', 'not_started', 0, [])
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'deepinfra', 'cloud_trim_silence': False,
+                                                     'deepinfra': {'model': 'openai/whisper-large-v3'}}})
+    wire = support.Wire([words()])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, support.Callbacks())
+    assert (result.state, result.provider, wire.count, catalog) == ('transcribed', 'completed', 1, [])
+    assert wire.requests[0].url.host == 'api.deepinfra.com'
+
+
+@pytest.mark.asyncio
+async def test_a_failing_configured_local_backend_is_failed_not_unavailable_and_not_retried(monkeypatch, clip):
