@@ -0,0 +1,278 @@
+"""Native voice seam, Gemini PCM -> MP3 (AUX-audio): a usable qualified converter is proved BEFORE the first paid request (single chunk
+included), the paid PCM becomes a real MP3 through the wrapped, bounded converter, and a converter that disappears, fails, lies or runs
+away AFTER payment is a truthful failure of the paid chunk (never the stock raw-WAV-under-.mp3 file, never a retry).
+
+REAL: the stock Gemini request builder / parser (the real ``requests`` session over ``RestWire``, synthetic bytes only), real 24 kHz mono
+16-bit PCM, the NEW owned approved ffmpeg for every conversion. HARNESS, stated plainly: the qualified network-deny launcher is a hashed
+stand-in (``launcher_passthrough.py`` / ``launcher_faulty.py``; NOT a sandbox, NOT launcher qualification). The paid-answer fault modes
+(``*-convert-2``) act on the 2nd ffmpeg child (the 1st is the capability preflight). Marked LOWERED-LIMIT: the chunk byte cap.
+"""
+import asyncio
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from gateway.session_native_voice import speakable_text, synthesize_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+from tests.gateway.mistral_voice_support import watch_worker
+from tests.waiting import async_wait_until
+
+KEY = 'rest-synthetic-key'
+SHORT = 'Hello there, friend.'
+LONG_TEXT = ('The first sentence is deliberately rather long. The second sentence is also fairly long here. '
+             'The third sentence closes out the whole text.')
+
+
+def gemini_profile(**section):
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'gemini', 'gemini': section}})
+    (get_hermes_home() / '.env').write_text(f'GEMINI_API_KEY={KEY}\n')
+    invalidate_env_cache()
+
+
+async def speak(out, callbacks, text=SHORT, deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def scratch(tmp_path, monkeypatch):
+    return support.private_tmp(tmp_path, monkeypatch)
+
+
+@pytest.fixture(autouse=True)
+def owned_ffmpeg():
+    support.ffmpeg_path()
+
+
+@pytest.fixture
+def no_stock_writer(monkeypatch):
+    """TRIPWIRE: a native Gemini call must never reach the stock WAV writer (raw-WAV-under-.mp3 fallback) or its unwrapped runner."""
+    def boom(*args, **kwargs):
+        raise AssertionError('stock converter reached inside a native call')
+    monkeypatch.setattr('tools.tts_tool_providers._write_wav_bytes_as', boom)
+    monkeypatch.setattr('tools.tts_tool_delivery._ffmpeg_run', boom)
+
+
+def ffmpeg_children(spawns, stand_in=support.PASSTHROUGH):
+    return [s for s in support.audio_spawns(spawns, stand_in) if support.program_of(s).rsplit('/', 1)[-1] == 'ffmpeg']
+
+
+def script(count, span=0.5):
+    return [rest.gemini_answer(rest.pcm_bytes(span + 0.2 * i)) for i in range(count)]
+
+
+def chunk_count(text, cap=60):
+    from tools.tts_tool_delivery import _split_text_for_tts
+    return len(_split_text_for_tts(speakable_text(text), cap))
+
+
+# ---- the converter is proved first; the paid PCM becomes a real MP3 ---------------------------------------------------------------
+@pytest.mark.asyncio
+@pytest.mark.parametrize('chunks', [1, 3])
+async def test_a_usable_converter_is_proved_before_the_first_request_and_paid_pcm_becomes_a_real_wrapped_mp3(
+        monkeypatch, tmp_path, out, scratch, no_stock_writer, chunks):
+    gemini_profile(max_text_length=60)
+    support.qualify(monkeypatch)
+    text = LONG_TEXT if chunks > 1 else SHORT
+    assert chunk_count(text) == chunks
+    modes = []
+    from tools import tts_tool_local
+    real = tts_tool_local._native_convert
+
+    def recording(ffmpeg, wav_path, mp3_path, policy, cwd, probe=False, watch=None):
+        if not probe:  # the private WAV of a paid answer: 0600 file in a 0700 directory of its own
+            modes.append((os.stat(wav_path).st_mode & 0o777, os.stat(os.path.dirname(wav_path)).st_mode & 0o777, cwd == os.path.dirname(wav_path),
+                          watch is not None))
+        return real(ffmpeg, wav_path, mp3_path, policy, cwd, probe, watch)
+    monkeypatch.setattr(tts_tool_local, '_native_convert', recording)
+    events = []
+    spawns = support.record_spawns(monkeypatch, events)
+    cb = support.Callbacks(events)
+    wire = rest.RestWire(script(chunks), tap=lambda request: events.append('request'))
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=text)
+    assert (result.state, result.provider, result.source, wire.count, cb.before_send_calls) == ('synthesized', 'completed', 'configured', chunks, chunks)
+    first_gate = events.index('before_send')
+    assert events[:first_gate].count('spawn') >= 1 and events.index('request') > first_gate  # a converter child ran before the FIRST send callback
+    children = ffmpeg_children(spawns)
+    real_conversions = [s for s in children if s['cwd'] and 'hermes-native-gemini-' in s['cwd']]
+    assert len(real_conversions) == chunks  # exactly one wrapped conversion per paid answer, no retry
+    argv = real_conversions[0]['args']
+    assert ['-nostdin', '-hide_banner'] == argv[argv.index('-nostdin'):][:2] and ['-protocol_whitelist', 'file'] == argv[argv.index('-protocol_whitelist'):][:2]
+    assert ['-f', 'wav', '-i'] == argv[argv.index('-f'):][:3] and real_conversions[0]['stdin'] == subprocess.DEVNULL
+    assert modes == [(0o600, 0o700, True, True)] * chunks
+    head = Path(result.path).read_bytes()[:3]
+    assert head == b'ID3' or head[0] == 0xFF  # a real MP3, never a WAV
+    assert support.media_seconds(result.path) == pytest.approx(sum(0.5 + 0.2 * i for i in range(chunks)), abs=0.5)
+    assert os.listdir(out) == [os.path.basename(result.path)] and os.listdir(scratch) == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('chunks, how', [(1, 'missing'), (1, 'broken'), (1, 'no-launcher'), (1, 'fail-convert'), (1, 'junk-convert'),
+                                         (3, 'missing'), (3, 'broken')])
+async def test_an_unusable_converter_is_unavailable_not_started_before_any_request_or_callback(
+        monkeypatch, tmp_path, out, scratch, no_stock_writer, chunks, how):
+    gemini_profile(max_text_length=60)
+    support.joiner(monkeypatch, tmp_path, how)
+    cb = support.Callbacks()
+    wire = rest.RestWire(script(chunks))
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=LONG_TEXT if chunks > 1 else SHORT)
+    assert (result.state, result.path, result.provider) == ('unavailable', None, 'not_started')
+    assert (wire.count, cb.before_send_calls) == (0, 0) and os.listdir(out) == [] and os.listdir(scratch) == []  # never a WAV named .mp3
+
+
+# ---- after payment -----------------------------------------------------------------------------------------------------------------
+@pytest.mark.asyncio
+async def test_a_converter_that_vanishes_after_the_paid_answer_is_failed_after_send_not_unavailable_and_not_retried(
+        monkeypatch, tmp_path, out, scratch, no_stock_writer):
+    gemini_profile()
+    support.qualify(monkeypatch)
+    real_which = shutil.which
+
+    def vanish(request):
+        monkeypatch.setattr(shutil, 'which', lambda name, *a, **k: None if name == 'ffmpeg' else real_which(name, *a, **k))
+    cb = support.Callbacks()
+    wire = rest.RestWire(script(1) + script(1), tap=vanish)
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert (wire.count, cb.before_send_calls) == (1, 1) and os.listdir(out) == [] and os.listdir(scratch) == []
+
+
+@pytest.mark.asyncio
+async def test_a_converter_that_writes_non_mp3_bytes_is_failed_after_send_never_a_mislabelled_file(monkeypatch, tmp_path, out, scratch, no_stock_writer):
+    gemini_profile()
+    support.joiner(monkeypatch, tmp_path, 'junk-convert-2')
+    spawns = support.record_spawns(monkeypatch)
+    cb = support.Callbacks()
+    wire = rest.RestWire(script(1) + script(1))
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert (wire.count, cb.before_send_calls, len(ffmpeg_children(spawns, support.FAULTY))) == (1, 1, 2)
+    assert os.listdir(out) == [] and os.listdir(scratch) == []
+
+
+@pytest.mark.asyncio
+async def test_malformed_pcm_after_payment_fails_without_a_conversion_or_retry(monkeypatch, out, scratch, no_stock_writer):
+    gemini_profile()
+    support.qualify(monkeypatch)
+    spawns = support.record_spawns(monkeypatch)
+    cb = support.Callbacks()
+    wire = rest.RestWire([rest.gemini_answer(rest.pcm_bytes(0.2) + b'\x00'), rest.gemini_answer(rest.pcm_bytes(0.2))])  # an odd byte: a partial frame
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert (wire.count, len(ffmpeg_children(spawns))) == (1, 1)  # only the preflight child: the partial frame is never silently dropped
+    assert os.listdir(out) == [] and os.listdir(scratch) == []
+
+
+@pytest.mark.asyncio
+async def test_lowered_limit_a_runaway_conversion_is_ended_by_the_watch_while_it_runs(monkeypatch, tmp_path, out, scratch, no_stock_writer):
+    try:
+        gemini_profile()
+        monkeypatch.setattr('gateway.session_native_voice.MAX_CHUNK_AUDIO_BYTES', 1024 * 1024)  # LOWERED-LIMIT (production: 16 MiB)
+        state = support.joiner(monkeypatch, tmp_path, 'grow-convert-2')
+        cb = support.Callbacks()
+        wire = rest.RestWire(script(1) + script(1))
+        with rest.rest_wire(monkeypatch, wire):
+            result = await speak(out, cb)
+        assert (result.state, result.path, result.provider) == ('too_long', None, 'failed_after_send')
+        assert (wire.count, cb.before_send_calls) == (1, 1)
+        await async_wait_until(lambda: support.pid_gone(state), timeout=15, what='the runaway conversion child to be ended')
+        assert not Path(str(state) + '.finished').exists() and os.listdir(out) == [] and os.listdir(scratch) == []
+    finally:
+        Path(str(tmp_path / 'launcher-state') + '.release').write_text('')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['stop', 'deadline'])
+async def test_stop_or_the_deadline_while_the_paid_conversion_is_held_leaves_no_late_result_callback_or_file(
+        monkeypatch, tmp_path, out, scratch, no_stock_writer, how):
+    try:
+        gemini_profile()
+        state = support.joiner(monkeypatch, tmp_path, 'hold-convert-2')
+        spawns = support.record_spawns(monkeypatch)
+        from gateway import session_native_voice_tts as tts_module
+        finished = watch_worker(monkeypatch, tts_module, '_synthesize')  # set when the TTS worker has fully returned
+        cb = support.Callbacks()
+        wire = rest.RestWire(script(1) + script(1))
+        clock = support.ReadinessClock(monkeypatch)
+        with rest.rest_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb, deadline_s=300))
+            await support.await_hold(task, state, 'the held paid conversion to start')  # readiness
+            held_at = len(ffmpeg_children(spawns, support.FAULTY))
+            assert (wire.count, cb.before_send_calls) == (1, 1)  # the chunk was paid before its conversion was held
+            if how == 'stop':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            else:
+                clock.advance()
+                result = await task
+                assert (result.state, result.path, result.provider) == ('timeout', None, 'unknown')
+            await async_wait_until(lambda: support.pid_gone(state), timeout=15, what='the held conversion child to be ended')
+            assert await asyncio.to_thread(finished.wait, 15)  # the abandoned worker itself has RETURNED
+            await async_wait_until(lambda: not os.listdir(out) and not os.listdir(scratch), timeout=15, what='the fenced worker to clean up')
+        assert len(ffmpeg_children(spawns, support.FAULTY)) == held_at and (wire.count, cb.before_send_calls) == (1, 1)
+    finally:
+        Path(str(tmp_path / 'launcher-state') + '.release').write_text('')
+
+
+@pytest.mark.asyncio
+async def test_a_paid_conversion_that_exits_nonzero_after_an_oversized_output_is_too_long_not_an_ordinary_failure(monkeypatch, out, scratch, no_stock_writer):
+    """LABELLED FINITE SYNTHETIC BOUNDARY (not a real-subprocess timing proof): the lowest runner call leaves a small LOWERED-LIMIT oversized
+    chunk file and raises CalledProcessError BEFORE any final watch (an exit between two watch polls). Terminal ``too_long`` after one paid send."""
+    from tools import tts_command_provider
+    gemini_profile()
+    support.qualify(monkeypatch)
+    monkeypatch.setattr('gateway.session_native_voice.MAX_CHUNK_AUDIO_BYTES', 64 * 1024)  # LOWERED-LIMIT (production: 16 MiB)
+    real = tts_command_provider.run_native_argv
+    left = []
+
+    def wrapper(argv, **kw):
+        if kw.get('cwd') and 'hermes-native-gemini-' in kw['cwd']:  # the real conversion of the paid answer (not the preflight)
+            Path(argv[-1]).write_bytes(b'\0' * (70 * 1024))
+            left.append(argv[-1])
+            raise subprocess.CalledProcessError(1, argv)
+        return real(argv, **kw)
+    monkeypatch.setattr(tts_command_provider, 'run_native_argv', wrapper)
+    cb = support.Callbacks()
+    wire = rest.RestWire([rest.gemini_answer(rest.pcm_bytes(0.1)), rest.gemini_answer(rest.pcm_bytes(0.1))])
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('too_long', None, 'failed_after_send')
+    assert (wire.count, cb.before_send_calls, len(left)) == (1, 1, 1)  # one paid send, one conversion, no retry
+    assert os.listdir(out) == [] and os.listdir(scratch) == []
+
+
+# ---- stock-off pins -------------------------------------------------------------------------------------------------------------------
+def test_the_stock_wav_wrapper_is_byte_equivalent_after_the_header_factoring():
+    import struct
+    from tools.tts_tool_delivery import _wav_header, _wrap_pcm_as_wav
+    pcm = bytes(range(256)) * 3
+    fmt = struct.pack('<4sIHHIIHH', b'fmt ', 16, 1, 1, 24000, 48000, 2, 16)
+    expected = struct.pack('<4sI4s', b'RIFF', 4 + len(fmt) + 8 + len(pcm), b'WAVE') + fmt + struct.pack('<4sI', b'data', len(pcm)) + pcm
+    assert _wrap_pcm_as_wav(pcm) == expected and _wav_header(len(pcm)) + pcm == expected
+
+
+def test_outside_a_native_call_the_stock_writer_keeps_its_raw_wav_fallback_when_ffmpeg_is_absent(monkeypatch, tmp_path):
+    from tools.tts_tool_delivery import _wrap_pcm_as_wav, _write_wav_bytes_as
+    monkeypatch.setattr(shutil, 'which', lambda name, *a, **k: None)
+    target = tmp_path / 'stock.mp3'
+    _write_wav_bytes_as(_wrap_pcm_as_wav(rest.pcm_bytes(0.1)), str(target))
+    assert target.read_bytes()[:4] == b'RIFF'  # the documented STOCK behaviour; a native call never reaches it (tripwire above)
