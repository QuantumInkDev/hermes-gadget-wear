+    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
+        raise RuntimeError("native engine helper or converter failed") from None
+    finally:
+        shutil.rmtree(cwd, ignore_errors=True)
+    _remove_quietly(wav_path)
