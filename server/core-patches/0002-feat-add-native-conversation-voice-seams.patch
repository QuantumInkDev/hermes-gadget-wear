+    oauth = rest.OAuthWire([('status', 401)] * 3)
+    with rest.oauth_wire(monkeypatch, oauth):
+        credentials = resolve_xai_http_credentials(prefer_api_key=True)
+    assert credentials['api_key'] == '' and 'synthetic oauth failure' in caplog.text  # stock still logs it
