+def test_the_freshness_check_requires_the_whole_request_window_and_ignores_api_keys():
+    from tools import native_send_policy
+    from tools.xai_http import require_native_fresh_bearer
+    policy = native_send_policy.SendPolicy(timeout_s=60.0, providers=frozenset())
+    oauth = lambda exp: {'provider': 'xai-oauth', 'api_key': rest.jwt(exp)}
+    require_native_fresh_bearer(oauth(None))  # outside a native call: stock, nothing is checked
+    with native_send_policy.activate(policy):
+        require_native_fresh_bearer(oauth(time.time() + HOUR))
+        require_native_fresh_bearer({'provider': 'xai', 'api_key': 'xai-explicit-key'})  # an API key has no expiry
+        for exp in (time.time() + 30, time.time() - 1, None):
+            with pytest.raises(native_send_policy.NativeSendRefused) as refused:
+                require_native_fresh_bearer(oauth(exp))
+            assert refused.value.reason == 'credentials'
+        policy.close()
+        with pytest.raises(native_send_policy.NativeSendRefused) as closed:
+            require_native_fresh_bearer(oauth(time.time() + HOUR))
+        assert closed.value.reason == 'closed'
