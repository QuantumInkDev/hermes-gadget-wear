+# ---- Task4 fix2 NI-1 / NM-2: input-derived completeness (audio packets), format-aware, no fixed byte budget ----------------------
+# A SMALL bounded format set, not a cross product: the original 24 kHz/48 kbps mono pin, 32 kHz/128 kbps mono, 44.1 kHz/192 kbps
+# stereo, 48 kHz/320 kbps stereo, plus one large-ID3 case and one no-Info/Xing case. Real ffmpeg conversion and copy-concat.
+BIG_ID3 = ('-metadata', 'title=' + 'T' * 3000, '-metadata', 'comment=' + 'C' * 3000)
+FORMATS = [
+    pytest.param(dict(rate=24000, channels=1, kbps=48), (), id='24k-48k-mono-pin'),
+    pytest.param(dict(rate=32000, channels=1, kbps=128), (), id='32k-128k-mono'),
+    pytest.param(dict(rate=44100, channels=2, kbps=192), (), id='44k-192k-stereo'),
+    pytest.param(dict(rate=48000, channels=2, kbps=320), (), id='48k-320k-stereo'),
+    pytest.param(dict(rate=32000, channels=1, kbps=128), BIG_ID3, id='32k-128k-mono-large-id3'),
+    pytest.param(dict(rate=48000, channels=2, kbps=320), ('-write_xing', '0'), id='48k-320k-stereo-no-info'),
