+++ b/tools/native_audio_pipeline.py
@@ -0,0 +1,205 @@
+"""Native audio pipeline: the usable multi-chunk JOIN of a native (Relay) speech call.
+
+A multi-chunk call pays for (or runs) every chunk before it can join them, so the join is proved BEFORE the first chunk
+request, engine child or Edge handshake: :func:`native_concat_preflight` runs the real ffmpeg on a tiny synthetic file (a 0.1 s
+WAV -> MP3, then a concat of that MP3 with itself) under the qualified network-deny launcher, COUNTS the compressed audio packets
+of the input and of the join with the real ffprobe (the same launcher), and also checks that the caller's output directory can be
+named in a concat list at all. Presence, ``-version`` or a WAV -> MP3 conversion alone is not concat capability. The probe is
+neither a provider send nor an engine launch (``probe=True``: it never marks a local launch and needs no ``before_send``), so a
+refusal is a truthful ``unsent``.
+
+**Completeness is input-derived, not a byte budget.** A stream-copy concat drops each later input's ID3 tag and Info/Xing frame; how
+many bytes that is depends on the bitrate, sample rate, tag size and whether an Info frame exists (measured here, 24 kHz/48 kbps
+dropped 236 bytes per extra input, 44.1 kHz/192 kbps stereo 670 and 48 kHz/320 kbps stereo 1004, a 3000-character tag thousands,
+and an input without an Info frame makes the output LARGER), so no fixed allowance is correct. The audio itself is never dropped:
+for every measured format the joined file held exactly the sum of its inputs' compressed audio packets (ffprobe
+``-count_packets``; tags and the Info frame are not packets), which is also what the DTS diagnostics ffmpeg prints at the
+boundaries of inputs that carry an Info frame turned out to be about. A join is accepted only when it is an MP3 AND its packet
+count equals the sum of the inputs' counts, so a truncated join, one that lost only a short final chunk, or a head-only file is
+refused. That makes ffprobe a new prerequisite of the MULTI-chunk native join only (see below).
+
+**Prerequisite and cost.** Native multi-chunk speech needs, besides ffmpeg and a qualified launcher, a usable ``ffprobe`` found on
+``PATH`` like ffmpeg (no install, fetch or fallback to another binary), proven by an actual launcher-wrapped packet count in the
+preflight BEFORE any chunk; missing or broken refuses ``unavailable``/``not_started`` with no paid work. Single-chunk calls (every
+Edge text of 600 code points or fewer) and the stock shared concat never need it.
+
+:func:`native_concat` is the real join. It is a launcher-wrapped, Stop-aware, deadline-bounded ``run_native_argv`` child with
+the exact remaining float deadline (no 300/120 s stock timeout, no ``int()`` rounding, no artificial minimum: once nothing
+remains no child is started and the call is a ``timeout``). It reads only local files (``-protocol_whitelist file``, ``-nostdin``,
+a private concat list, no URL, no shell) and stages its output next to the final file under a size watch (the total
+speech-audio cap ends the child while it runs, not only a check afterwards). The staged file is renamed only after
+:func:`_complete`. Stock-off, the shared ``tools.tts_tool_delivery._concat_audio_files`` is unchanged. Neither function retries or
+falls back. A refusal AFTER chunks were paid or a local engine child started (a vanished joiner, an unusable launcher) is reported
+by the seam as ``failed``, never ``unavailable``.
+
+Not sandbox proof: the launcher is whatever ``tools.native_local_launcher`` qualified for this host.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import tempfile
+import uuid
+from typing import Callable, Optional
+
+from tools import native_send_policy
+
+_PROBE_INPUT = ("-v", "error", "-protocol_whitelist", "file", "-select_streams", "a:0", "-count_packets", "-show_entries",
+                "stream=nb_read_packets", "-of", "csv=p=0")
+_JOIN_INPUT = ("-nostdin", "-hide_banner", "-loglevel", "error", "-protocol_whitelist", "file", "-f", "concat", "-safe", "0",
+               "-i")
+
+
+def _unsupported() -> native_send_policy.NativeSendRefused:
+    return native_send_policy.refuse("unsupported")
+
+
+def _list_line(path: str) -> str:
+    """One ``file '<path>'`` line of an ffmpeg concat list (a single quote inside the path is written ``'\\''``)."""
+    if not os.path.isabs(path) or any(char in path for char in "\n\r\0"):
+        raise _unsupported()
+    return "file '" + path.replace("'", "'\\''") + "'\n"
+
+
+def _is_mp3(path: str) -> bool:
+    """A regular, non-empty file whose head is an ID3 tag or an MPEG frame sync."""
+    try:
+        info = os.lstat(path)
+        if not os.path.isfile(path) or os.path.islink(path) or info.st_size <= 0:
+            return False
+        with open(path, "rb") as handle:
+            head = handle.read(3)
+    except OSError:
+        return False
+    return head[:3] == b"ID3" or head[:1] == b"\xff"
+
+
+def _count_packets(ffprobe: str, path: str, policy, cwd: str) -> int:
+    """The number of compressed audio packets of ``path`` as the real ffprobe counts them, as a launcher-wrapped, Stop-aware,
+    exactly-bounded child (never a launch: ``probe=True``). Anything but one positive integer is a refusal of the tool."""
+    from tools.tts_command_provider import run_native_argv
+    from tools.tts_tool_local import _ENGINE_STREAM_BYTES, _native_child_env, _remaining
+    try:
+        reply = run_native_argv([ffprobe, *_PROBE_INPUT, path], timeout=_remaining(policy), env=_native_child_env(), cwd=cwd,
+                                max_stream_bytes=_ENGINE_STREAM_BYTES, probe=True).stdout.strip()
+        count = int(reply)
+    except subprocess.TimeoutExpired:
+        raise native_send_policy.refuse("timeout") from None
+    except (subprocess.CalledProcessError, OSError, ValueError):
+        raise _unsupported() from None
+    if count <= 0:
+        raise _unsupported()
+    return count
+
+
+def _complete(ffprobe: str, inputs: list[str], output: str, policy, cwd: str) -> bool:
+    """A usable join: an MP3 head AND exactly the compressed audio packets of the inputs (tags and the Info/Xing frame are not
+    packets). Input-derived and format-independent, so it neither rejects a legitimate bitrate/sample-rate/tag/Info variation nor
+    admits a join that lost audio, however short the lost chunk."""
+    if not _is_mp3(output):
+        return False
+    return _count_packets(ffprobe, output, policy, cwd) == sum(_count_packets(ffprobe, path, policy, cwd) for path in inputs)
+
+
+def _run_join(ffmpeg: str, list_path: str, output: str, policy, cwd: str, probe: bool, limit: Optional[int] = None) -> None:
+    """The one concat child: copy the (all MP3) inputs into ``output`` under the launcher, Stop and the exact remaining
+    deadline, with ``limit`` (bytes) enforced WHILE it runs: the watch ends a child whose output outgrows it."""
+    from tools.tts_command_provider import run_native_argv
+    from tools.tts_tool_local import _ENGINE_STREAM_BYTES, _native_child_env, _remaining
+
+    def watch() -> Optional[str]:
+        try:
+            return "too_long" if limit is not None and os.path.getsize(output) > limit else None
+        except OSError:
+            return None
+    run_native_argv([ffmpeg, *_JOIN_INPUT, list_path, "-vn", "-c:a", "copy", "-y", "-f", "mp3", output],
+                    timeout=_remaining(policy), env=_native_child_env(), cwd=cwd, max_stream_bytes=_ENGINE_STREAM_BYTES,
+                    watch=watch, probe=probe)
+
+
+def _join_files(ffmpeg: str, paths: list[str], output: str, policy, work: str, probe: bool, limit: Optional[int] = None) -> None:
+    list_path = os.path.join(work, "inputs.txt")
+    with open(list_path, "w", encoding="utf-8") as handle:
+        handle.writelines(_list_line(path) for path in paths)
+    try:
+        _run_join(ffmpeg, list_path, output, policy, work, probe, limit)
+    except subprocess.TimeoutExpired:
+        raise native_send_policy.refuse("timeout") from None  # its timeout IS the call's remaining deadline
+
+
+def _tool() -> tuple[object, str]:
+    policy = native_send_policy.current()
+    ffmpeg = shutil.which("ffmpeg")
+    if policy is None or policy.deadline is None or ffmpeg is None or not os.access(ffmpeg, os.X_OK):
+        raise _unsupported()
+    return policy, ffmpeg
+
+
+def _packet_tool() -> str:
+    ffprobe = shutil.which("ffprobe")
+    if ffprobe is None or not os.access(ffprobe, os.X_OK):
+        raise _unsupported()
+    return ffprobe
+
+
+def native_concat_preflight(output_dir: Optional[str] = None) -> None:
+    """Native call only, BEFORE any chunk request, engine child or Edge handshake of a multi-chunk call: prove with the real
+    ffmpeg, under the qualified launcher, that a synthetic MP3 can be converted AND concatenated into a complete output, and
+    (``output_dir``) that the caller's directory can be named in the concat list at all. Missing, broken, truncating or
+    unqualified, or an ineligible directory -> the policy's ``unsupported`` refusal (unsent); Stop/deadline refusals pass
+    through unchanged."""
+    from tools.native_local_launcher import qualified_prefix
+    from tools.tts_tool_local import _native_convert, _write_probe_wav
+    policy, ffmpeg = _tool()
+    ffprobe = _packet_tool()
+    if qualified_prefix() is None:
+        raise _unsupported()
+    if output_dir is not None:
+        _list_line(os.path.join(output_dir, ".native-speech-0.chunk001.mp3"))  # the paths the join will list
+    work = tempfile.mkdtemp(prefix="hermes-native-concat-")
+    try:
+        wav, mp3, joined = (os.path.join(work, name) for name in ("probe.wav", "probe.mp3", "joined.mp3"))
+        _write_probe_wav(wav)
+        try:
+            _native_convert(ffmpeg, wav, mp3, policy, work, probe=True)
+            if not _is_mp3(mp3):
+                raise _unsupported()
+            _join_files(ffmpeg, [mp3, mp3], joined, policy, work, probe=True)
+        except subprocess.TimeoutExpired:
+            raise native_send_policy.refuse("timeout") from None
+        except (subprocess.CalledProcessError, OSError):
+            raise _unsupported() from None
+        if not _complete(ffprobe, [mp3, mp3], joined, policy, work):
+            raise _unsupported()
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+
+def native_concat(paths: list[str], output: str, track: Optional[Callable[[str], object]] = None,
+                  limit: Optional[int] = None) -> str:
+    """Native call only: join the MP3 chunk files ``paths`` (in order) into ``output`` and return it. ``track`` receives the
+    staging path BEFORE the child starts, so the caller can remove it on any failure, Stop or late completion; ``limit`` is the
+    byte cap of the joined file, enforced while the child runs. A failure after the chunks were produced raises (the seam
+    reports ``failed``: ``RuntimeError`` here, or a policy refusal that is not ``unavailable`` once chunks were paid); it is
+    never retried."""
+    policy, ffmpeg = _tool()
+    ffprobe = _packet_tool()
+    staged = os.path.join(os.path.dirname(output), f".{os.path.basename(output)}.{uuid.uuid4().hex}.joining.mp3")
+    if track is not None:
+        track(staged)
+    work = tempfile.mkdtemp(prefix="hermes-native-concat-")
+    try:
+        _join_files(ffmpeg, paths, staged, policy, work, probe=False, limit=limit)
+        if not _complete(ffprobe, paths, staged, policy, work):
+            raise RuntimeError("native join produced no usable audio")
+        os.replace(staged, output)
+    except (subprocess.CalledProcessError, OSError):
+        raise RuntimeError("native join failed") from None
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+        try:
+            os.remove(staged)
+        except OSError:
+            pass  # renamed into place, or never created
+    return output
