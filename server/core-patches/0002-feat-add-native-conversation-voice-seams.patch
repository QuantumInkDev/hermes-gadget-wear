+    support.ffmpeg_path()
+    real = subprocess.Popen
+
+    class Failing(real):
+        def __init__(self, args, *a, **k):
+            if isinstance(args, (list, tuple)) and str(FIXTURES / 'engine_fixture.py') in args:
+                raise OSError('synthetic: the engine child cannot be started')
+            super().__init__(args, *a, **k)
+    monkeypatch.setattr(subprocess, 'Popen', Failing)
+    result = await speak('MODE:ok words', out)
