@@ -0,0 +1,166 @@
+"""Existing-source analogs of the native display seam, on the real source authority.
+
+A messaging-source session (a Telegram conversation) is readable by a Gadget device principal that
+the registered adapter actually owns (``source_owner``) and that holds ``session:read``; the analogs
+reuse that proof, the existing target and its readability rules, and add nothing else. The SDK's
+8,192/65,536 response-bound regression of the existing-history path is NOT exercised or fixed here.
+"""
+from dataclasses import replace
+
+import pytest
+
+from gateway.session_contract import Principal
+from gateway.session_existing import ExistingTarget
+from gateway.session_native_admission import native_principal
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway import native_display_support as support
+from tests.gateway import relay_native_support
+
+rig = relay_native_support.rig
+
+
+def device(rig_, name='phone', capabilities=('session:read',)):
+    source = rig_.adapter.build_source(chat_id=name, chat_type='dm', user_id=name)
+    return Principal(native_principal(source), rig_.authority.profile_id, frozenset(capabilities), 'relay-existing-' + name), source
+
+
+def telegram(rig_, session_id='tg-1'):
+    db = rig_.authority.db
+    db.create_session(session_id, source='telegram')
+    return ExistingTarget('a', session_id, 'telegram')
+
+
+async def existing_fragments(rig_, actor, source, target):
+    """The fragments of the existing reader's rows, via the identity-addressed seam only (rows come
+    from ``read_existing_history``, the existing source reader, as the oracle for identity and text)."""
+    page = await rig_.authority.read_existing_history(actor, target, adapter=rig_.adapter, source=source,
+                                                      authorize=lambda: None)
+    return page.rows
+
+
+@pytest.mark.asyncio
+async def test_existing_identity_read_equals_the_existing_history_rows(rig):
+    actor, source = device(rig)
+    target = telegram(rig)
+    db = rig.authority.db
+    db.append_message('tg-1', 'user', 'telegram question')
+    db.append_message('tg-1', 'assistant', 'multi ' + 'é' * 6000)
+    db.append_message('tg-1', 'assistant', '😀' * 3000)
+    rows = await existing_fragments(rig, actor, source, target)
+    assert len(rows) == 3
+    for row in rows:
+        parts, segment = [], 0
+        while True:
+            fragment = await rig.authority.read_existing_display(
+                actor, target, adapter=rig.adapter, source=source, authorize=lambda: None, row_id=row.row_id,
+                segment=segment)
+            parts.append(fragment)
+            segment += 1
+            if segment == fragment.segment_count:
+                break
