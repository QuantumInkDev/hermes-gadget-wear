new file mode 100644
index 0000000000000000000000000000000000000000..0ebcf76957838ebc56837a23b80f50d0d9c2ab97
--- /dev/null
+++ b/gateway/session_native_voice_display.py
@@ -0,0 +1,294 @@
+"""Identity-addressed canonical display reads for the native voice seam (``session_native_voice``).
+
+Playback of a message the consumer can only name by its public id needs the exact canonical text of
+ONE visible display row. These readers add no projection of their own: selection is the existing
+visible-row projection (``session_read_projection._selection``), bodies are the existing
+``HistoryFragment`` segments (``session_history_segments._body``), authority is the actual
+``SessionAuthority.authorize(..., 'session:read')`` before and after, and every query runs under the
+existing 2 s deadline and SQLite progress handler. Other rows' content is never hydrated.
+
+``locate`` streams identity scalars newest-first and stops at the first match. Its two budgets, the
+row bound and the deadline, both end with the existing ``RuntimeStoreError('read_budget')`` whose
+``field`` names the bound that stopped it: absent content is only ever reported by a search that
+completed, so "not found" and "not searched far enough" never look alike.
+"""
+from __future__ import annotations
+
+import asyncio
+import sqlite3
+import threading
+import time
+
+from gateway.session_history_segments import HistoryFragment, _body
+from gateway.session_read_projection import _lineage, _selection, _text
+from hermes_state_runtime import RuntimeStoreError
+
+MAX_IDENTITY_BYTES = 128
+READ_DEADLINE_S = 2.0
+MAX_INT64 = 9223372036854775807
+
+
+def _valid_identity(identity):
+    if (not isinstance(identity, str) or not identity
+            or len(identity.encode('utf-8', errors='replace')) > MAX_IDENTITY_BYTES):
+        raise RuntimeStoreError('invalid_params')
+    return identity
+
+
+def _valid_read(identity, segment, max_bytes):
+    _valid_identity(identity)
+    if (type(segment) is not int or not 0 <= segment <= MAX_INT64
+            or type(max_bytes) is not int or not 0 <= max_bytes <= 65536):
+        raise RuntimeStoreError('invalid_params')
+
+
+def _valid_locate(matches, max_rows):
+    if not callable(matches) or type(max_rows) is not int or not 1 <= max_rows <= 65536:
+        raise RuntimeStoreError('invalid_params')
+
+
+def _selected(conn, lineage, identity):
+    """``(physical_id, sort_id)`` of the visible display row with this identity, else None."""
+    return conn.execute(_selection(lineage) + 'SELECT row_id,sort_id FROM display_rows WHERE identity=?',
+                        (*lineage, identity)).fetchone()
+
+
+def _revision(conn, physical):
+    """The row's content-revision stamp as an int (0 = never revised); a malformed stamp fails closed
+    exactly as the fragment fingerprint does."""
+    from hermes_state_common import DISPLAY_CONTENT_REVISION_PREFIX
+    row = conn.execute(
+        "SELECT CASE WHEN typeof(value)='text' AND length(CAST(value AS BLOB)) BETWEEN 1 AND 19 AND value<>'0' "
+        "THEN value ELSE 'invalid' END FROM state_meta WHERE key=?",
+        (DISPLAY_CONTENT_REVISION_PREFIX + str(physical),)).fetchone()
+    revision = row[0] if row else '0'
+    if revision != '0' and (not revision.isascii() or not revision.isdecimal()
+                            or not 0 < int(revision) <= MAX_INT64 or str(int(revision)) != revision):
+        raise RuntimeStoreError('temporarily_unavailable')
+    return int(revision)
+
+
+def _created_ms(row):
+    created = row['timestamp']
+    if not isinstance(created, (int, float)) or not 0 <= created <= 9223372036854775:
+        raise RuntimeStoreError('projection_too_large')
+    return int(created * 1000)
+
+
+class _Budget:
+    """The read deadline and cancellation of one worker query, shared with its progress handler."""
+
+    def __init__(self, cancelled, deadline):
+        self.cancelled, self.deadline = cancelled, deadline
+
+    def stopped(self):
+        return self.cancelled.is_set() or time.monotonic() >= self.deadline
+
+
+def _guarded(db, budget, work, *, on_stop):
+    """Run ``work(conn)`` in one read snapshot under the progress handler; ``on_stop`` builds the
+    refusal when the budget ends it."""
+    with db._read_ctx() as conn:
+        conn.set_progress_handler(lambda: int(budget.stopped()), 1000)
+        conn.execute('BEGIN')
+        try:
+            if budget.stopped():
+                raise on_stop()
+            return work(conn)
+        except sqlite3.OperationalError as exc:
+            if budget.stopped():
+                raise on_stop() from exc
+            raise
+        finally:
+            conn.set_progress_handler(None, 0)
+            conn.execute('ROLLBACK')
+
+
+def _read_stop():
+    return RuntimeStoreError('read_deadline')
+
+
+def _fragment(db, conn, root, identity, segment, max_bytes, budget):
+    lineage = _lineage(conn, root, lambda: _raise_if(budget, _read_stop))
+    selected = _selected(conn, lineage, identity)
+    if selected is None:
+        raise RuntimeStoreError('not_found')
+    physical, order = selected
+    _revision(conn, physical)
+    row, text, count, _ = _body(db, conn, physical, segment, max_bytes)
+    if text is None:  # a carrier the canonical normalizer hides: not a displayable row
+        raise RuntimeStoreError('not_found')
+    return HistoryFragment(identity, physical, order, row['role'], text, _created_ms(row), segment, count)
+
+
+def _raise_if(budget, make):
+    if budget.stopped():
+        raise make()
+
+
+def read_fragment(db, root, identity, segment, max_bytes, budget):
+    """Worker thread: ONE visible row's ``HistoryFragment`` (the exact object the position reader yields)."""
+    return _guarded(db, budget, lambda conn: _fragment(db, conn, root, identity, segment, max_bytes, budget),
+                    on_stop=_read_stop)
+
+
+def _total_bytes(db, conn, physical):
+    """UTF-8 bytes of the row's canonical text: the projection for bodies the reader hydrates whole, the
+    stored size for the larger ones it slices as BLOBs."""
+    row = conn.execute(
+        "SELECT role,content,display_kind,COALESCE(_compressed_summary,0)<>0 AS _compressed_summary,"
+        "length(CAST(content AS BLOB)) AS size FROM messages WHERE id=?", (physical,)).fetchone()
+    if row['size'] > 64000:
+        return row['size']
+    return len(_text(db, row).encode('utf-8'))
+
+
+def _location(db, conn, physical, identity):
+    from gateway.session_native_voice import NativeDisplayLocation
+    row, text, count, _ = _body(db, conn, physical, 0, 65536)
+    if text is None:
+        return None  # a hidden carrier is not a playable row; the search goes on
+    return NativeDisplayLocation(identity, physical, row['role'], _created_ms(row), count,
+                                 _total_bytes(db, conn, physical))
+
+
+def _budget_refusal(bound, limit):
+    return RuntimeStoreError('read_budget', field='locate_' + bound, detail=f'stopped by the {bound} bound ({limit})')
+
+
+def locate_rows(db, root, matches, max_rows, budget, deadline_s):
+    """Worker thread: newest-first identity scalars; the first row ``matches`` accepts, else None
+    after a COMPLETED search. Stopping at either bound raises ``read_budget`` naming it."""
+    def work(conn):
+        lineage = _lineage(conn, root, lambda: _raise_if(budget, lambda: _budget_refusal('deadline', deadline_s)))
+        cursor = conn.execute(
+            _selection(lineage) + "SELECT row_id,CASE WHEN length(CAST(identity AS BLOB))<=128 THEN identity END "
+            "FROM display_rows ORDER BY sort_id DESC", lineage)
+        examined = 0
+        for physical, identity in cursor:
+            if examined >= max_rows:
+                raise _budget_refusal('rows', max_rows)
+            examined += 1
+            if budget.stopped():
+                raise _budget_refusal('deadline', deadline_s)
+            if identity is not None and matches(identity):
+                found = _location(db, conn, physical, identity)
+                if found is not None:
+                    return found
+        return None
+    return _guarded(db, budget, work, on_stop=lambda: _budget_refusal('deadline', deadline_s))
+
+
+async def _off_loop(work, deadline_s, on_timeout):
+    cancelled = threading.Event()
+    budget = _Budget(cancelled, time.monotonic() + deadline_s)
+    try:
+        return await asyncio.wait_for(asyncio.to_thread(work, budget), deadline_s)
+    except TimeoutError as exc:
+        cancelled.set()
+        raise on_timeout() from exc
+    except asyncio.CancelledError:
+        cancelled.set()
+        raise
+
+
+def _deadline():
+    from gateway import session_native_voice
+    return session_native_voice.LOCATE_DEADLINE_S
+
+
+async def locate_display(authority, actor, ref, *, authorize, matches, max_rows):
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    _valid_locate(matches, max_rows)
+    limit = _deadline()
+    found = await _off_loop(lambda b: locate_rows(authority.db, ref.session_id, matches, max_rows, b, limit),
+                            limit, lambda: _budget_refusal('deadline', limit))
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    return found
+
+
+async def read_display(authority, actor, ref, *, authorize, identity, segment, max_bytes):
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    _valid_read(identity, segment, max_bytes)
+    fragment = await _off_loop(
+        lambda b: read_fragment(authority.db, ref.session_id, identity, segment, max_bytes, b),
+        READ_DEADLINE_S, _read_stop)
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    return fragment
+
+
+def read_token(db, root, identity, budget):
+    """Worker/caller thread: ``(identity, physical_id, revision)`` of ONE visible display row from the
+    projection's scalars and the row's revision stamp only. No content column is read."""
+    from gateway.session_native_voice import NativeDisplayToken
+
+    def work(conn):
+        lineage = _lineage(conn, root, lambda: _raise_if(budget, _read_stop))
+        selected = _selected(conn, lineage, identity)
+        if selected is None:
+            raise RuntimeStoreError('not_found')
+        return NativeDisplayToken(identity, selected[0], _revision(conn, selected[0]))
+    return _guarded(db, budget, work, on_stop=_read_stop)
+
+
+def check_display(authority, actor, ref, *, authorize, identity):
+    """Scalar fence for the synchronous socket output-lock boundary (design P2): the identity is still a visible
+    display row of this lineage; the returned token changes whenever its physical row or content revision does.
+    The consumer takes one token before the first segment read, one after the last, and one at P2, and refuses
+    unless they are equal."""
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    _valid_identity(identity)
+    budget = _Budget(threading.Event(), time.monotonic() + READ_DEADLINE_S)
+    token = read_token(authority.db, ref.session_id, identity, budget)
+    authorize()
+    authority.authorize(actor, ref, 'session:read')
+    return token
+
+
+def check_existing_fence(authority, actor, target, *, adapter, source, authorize, row_id):
+    from gateway.session_existing import _prove, _readable, _targets, check_existing
+    _targets((target,))
+    _prove(authority, actor, adapter=adapter, source=source, authorize=authorize)
+    _valid_identity(row_id)
+    with authority.db._read_ctx() as conn:
+        if _readable(authority, conn, actor, target) is None:
+            raise RuntimeStoreError('not_found')
+    budget = _Budget(threading.Event(), time.monotonic() + READ_DEADLINE_S)
+    token = read_token(authority.db, target.session_id, row_id, budget)
+    check_existing(authority, actor, (target,), adapter=adapter, source=source, authorize=authorize)
+    return token
+
+
+async def locate_existing(authority, actor, target, *, adapter, source, authorize, matches, max_rows):
+    from gateway.session_existing import _prove, _readable, _targets, check_existing
+    _targets((target,))
+    _prove(authority, actor, adapter=adapter, source=source, authorize=authorize)
+    _valid_locate(matches, max_rows)
+    with authority.db._read_ctx() as conn:
+        if _readable(authority, conn, actor, target) is None:
+            raise RuntimeStoreError('not_found')
+    limit = _deadline()
+    found = await _off_loop(lambda b: locate_rows(authority.db, target.session_id, matches, max_rows, b, limit),
+                            limit, lambda: _budget_refusal('deadline', limit))
+    check_existing(authority, actor, (target,), adapter=adapter, source=source, authorize=authorize)
+    return found
+
+
+async def read_existing(authority, actor, target, *, adapter, source, authorize, row_id, segment, max_bytes):
+    from gateway.session_existing import _prove, _readable, _targets, check_existing
+    _targets((target,))
+    _prove(authority, actor, adapter=adapter, source=source, authorize=authorize)
+    _valid_read(row_id, segment, max_bytes)
+    with authority.db._read_ctx() as conn:
+        if _readable(authority, conn, actor, target) is None:
+            raise RuntimeStoreError('not_found')
+    fragment = await _off_loop(
+        lambda b: read_fragment(authority.db, target.session_id, row_id, segment, max_bytes, b),
+        READ_DEADLINE_S, _read_stop)
+    check_existing(authority, actor, (target,), adapter=adapter, source=source, authorize=authorize)
+    return fragment
diff --git a/gateway/session_native_voice_gate.py b/gateway/session_native_voice_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..f1eb90948e87aded5bbe5b89a1e924627768a06e
--- /dev/null
+++ b/gateway/session_native_voice_gate.py
@@ -0,0 +1,150 @@
+"""Shared plumbing of the native voice seam: the send gate, bounded waiting and provider evidence.
+
+The consumer's ``authorize`` / ``before_send`` callables belong to the consumer's event loop (they
+touch its registry and durable accounting), so the worker thread that is about to send never runs
+them itself: it asks the loop to run them and blocks until the verdict arrives. The send happens
+only after ``before_send`` returned; any refusal leaves the request unsent.
+"""
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import threading
+import time
+
+from hermes_state_runtime import RuntimeStoreError
+from tools import native_send_policy
+
+PROVIDER_NOT_STARTED = 'not_started'
+PROVIDER_COMPLETED = 'completed'
+PROVIDER_FAILED = 'failed_after_send'
+PROVIDER_UNKNOWN = 'unknown'
+
+
+def validate_call(authorize, before_send, deadline_s):
+    if not callable(authorize) or not callable(before_send):
+        raise RuntimeStoreError('invalid_params')
+    if (isinstance(deadline_s, bool) or not isinstance(deadline_s, (int, float))
+            or not 0 < deadline_s <= 600):
+        raise RuntimeStoreError('invalid_params')
+
+
+def check(authorize):
+    """Run the consumer's authorization: None when it holds, else the stable refusal token."""
+    try:
+        authorize()
+    except asyncio.CancelledError:
+        return 'cancelled'
+    except Exception:  # health: allow BLE001 -- consumer callback; any raise is a refusal and its text must not leave
+        return 'refused'
+    return None
+
+
+def loop_gate(loop, policy, authorize, before_send, deadline):
+    """The ``SendPolicy`` gate: authorize + ``before_send`` on the consumer's loop, awaited by the worker.
+
+    ``policy.close()`` and the callbacks both run on the loop thread, so the fence is exact: once the call
+    was closed (deadline, cancellation, return), a callback still queued on the loop does NOTHING, and the
+    consumer's durable accounting is never touched after the result was delivered.
+    """
+    def gate():
+        verdict: concurrent.futures.Future = concurrent.futures.Future()
+        abandoned = threading.Event()
+
+        def run():
+            if abandoned.is_set() or policy.is_closed():
+                verdict.set_result('closed')
+                return
+            refusal = check(authorize)
+            if refusal is None:
+                try:
+                    before_send()
+                except asyncio.CancelledError:
+                    refusal = 'cancelled'
+                except Exception:  # health: allow BLE001 -- consumer callback; any raise refuses the send
+                    refusal = 'refused'
+                else:
+                    policy.commit()
+            verdict.set_result(refusal)
+        try:
+            loop.call_soon_threadsafe(run)
+            refusal = verdict.result(timeout=max(0.0, deadline - time.monotonic()))
+        except concurrent.futures.TimeoutError:
+            abandoned.set()
+            raise native_send_policy.NativeSendRefused('timeout') from None
+        except RuntimeError:  # the loop is gone
+            abandoned.set()
+            raise native_send_policy.NativeSendRefused('closed') from None
+        if refusal is not None:
+            raise native_send_policy.NativeSendRefused(refusal)
+    return gate
+
+
+def loop_probe(loop, policy, authorize, deadline):
+    """The credential-phase probe: ``authorize`` ONLY, on the consumer's loop, under the same close/abandon/deadline fence.
+
+    It is asked immediately before each actual OAuth discovery/refresh request. It is not a send: it never calls
+    ``before_send``, never ``policy.commit()``, and leaves every send counter alone. The worker never runs the callback itself;
+    a callback still queued after the call was closed, abandoned or returned does nothing."""
+    def probe():
+        verdict: concurrent.futures.Future = concurrent.futures.Future()
+        abandoned = threading.Event()
+
+        def run():
+            if abandoned.is_set() or policy.is_closed():
+                verdict.set_result('closed')
+                return
+            verdict.set_result(check(authorize))
+        try:
+            loop.call_soon_threadsafe(run)
+            refusal = verdict.result(timeout=max(0.0, deadline - time.monotonic()))
+        except concurrent.futures.TimeoutError:
+            abandoned.set()
+            raise native_send_policy.NativeSendRefused('timeout') from None
+        except RuntimeError:  # the loop is gone
+            abandoned.set()
+            raise native_send_policy.NativeSendRefused('closed') from None
+        if refusal is not None:
+            raise native_send_policy.NativeSendRefused(refusal)
+    return probe
+
+
+def new_policy(loop, authorize, before_send, deadline, *, timeout_s, providers, max_output_bytes=None):
+    """A send policy whose gate runs the consumer's callbacks on ``loop`` under the close fence; its credential phase
+    asks the consumer's ``authorize`` alone, on the same loop, under the same fence."""
+    policy = native_send_policy.SendPolicy(timeout_s=timeout_s, providers=providers, max_output_bytes=max_output_bytes)
+    policy.set_gate(loop_gate(loop, policy, authorize, before_send, deadline))
+    policy.set_credential_probe(loop_probe(loop, policy, authorize, deadline))
+    return policy
+
+
+TIMED_OUT = object()  # returned by :func:`bounded` when the deadline ended the wait first
+
+
+async def bounded(work, deadline, on_expiry):
+    """Await ``work`` in a worker thread, at most until ``deadline`` (monotonic).
+
+    The deadline only ends OUR waiting. On expiry ``on_expiry`` runs (it closes the send policy, so
+    the abandoned worker can start no further send) and its answer says whether a request may
+    already have left. Returns ``(value, maybe_sent)``; ``value`` is ``TIMED_OUT`` on expiry.
+    """
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        return TIMED_OUT, on_expiry()
+    try:
+        return await asyncio.wait_for(asyncio.to_thread(work), remaining), False
+    except TimeoutError:
+        return TIMED_OUT, on_expiry()
+    except asyncio.CancelledError:
+        on_expiry()
+        raise
+
+
+def provider_state(policy, answered):
+    """Billing evidence about the configured remote provider after the worker returned.
+
+    ``answered``: the one request was answered with a usable (even empty) result.
+    """
+    if not policy.sends:
+        return PROVIDER_NOT_STARTED
+    return PROVIDER_COMPLETED if answered else PROVIDER_FAILED
