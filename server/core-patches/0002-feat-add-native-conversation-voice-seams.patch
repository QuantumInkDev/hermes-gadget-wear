+def oversize_then_fail(monkeypatch, selector, size):
+    """Wrap the lowest runner: a child chosen by ``selector(argv)`` leaves ``size`` bytes at its last argument and fails; the rest run for real."""
+    from tools import tts_command_provider
+    real = tts_command_provider.run_native_argv
+    chosen = []
+
+    def wrapper(argv, **kw):
+        if selector(argv):
+            chosen.append(os.path.basename(argv[0]))
+            Path(argv[-1]).write_bytes(b'\0' * size)
+            raise subprocess.CalledProcessError(1, argv)
+        return real(argv, **kw)
+    monkeypatch.setattr(tts_command_provider, 'run_native_argv', wrapper)
+    return chosen
