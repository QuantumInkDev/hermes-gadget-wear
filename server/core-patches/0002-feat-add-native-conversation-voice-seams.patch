diff --git a/tests/tools/test_native_command_runner.py b/tests/tools/test_native_command_runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..d568d7221cb6d67e5824eedc0a387ddccf7c253a
--- /dev/null
+++ b/tests/tools/test_native_command_runner.py
@@ -0,0 +1,182 @@
+"""Native-only bounds of the shared command runner, through the REAL ``run_command_provider`` (real ``/bin/sh``, real
+child interpreter, real pipes and process-tree cleanup).
+
+The children are the fixed, network-free fixture scripts in ``native_command_fixtures/`` (each with a hard maximum
+lifetime and bounded arguments). Inside a native call the absolute deadline and Stop end a run whatever its output,
+each stream and a transcript file are capped, and the whole same-session tree is gone afterwards. Outside one the
+stock runner is unchanged (the existing idle-timeout tests in ``test_transcription_tools.py`` keep covering it).
+
+Not covered, and not claimed: a descendant that calls ``setsid`` leaves the process group and is NOT reached by the
+group kill; containment of hostile commands needs the OS-level launcher that is not admitted yet.
+"""
+import os
+import shlex
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from tools import native_send_policy
+from tools.native_send_policy import NativeSendRefused, SendPolicy
+from tools.tts_command_provider import run_command_provider
+
+FIXTURES = Path(__file__).resolve().parent / 'native_command_fixtures'
+pytestmark = pytest.mark.skipif(os.name == 'nt', reason='POSIX process-group behaviour; Windows is a separate gate')
+
+
+def command(script, *args):
+    return shlex.join([sys.executable, str(FIXTURES / script), *map(str, args)])
+
+
+def native(deadline_s=30.0, cap=65536):
+    return SendPolicy(timeout_s=deadline_s, providers=frozenset(), max_output_bytes=cap,
+                      deadline=time.monotonic() + deadline_s)
+
+
+def gone(pid, within=5.0):
+    import psutil
+    end = time.monotonic() + within
+    while time.monotonic() < end:
+        try:
+            if psutil.Process(pid).status() == psutil.STATUS_ZOMBIE:
+                return True
+        except psutil.NoSuchProcess:
+            return True
+        time.sleep(0.05)
+    return False
+
+
+def pids(pidfile, within=10.0):
+    end = time.monotonic() + within
+    while time.monotonic() < end:
+        if pidfile.exists():
+            return [int(p) for p in pidfile.read_text().split()]
+        time.sleep(0.05)
+    raise AssertionError('the fixture never wrote its pids')
+
+
+def test_the_absolute_deadline_ends_a_never_idle_run():
+    policy = native(deadline_s=1.0)
+    started = time.monotonic()
+    with native_send_policy.activate(policy), pytest.raises(NativeSendRefused) as refused:
+        run_command_provider(command('progress.py', 20), timeout=5)  # never idle: the stock timeout cannot fire
+    assert refused.value.reason == 'timeout' and policy.refusal == 'timeout'
+    assert time.monotonic() - started < 6
+
+
+@pytest.mark.parametrize('mode', ['stay', 'orphan'])
+def test_stop_kills_the_whole_same_session_tree(tmp_path, mode):
+    """``orphan``: the fixture's own process exits at once, so the stock tree walk from the shell no longer sees the
+    child that still holds the pipe; the group kill does."""
+    policy, pidfile = native(), tmp_path / 'pids'
+    result = {}
+
+    def run():
+        try:
+            with native_send_policy.activate(policy):
+                run_command_provider(command('tree.py', pidfile, mode), timeout=10)
+        except NativeSendRefused as exc:
+            result['reason'] = exc.reason
+    worker = threading.Thread(target=run)
+    worker.start()
+    parent, child = pids(pidfile)
+    assert gone(child, within=0.3) is False  # it is really running before Stop
+    policy.close()
+    worker.join(10)
+    assert not worker.is_alive() and result == {'reason': 'closed'}
+    assert gone(parent) and gone(child)
+
+
+@pytest.mark.parametrize('stream', ['stdout', 'stderr'])
+def test_each_stream_is_capped_and_the_run_is_refused(stream):
+    policy = native(cap=65536)
+    with native_send_policy.activate(policy), pytest.raises(NativeSendRefused) as refused:
+        run_command_provider(command('flood.py', stream, 300000), timeout=10)
+    assert refused.value.reason == 'too_long' and policy.refusal == 'too_long'
+
+
+def test_stock_runner_keeps_uncapped_output_outside_a_native_call():
+    result = run_command_provider(command('flood.py', 'stdout', 300000), timeout=10)
+    assert result.returncode == 0 and len(result.stdout) == 300000
+
+
+def test_a_transcript_file_over_the_cap_is_refused_before_it_is_read(tmp_path, monkeypatch):
+    from tools.transcription_command import _transcribe_command_stt
+    audio = tmp_path / 'clip.wav'
+    audio.write_bytes(b'fixture audio')
+    reads = []
+    original = Path.read_text
+    monkeypatch.setattr(Path, 'read_text', lambda self, *a, **k: reads.append(self.name) or original(self, *a, **k))
+    policy = native(cap=65536)
+    config = {'command': command('big_transcript.py') + ' {output_path} 200000'}
+    with native_send_policy.activate(policy), pytest.raises(NativeSendRefused) as refused:
+        _transcribe_command_stt(str(audio), 'fixture-cli', config, {})
+    assert refused.value.reason == 'too_long' and 'transcript.txt' not in reads
+
+
+def test_a_transcript_file_within_the_cap_is_read_inside_a_native_call(tmp_path):
+    from tools.transcription_command import _transcribe_command_stt
+    audio = tmp_path / 'clip.wav'
+    audio.write_bytes(b'fixture audio')
+    config = {'command': command('big_transcript.py') + ' {output_path} 1000'}
+    with native_send_policy.activate(native(cap=65536)):
+        result = _transcribe_command_stt(str(audio), 'fixture-cli', config, {})
+    assert result == {'success': True, 'transcript': 'x' * 1000, 'provider': 'fixture-cli'}
+
+
+# ---- I-1: the actual local launch is recorded on the call's policy (never a declaration or a probe) -----------------
+def test_a_successful_spawn_is_the_call_s_local_launch():
+    policy = native()
+    assert policy.local_launched is False
+    with native_send_policy.activate(policy):
+        run_command_provider(command('flood.py', 'stdout', 10), timeout=10)
+    assert policy.local_launched is True
+
+
+def test_a_failed_popen_or_a_refused_prespawn_is_not_a_launch(monkeypatch):
+    import subprocess
+    policy = native()
+
+    def no_spawn(*a, **k):
+        raise OSError('spawn failed')
+    monkeypatch.setattr(subprocess, 'Popen', no_spawn)
+    with native_send_policy.activate(policy), pytest.raises(OSError):
+        run_command_provider(command('flood.py', 'stdout', 10), timeout=10)
+    monkeypatch.undo()
+    stopped = native()
+    stopped.close()
+    with native_send_policy.activate(stopped), pytest.raises(NativeSendRefused):
+        run_command_provider(command('flood.py', 'stdout', 10), timeout=10)
+    assert policy.local_launched is False and stopped.local_launched is False
+
+
+def test_a_timed_out_run_does_not_wait_on_its_already_joined_readers():
+    """M-7: the pipe close after a timeout neither re-joins the readers nor closes a pipe under a live one."""
+    from tools.tts_command_provider import _close_command_pipes
+    joins, closed = [], []
+
+    class Reader:
+        def __init__(self, alive):
+            self.alive = alive
+
+        def join(self, timeout=None):
+            joins.append(timeout)
+
+        def is_alive(self):
+            return self.alive
+
+    class Stream:
+        def __init__(self, name):
+            self.name = name
+
+        def close(self):
+            closed.append(self.name)
+
+    class Proc:
+        stdout, stderr = Stream('stdout'), Stream('stderr')
+    _close_command_pipes(Proc(), [Reader(False), Reader(True)], wait=0)
+    assert joins == [] and closed == ['stdout']
+    _close_command_pipes(Proc(), [Reader(False), Reader(False)])
+    assert joins == [2.0, 2.0] and closed == ['stdout', 'stdout', 'stderr']
diff --git a/tests/tools/test_native_local_launcher.py b/tests/tools/test_native_local_launcher.py
new file mode 100644
index 0000000000000000000000000000000000000000..c521db8da2b9230ce98119d5f54fe89ae36df505
--- /dev/null
+++ b/tests/tools/test_native_local_launcher.py
@@ -0,0 +1,111 @@
+"""Launcher qualification logic (unit): the argv prefix exists only for an exact platform/arch/release/binary identity.
+
+No host sandbox or network probe runs here and the real ``/usr/bin/sandbox-exec`` is never read: every case points
+the qualification table at a test-owned file. The host qualification itself is the controller's recorded probe.
+"""
+import hashlib
+import os
+import platform
+import sys
+
+import pytest
+
+from tools import native_local_launcher as launcher
+from tools import native_send_policy
+from tools.native_send_policy import NativeSendRefused, SendPolicy
+
+
+def host():
+    return sys.platform, platform.machine(), os.uname().release
+
+
+@pytest.fixture
+def binary(tmp_path):
+    path = tmp_path / 'launcher-binary'
+    path.write_bytes(b'#!/bin/false\nsynthetic launcher identity\n')
+    path.chmod(0o755)
+    return path
+
+
+def entry(path, sha=None, **over):
+    system, machine, release = host()
+    fields = dict(system=system, machine=machine, release=release, path=str(path),
+                  sha256=sha or hashlib.sha256(path.read_bytes()).hexdigest(), argv_prefix=(str(path), '-p', launcher.PROFILE))
+    fields.update(over)
+    return launcher.LauncherQualification(**fields)
+
+
+def test_the_sealed_table_names_one_exact_host_binary_and_profile():
+    (only,) = launcher.QUALIFIED
+    assert (only.system, only.machine, only.release, only.path) == ('darwin', 'arm64', '27.0.0', '/usr/bin/sandbox-exec')
+    assert only.sha256 == '58839ef01b4eef8aac0d2aa8f9d1c074ae45aafe3533965b030672450064acc8'
+    assert only.argv_prefix == ('/usr/bin/sandbox-exec', '-p', '(version 1) (allow default) (deny network*)')
+
+
+def test_an_exact_match_yields_the_tables_own_prefix(monkeypatch, binary):
+    monkeypatch.setattr(launcher, 'QUALIFIED', (entry(binary),))
+    assert launcher.qualified_prefix() == (str(binary), '-p', launcher.PROFILE)
+
+
+@pytest.mark.parametrize('change', ['sha', 'release', 'machine', 'system'])
+def test_any_identity_mismatch_fails_closed(monkeypatch, binary, change):
+    over = {'sha': {'sha': '0' * 64}, 'release': {'release': 'other'}, 'machine': {'machine': 'other'},
+            'system': {'system': 'other'}}[change]
+    monkeypatch.setattr(launcher, 'QUALIFIED', (entry(binary, **over),))
+    assert launcher.qualified_prefix() is None
+
+
+def test_a_changed_binary_invalidates_the_qualification_at_once(monkeypatch, binary):
+    monkeypatch.setattr(launcher, 'QUALIFIED', (entry(binary),))
+    assert launcher.qualified_prefix() is not None
+    binary.write_bytes(binary.read_bytes() + b'changed')
+    assert launcher.qualified_prefix() is None
+
+
+@pytest.mark.parametrize('kind', ['absent', 'symlink', 'not-executable', 'directory'])
+def test_an_unusable_launcher_fails_closed(monkeypatch, binary, tmp_path, kind):
+    good = entry(binary)
+    target = tmp_path / kind
+    if kind == 'symlink':
+        target.symlink_to(binary)
+    elif kind == 'not-executable':
+        target.write_bytes(binary.read_bytes())
+        target.chmod(0o644)
+    elif kind == 'directory':
+        target.mkdir()
+    monkeypatch.setattr(launcher, 'QUALIFIED', (launcher.LauncherQualification(
+        good.system, good.machine, good.release, str(target), good.sha256, good.argv_prefix),))
+    assert launcher.qualified_prefix() is None
+
+
+def test_seam_policies_get_the_prefix_from_the_table_and_bare_policies_none(monkeypatch, binary):
+    import time
+    monkeypatch.setattr(launcher, 'QUALIFIED', (entry(binary),))
+    seam = SendPolicy(timeout_s=5, providers=frozenset(), max_output_bytes=4096, deadline=time.monotonic() + 5,
+                      require_launcher=True)
+    with native_send_policy.activate(seam):
+        assert native_send_policy.command_bounds().argv_prefix == (str(binary), '-p', launcher.PROFILE)
+    monkeypatch.setattr(launcher, 'QUALIFIED', ())
+    with native_send_policy.activate(seam), pytest.raises(NativeSendRefused) as refused:
+        native_send_policy.command_bounds()
+    assert refused.value.reason == 'unsupported'
+    bare = SendPolicy(timeout_s=5, providers=frozenset(), max_output_bytes=4096, deadline=time.monotonic() + 5)
+    with native_send_policy.activate(bare):
+        assert native_send_policy.command_bounds().argv_prefix == ()
+
+
+def test_run_native_argv_never_runs_without_a_qualified_launcher(monkeypatch):
+    import time
+    from tools.tts_command_provider import run_native_argv
+    monkeypatch.setattr(launcher, 'QUALIFIED', ())
+    spawned = []
+    monkeypatch.setattr('subprocess.Popen', lambda *a, **k: spawned.append(a))
+    bare = SendPolicy(timeout_s=5, providers=frozenset(), max_output_bytes=4096, deadline=time.monotonic() + 5)
+    for policy in (None, bare):
+        if policy is None:
+            with pytest.raises(NativeSendRefused):
+                run_native_argv([sys.executable, '-c', 'pass'], timeout=1, env={})
+        else:
+            with native_send_policy.activate(policy), pytest.raises(NativeSendRefused):
+                run_native_argv([sys.executable, '-c', 'pass'], timeout=1, env={})
+    assert spawned == []
diff --git a/tests/tools/test_native_rest_stock_transport.py b/tests/tools/test_native_rest_stock_transport.py
new file mode 100644
index 0000000000000000000000000000000000000000..a88d835f28eb1dd5f336628a2514963eda3334f8
--- /dev/null
+++ b/tests/tools/test_native_rest_stock_transport.py
@@ -0,0 +1,108 @@
+"""Stock REST TTS behaviour that the native voice seam must not change.
+
+Measured on the stock generators with only the ``requests`` adapter replaced (``tests/gateway/rest_voice_support``). When
+no native call is active every native-policy hook is inert: 60 s timeout, followed redirects, the library's own request
+encoding, the auxiliary-model speech-tag rewrite and its failure fallback, the 16 MiB reader error type, an OAuth bearer
+without an expiry claim and the provider-text log lines.
+"""
+import os
+from pathlib import Path
+
+import pytest
+import requests
+
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+
+
+def configure(provider, env, **section):
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'tts': {'provider': provider, provider: section}})
+    (get_hermes_home() / '.env').write_text(env)
+    invalidate_env_cache()
+
+
+class Auxiliary:
+    def __init__(self, monkeypatch, reply=None, error=None):
+        self.calls = []
+        self.reply, self.error = reply, error
+        monkeypatch.setattr('agent.auxiliary_client.call_llm', self)
+
+    def __call__(self, **kwargs):
+        self.calls.append(kwargs)
+        if self.error:
+            raise self.error
+        message = type('M', (), {'content': self.reply})()
+        return type('R', (), {'choices': [type('C', (), {'message': message})()]})()
+
+
+def generate(name, tmp_path, text='Hello there, friend.', config=None):
+    from tools import tts_tool, tts_tool_providers as providers
+    generator = {'xai': providers._generate_xai_tts, 'minimax': providers._generate_minimax_tts,
+                 'gemini': providers._generate_gemini_tts}[name]
+    return generator(text, str(tmp_path / f'{name}.mp3'), config if config is not None else tts_tool._load_tts_config())
+
+
+def test_stock_requests_keep_the_sixty_second_timeout_follow_redirects_and_default_encoding(monkeypatch, tmp_path):
+    configure('xai', 'XAI_API_KEY=xai-key\n')
+    wire = rest.RestWire([('redirect', 'https://api.x.ai/v1/tts/elsewhere'), ('audio', b'ID3followed')])
+    with rest.rest_wire(monkeypatch, wire):
+        path = generate('xai', tmp_path)
+    assert Path(path).read_bytes() == b'ID3followed' and wire.count == 2  # stock follows a redirect (a second request)
+    assert wire.timeouts() == [60, 60] and wire.requests[0][0].headers['Accept-Encoding'] != 'identity'
+    configure('minimax', 'MINIMAX_API_KEY=mm-key\n')
+    wire = rest.RestWire([rest.minimax_answer(b'ID3mm')])
+    with rest.rest_wire(monkeypatch, wire):
+        generate('minimax', tmp_path)
+    assert wire.timeouts() == [60] and wire.requests[0][0].headers['Accept-Encoding'] != 'identity'
+
+
+def test_stock_xai_tags_still_ask_the_auxiliary_model_and_fall_back_when_it_fails(monkeypatch, tmp_path):
+    configure('xai', 'XAI_API_KEY=xai-key\n', auto_speech_tags=True)
+    aux = Auxiliary(monkeypatch, reply='Plain words [whisper]here[/whisper] now.')
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.rest_wire(monkeypatch, wire):
+        generate('xai', tmp_path, text='Plain words here now.')
+    assert len(aux.calls) == 1 and aux.calls[0]['task'] == 'tts_audio_tags'
+    assert wire.body_json()['text'] == 'Plain words [whisper]here[/whisper] now.'  # stock sends the auxiliary rewrite
+    aux = Auxiliary(monkeypatch, error=RuntimeError('auxiliary down'))
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.rest_wire(monkeypatch, wire):
+        generate('xai', tmp_path, text='First paragraph is here.\n\nSecond paragraph follows now.')
+    assert len(aux.calls) == 1 and wire.body_json()['text'] == 'First paragraph is here. [pause] Second paragraph follows now.'
+
+
+def test_stock_gemini_audio_tags_still_ask_the_auxiliary_model(monkeypatch, tmp_path):
+    configure('gemini', 'GEMINI_API_KEY=g-key\n', model='gemini-3.1-flash-tts-preview', audio_tags=True)
+    aux = Auxiliary(monkeypatch, reply='[excitedly] Plain words only.')
+    wire = rest.RestWire([rest.gemini_answer(rest.pcm_bytes(0.3))])
+    with rest.rest_wire(monkeypatch, wire):
+        generate('gemini', tmp_path, text='Plain words only.')
+    assert len(aux.calls) == 1 and wire.body_json()['contents'][0]['parts'][0]['text'] == '[excitedly] Plain words only.'
+
+
+def test_stock_oversize_body_is_still_a_runtime_error_and_a_declared_length_is_still_read(monkeypatch, tmp_path):
+    from tools.tts_tool_providers import TTS_RESPONSE_BODY_LIMIT_BYTES
+    configure('xai', 'XAI_API_KEY=xai-key\n')
+    wire = rest.RestWire([('raw', 200, {'Content-Type': 'audio/mpeg'}, b'\0' * (TTS_RESPONSE_BODY_LIMIT_BYTES + 1), False)])
+    with rest.rest_wire(monkeypatch, wire), pytest.raises(RuntimeError, match='response exceeds') as raised:
+        generate('xai', tmp_path)
+    assert type(raised.value) is RuntimeError  # not a native refusal
+
+
+def test_stock_oauth_bearer_without_an_expiry_claim_is_still_used(monkeypatch, tmp_path):
+    configure('xai', '')
+    rest.write_oauth_store('opaque-bearer-without-expiry')
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, rest.OAuthWire()), rest.rest_wire(monkeypatch, wire):
+        generate('xai', tmp_path)
+    assert wire.requests[0][0].headers['Authorization'] == 'Bearer opaque-bearer-without-expiry'
+
+
+def test_stock_post_failures_are_not_wrapped_or_reclassified(monkeypatch, tmp_path):
+    configure('gemini', 'GEMINI_API_KEY=g-key\n')
+    wire = rest.RestWire([('status', 429, b'{"error": {"message": "quota"}}')])
+    with rest.rest_wire(monkeypatch, wire), pytest.raises(RuntimeError, match=r'Gemini TTS API error \(HTTP 429\): quota'):
+        generate('gemini', tmp_path)
+    assert wire.count == 1 and not [name for name in os.listdir(tmp_path) if name.endswith('.mp3')]
diff --git a/tests/tools/test_native_send_policy_unit.py b/tests/tools/test_native_send_policy_unit.py
new file mode 100644
index 0000000000000000000000000000000000000000..469bd591fd0e3e7f9766ab2cdeaa0be46d07fa8d
--- /dev/null
+++ b/tests/tools/test_native_send_policy_unit.py
@@ -0,0 +1,119 @@
+"""Direct ``SendPolicy`` pins, with no consumer, seam or provider in between.
+
+N2: a credential-phase refusal CLOSES the policy, and that close is sticky on its own: a later ``begin()`` and a later
+probe are refused ``closed`` without asking the gate or the probe again, whatever the consumer would now answer.
+Also pins the per-call custom-route admission and the command bounds a native call imposes.
+"""
+import time
+
+import pytest
+
+from tools import native_send_policy
+from tools.native_send_policy import NativeSendRefused, SendPolicy
+
+
+def _policy(**kw):
+    return SendPolicy(timeout_s=5.0, providers=frozenset({'openai'}), **kw)
+
+
+@pytest.mark.parametrize('reason', ['refused', 'cancelled', 'timeout', 'closed'])
+def test_a_probe_refusal_closes_the_policy_and_every_later_send_or_probe_is_refused_closed(reason):
+    policy = _policy()
+    gate_calls, probe_calls = [], []
+
+    def probe():
+        probe_calls.append(1)
+        if len(probe_calls) == 1:
+            raise NativeSendRefused(reason)
+    policy.set_gate(lambda: gate_calls.append(1))
+    policy.set_credential_probe(probe)
+
+    with pytest.raises(NativeSendRefused) as first:
+        policy.probe_credentials()
+    assert first.value.reason == reason
+    assert policy.closed is True and policy.refusal == reason
+
+    with pytest.raises(NativeSendRefused) as send:
+        policy.begin()
+    with pytest.raises(NativeSendRefused) as again:
+        policy.probe_credentials()
+    assert (send.value.reason, again.value.reason) == ('closed', 'closed')
+    assert gate_calls == [] and probe_calls == [1]  # the consumer is never asked again
+    assert policy.sends == 0 and policy.refusal == reason  # the first truthful reason is kept
