+    from gateway import session_native_voice_tts as tts_module
+    CASES['xai']['profile'](max_text_length=60)
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    first_answered = threading.Event()
+    release = threading.Event()
+    state = {'n': 0}
+
+    def tap(request):
+        state['n'] += 1
+        if state['n'] == 2:  # the second chunk's request is the one that stalls
+            first_answered.set()
+            assert release.wait(30)
+    cb = support.Callbacks()
+    wire = rest.RestWire([('audio', b'ID3one'), ('audio', b'ID3two'), ('audio', b'ID3three')], tap=tap)
+    from tests.gateway.test_native_voice_rest_tts import LONG_TEXT
+    try:
+        with rest.rest_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb, text=LONG_TEXT))
+            assert await asyncio.to_thread(first_answered.wait, 10)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
