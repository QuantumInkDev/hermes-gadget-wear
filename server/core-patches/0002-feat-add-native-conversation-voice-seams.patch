+# ---- Task4 fix1 I4: a bounded-response safety refusal is TERMINAL for native STT (no installed local fallback) ---------------
+@pytest.fixture
+def fallback(monkeypatch):
+    """A cached installed local STT backend that WOULD answer if the seam ever fell back to it."""
+    calls = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: calls.append(path) or {'success': True, 'transcript': ' local words '})
+    return calls
+
+
+TERMINAL_CASES = [('unsupported-encoding', {'Content-Encoding': 'gzip'}, None), ('response-bound', {}, 2 * CAP)]
