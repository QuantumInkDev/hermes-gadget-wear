+    assert outcome(result) == ('failed', None, 'failed_after_send')  # exact: a paid answer that could not be converted
+    assert (wire.count, cb.before_send_calls, len(converter.calls)) == (1, 1, 1)  # one request, one paid callback, one conversion
+    assert os.listdir(out) == []  # the chunk file never survived
+    assert not os.path.exists(converter.wav_paths[0])  # the temporary WAV was removed by the stock cleanup
+    assert 'synthetic ffmpeg failure' not in repr(result)
