+# ---- Task4 fix1 I2: Stop / the deadline while the response BODY read is held -------------------------------------------------
+HELD = [pytest.param(next(p.values[0] for p in BACKENDS if p.values[0].name == name), id=name)
+        for name in ('openai-text', 'xai')]
+
