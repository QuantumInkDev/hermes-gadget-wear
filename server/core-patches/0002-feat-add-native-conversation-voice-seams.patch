+# ---- fix1 M3: a non-zero exit that leaves an oversized output is a terminal bound violation -----------------------------------------
+# LABELLED FINITE SYNTHETIC BOUNDARY (not a real-subprocess timing proof): the lowest runner call writes a small LOWERED-LIMIT oversized
+# output and then raises ``CalledProcessError`` BEFORE any final watch, which models "the child left the file between two watch polls and
+# exited non-zero". The existing watched-runaway behaviour (``grow-convert``) and an ordinary under-cap failure are kept separate.
+def bounded_policy():
+    from tools import native_send_policy
+    return native_send_policy.SendPolicy(timeout_s=5.0, providers=frozenset(), deadline=time.monotonic() + 60, max_output_bytes=1024,
+                                         require_launcher=True)
