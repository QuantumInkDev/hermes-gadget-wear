+    support.qualify(monkeypatch)
+    clip = support.write_wav(tmp_path / 'short.wav', seconds=1.0)
+    events, upload = [], Upload()
+    spawns = support.record_spawns(monkeypatch, events)
+    cb = support.Callbacks(events)
+    wire = support.Wire([words()], tap=lambda request: (events.append('request'), upload(request)))
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.source, result.provider) == ('transcribed', 'configured', 'completed')
+    assert (wire.count, cb.before_send_calls, stock_runner) == (1, 1, [])
+    assert names(spawns) == ['ffprobe', 'ffprobe'], names(spawns)  # the trim gate probe BEFORE 12 s, then the duration-cap probe
+    assert upload.is_wav  # the unchanged full recording
+    first = children(spawns)[0][1]
+    argv = first['args']
+    assert argv[:4] == [sys.executable, str(support.PASSTHROUGH), '-p', '(version 1) (allow default) (deny network*)']
+    assert ['-protocol_whitelist', 'file'] == argv[argv.index('-protocol_whitelist'):][:2] and argv[-1] == str(clip)
+    assert 'format=duration' in argv and first['stdin'] == subprocess.DEVNULL
+    assert first['cwd'] and str(scratch) in first['cwd'] and not os.path.exists(first['cwd'])  # a private cwd, removed
+    assert events.index('request') > max(i for i, e in enumerate(events) if e == 'spawn')  # every child ran before the send
+    assert os.listdir(scratch) == []
