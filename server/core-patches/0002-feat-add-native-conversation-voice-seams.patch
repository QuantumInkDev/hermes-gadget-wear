+async def test_each_provider_sends_once_through_the_gate_with_the_stock_request(monkeypatch, out, name):
+    case = CASES[name]
+    case['profile']()
+    events = []
+    cb = support.Callbacks(events)
+    wire = rest.RestWire([case['ok']], tap=lambda request: events.append('request'))
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, result.source, wire.count) == ('synthesized', 'completed', 'configured', 1)
+    if name == 'gemini':  # AUX-audio: the converter preflight's authorization-only probes come first, then the same gate order
+        gate = events.index('before_send')
+        assert events.count('before_send') == events.count('request') == 1 and events[gate + 1] == 'request' and events[-1] == 'authorize'
+        assert 'request' not in events[:gate]  # every preflight child ran before the first (paid) request
+    else:
+        assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']  # gate immediately before the wire
+    request, kwargs = wire.requests[0]
+    assert request.url.split('?')[0].endswith(case['path']) and case['host'] in request.url
+    assert kwargs['timeout'] == 60.0
+    assert request.headers['Accept-Encoding'] == 'identity'
+    if case['audio'] is not None:
