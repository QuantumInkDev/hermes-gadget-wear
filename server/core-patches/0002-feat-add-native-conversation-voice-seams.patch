+    ref, texts, _ = lineage
+    oracle = support.by_identity(await support.fragments(rig.authority, reader(), ref))
+    assert len(oracle) == len(texts) + 1
+    segments = 0
+    for identity, parts in oracle.items():
+        for frag in parts:
+            got = await rig.authority.read_native_display(
+                reader(), ref, authorize=lambda: None, identity=identity, segment=frag.segment_index)
+            assert got == frag, (identity, frag.segment_index)
+            segments += 1
+    assert segments > len(oracle)  # multi-segment rows were really compared segment by segment
+    for name, text in texts.items():
+        assert [i for i, parts in oracle.items() if support.whole_text(parts) == text], name
