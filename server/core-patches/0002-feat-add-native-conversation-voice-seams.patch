+# ---- Task4: the plugin transport and the shared response hook enforce identity and the declared size ---------------------
+def _answer_through(monkeypatch, headers, body, limit=1024):
+    """The native plugin transport (a real httpx client, synthetic bytes) asked for a counting streamed answer."""
+    from tests.gateway import native_voice_support as support
+    policy = _policy(max_output_bytes=limit)
+    policy.set_gate(lambda: None)
+    wire = support.BodyWire(200, headers, body)
+    with support.provider_wire(monkeypatch, wire), native_send_policy.activate(policy):
+        client = native_send_policy.native_transport().client
+        try:
+            return wire, client.get('https://plugin.invalid/answer')
+        finally:
+            policy.close_clients()
+
+
+def test_the_plugin_transport_refuses_a_nonidentity_answer_before_reading_it(monkeypatch):
+    import gzip
+    from tests.gateway import native_voice_support as support
+    policy = _policy(max_output_bytes=1024)
+    policy.set_gate(lambda: None)
+    wire = support.BodyWire(200, {'Content-Encoding': 'gzip'}, gzip.compress(b'small'))
+    with support.provider_wire(monkeypatch, wire), native_send_policy.activate(policy):
+        client = native_send_policy.native_transport().client
+        with pytest.raises(NativeSendRefused):
+            client.get('https://plugin.invalid/answer')
+        policy.close_clients()
+    assert wire.body.pulled == 0 and wire.body.closed and wire.requests[0].headers['accept-encoding'] == 'identity'
+
+
+def test_the_plugin_transport_still_reads_an_identity_answer_whole_and_refuses_an_oversize_one(monkeypatch):
+    wire, response = _answer_through(monkeypatch, {'Content-Type': 'text/plain'}, b'x' * 100)
+    assert response.content == b'x' * 100 and wire.body.closed
+    with pytest.raises(NativeSendRefused):
+        _answer_through(monkeypatch, {'Content-Length': '2048'}, b'x' * 2048)
