+    started = time.monotonic()
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb, deadline_s=30)
+    assert time.monotonic() - started < 10  # the deadline did not decide this
+    assert (result.state, result.transcript, result.source, result.provider) == (state, None, None, 'not_started')
+    assert no_fallback == [] and wire.count == 0 and cb.before_send_calls == 0
