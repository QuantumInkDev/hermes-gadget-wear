+
+# ---- Task4 fix1 I1: a REDIRECT-class answer is bounded before Requests' own redirect processing -----------------------------
+REDIRECT_CASES = [
+    # (id, headers, body size or the gzip marker)
+    ('declared-oversize', {'Content-Length': str(CAP + 1)}, CAP + 1),
+    ('absent-length', {}, 2 * CAP),
+    ('false-length', {'Content-Length': '10'}, 2 * CAP),
+    ('gzip', {'Content-Encoding': 'gzip'}, None),
+]
+REQUESTS_BACKENDS = [p for p in BACKENDS if p.values[0].family == 'requests']
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('backend', REQUESTS_BACKENDS)
+@pytest.mark.parametrize('case', REDIRECT_CASES, ids=[c[0] for c in REDIRECT_CASES])
+async def test_a_redirect_class_answer_is_bounded_and_refused_before_requests_resolves_the_redirect(
+        monkeypatch, clip, backend, case):
+    """Requests' ``Session.send`` runs ``resolve_redirects`` even with ``allow_redirects=False`` and that evaluates
+    ``response.content`` (a whole, DECODED read) for a 3xx with ``Location``. The bound and the identity rule therefore run in
+    the response hook, which Requests dispatches BEFORE that. One send, no second request, no decoder entered."""
+    import urllib3.response
+    _, headers, size = case
+    backend.profile()
+    entered = []
+    real = urllib3.response.GzipDecoder.decompress
+    monkeypatch.setattr(urllib3.response.GzipDecoder, 'decompress', lambda self, *a, **k: entered.append(1) or real(self, *a, **k))
+    declared = headers.get('Content-Length') == str(CAP + 1)
+    body = gzip.compress(backend.shape(CAP)) if size is None else backend.shape(size - len(backend.shape(0)) if declared else size)
+    wire = RawWire(307, {'Content-Type': backend.kind, 'Location': 'https://redirect.invalid/elsewhere', **headers}, body)
+    with backend.context(monkeypatch, wire):
+        result, cb = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1  # exactly one send: the redirect is an answer, never followed
+    assert entered == [] and wire.body.closed
+    if size is None or declared:
+        assert wire.body.pulled == 0
+    else:
+        assert wire.body.pulled <= CAP + CHUNK < len(body)
