+# A normalized WAV bigger than this is a runaway (a tiny low-bitrate file can decode to hours of PCM): the native normalizer
+# ends the converter and fails the call instead of filling the disk.
+NORMALIZED_WAV_MAX_BYTES = 64 * 1024 * 1024
+_NATIVE_NORMALIZE_INPUT = ("-nostdin", "-hide_banner", "-loglevel", "error", "-protocol_whitelist", "file", "-i")
+
+
+def _normalize_local_audio_native(ffmpeg: str, file_path: str, converted_path: str) -> tuple[Optional[str], Optional[str]]:
+    """Native call only (the managed whisper.cpp branch): the SAME conversion as the stock normalizer, but as a launcher-wrapped,
+    Stop-aware child bounded by the call's exact remaining deadline, local-file protocols only, no stdin, capped output
+    streams and a capped, checked WAV. A conversion that fails or leaves no real WAV is an error result (the child really
+    ran); Stop/deadline refusals propagate. Cleanup is the caller's temporary directory."""
+    from tools.tts_command_provider import run_native_argv
+    from tools.tts_tool_local import _ENGINE_STREAM_BYTES, _native_child_env, _remaining
+    policy = native_send_policy.current()
+
+    def watch() -> Optional[str]:
+        try:
+            return "too_long" if os.path.getsize(converted_path) > NORMALIZED_WAV_MAX_BYTES else None
+        except OSError:
+            return None
+    try:
+        run_native_argv([ffmpeg, *_NATIVE_NORMALIZE_INPUT, file_path, "-y", converted_path],
+                        timeout=_remaining(policy), env=_native_child_env(),
+                        cwd=os.path.dirname(converted_path), watch=watch, max_stream_bytes=_ENGINE_STREAM_BYTES)
+    except subprocess.TimeoutExpired:
+        raise native_send_policy.refuse("timeout") from None  # its timeout IS the call's remaining deadline
+    except subprocess.CalledProcessError:
+        return None, "Failed to convert audio for local STT"
+    if not _is_real_wav(converted_path):
+        return None, "Failed to convert audio for local STT"
+    return converted_path, None
+
+
+def _is_real_wav(path: str) -> bool:
+    """A regular file with a RIFF/WAVE head that holds audio and is within the normalized-WAV bound."""
+    try:
+        with open(path, "rb") as handle:
+            head = handle.read(12)
+        size = os.path.getsize(path)
+    except OSError:
+        return False
+    return head[:4] == b"RIFF" and head[8:12] == b"WAVE" and 44 < size <= NORMALIZED_WAV_MAX_BYTES
+
+
