+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb, deadline_s=90)  # the request timeout is min(60 s policy, deadline)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'bonjour le monde', 'configured', 'completed')
+    assert wire.count == 1 and events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    (built,) = sdk
+    assert built['kwargs']['client'] is built['sender']  # the SDK sends through the very client that carries the hook
+    assert built['kwargs']['retry_config'] is None and built['kwargs']['timeout_ms'] == 60000
+    assert [(c['retries'], c['timeout_ms'], c['language']) for c in built['calls']] == [(None, 60000, 'fr')]
+    assert (built['sender'].follow_redirects, built['sender'].timeout.read) == (False, 60.0)  # the options it carries
