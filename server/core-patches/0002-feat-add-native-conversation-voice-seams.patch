+"""One-send transport policy for a native (Relay) voice call.
+
+``gateway.session_native_voice`` activates a :class:`SendPolicy` around exactly one configured
+provider request (per STT call, per TTS chunk). The provider modules ask this module at their
+transport boundary, and only there, so an ordinary ``transcribe_audio`` / ``text_to_speech_tool``
+call, where no policy is active, keeps its SDK retries, timeouts, redirects, transcode retry and
+log lines untouched.
+
+The policy never trusts a client library to honour "no retry" or "I use the client you gave me":
+``begin()`` runs immediately before every transport send and refuses a second send in the same
+scope; the seam additionally proves, BEFORE a hooked SDK is invoked, that the SDK sends through the
+very client that carries the hook, and requires, AFTER it, exactly one gated send. A send nobody
+gated is reported as ``unknown`` accounting, never ``not_started``. Refusals carry stable tokens,
+never provider text.
+"""
+from __future__ import annotations
+
+import contextlib
+import contextvars
+from dataclasses import dataclass
+import inspect
+import logging
+import threading
+import time
+from typing import Any, Callable, Iterable, Iterator, Optional
+
+
+class NativeSendRefused(RuntimeError):
+    """A transport send the policy refused; ``reason`` is a stable token, never provider text."""
+
+    def __init__(self, reason: str):
+        super().__init__(reason)
+        self.reason = reason
+
+
+class CredentialPhaseStopped(BaseException):
+    """An actual OAuth discovery/refresh request of the credential phase was refused (``reason`` is a stable token).
+
+    A ``BaseException`` ON PURPOSE, like ``asyncio.CancelledError``: the stock credential pool treats any ``Exception`` from a
+    refresh as a failed account (it benches the account for a cooldown or clears its stored tokens) and the stock resolver
+    swallows ``Exception`` and falls through to another credential. A Stop, deadline or lost authority is not an account
+    fault and must not fall through, so this passes both untouched; ``tools.xai_http`` converts it to
+    :class:`NativeSendRefused` at the resolver boundary."""
+
+    def __init__(self, reason: str):
+        super().__init__(reason)
+        self.reason = reason
+
+
+class SendPolicy:
+    """Counts and gates transport sends for one native call.
+
+    ``gate`` (set once, before the worker starts) runs the caller's ``authorize`` + ``before_send`` on the
+    owning event loop and raises :class:`NativeSendRefused` to refuse; it calls :meth:`commit` once the
+    consumer's ``before_send`` returned. ``providers`` is the closed set of provider names the call may reach; one held
+    custom route may be added for this call only (:meth:`admit_custom`, :meth:`admit_local`). ``deadline`` is the call's
+    absolute ``time.monotonic()`` bound when the caller has one. ``require_launcher`` (set for every seam policy) makes
+    every local child of the call run inside the qualified OS network-deny launcher, or not at all.
+    """
+
+    def __init__(self, *, timeout_s: float, providers: frozenset[str], gate: Optional[Callable[[], None]] = None,
+                 max_output_bytes: Optional[int] = None, deadline: Optional[float] = None,
+                 require_launcher: bool = False):
+        self.timeout_s = timeout_s
+        self.providers = providers
+        self.max_output_bytes = max_output_bytes
+        self.deadline = deadline
+        self.require_launcher = require_launcher
+        self._custom: Optional[str] = None
+        self._local: Optional[str] = None
+        self._local_launched = False
+        self._gate = gate
+        self._credential_probe: Optional[Callable[[], None]] = None
+        self._lock = threading.Lock()
+        self._scope_sends = 0
+        self._entered = False
+        self._committed = False
+        self._clients: list[Any] = []
+        self.sends = 0
+        self.refusal: Optional[str] = None
+        self.closed = False
+
+    def set_gate(self, gate: Callable[[], None]) -> None:
+        self._gate = gate
+
+    def set_credential_probe(self, probe: Callable[[], None]) -> None:
+        """The authorization-only check of the credential phase (runs the consumer's ``authorize`` on its own loop)."""
+        self._credential_probe = probe
+
+    @property
+    def scope_sends(self) -> int:
+        """Gated sends admitted since the last :meth:`arm`."""
+        return self._scope_sends
+
+    @property
+    def entered(self) -> bool:
+        """The provider invocation of the current scope was entered (the injected client was proven, or the
+        Edge connector built, and the SDK is about to be called)."""
+        return self._entered
+
+    def mark_entered(self) -> None:
+        with self._lock:
+            self._entered = True
+
+    def silent_after_entry(self) -> bool:
+        """True when an invocation was entered, no send passed the gate in this scope and no policy refusal
+        explains it: whatever happened next (an exception, a failure answer) may have left through a path the
+        gate never saw, so the accounting is ambiguous (``unknown``), never ``not_started``."""
+        with self._lock:
+            return self._entered and not self._scope_sends and self.refusal is None
+
+    def refusal_for(self, reason: str) -> NativeSendRefused:
+        """The exception to raise for ``reason``, remembering the first reason for the caller's report."""
+        with self._lock:
+            return self._refusal_locked(reason)
+
+    def _refusal_locked(self, reason: str) -> NativeSendRefused:
+        self.refusal = self.refusal or reason
+        return NativeSendRefused(reason)
+
+    def arm(self) -> None:
+        """Open a fresh one-send scope (one TTS chunk); cumulative ``sends`` keeps counting."""
+        with self._lock:
+            self._scope_sends = 0
+            self._entered = False
+
+    def is_closed(self) -> bool:
+        with self._lock:
+            return self.closed
+
+    def commit(self) -> None:
+        """Loop side: the consumer's ``before_send`` returned for a send that has not left yet."""
+        with self._lock:
+            self._committed = True
+
+    def begin(self) -> None:
+        """Called immediately before a transport send: refuse a closed policy or a second send,
+        then let the caller's gate authorize and durably record the send before it happens."""
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+            if self._scope_sends:
+                raise self._refusal_locked('second')
+        try:
+            if self._gate is None:
+                raise NativeSendRefused('refused')
+            self._gate()
+        except NativeSendRefused as exc:
+            raise self.refusal_for(exc.reason) from None
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+            self._scope_sends = 1
+            self.sends += 1
+            self._committed = False
+
+    def on_request(self, _request) -> None:
+        """httpx ``request`` event hook: the actual transport boundary of SDK and httpx clients."""
+        self.begin()
+
+    def probe_credentials(self) -> None:
+        """Called immediately before an OAuth discovery/refresh HTTP request: refuse a closed policy, else ask the
+        consumer whether the call is still authorized. This is NOT a send: it never runs ``before_send``, never commits,
+        never counts a send nor opens a scope, and a policy with no probe fails closed.
+
+        A refusal CLOSES the policy: it is terminal for the call, so no later probe, OAuth request or paid ``begin`` can be
+        admitted even if a stock caller swallowed the exception or the consumer would authorize again."""
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+        try:
+            if self._credential_probe is None:
+                raise NativeSendRefused('refused')
+            self._credential_probe()
+        except NativeSendRefused as exc:
+            refusal = self.refusal_for(exc.reason)  # keeps the FIRST truthful reason
+            self.close()  # terminal: a stock quiet availability probe may swallow this, and authority may return later
+            raise refusal from None
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+
+    def on_credential_request(self, _request) -> None:
+        """httpx ``request`` event hook of the OAuth clients: the actual lowest OAuth boundary under the credential phase."""
+        try:
+            self.probe_credentials()
+        except NativeSendRefused as exc:
+            raise CredentialPhaseStopped(exc.reason) from None
+
+    def admit_custom(self, name: str) -> None:
+        """Admit exactly one custom route, already selected through the stock precedence and checked capable on the
+        held instance, into THIS call's provider set. It certifies nothing by itself (the send gate still counts and
+        refuses at the transport); it never touches a registry and a second, different name is refused."""
+        with self._lock:
+            if self._custom is not None and self._custom != name:
+                raise self._refusal_locked('unsupported')
+            self._custom = name
+
+    @property
+    def custom(self) -> Optional[str]:
+        """The custom route admitted for this call, or None."""
+        return self._custom
+
+    def admit_local(self, name: str) -> None:
+        """Admit one held LOCAL route (a launcher-wrapped command adapter or ``local_command``): like
+        :meth:`admit_custom`, and its outcome is accounted local (no gated send expected, never "unaccounted")."""
+        self.admit_custom(name)
+        with self._lock:
+            self._local = name
+
+    @property
+    def local_route(self) -> Optional[str]:
+        """The local route admitted for this call, or None."""
+        return self._local
+
+    def mark_local_launch(self) -> None:
+        """A local child of this call was actually started (its ``Popen`` returned). Set by the runner only."""
+        with self._lock:
+            self._local_launched = True
+
+    @property
+    def local_launched(self) -> bool:
+        """True once a local child of this call was actually started: a later failure is a failure after a local
+        invocation (``failed``), never "nothing was tried"."""
+        return self._local_launched
+
+    def require_provider(self, provider: str) -> None:
+        if provider not in self.providers and (self._custom is None or provider != self._custom):
+            raise self.refusal_for('unsupported')
+
+    def track(self, client: Any) -> Any:
+        """Remember a client this call built so :meth:`close_clients` can release its pool."""
+        with self._lock:
+            self._clients.append(client)
+        return client
+
+    def close_clients(self) -> None:
+        with self._lock:
+            clients, self._clients = self._clients, []
+        for client in clients:
+            with contextlib.suppress(Exception):
+                client.close()
+
+    def close(self) -> bool:
+        """Stop admitting sends; True when a request may have left, or the consumer already recorded one."""
+        with self._lock:
+            self.closed = True
+            return self.sends > 0 or self._committed
+
+
+_current: contextvars.ContextVar[Optional[SendPolicy]] = contextvars.ContextVar('native_send_policy', default=None)
+
+
+class _QuietInNativeCalls(logging.Filter):
+    """Drops the stock provider helpers' log records while a native call is active in THIS context:
+    their lines carry provider messages, tracebacks and audio basenames (design 8.1, 10.3). Other
+    threads and ordinary stock calls are untouched. A dropped record is dropped for EVERY handler
+    (a logger filter runs before any handler), so during a native call it is not available in an
+    operator's local log either."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        return _current.get() is None
+
+
+# Python applies a logger's filters only to records created on THAT logger, so the loggers below are named exactly.
+# Behaviourally tested: the stock STT/TTS helpers (``tools.transcription_tools``, ``tools.tts_tool``), the credential pool
+# (an OAuth refresh failure logs the authority's response body) and ``mistralai.client._hooks.deprecation_warning`` (its
+# WARNING carries a provider-supplied date). Installed but NOT exercised by any test: ``mistralai.client``,
+# ``mistralai.client._hooks.tracing`` and ``mistralai.client._hooks.workflow_encoding_hook``. Not filtered at all: the
+# pinned SDK's other loggers, e.g. ``mistralai.extra.observability.otel``/``.telemetry`` (WARNINGs with tracebacks when SDK
+# tracing and a global tracer are active); that belongs to the global-OpenTelemetry condition (M1/CV2).
+_QUIET_LOGGERS = (
+    'tools.transcription_tools', 'tools.tts_tool', 'agent.credential_pool', 'mistralai.client',
+    'mistralai.client._hooks.deprecation_warning', 'mistralai.client._hooks.tracing',
+    'mistralai.client._hooks.workflow_encoding_hook')
+
+
+def _install_quiet_filter() -> None:
+    for name in _QUIET_LOGGERS:
+        logger = logging.getLogger(name)
+        if not any(isinstance(f, _QuietInNativeCalls) for f in logger.filters):
+            logger.addFilter(_QuietInNativeCalls())
+
+
+_install_quiet_filter()
+
+
+def current() -> Optional[SendPolicy]:
+    return _current.get()
+
+
+@contextlib.contextmanager
+def activate(policy: SendPolicy) -> Iterator[SendPolicy]:
+    token = _current.set(policy)
+    try:
+        yield policy
+    finally:
+        _current.reset(token)
+
+
+def installs_allowed() -> bool:
+    """False inside a native call: it uses only what is already installed and cached, never a lazy
+    SDK install nor a model download."""
+    return _current.get() is None
+
+
+def auxiliary_llm_allowed() -> bool:
+    """False inside a native call: it makes no auxiliary-model request (a hidden second paid request on an
+    unrelated provider, outside the send gate), so optional speech-tag rewrites keep their stock fallback text."""
+    return _current.get() is None
+
+
+def require_open() -> None:
+    """Inside a native call: refuse UNSENT once Stop or the deadline closed the policy, before any credential work."""
+    policy = _current.get()
+    if policy is not None and policy.is_closed():
+        raise policy.refusal_for('closed')
+
+
+def check_alive() -> None:
+    """Inside a native call, between body reads: refuse once Stop/the deadline closed the call (``closed``) or the absolute
+    deadline passed (``timeout``). Cheap, no callback, no send. A read that is already blocked is not preempted by this."""
+    policy = _current.get()
+    if policy is None:
+        return
+    if policy.is_closed():
+        raise policy.refusal_for('closed')
+    if policy.deadline is not None and time.monotonic() >= policy.deadline:
+        raise policy.refusal_for('timeout')
+
+
+def credential_client_kwargs() -> dict:
+    """Extra ``httpx.Client(...)`` kwargs of an OAuth discovery/refresh client: the credential-phase probe on every request
+    it sends. Outside a native call: nothing (the stock clients are built exactly as before)."""
+    policy = _current.get()
+    return {} if policy is None else {'event_hooks': {'request': [policy.on_credential_request]}}
+
+
+def credential_timeout(seconds: float) -> float:
+    """An OAuth request timeout bounded by the native call's budget (``min(stock, the call's bound)``); stock outside one."""
+    policy = _current.get()
+    return seconds if policy is None else min(seconds, policy.timeout_s)
+
+
+def no_resend() -> bool:
+    """True inside a native call: no post-send retry of any kind (transcode retry, OAuth refresh, redirect)."""
+    return _current.get() is not None
+
+
+def refuse(reason: str) -> NativeSendRefused:
+    """The refusal to raise for ``reason``, recorded on the active policy so the caller can report it."""
+    policy = _current.get()
+    return policy.refusal_for(reason) if policy is not None else NativeSendRefused(reason)
+
+
+def mark_entered() -> None:
+    """Immediately before an SDK/engine invocation whose gate is proven: from here a zero-send exception or
+    failure is ambiguous, not "nothing was sent"."""
+    policy = _current.get()
+    if policy is not None:
+        policy.mark_entered()
+
+
+def begin_send() -> None:
+    """Transport-boundary hook for providers that do not go through an httpx client."""
+    policy = _current.get()
+    if policy is not None:
+        policy.begin()
+
+
+def require_provider(provider: str) -> None:
+    policy = _current.get()
+    if policy is not None:
+        policy.require_provider(provider)
+
+
+def admit_custom(name: str) -> None:
+    """Inside a native call: admit the one held custom route (see :meth:`SendPolicy.admit_custom`)."""
+    policy = _current.get()
+    if policy is not None:
+        policy.admit_custom(name)
+
+
+@dataclass(frozen=True, slots=True)
+class CommandBounds:
+    """What a native call imposes on a command child it spawns, on top of the stock idle timeout.
+
+    ``argv_prefix`` is the qualified OS network-deny launcher (``tools.native_local_launcher``) for seam calls, empty for
+    a bare policy. Bounds are NOT containment: the child is the operator's own code, and the group kill does not reach a
+    descendant that left the process group."""
+    deadline_monotonic: float  # absolute; whichever of this and the stock idle timeout comes first ends the run
+    max_stream_bytes: int  # per stream (stdout, stderr) and for a transcript file; chunk-granular (64 KiB reads)
+    closed: Callable[[], bool]  # cancellation: Stop or the deadline closed the policy
+    argv_prefix: tuple[str, ...] = ()
+
+
+def command_bounds() -> Optional[CommandBounds]:
+    """Inside a native call: the bounds for a command child (refused UNSENT when the call has no deadline or output
+    cap to impose, or when it requires the launcher and this host has no qualified one). Outside one: None, and the stock
+    runner is byte-for-byte unchanged. ``argv_prefix`` is built here from the qualification table, never passed in."""
+    policy = _current.get()
+    if policy is None:
+        return None
+    if policy.deadline is None or policy.max_output_bytes is None:
+        raise policy.refusal_for('unsupported')
+    prefix: tuple[str, ...] = ()
+    if policy.require_launcher:
+        from tools.native_local_launcher import qualified_prefix
+        prefix = qualified_prefix() or ()
+        if not prefix:
+            raise policy.refusal_for('unsupported')
+    return CommandBounds(deadline_monotonic=policy.deadline, max_stream_bytes=policy.max_output_bytes,
+                         closed=policy.is_closed, argv_prefix=prefix)
+
+
+def authorize_local_start() -> None:
+    """Immediately before a seam call spawns a local child: refuse a closed call and re-ask the consumer's ``authorize``
+    on its own loop (the authorization-only probe; a refusal is terminal). Not a send: nothing is counted or committed."""
+    policy = _current.get()
+    if policy is not None and policy.require_launcher:
+        policy.probe_credentials()
+
+
+def mark_local_launch() -> None:
+    """Inside a native call: record that a local child was actually started (see :meth:`SendPolicy.mark_local_launch`)."""
+    policy = _current.get()
+    if policy is not None:
+        policy.mark_local_launch()
+
+
+def admit_local(name: str) -> None:
+    """Inside a native call: admit the one held local route (see :meth:`SendPolicy.admit_local`)."""
+    policy = _current.get()
+    if policy is not None:
+        policy.admit_local(name)
+
+
+def request_timeout(default: float) -> float:
+    policy = _current.get()
+    return default if policy is None else min(default, policy.timeout_s)
+
+
+def requests_kwargs() -> dict:
+    """Extra ``requests.post`` kwargs: a 307/308 is an answer, never a second POST the policy cannot see."""
+    return {} if _current.get() is None else {'allow_redirects': False}
+
+
+def stt_requests_kwargs() -> dict:
+    """Extra ``requests.post`` kwargs of a native STT upload: no redirect (:func:`requests_kwargs`), ``stream=True`` (Requests
+    returns after the headers instead of reading the whole answer) and the response hook that buffers the answer under the
+    1 MiB cap with identity enforced. The hook is what runs BEFORE Requests' redirect step (see
+    :mod:`tools.native_response_bounds`); the caller's parser then reads the bounded bytes."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    from tools.native_response_bounds import requests_response_hook
+    return {'allow_redirects': False, 'stream': True,
+            'hooks': {'response': [requests_response_hook(response_limit(1 << 20), buffer=True)]}}
+
+
+def tts_requests_kwargs(default_limit: int) -> dict:
+    """Extra ``requests.post`` kwargs of a native REST TTS send: the redirect-is-an-answer rule of :func:`requests_kwargs`
+    plus the response hook (liveness, identity, declared length, a redirect-class answer refused unread). The body itself is
+    streamed by the caller under :func:`response_limit`."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    from tools.native_response_bounds import requests_response_hook
+    return {'allow_redirects': False,
+            'hooks': {'response': [requests_response_hook(response_limit(default_limit), buffer=False)]}}
+
+
+def rest_headers(headers: dict) -> dict:
+    """Request headers for a native REST send: the body is REQUESTED uncompressed. That is only a request: a peer may ignore
+    it, so the enforcement is the response side (:func:`tools.native_response_bounds.refuse_nonidentity` refuses a
+    nonidentity answer before any decoder runs). Outside a native call the headers are returned untouched."""
+    return headers if _current.get() is None else {**headers, 'Accept-Encoding': 'identity'}
+
+
+def response_limit(default: int) -> int:
+    """Body cap for a REST answer: the stock limit, never above the native output cap. The read is chunk-granular
+    (64 KiB reads), so this bounds what is kept to the limit plus one chunk; it is not an allocation-hard heap cap."""
+    policy = _current.get()
+    cap = None if policy is None else policy.max_output_bytes
+    return default if cap is None else min(default, cap)
+
+
+def bounded_stream(chunks: Iterable[bytes]) -> Iterator[bytes]:
+    """Pass audio chunks through; inside a native call, refuse a body over the policy's byte cap."""
+    policy = _current.get()
+    limit = None if policy is None else policy.max_output_bytes
+    written = 0
+    for chunk in chunks:
+        written += len(chunk)
+        if limit is not None and written > limit:
+            raise refuse('too_long')
+        yield chunk
+
+
+def prove_injected(sender: Any, injected: Any) -> None:
+    """Inside a native call: refuse UNSENT unless the SDK sends through exactly the instance that carries
+    the hook. Outside one: nothing to prove."""
+    if _current.get() is not None and (injected is None or sender is not injected):
+        raise refuse('unsupported')
+
+
+def openai_client_kwargs(configured_timeout: Optional[float] = None) -> dict:
+    """Extra ``OpenAI(...)`` kwargs: explicit timeout, zero SDK retries, no redirects, the send hook on the real client and
+    the answer bound + identity enforcement on its response (before the SDK or its JSON layer buffers the body)."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    from openai import DefaultHttpxClient
+    timeout = policy.timeout_s if configured_timeout is None else min(configured_timeout, policy.timeout_s)
+    hooks: dict = {'request': [policy.on_request]}
+    if policy.max_output_bytes is not None:  # STT: the 1 MiB answer cap; TTS: the chunk audio cap. Before the SDK reads the body
+        hooks['response'] = [_bounded_answer(policy.max_output_bytes)]
+    http_client = policy.track(DefaultHttpxClient(timeout=timeout, follow_redirects=False, event_hooks=hooks,
+                                                  headers={'Accept-Encoding': 'identity'}))
+    return {'timeout': timeout, 'max_retries': 0, 'http_client': http_client}
+
+
+def elevenlabs_client_kwargs() -> dict:
+    """Extra ``ElevenLabs(...)`` kwargs: explicit timeout, the send hook on the httpx client it must use and the answer bound
+    + identity enforcement on its response."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import httpx
+    hooks: dict = {'request': [policy.on_request]}
+    if policy.max_output_bytes is not None:
+        hooks['response'] = [_bounded_answer(policy.max_output_bytes)]
+    http_client = policy.track(httpx.Client(timeout=policy.timeout_s, follow_redirects=False, event_hooks=hooks,
+                                            headers={'Accept-Encoding': 'identity'}))
+    return {'timeout': policy.timeout_s, 'httpx_client': http_client}
+
+
+def native_transport():
+    """The :class:`agent.native_once.NativeTransport` handed to an opted-in plugin: a plain httpx client (httpx's
+    default transport makes no automatic retry) with redirects disabled, the call's timeout, the send gate on every
+    request and the answer bound on every response. The client asks for ``Accept-Encoding: identity`` and the response hook
+    REFUSES any nonidentity ``Content-Encoding`` before the body is read or decoded (a plugin that ignores identity-only
+    answers cannot be served by this transport), refuses an advertised oversize body unread and bounds the rest per
+    underlying chunk (chunk-granular, not an allocation-hard cap; Stop/the deadline are checked between chunks). Tracked, so
+    the seam closes it whatever the plugin did."""
+    policy = _current.get()
+    if policy is None or policy.max_output_bytes is None:
+        raise refuse('unsupported')
+    import httpx
+    from agent.native_once import NativeTransport
+    client = policy.track(httpx.Client(timeout=policy.timeout_s, follow_redirects=False,
+                                       event_hooks={'request': [policy.on_request],
+                                                    'response': [_bounded_answer(policy.max_output_bytes)]},
+                                       headers={'Accept-Encoding': 'identity'}))
+    return NativeTransport(client=client)
+
+
+def elevenlabs_request_options() -> Optional[dict]:
+    policy = _current.get()
+    return None if policy is None else {'max_retries': 0, 'timeout_in_seconds': policy.timeout_s}
+
+
+_JSON_ENVELOPE_BYTES = 4096  # a base64 audio body is wrapped in a small JSON object
+
+
+def _bounded_answer(limit: int) -> Callable[[Any], None]:
+    """httpx ``response`` event hook, run BEFORE the client's eager body read: a nonidentity ``Content-Encoding`` is refused on
+    the headers (no decoder ever sees the body), an advertised ``Content-Length`` over ``limit`` is refused with zero body
+    reads, and otherwise the body is refused once it exceeds ``limit`` bytes whether or not its length was declared (the SDK
+    reads it whole, so nothing else bounds it). A declared length is an early-rejection aid, never proof. Stop/the deadline are
+    checked between chunks (never a callback or a send); a read already blocked in the stream is not preempted.
+
+    With the encoding rule the stream is undecoded, so the check is per underlying stream chunk: the data kept is at most
+    ``limit`` plus the one chunk that crosses it. That is NOT an allocation-hard heap cap. The clients built here also ask
+    for ``Accept-Encoding: identity``, but that request is not what enforces anything."""
+    from tools.native_response_bounds import refuse_nonidentity
+
+    def hook(response) -> None:
+        check_alive()
+        refuse_nonidentity(response.headers.get('content-encoding'))
+        declared = response.headers.get('content-length', '')
+        if declared.isdigit() and int(declared) > limit:
+            raise refuse('too_long')
+        iter_bytes = response.iter_bytes
+
+        def bounded(chunk_size=None):
+            total = 0
+            for chunk in iter_bytes(chunk_size):
+                check_alive()  # Stop/deadline between chunks; a read already blocked in the stream is not preempted
+                total += len(chunk)
+                if total > limit:
+                    raise refuse('too_long')
+                yield chunk
+        response.iter_bytes = bounded
+    return hook
+
+
+class _InertAsyncClient:
+    """The ``async_client`` of a native Mistral SDK object. The SDK builds an ``httpx.AsyncClient`` we never use and its
+    finalizer would close that client on whatever loop is running when the SDK object is collected. A supplied client is
+    never closed by the SDK, and this one owns no resource: every async path is refused (an async send would be a send the
+    gate never saw)."""
+
+    async def send(self, request, **_options):
+        raise refuse('unsupported')
+
+    def build_request(self, method, url, **_options):
+        raise refuse('unsupported')
+
+    async def aclose(self) -> None:
+        return None
+
+
+def mistral_client_kwargs(*, base64_audio: bool = False) -> dict:
+    """Extra ``Mistral(...)`` kwargs: explicit timeout, zero SDK retries, no redirects, the send hook on the very
+    client it must use, the answer bounded on the wire (identity enforced, see :func:`_bounded_answer`), an inert async
+    client (the SDK's own would be finalized on a loop) and no SDK debug log (which would print keys and bodies).
+
+    ``base64_audio``: the answer is JSON carrying the base64 audio, so the cap is that of the audio, encoded."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import httpx
+    from mistralai.client.utils.logger import NoOpLogger
+    timeout_ms = max(1, round(policy.timeout_s * 1000))
+    hooks: dict = {'request': [policy.on_request]}
+    if policy.max_output_bytes is not None:
+        limit = policy.max_output_bytes
+        hooks['response'] = [_bounded_answer((limit + 2) // 3 * 4 + _JSON_ENVELOPE_BYTES if base64_audio else limit)]
+    http_client = policy.track(httpx.Client(timeout=timeout_ms / 1000, follow_redirects=False, event_hooks=hooks,
+                                            headers={'Accept-Encoding': 'identity'}))
+    return {'client': http_client, 'async_client': _InertAsyncClient(), 'timeout_ms': timeout_ms, 'retry_config': None,
+            'debug_logger': NoOpLogger()}
+
+
+def mistral_request_options(client: Any, injected: dict, *endpoints: Callable, needs: Iterable[str] = ()) -> dict:
+    """Per-call options for the pinned Mistral SDK; refuses UNSENT, before the invocation is entered, unless the
+    installed SDK sends through the injected client and every endpoint can be told zero retries and an explicit
+    timeout (and takes every request field in ``needs``). Disables the SDK's opt-in trace exporter, a second
+    outbound path the gate would never see. Outside a native call: nothing.
+
+    The ``telemetry`` read-back below is NOT proof the SDK honours the switch (the pinned 2.4.8 configuration is a plain
+    object that reads back whatever was assigned). The proof is the SDK's own ``getattr`` of the attribute plus the
+    behavioural exporter test in ``tests/gateway/test_native_voice_mistral_fences.py``, which must run on any SDK change."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    config = getattr(client, 'sdk_configuration', None)
+    prove_injected(getattr(config, 'client', None), injected.get('client'))
+    required = {'retries', 'timeout_ms', *needs}
+    for endpoint in endpoints:
+        if not required <= inspect.signature(endpoint).parameters.keys():
+            raise refuse('unsupported')
+    config.telemetry = False
+    if getattr(config, 'telemetry', None) is not False:
+        raise refuse('unsupported')
+    return {'retries': None, 'timeout_ms': injected['timeout_ms']}
+
+
+def edge_communicate_kwargs() -> dict:
+    """Extra ``edge_tts.Communicate(...)`` kwargs: every websocket handshake passes the gate, so the
+    library's own 403 re-handshake (a second send) is refused, and the timeouts are explicit."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import aiohttp
+
+    class GatedConnector(aiohttp.TCPConnector):
+        async def connect(self, req, traces, timeout):
+            policy.begin()
+            return await super().connect(req, traces, timeout)
+    return {'connector': GatedConnector(), 'connect_timeout': max(1, int(min(10, policy.timeout_s))),
+            'receive_timeout': max(1, int(policy.timeout_s))}
