+"""Stock STT/TTS provider transport behaviour that the native voice seam must not share.
+
+Measured on the real OpenAI SDK + httpx client with only the network transport replaced
+(``tests/gateway/native_voice_support.py``). The numbers are observations of the retained stock
+paths: the native seam (``gateway.session_native_voice``) is held to exactly one request, and
+these controls prove that its transport policy never leaks into the ordinary ``transcribe_audio``
+/ ``text_to_speech_tool`` paths when no native call is active.
+"""
+import asyncio
+import json
+import threading
+
+import httpx
+import pytest
+
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+STT_CONFIG = {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                      'openai': {'api_key': 'sk-synthetic-stt', 'model': 'whisper-1'}}}
+TTS_CONFIG = {'tts': {'provider': 'openai', 'openai': {'api_key': 'sk-synthetic-tts'}}}
+
+
+def measured(label, **values):
+    print('NATIVE_VOICE_STOCK_MEASURE ' + json.dumps({'label': label, **values}, sort_keys=True))
+
+
+@pytest.fixture
+def stt(monkeypatch, tmp_path):
+    support.write_config(get_hermes_home(), STT_CONFIG)
+    monkeypatch.setattr('tools.transcription_cloud._transcode_audio_for_stt',
+                        lambda path, work: (None, 'transcode unavailable'))
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+def test_stock_stt_success_sends_one_request(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('ok', {'text': 'hello world', 'json': False})])
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert result['success'] and result['transcript'] == 'hello world'
+    assert wire.count == 1
+    measured('stock_stt_success', requests=wire.count, timeouts=[str(t) for t in wire.timeouts()])
+
+
+def test_stock_stt_resends_after_provider_5xx(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert not result['success']
+    assert wire.count >= 2, 'the stock path re-sends a request the provider may already have accepted'
+    measured('stock_stt_5xx_without_transcode', requests=wire.count)
+
+
+def test_stock_stt_resends_after_5xx_and_a_successful_transcode(monkeypatch, tmp_path, stt):
+    import shutil
+    from tools.transcription_tools import transcribe_audio
+
+    def transcode(path, work):
+        out = f'{work}/clip.m4a'
+        shutil.copyfile(path, out)
+        return out, None
+    monkeypatch.setattr('tools.transcription_cloud._transcode_audio_for_stt', transcode)
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert not result['success']
+    assert wire.count >= 2
+    measured('stock_stt_5xx_with_transcode_retry', requests=wire.count)
+
+
+def test_stock_stt_resends_after_connection_reset(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('raise', httpx.ReadError('synthetic reset'))] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert not result['success']
+    assert wire.count >= 2
+    measured('stock_stt_connection_reset', requests=wire.count)
+
+
+def test_stock_stt_uses_the_configured_timeout_and_one_sdk_retry(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        transcribe_audio(stt)
+    timeouts = {tuple(sorted((t or {}).items())) for t in wire.timeouts()}
+    measured('stock_stt_transport_settings', timeouts=sorted(str(t) for t in timeouts))
+    assert all(t and t['read'] == 60.0 for t in wire.timeouts())
+
+
+def test_stock_tts_resends_after_provider_5xx(monkeypatch):
+    from tools.tts_tool import text_to_speech_tool
+    support.write_config(get_hermes_home(), TTS_CONFIG)
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = json.loads(text_to_speech_tool('hello world'))
+    assert not result['success']
+    assert wire.count >= 2
+    measured('stock_tts_openai_5xx', requests=wire.count,
+             timeouts=sorted({str(t) for t in wire.timeouts()}))
+
+
+def stock_elevenlabs():
+    pytest.importorskip('elevenlabs')
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs'}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+
+
+def test_stock_elevenlabs_request_count_and_timeout_are_measured_not_assumed(monkeypatch):
+    """The REAL pinned ``elevenlabs`` SDK (overlay wheel 1.59.0) builds its own httpx client and, with no
+    ``request_options``, does not retry: observed, not assumed (the design assumed unpinned defaults)."""
+    stock_elevenlabs()
+    from tools.tts_tool import text_to_speech_tool
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = json.loads(text_to_speech_tool('hello world'))
+    assert not result['success'] and wire.count >= 1
+    measured('stock_tts_elevenlabs_5xx', requests=wire.count, timeouts=sorted({str(t) for t in wire.timeouts()}))
+
+
+def test_stock_elevenlabs_read_timeout_is_not_resent_and_a_stall_blocks_until_released(monkeypatch):
+    stock_elevenlabs()
+    from tools.tts_tool import text_to_speech_tool
+    wire = support.Wire([('raise', httpx.ReadTimeout('synthetic timeout'))] * 4)
+    with support.provider_wire(monkeypatch, wire):
+        assert not json.loads(text_to_speech_tool('hello world'))['success']
+    reads = wire.count
+    release = threading.Event()
+    held = support.Wire([('ok', {'audio': b'ID3held'})], hold=release)
+    outcome = []
+    with support.provider_wire(monkeypatch, held):
+        worker = threading.Thread(target=lambda: outcome.append(json.loads(text_to_speech_tool('hello world'))))
+        worker.start()
+        assert held.entered.wait(10)
+        worker.join(1.0)
+        still_blocked = worker.is_alive()  # no deadline of its own: the stock call waits for the transport
+        release.set()
+        worker.join(30)
+    assert still_blocked and not worker.is_alive() and outcome and outcome[0]['success']
+    measured('stock_tts_elevenlabs_timeout_and_stall', read_timeout_requests=reads, blocked_after_1s=still_blocked,
+             effective_timeouts=sorted({str(t) for t in held.timeouts()}))
+
+
+@pytest.mark.asyncio
+async def test_stock_edge_resends_after_a_403_handshake_over_the_real_client_stack(monkeypatch):
+    """The REAL ``edge_tts`` 7.2.7 + aiohttp client; only the socket is synthetic (no service connection)."""
+    pytest.importorskip('edge_tts')
+    from tools.tts_tool import text_to_speech_tool
+    boundary = await support.EdgeBoundary([403, 'ok']).start(monkeypatch)
+    try:
+        result = json.loads(await asyncio.to_thread(text_to_speech_tool, 'hello world'))
+    finally:
+        await boundary.stop()
+    assert result['success'] and boundary.handshakes == 2, 'the stock library re-handshakes after a 403'
+    measured('stock_tts_edge_403_then_ok', handshakes=boundary.handshakes)
