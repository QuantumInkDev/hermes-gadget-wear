@@ -0,0 +1,388 @@
+"""Native voice seam: configured speech-to-text sent once, truthful outcomes, no leaks.
+
+Real OpenAI SDK, real httpx client and real ``requests`` session over a synthetic network transport
+(``native_voice_support``); the profile's STT configuration is the real ``config.yaml`` read at call
+time. Counts below are requests that reached the transport. The stock-path counterparts (2 and 4
+requests for the same failures) are recorded in ``tests/tools/test_native_voice_stock_transport.py``.
+"""
+import asyncio
+import logging
+import threading
+import time
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+
+KEY = 'sk-synthetic-native-stt'
+
+
+def openai_config(**stt):
+    return {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                    'openai': {'api_key': KEY, 'model': 'whisper-1'}, **stt}}
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def configured():
+    support.write_config(get_hermes_home(), openai_config())
+
+
+async def seam(clip, callbacks, deadline_s=30):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                         deadline_s=deadline_s)
+
+
+def words(text='hello world'):
+    return ('ok', {'text': text, 'json': False})
+
+
+@pytest.mark.asyncio
+async def test_configured_success_sends_once_after_before_send(monkeypatch, clip, configured):
+    events = []
+    cb = support.Callbacks(events)
+    wire = support.Wire([words()], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'hello world', 'configured', 'completed')
+    assert wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    assert wire.requests[0].headers['authorization'] == f'Bearer {KEY}'
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('failure', [
+    ('status', 500), ('status', 503), ('raise', httpx.ReadError('synthetic reset')),
+    ('raise', httpx.ConnectError('synthetic')), ('raise', httpx.ReadTimeout('synthetic'))],
+    ids=['5xx', '503', 'reset', 'connect', 'timeout'])
+async def test_provider_failure_is_not_resent(monkeypatch, clip, configured, failure):
+    cb = support.Callbacks()
+    wire = support.Wire([failure] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert wire.count == 1
+    assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+    assert cb.before_send_calls == 1
+
+
+@pytest.mark.asyncio
+async def test_no_post_answer_transcode_retry_and_configured_retries_are_overridden(monkeypatch, clip):
+    support.write_config(get_hermes_home(), openai_config(openai={'api_key': KEY, 'max_retries': 5, 'timeout': 600}))
+    transcodes = []
+
+    def transcode(path, work):
+        transcodes.append(path)
+        return None, 'unreachable'
+    monkeypatch.setattr('tools.transcription_cloud._transcode_audio_for_stt', transcode)
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, support.Callbacks(), deadline_s=45)
+    assert wire.count == 1 and transcodes == []
+    assert result.state == 'failed'
+    assert {t['read'] for t in wire.timeouts()} == {45.0}  # explicit: min(configured 600, deadline 45)
+
+
+@pytest.mark.asyncio
+async def test_request_timeout_is_the_policy_cap_not_the_sdk_default(monkeypatch, clip, configured):
+    wire = support.Wire([words()])
+    with support.provider_wire(monkeypatch, wire):
+        await seam(clip, support.Callbacks(), deadline_s=300)
+    assert {t['read'] for t in wire.timeouts()} == {60.0}
+
+
+@pytest.mark.asyncio
+async def test_empty_and_too_long_transcripts_are_stable_outcomes(monkeypatch, clip, configured):
+    for body, state in (('   ', 'empty'), ('x' * 4001, 'too_long'), ('😀' * 4001, 'too_long')):
+        wire = support.Wire([words(body)])
+        with support.provider_wire(monkeypatch, wire):
+            result = await seam(clip, support.Callbacks())
+        assert (result.state, result.transcript, result.provider, wire.count) == (state, None, 'completed', 1)
+    wire = support.Wire([words('é' * 4000)])  # 4,000 code points, 8,000 bytes: within both bounds
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 4000)])  # 4,000 code points but 16,000 bytes
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 4001)])
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'too_long'
+
+
+@pytest.mark.asyncio
+async def test_transcript_byte_bound_is_enforced_separately(monkeypatch, clip, configured):
+    wire = support.Wire([words('€' * 3000 + 'a' * 1000)])  # 4,000 code points, 10,000 bytes: fine
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('€' * 3000 + '😀' * 1000)])  # 4,000 code points, 13,000 bytes: fine
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 3999 + '€' * 1)])  # 4,000 code points, 15,999 bytes: fine
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'transcribed'
+    wire = support.Wire([words('😀' * 3999 + '€€')])  # 4,001 code points
+    with support.provider_wire(monkeypatch, wire):
+        assert (await seam(clip, support.Callbacks())).state == 'too_long'
+
+
+@pytest.mark.asyncio
+async def test_unacceptable_input_never_reaches_the_provider(monkeypatch, tmp_path, configured):
+    wire = support.Wire([words()])
+    cb = support.Callbacks()
+    huge = tmp_path / 'huge.wav'
+    huge.write_bytes(b'\0' * (2 * 1024 * 1024 + 1))
+    empty = tmp_path / 'empty.wav'
+    empty.write_bytes(b'')
+    real = support.write_wav(tmp_path / 'real.wav')
+    link = tmp_path / 'link.wav'
+    link.symlink_to(real)
+    with support.provider_wire(monkeypatch, wire):
+        for path in (str(huge), str(empty), str(link), str(tmp_path / 'missing.wav'), str(tmp_path), '', 'a\0b'):
+            result = await seam(path, cb)
+            assert (result.state, result.provider) == ('refused', 'not_started'), path
+        with pytest.raises(Exception, match='invalid_params'):
+            await transcribe_native_once(real, authorize=cb.authorize, before_send=cb.before_send, deadline_s=0)
+        with pytest.raises(Exception, match='invalid_params'):
+            await transcribe_native_once(real, authorize=None, before_send=cb.before_send, deadline_s=5)
+    assert wire.count == 0 and cb.before_send_calls == 0
+
+
+@pytest.mark.asyncio
+async def test_before_send_refusal_sends_nothing(monkeypatch, clip, configured, caplog):
+    caplog.set_level(logging.DEBUG)
+    cb = support.Callbacks(refuse_before_send=True)
+    wire = support.Wire([words()])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.provider) == ('refused', None, 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 1
+    assert support.SECRET not in repr(result) + caplog.text
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('call, sent, provider', [(1, 0, 'not_started'), (2, 0, 'not_started'), (3, 1, 'completed')],
+                         ids=['before-work', 'at-the-send-gate', 'after-the-await'])
+async def test_authorize_refusal_at_each_point_withholds_the_result(monkeypatch, clip, configured, call, sent, provider):
+    cb = support.Callbacks(refuse_authorize_at=call)
+    wire = support.Wire([words('must not be returned')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.provider) == ('refused', None, provider)
+    assert wire.count == sent
+    assert cb.before_send_calls == (1 if sent else 0)
+
+
+@pytest.mark.asyncio
+async def test_a_stop_signalled_through_authorize_is_cancelled_not_refused(monkeypatch, clip, configured):
+    cb = support.Callbacks(refuse_authorize_at=2, authorize_error=asyncio.CancelledError())
+    wire = support.Wire([words()])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.provider, wire.count) == ('cancelled', 'not_started', 0)
+
+
+@pytest.mark.asyncio
+async def test_deadline_ends_the_wait_and_claims_nothing_about_the_provider(monkeypatch, clip, configured):
+    release = threading.Event()
+    wire = support.Wire([words()], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            result = await seam(clip, support.Callbacks(), deadline_s=0.5)
+    finally:
+        release.set()
+    assert (result.state, result.transcript, result.source, result.provider) == ('timeout', None, None, 'unknown')
+    assert wire.count == 1
+
+
+@pytest.mark.asyncio
+async def test_task_cancellation_propagates_and_fences_the_worker(monkeypatch, clip, configured):
+    release = threading.Event()
+    wire = support.Wire([words()], hold=release)
+    task = asyncio.create_task(seam(clip, support.Callbacks()))
