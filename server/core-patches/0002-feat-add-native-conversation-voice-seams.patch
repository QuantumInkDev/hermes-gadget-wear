+def test_the_credential_hook_converts_the_sticky_refusal_to_a_phase_stop():
+    policy = _policy()
+    policy.set_credential_probe(lambda: (_ for _ in ()).throw(NativeSendRefused('refused')))
+    with pytest.raises(native_send_policy.CredentialPhaseStopped):
+        policy.on_credential_request(None)
+    with pytest.raises(native_send_policy.CredentialPhaseStopped) as later:
+        policy.on_credential_request(None)
+    assert later.value.reason == 'closed'
