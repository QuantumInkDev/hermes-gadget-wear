+"""Native voice seam, STT PREPARATION (AUX-audio): the cloud pre-upload probe / trim / CAF / full compaction run only as
+launcher-wrapped, Stop-aware, bounded children, and an unusable optional capability never changes the unchanged full upload.
+
+REAL: the pinned OpenAI SDK + httpx (synthetic bytes only), the real runner / process group / pipes, the NEW owned approved
+ffmpeg/ffprobe for every valid conversion and measurement. HARNESS, stated plainly: the qualified network-deny launcher is a hashed
+stand-in (``launcher_passthrough.py`` / ``launcher_faulty.py``; NOT a sandbox, NOT launcher qualification) and ``afconvert`` is a
+labelled stand-in (an empty 0755 file that is never executed: the faulty launcher substitutes the owned ffmpeg); the host
+``afconvert`` and the Homebrew ffmpeg are never executed (``COMMON_LOCAL_BIN_DIRS`` is bound to ``()``). Tests marked LOWERED-LIMIT patch a
+provider byte cap to reach the fitting / still-over branches with a small file; they are NOT production reachability. The one test
+marked PRODUCTION uses a real owned compressed recording under the 2 MiB native cap that is beyond the actual default duration cap.
+"""
+import asyncio
+import os
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from gateway.session_native_voice import transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway.mistral_voice_support import watch_worker
+from tests.waiting import async_wait_until
+
+KEY = 'sk-synthetic-prep'
+STOCK_RUNNER = 'stock runner reached inside a native call'
+
+
+def config(**stt):
+    section = {'provider': 'openai', 'openai': {'api_key': KEY, 'model': 'whisper-1'}}
+    section.update(stt)
+    return {'stt': section}
+
+
+def words(text='hello world'):
+    return ('ok', {'text': text, 'json': False})
+
+
+async def hear(clip, callbacks, deadline_s=60):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+@pytest.fixture(autouse=True)
+def owned_tools(monkeypatch):
+    """Only the NEW owned approved ffmpeg/ffprobe on PATH: the Homebrew candidates of the STT discovery are bound away."""
+    support.ffmpeg_path()
+    support.ffprobe_path()
+    monkeypatch.setattr('tools.transcription_audio.COMMON_LOCAL_BIN_DIRS', ())
+
+
+@pytest.fixture
+def scratch(tmp_path, monkeypatch):
+    return support.private_tmp(tmp_path, monkeypatch)
+
+
+@pytest.fixture
+def stock_runner(monkeypatch):
+    """TRIPWIRE: the stock unwrapped runner must never be reached by a native call."""
+    from tools import transcription_audio
+    calls = []
+
+    def tripwire(command, **kwargs):
+        calls.append(command)
+        raise AssertionError(STOCK_RUNNER)
+    monkeypatch.setattr(transcription_audio, '_run_quiet', tripwire)
+    yield calls
+    # TEARDOWN: the stock trim/probe bodies swallow the tripwire's own AssertionError, so the record is what must stay empty
+    assert calls == [], STOCK_RUNNER
+
+
+def children(spawns, stand_in=support.PASSTHROUGH):
+    """(program name, spawn) of every launcher-wrapped child, in spawn order (ffmpeg, ffprobe and the afconvert stand-in)."""
+    wrapped = [s for s in spawns if isinstance(s['args'], list) and len(s['args']) > 5 and str(stand_in) in s['args'][:2]]
+    return [(os.path.basename(support.program_of(s)), s) for s in wrapped]
+
+
+def names(spawns, stand_in=support.PASSTHROUGH):
+    return [name for name, _ in children(spawns, stand_in)]
+
+
+def afconvert_stand_in(monkeypatch, tmp_path):
+    path = tmp_path / 'afconvert'
+    path.write_bytes(b'')  # never executed: the faulty launcher substitutes the owned ffmpeg
+    path.chmod(0o755)
+    real = shutil.which
+    monkeypatch.setattr(shutil, 'which', lambda name, *a, **k: str(path) if name == 'afconvert' else real(name, *a, **k))
+    return str(path)
+
+
+def tone_wav(path, seconds=14.0):
+    """A 16 kHz mono PCM tone (NOT silence, so the compact STT m4a is a real ~4 KB/s size)."""
+    return support.tone_and_silence_wav(path, tone_s=seconds, silence_s=0.0)
+
+
+def long_low_bitrate_mp3(path):
+    """700 s of 16 kHz mono sine at 16 kbps by the owned ffmpeg (~1.4 MB): bounded fast generation, no wall-clock wait."""
+    subprocess.run([support.ffmpeg_path(), '-loglevel', 'error', '-y', '-f', 'lavfi', '-i', 'sine=frequency=300:duration=700:sample_rate=16000',
+                    '-ac', '1', '-b:a', '16k', str(path)], check=True, capture_output=True, timeout=120, stdin=subprocess.DEVNULL)
+    return path
+
+
+def caf(path, seconds=1.0):
+    subprocess.run([support.ffmpeg_path(), '-loglevel', 'error', '-y', '-f', 'lavfi', '-i',
+                    f'sine=frequency=440:duration={seconds}:sample_rate=16000', '-ac', '1', '-c:a', 'pcm_s16le', '-f', 'caf',
+                    str(path)], check=True, capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
+    return str(path)
+
+
+class Upload:
+    """What the one send carried: tapped from the request before the synthetic provider answers."""
+
+    def __init__(self):
+        self.bodies = []
+
+    def __call__(self, request):
+        self.bodies.append(request.read())
+
+    @property
+    def is_m4a(self):
+        return b'ftyp' in self.bodies[-1]
+
+    @property
+    def is_wav(self):
+        return b'RIFF' in self.bodies[-1] and b'ftyp' not in self.bodies[-1]
+
