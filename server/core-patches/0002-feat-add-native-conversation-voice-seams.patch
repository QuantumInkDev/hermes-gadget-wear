+async def test_a_redirect_class_rest_tts_answer_is_refused_before_requests_reads_or_decodes_it(monkeypatch, out, name, kind):
+    """Requests' ``resolve_redirects`` evaluates ``response.content`` of a 3xx with ``Location`` (a whole, decoded read) even
+    with ``allow_redirects=False``. The native hook refuses first: zero body bytes pulled, no decoder entered, closed, exactly
+    one send, ``failed_after_send``."""
+    import urllib3.response
+    from tests.gateway.native_voice_support import RawWire
+    CASES[name]['profile']()
+    entered = []
+    real = urllib3.response.GzipDecoder.decompress
+    monkeypatch.setattr(urllib3.response.GzipDecoder, 'decompress', lambda self, *a, **k: entered.append(1) or real(self, *a, **k))
+    headers = {'Location': 'https://redirect.invalid/elsewhere', 'Content-Type': 'application/octet-stream'}
+    if kind == 'declared-oversize':
+        headers['Content-Length'] = str(16 * 1024 * 1024 + 1)
+        body = b'\0' * (16 * 1024 * 1024 + 1)
+    elif kind == 'absent-length':
+        body = b'\0' * (2 * 1024 * 1024)
+    else:
+        headers['Content-Encoding'] = 'gzip'
+        body = rest.gzipped(b'\0' * (2 * 1024 * 1024))
+    wire = RawWire(307, headers, body)
+    import requests
+    adapter = wire.adapter()
+    monkeypatch.setattr(requests.Session, 'get_adapter', lambda self, url: adapter)
+    cb = support.Callbacks()
+    result = await speak(out, cb)
+    expected = 'too_long' if kind == 'declared-oversize' else 'failed'  # the response bound maps to the existing too_long state
+    assert (outcome(result), wire.count, cb.before_send_calls) == ((expected, None, 'failed_after_send'), 1, 1)
+    assert wire.body.pulled == 0 and wire.body.closed and entered == [] and os.listdir(out) == []
