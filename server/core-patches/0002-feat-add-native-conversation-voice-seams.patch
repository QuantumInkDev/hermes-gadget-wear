+def configure_rig_home(tmp_path, cap=None):
+    support.write_config(tmp_path, {'tts': elevenlabs_tts('A', cap)})
+    (tmp_path / '.env').write_text(f"ELEVENLABS_API_KEY={PROFILES['A']['key']}\n")
