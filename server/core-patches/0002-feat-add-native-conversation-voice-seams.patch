+# ---- NeuTTS compatibility: engine-scoped rows, simultaneous normal+fork, conditional load modules ------------------------
+# An ordinary NeuTTS 1.4.1 installation per NeuTTS's OWN METADATA (Requires-Dist transformers==5.1.0, phonemizer>=3.0.0 =
+# the NORMAL distribution); the Kitten lock set is transformers 5.17.0 + phonemizer-fork. A distribution a test does not name is
+# installed at an arbitrary version, except phonemizer-fork, which is absent unless named.
+ORDINARY_NEUTTS = {'neutts': '1.4.1', 'transformers': '5.1.0', 'phonemizer': '3.4.0', 'neucodec': '0.0.4',
+                   'huggingface-hub': '1.24.0'}
+KITTEN_LOCK = {'kittentts': '0.8.1', 'misaki': '0.9.4', 'num2words': '0.5.14', 'espeakng-loader': '0.2.4',
+               'transformers': '5.17.0', 'phonemizer-fork': '3.3.2', 'huggingface-hub': '1.24.0'}
+VENDOR = ('neutts', 'neutts.neutts', 'neucodec', 'transformers', 'phonemizer', 'phonemizer.backend', 'torch', 'torchaudio',
+          'librosa', 'llama_cpp', 'perth', 'soundfile')
+STAGES = ('hub', 'package_dir', 'preflight', 'synth')
+
+
+class World:
+    """A synthetic installation seen only through the helper's metadata and spec probes; every probe is recorded."""
+
+    def __init__(self, versions, absent_distributions=(), absent_modules=()):
+        self.versions, self.absent_distributions = dict(versions), set(absent_distributions)
+        self.absent_modules, self.events = set(absent_modules), []
+
+    def version_of(self, distribution):
+        self.events.append(('metadata', distribution))
+        fork_unnamed = distribution == 'phonemizer-fork' and distribution not in self.versions
+        if distribution in self.absent_distributions or fork_unnamed:
+            raise importlib.metadata.PackageNotFoundError(distribution)
+        return self.versions.get(distribution, '9.9.9')
+
+    def find(self, name):
+        self.events.append(('find', name))
+        return name not in self.absent_modules
+
+
+def probes_then_stages(events):
+    """Every metadata/spec probe precedes the first cache/package/preflight/synthesis step (and none follows it)."""
+    kinds = [event[0] for event in events]
+    first = next((i for i, kind in enumerate(kinds) if kind in STAGES), len(kinds))
+    return all(kind in ('metadata', 'find') for kind in kinds[:first]) and not {'metadata', 'find'} & set(kinds[first:])
+
+
+def neutts_boundary(monkeypatch, tmp_path, hub, world, interpreter=(3, 13), **options):
+    """LABELLED SYNTHETIC ENGINE BOUNDARY (source wiring only: not a genuine 3.13, model, cache, closure or inference). The REAL
+    ``helper.run`` routes over an injected metadata/spec world and the existing synthetic cache tree; the helper's module-level
+    ``sys`` is a stand-in carrying only a synthetic ``version_info``; vendor modules are None in ``sys.modules`` so any import
+    would fail; ``_synthesize_neutts`` records its call and writes a small non-vendor WAV."""
+    opts, pkg, _ = neutts_world(tmp_path, hub)
+    real_preflight, events = helper.preflight_neutts, world.events
+    for name in VENDOR:
+        monkeypatch.setitem(sys.modules, name, None)
+    monkeypatch.setattr(helper, 'sys',
+                        types.SimpleNamespace(version_info=(*interpreter, 0, 'final', 0), platform=sys.platform))
+    monkeypatch.setattr(helper, '_installed', world.find)
+    monkeypatch.setattr(helper, '_version_of', world.version_of)
+    monkeypatch.setattr(helper, 'package_dir',
+                        lambda name: (events.append(('package_dir', name)), pkg if name == 'neutts' else None)[1])
+    monkeypatch.setattr(helper, 'HubCache', lambda: (events.append(('hub',)), hub)[1])
+    monkeypatch.setattr(helper, 'preflight_neutts', lambda o, h, p, perth: (
+        events.append(('preflight',)), real_preflight(o, h, p, perth, version=(3, 13)))[1])
+
+    def synthesize(req, resolved):
+        events.append(('synth', dict(req['neutts']), resolved))
+        Path(req['wav_path']).write_bytes(b'RIFF' + bytes(100))
+        return 24000
+    monkeypatch.setattr(helper, '_synthesize_neutts', synthesize)
+    req = json.loads(request(tmp_path, 'neutts'))
+    req['neutts'] = {**opts, **options}
+    return helper.parse_request(json.dumps(req).encode())
+
