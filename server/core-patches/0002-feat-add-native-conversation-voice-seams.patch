@@ -0,0 +1,323 @@
+"""Native voice seam: configured text-to-speech, one request per chunk, stop at the first failed chunk.
+
+Real OpenAI SDK, real httpx client over a synthetic network transport; the profile's TTS
+configuration is the real ``config.yaml`` read at call time. The ElevenLabs and Edge engines run against
+the REAL pinned SDKs in ``test_native_voice_sdk_boundaries``.
+"""
+import asyncio
+import logging
+import os
+import threading
+from pathlib import Path
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import speakable_text, synthesize_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-native-tts'
+SENTENCES = ('The first sentence is deliberately rather long. ', 'The second sentence is also fairly long here. ',
+             'The third sentence closes out the whole text.')
+LONG_TEXT = ''.join(SENTENCES)
+
+
+def openai_config(max_text_length=None, **openai):
+    section = {'api_key': KEY, 'model': 'gpt-4o-mini-tts', 'voice': 'nova', **openai}
+    if max_text_length:
+        section['max_text_length'] = max_text_length
+    return {'tts': {'provider': 'openai', 'openai': section}}
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def configured():
+    support.write_config(get_hermes_home(), openai_config())
+
+
+@pytest.fixture
+def joined(monkeypatch):
+    """Byte-wise MP3 join for the ffmpeg concat step (a subprocess the offline guard forbids)."""
+    def concat(paths, output, voice_compatible=False):
+        with open(output, 'wb') as joined_file:
+            for path in paths:
+                with open(path, 'rb') as part:
+                    joined_file.write(part.read())
+        return output
+    monkeypatch.setattr('tools.tts_tool_delivery._concat_audio_files', concat)
+
+
+async def seam(text, out, callbacks, deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+def chunk_count(text, cap):
+    from tools.tts_tool_delivery import _split_text_for_tts
+    return len(_split_text_for_tts(speakable_text(text), cap))
+
+
+def audio(tag):
+    return ('ok', {'audio': f'ID3{tag}'.encode()})
+
+
+@pytest.mark.asyncio
+async def test_single_chunk_success_writes_one_file_in_the_caller_directory(monkeypatch, out, configured):
+    events = []
+    cb = support.Callbacks(events)
+    wire = support.Wire([audio('one')], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, cb)
+    assert (result.state, result.source, result.provider) == ('synthesized', 'configured', 'completed')
+    assert result.code_points == len('Hello there, friend.')
+    assert os.path.dirname(result.path) == out and Path(result.path).read_bytes() == b'ID3one'
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    body = wire.requests[0].read()
+    assert b'"voice":"nova"' in body.replace(b' ', b'') and b'gpt-4o-mini-tts' in body
+    assert not (get_hermes_home() / 'cache' / 'audio').exists() or not list((get_hermes_home() / 'cache' / 'audio').iterdir())
+
+
+@pytest.mark.asyncio
+async def test_provider_failure_is_not_resent_and_leaves_no_file(monkeypatch, out, configured):
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, cb)
+    assert wire.count == 1  # the stock path sends 3 for the same failure (tests/tools stock transport)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert os.listdir(out) == []
+    assert {t['read'] for t in wire.timeouts()} == {60.0}  # explicit policy, not the SDK's 600 s default
+
+
+@pytest.mark.asyncio
+async def test_request_timeout_never_exceeds_the_deadline(monkeypatch, out, configured):
+    wire = support.Wire([audio('x')])
+    with support.provider_wire(monkeypatch, wire):
+        await seam('Hello there, friend.', out, support.Callbacks(), deadline_s=25)
+    assert {t['read'] for t in wire.timeouts()} == {25.0}
+
+
+@pytest.mark.asyncio
+async def test_exactly_one_request_per_core_chunk_in_order(monkeypatch, out, joined):
+    support.write_config(get_hermes_home(), openai_config(max_text_length=60))
+    expected = chunk_count(LONG_TEXT, 60)
+    assert expected >= 3
+    cb = support.Callbacks()
+    wire = support.Wire([audio(f'c{i}') for i in range(expected)])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(LONG_TEXT, out, cb)
+    assert (result.state, result.provider) == ('synthesized', 'completed')
+    assert wire.count == expected and cb.before_send_calls == expected
+    assert Path(result.path).read_bytes() == b''.join(f'ID3c{i}'.encode() for i in range(expected))
+    assert os.listdir(out) == [os.path.basename(result.path)]
+
+
+@pytest.mark.asyncio
+async def test_first_failed_chunk_ends_the_call_without_further_requests(monkeypatch, out, joined):
+    support.write_config(get_hermes_home(), openai_config(max_text_length=60))
+    cb = support.Callbacks()
+    wire = support.Wire([audio('c0'), ('status', 500), audio('never'), audio('never')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(LONG_TEXT, out, cb)
+    assert wire.count == 2 and cb.before_send_calls == 2
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_before_send_refusal_on_a_later_chunk_stops_with_nothing_left(monkeypatch, out, joined):
+    support.write_config(get_hermes_home(), openai_config(max_text_length=60))
+    cb = support.Callbacks(refuse_before_send_at=2)
+    wire = support.Wire([audio('c0'), audio('never')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(LONG_TEXT, out, cb)
+    assert wire.count == 1
+    assert (result.state, result.path, result.provider) == ('refused', None, 'completed')
+    assert os.listdir(out) == [] and support.SECRET not in repr(result)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('call, sent, provider', [(1, 0, 'not_started'), (2, 0, 'not_started'), (3, 1, 'completed')],
+                         ids=['before-work', 'at-the-send-gate', 'after-the-await'])
+async def test_authorize_refusal_withholds_the_audio(monkeypatch, out, configured, call, sent, provider):
+    cb = support.Callbacks(refuse_authorize_at=call)
+    wire = support.Wire([audio('must-not-be-returned')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, cb)
+    assert (result.state, result.path, result.provider) == ('refused', None, provider)
+    assert wire.count == sent and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_deadline_fences_the_worker_so_no_later_chunk_or_file_appears(monkeypatch, out, joined):
+    support.write_config(get_hermes_home(), openai_config(max_text_length=60))
+    from gateway import session_native_voice_tts as tts_module
+    finished = threading.Event()
+    original = tts_module._synthesize
+
+    def watched(*args):
+        try:
+            return original(*args)
+        finally:
+            finished.set()
+    monkeypatch.setattr(tts_module, '_synthesize', watched)
+    release = threading.Event()
+    wire = support.Wire([audio('c0'), audio('never'), audio('never')], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            result = await seam(LONG_TEXT, out, support.Callbacks(), deadline_s=0.5)
+    finally:
+        release.set()
+    assert (result.state, result.path, result.provider) == ('timeout', None, 'unknown')
+    assert await asyncio.to_thread(finished.wait, 10)
+    assert wire.count == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_audio_over_the_output_bound_is_cut_off_and_removed(monkeypatch, out, configured):
+    monkeypatch.setattr('gateway.session_native_voice.MAX_CHUNK_AUDIO_BYTES', 1000)
+    wire = support.Wire([('ok', {'audio': b'A' * 5000})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, support.Callbacks())
+    assert (result.state, result.path) == ('too_long', None)
+    assert wire.count == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_task_cancellation_propagates_and_leaves_no_file_or_second_chunk(monkeypatch, out, joined):
+    support.write_config(get_hermes_home(), openai_config(max_text_length=60))
+    from gateway import session_native_voice_tts as tts_module
+    finished = threading.Event()
+    original = tts_module._synthesize
+
+    def watched(*args):
+        try:
+            return original(*args)
+        finally:
+            finished.set()
+    monkeypatch.setattr(tts_module, '_synthesize', watched)
+    release = threading.Event()
+    wire = support.Wire([audio('c0'), audio('never'), audio('never')], hold=release)
+    task = asyncio.create_task(seam(LONG_TEXT, out, support.Callbacks()))
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            assert await asyncio.to_thread(wire.entered.wait, 10)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+    finally:
+        release.set()
+    assert await asyncio.to_thread(finished.wait, 10)
+    assert wire.count == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_empty_unspeakable_and_over_long_text_never_reach_the_provider(monkeypatch, out, configured):
+    cb = support.Callbacks()
+    wire = support.Wire([audio('x')])
+    with support.provider_wire(monkeypatch, wire):
+        for text, state in (('', 'empty'), ('   \n ', 'empty'), ('```code only```', 'empty'),
+                            ('x' * 4097, 'too_long'), ('😀' * 2049, 'too_long')):
+            result = await seam(text, out, cb)
+            assert (result.state, result.path, result.provider) == (state, None, 'not_started'), text[:12]
+    assert wire.count == 0 and cb.before_send_calls == 0
+
+
+@pytest.mark.asyncio
+async def test_output_directory_must_be_an_existing_absolute_directory(monkeypatch, tmp_path, configured):
+    cb = support.Callbacks()
+    wire = support.Wire([audio('x')])
+    plain_file = tmp_path / 'a-file'
+    plain_file.write_text('x')
+    with support.provider_wire(monkeypatch, wire):
+        for bad in ('relative/dir', str(tmp_path / 'missing'), str(plain_file), '', None):
+            result = await seam('Hello there, friend.', bad, cb)
+            assert (result.state, result.provider) == ('refused', 'not_started'), bad
+    assert wire.count == 0 and not (tmp_path / 'missing').exists()
+
+
+@pytest.mark.asyncio
+async def test_unusable_configured_voices_never_fall_back_to_another_provider(monkeypatch, out):
+    cb = support.Callbacks()
+    wire = support.Wire([audio('x')])
+    cases = {
+        'voice-off-or-unknown': {'tts': {'provider': 'none'}},
+        'unsupported-cloud': {'tts': {'provider': 'minimax', 'minimax': {'api_key': 'mm-key'}}},
+        'elevenlabs-without-key': {'tts': {'provider': 'elevenlabs'}},
+    }
+    with support.provider_wire(monkeypatch, wire):
+        for name, config in cases.items():
+            support.write_config(get_hermes_home(), config)
+            result = await seam('Hello there, friend.', out, cb)
+            assert (result.state, result.path, result.provider) == ('unavailable', None, 'not_started'), name
+    assert wire.count == 0 and cb.before_send_calls == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_profile_voice_model_and_key_are_read_per_call_and_never_cross(monkeypatch, out, tmp_path):
+    seen = []
+    for name, voice, key in (('a', 'nova', 'sk-A'), ('b', 'onyx', 'sk-B'), ('a', 'nova', 'sk-A')):
+        home = tmp_path / f'profile-{name}'
+        support.write_config(home, openai_config(api_key=key, voice=voice))
+        monkeypatch.setenv('HERMES_HOME', str(home))
+        wire = support.Wire([audio(name)])
+        with support.provider_wire(monkeypatch, wire):
+            result = await seam('Hello there, friend.', out, support.Callbacks())
+        assert result.state == 'synthesized'
+        body = wire.requests[0].read().replace(b' ', b'')
+        seen.append((wire.requests[0].headers['authorization'], b'"voice":"' + voice.encode() in body))
+    assert seen == [('Bearer sk-A', True), ('Bearer sk-B', True), ('Bearer sk-A', True)]
+
+
+@pytest.mark.asyncio
+async def test_results_and_logs_carry_no_key_text_or_path(monkeypatch, out, configured, caplog):
+    caplog.set_level(logging.INFO)
+    for script, cb in (([audio('a')], support.Callbacks()), ([('status', 500)], support.Callbacks()),
+                       ([audio('a')], support.Callbacks(refuse_before_send=True))):
+        wire = support.Wire(script)
+        with support.provider_wire(monkeypatch, wire):
+            result = await seam('Private words to speak.', out, cb)
+        assert KEY not in repr(result) and support.SECRET not in repr(result)
+    leaks = [line for line in caplog.text.splitlines()
+             if KEY in line or out in line or support.SECRET in line or 'Private words' in line]
+    assert not leaks, leaks
+    caplog.set_level(logging.DEBUG)
+    caplog.clear()
+    with support.provider_wire(monkeypatch, support.Wire([audio('a')])):
+        await seam('Private words to speak.', out, support.Callbacks())
+    assert not [r for r in caplog.records if r.name.startswith(('gateway.session_native_voice', 'tools.native_send'))]
+
+
+def test_speakable_text_applies_the_reviewed_spoken_normalization():
+    spoken = speakable_text('# Title\n**Bold** words [a link](https://example.com/x) 😀 see https://example.org now.')
+    assert '*' not in spoken and '#' not in spoken and 'https' not in spoken and '😀' not in spoken
+    assert 'Bold words' in spoken and 'a link' in spoken
+    assert speakable_text('plain sentence.') == 'plain sentence.'
+    assert speakable_text('x' * 10000) == 'x' * 10000  # no length cap: callers own bounds
+
+
+@pytest.mark.asyncio
+async def test_deepinfra_voice_needs_a_pinned_model_so_no_catalog_request_precedes_the_send(monkeypatch, out):
+    (get_hermes_home() / '.env').write_text('DEEPINFRA_API_KEY=di-synthetic-key\n')
+    catalog = []
+    monkeypatch.setattr('hermes_cli.models.deepinfra_model_ids', lambda tag, **kw: catalog.append(tag) or ['guess/model'])
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'deepinfra'}})
+    wire = support.Wire([audio('x')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, support.Callbacks())
+    assert (result.state, result.provider, wire.count, catalog) == ('unavailable', 'not_started', 0, [])
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'deepinfra', 'deepinfra': {'model': 'hexgrad/Kokoro-82M', 'voice': 'af_bella'}}})
+    wire = support.Wire([audio('x')])
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, support.Callbacks())
+    assert (result.state, result.provider, wire.count, catalog) == ('synthesized', 'completed', 1, [])
+    assert wire.requests[0].url.host == 'api.deepinfra.com'
