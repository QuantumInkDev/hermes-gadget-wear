+class IgnoresInjectedClient:
+    """Labelled stand-in: an SDK that builds and uses its OWN client whatever it is handed."""
+
+    def __init__(self, api_key=None, timeout=None, httpx_client=None, environment=None):
+        self.http = httpx.Client()
+        self.text_to_speech = self
+        self._client_wrapper = type('W', (), {'httpx_client': type('H', (), {'httpx_client': self.http})()})()
+
+    def convert(self, voice_id, *, text, model_id=None, output_format=None, request_options=None):
+        yield self.http.post('https://api.elevenlabs.io/v1/x', json={'text': text}).content
+
+
+class ProvesButBypasses(IgnoresInjectedClient):
+    """Labelled stand-in: reports the injected client as its sender but really sends through another."""
+
+    def __init__(self, api_key=None, timeout=None, httpx_client=None, environment=None):
+        super().__init__()
+        self._client_wrapper = type('W', (), {'httpx_client': type('H', (), {'httpx_client': httpx_client})()})()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('sdk, state, provider, requests, callbacks', [
+    (IgnoresInjectedClient, 'unavailable', 'not_started', 0, 0),   # identity not proven: refused UNSENT
+    (ProvesButBypasses, 'failed', 'unknown', 1, 0),                # a send nobody gated: never "not_started"
+], ids=['ignores-injected', 'proves-then-bypasses'])
+async def test_a_hooked_engine_that_bypasses_the_gate_cannot_be_synthesized_or_not_started(
+        monkeypatch, out, sdk, state, provider, requests, callbacks):
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs'}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+    monkeypatch.setattr('tools.tts_tool._import_elevenlabs', lambda: sdk)
+    cb = support.Callbacks()
+    wire = support.Wire([('ok', {'audio': b'ID3bypass'})] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == (state, None, provider)
+    assert wire.count == requests and cb.before_send_calls == callbacks and os.listdir(out) == []
