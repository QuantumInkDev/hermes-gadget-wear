+        assert (result.state, result.transcript, result.source, result.provider) == ('refused', None, None, 'not_started')
+        assert (len(oauth.gets), len(oauth.posts)) == expected_oauth
+        assert self.cloud.count == 0 and self.cb.before_send_calls == 0 and self.local == []  # no provider substituted, no fallback
+        assert self.cb.authorize_calls == authorize_calls  # exact: nothing asked the consumer again
+        assert rest.read_oauth_store()['providers']['xai-oauth']['tokens']['access_token'] == self.access
+        assert support.SECRET not in repr(result)
