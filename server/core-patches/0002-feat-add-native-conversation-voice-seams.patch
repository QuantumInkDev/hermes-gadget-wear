+    sdk_clients = []
+    from elevenlabs.client import ElevenLabs
+    original = ElevenLabs.__init__
+
+    def record(self, *a, **k):
+        original(self, *a, **k)
+        sdk_clients.append(self)
+    monkeypatch.setattr(ElevenLabs, '__init__', record)
+    with support.provider_wire(monkeypatch, wire):
