+    assert (result.state, result.provider) == ('synthesized', 'completed')
+    assert cb.before_send_calls == chunks == boundary.handshakes == len(boundary.texts)  # one send, one text per chunk
+    spoken = [ssml_text(text) for text in boundary.texts]
+    assert all(0 < len(text) <= 600 for text in spoken)
+    assert ' '.join(' '.join(spoken).split()) == ' '.join(speakable_text(FULL_TEXT).split())  # whole, in order
+    assert result.code_points == sum(len(text) for text in spoken)
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert abs(support.media_seconds(result.path) - chunks * 1.0) < 0.5  # the REAL ffmpeg joined real MP3 chunks
+    assert support.packets(result.path) == chunks * support.packets(tmp_path / 'sine.mp3')  # NM-2: not one audio packet lost
