@@ -0,0 +1,243 @@
+"""Configured one-request-per-chunk text-to-speech for the native voice seam (``session_native_voice``).
+
+The profile's own TTS configuration (provider, voice, model) is read at call time through the stock
+resolvers; the stock chunker splits the normalized text; each chunk is synthesized by the stock
+provider generator under a one-send transport policy. There is no retry and no other provider: the
+first failed chunk ends the call and every audio file written for it is removed.
+"""
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+import os
+import shutil
+import time
+import uuid
+
+from gateway import session_native_voice_gate as gate
+from tools import native_send_policy
+
+# V1 prerequisite coverage (stage amendment; the full configured-voice set is the V1-P gate): voices whose
+# transport the seam can hold to one request per chunk. Others - Mistral, MiniMax, xAI, Gemini, local engines,
+# command and plugin providers - are refused UNSENT, never replaced by another provider.
+TTS_PROVIDERS = frozenset({'edge', 'elevenlabs', 'openai', 'deepinfra'})
+# Every covered engine sends through a client the seam hooks (httpx for the SDKs, the aiohttp connector for
+# Edge): its identity is proven before the call and exactly one gated send is required after it.
+HOOKED_PROVIDERS = TTS_PROVIDERS
+EDGE_CHUNK_CODE_POINTS = 600  # one Edge websocket message set per chunk (the library splits at 4,096 escaped bytes)
+MAX_NORMALIZED_CODE_POINTS = 2 * 4096
+FILE_PREFIX = 'native-speech-'
+
+
+@dataclass
+class _Synth:
+    state: str
+    path: str | None = None
+    code_points: int = 0
+    answered: bool = False  # every request that was sent got a usable answer
+    unaccounted: bool = False  # audio was produced (or a send happened) outside the gate: accounting is unknown
+
+
+def _make(state, path, code_points, source, provider):
+    from gateway.session_native_voice import NativeSpeech
+    return NativeSpeech(state, path, code_points, source, provider)
+
+
+def _utf16_units(text):
+    return len(text.encode('utf-16-le')) // 2
+
+
+def _owned_dir(output_dir):
+    return isinstance(output_dir, str) and os.path.isabs(output_dir) and os.path.isdir(output_dir)
+
+
+def _remove(paths):
+    for path in paths:
+        try:
+            os.remove(path)
+        except OSError:
+            continue  # already gone or never created: the goal of the cleanup is met
+
+
+@dataclass
+class _Run:
+    """One synthesis call inside its worker thread."""
+    policy: native_send_policy.SendPolicy
+    output_dir: str
+    run_id: str
+    paths: list
+    done: int = 0  # chunks whose request was answered and whose audio was kept
+    unaccounted: bool = False  # an engine produced audio without exactly one gated send
+
+    @property
+    def answered(self):
+        """Every request that was sent got an answer (a refused send or an early stop leaves none open)."""
+        return self.policy.sends == self.done
+
+
+def _chunk_audio(run, engine, config, chunk, path):
+    """One request: arm a fresh one-send scope, synthesize, bound the file. Returns an error state or None."""
+    from gateway.session_native_voice import MAX_CHUNK_AUDIO_BYTES
+    from tools import tts_tool as tts
+    run.policy.arm()
+    try:
+        tts._synthesize_builtin(engine, chunk, path, config, None)
+    finally:
+        run.policy.close_clients()
+    if run.policy.scope_sends != 1:
+        run.unaccounted = True  # audio came back through a path the gate never saw
+        return 'failed'
+    run.done += 1
+    try:
+        size = os.path.getsize(path)
+    except OSError:
+        return 'failed'
+    if size <= 0:
+        return 'failed'
+    return 'too_long' if size > MAX_CHUNK_AUDIO_BYTES else None
+
+
+def _synthesize_chunks(run, engine, config, chunks):
+    """Stop at the first failed chunk; returns its failure state or None."""
+    from gateway.session_native_voice import MAX_SPEECH_AUDIO_BYTES
+    total = 0
+    for index, chunk in enumerate(chunks, start=1):
+        path = os.path.join(run.output_dir, f'.{FILE_PREFIX}{run.run_id}.chunk{index:03d}.mp3')
+        run.paths.append(path)
+        failure = _chunk_audio(run, engine, config, chunk, path)
+        if failure:
+            return failure
+        total += os.path.getsize(path)
+        if total > MAX_SPEECH_AUDIO_BYTES:
+            return 'too_long'
+    return None
+
+
+def _final_path(output_dir, run_id):
+    return os.path.join(output_dir, f'{FILE_PREFIX}{run_id}.mp3')
+
+
+def _join(run):
+    """One audio file from the chunk files (a rename for a single chunk, the stock concat otherwise)."""
+    final = _final_path(run.output_dir, run.run_id)
+    if len(run.paths) == 1:
+        os.replace(run.paths[0], final)
+        return final
+    from tools.tts_tool_delivery import _concat_audio_files
+    return _concat_audio_files(run.paths, final, voice_compatible=False)
+
+
+def _plan(text, config):
+    """``(engine, chunks)``; ``engine`` is None when the configured voice cannot be used."""
+    from gateway.session_native_voice import speakable_text
+    from tools import tts_tool as tts
+    from tools.tts_tool_delivery import _resolve_max_text_length, _split_text_for_tts
+    provider = tts._get_provider(config)
+    if provider not in TTS_PROVIDERS:
+        return None, []
+    engine, unavailable = tts._select_builtin_engine(provider)
+    if unavailable or engine != provider:
+        return None, []  # never the stock fallback to another engine
+    spoken = speakable_text(text)
+    cap = _resolve_max_text_length(provider, config)
+    if provider == 'edge':
+        cap = min(cap, EDGE_CHUNK_CODE_POINTS)
+    chunks = _split_text_for_tts(spoken, cap) if spoken.strip() else []
+    return engine, chunks
+
+
+def _run_chunks(run, text):
+    """The synthesis proper, inside the policy; returns the worker's verdict."""
+    from tools import tts_tool as tts
+    if not _owned_dir(run.output_dir):
+        return _Synth('refused')
+    config = tts._load_tts_config()
+    engine, chunks = _plan(text, config)
+    if engine is None:
+        return _Synth('unavailable')
+    if not chunks:
+        return _Synth('empty')
+    code_points = sum(len(chunk) for chunk in chunks)
+    if code_points > MAX_NORMALIZED_CODE_POINTS:
+        return _Synth('too_long')
+    if len(chunks) > 1 and shutil.which('ffmpeg') is None:
+        return _Synth('unavailable')  # the join is certain to fail: never pay for chunks that cannot be joined
+    failure = _synthesize_chunks(run, engine, config, chunks)
+    if failure:
+        return _Synth(failure, code_points=code_points)
+    final = _join(run)
+    if not final:
+        return _Synth('failed', code_points=code_points)  # chunks that were paid for but cannot be joined
+    return _Synth('synthesized', final, code_points)
+
+
+def _synthesize(text, output_dir, policy, run_id):
+    """Worker thread. A fenced (deadline-abandoned) worker leaves no file behind."""
+    run = _Run(policy, output_dir, run_id, [])
+    try:
+        with native_send_policy.activate(policy):
+            verdict = _run_chunks(run, text)
+    except native_send_policy.NativeSendRefused:
+        verdict = _Synth('failed')  # the policy recorded why
+    except Exception:  # health: allow BLE001 -- provider/library failure becomes the stable 'failed' token; its text must not leave
+        verdict = _Synth('failed')
+    finally:
+        _remove(run.paths)  # chunk files; the joined file is a different path and survives
+        if policy.closed and isinstance(output_dir, str):
+            _remove([_final_path(output_dir, run_id)])
+    verdict.answered = run.answered
+    verdict.unaccounted = run.unaccounted
+    return verdict
+
+
+def _discard_run(output_dir, run_id):
+    """The abandoned worker removes its own files once fenced; this covers a finish that beat the fence."""
+    if isinstance(output_dir, str):
+        _remove([_final_path(output_dir, run_id)])
+
+
+def _failure_state(synth, policy):
+    if synth.state in ('refused', 'unavailable', 'empty', 'too_long'):
+        return synth.state
+    if synth.unaccounted:
+        return 'failed'
+    if policy.refusal in ('refused', 'cancelled', 'too_long'):
+        return policy.refusal
+    if policy.refusal == 'unsupported' or not policy.sends:
+        return 'unavailable'
+    return 'failed'
+
+
+async def synthesize_once(text, *, output_dir, authorize, before_send, deadline_s):
+    from gateway.session_native_voice import MAX_CHUNK_AUDIO_BYTES, TTS_REQUEST_TIMEOUT_S
+    gate.validate_call(authorize, before_send, deadline_s)
+    if not isinstance(text, str) or not text.strip():
+        return _make('empty', None, 0, None, gate.PROVIDER_NOT_STARTED)
+    from gateway.session_native_voice import MAX_SPEECH_UTF16_UNITS
+    if _utf16_units(text) > MAX_SPEECH_UTF16_UNITS:
+        return _make('too_long', None, 0, None, gate.PROVIDER_NOT_STARTED)
+    deadline = time.monotonic() + deadline_s
+    policy = gate.new_policy(asyncio.get_running_loop(), authorize, before_send, deadline,
+                             timeout_s=min(TTS_REQUEST_TIMEOUT_S, float(deadline_s)), providers=TTS_PROVIDERS,
+                             max_output_bytes=MAX_CHUNK_AUDIO_BYTES)
+    refusal = gate.check(authorize)
+    if refusal:
+        return _make(refusal, None, 0, None, gate.PROVIDER_NOT_STARTED)
+    run_id = uuid.uuid4().hex
+    try:
+        synth, maybe_sent = await gate.bounded(
+            lambda: _synthesize(text, output_dir, policy, run_id), deadline, policy.close)
+    except asyncio.CancelledError:
+        _discard_run(output_dir, run_id)
+        raise
+    if synth is gate.TIMED_OUT:
+        _discard_run(output_dir, run_id)
+        return _make('timeout', None, 0, None, gate.PROVIDER_UNKNOWN if maybe_sent else gate.PROVIDER_NOT_STARTED)
+    provider = gate.PROVIDER_UNKNOWN if synth.unaccounted else gate.provider_state(policy, synth.answered)
+    refusal = gate.check(authorize)
+    if refusal or synth.state != 'synthesized':
+        _remove([synth.path] if synth.path else [])
+        state = refusal or _failure_state(synth, policy)
+        return _make(state, None, synth.code_points if state in ('failed', 'too_long') else 0,
+                     'configured' if policy.sends or synth.unaccounted else None, provider)
+    return _make('synthesized', synth.path, synth.code_points, 'configured', provider)
