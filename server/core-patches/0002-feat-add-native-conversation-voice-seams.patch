@@ -0,0 +1,21 @@
+"""Native local STT command fixture: ``stt_flood.py MODE OUT`` fails the call AFTER it really started, in one bounded
+way: ``stdout`` writes 1 MiB + 128 KiB of 'x' to stdout (past the per-stream cap); ``file`` writes 1 MiB + 1 byte to
+OUT (past the transcript cap); ``symlink`` makes OUT a symlink to a small sibling file. Network-free; writes only OUT
+and ``OUT.target``; no child process."""
+import os
+import sys
+
+mode, out = sys.argv[1], sys.argv[2]
+if mode == 'stdout':
+    for _ in range(144):  # bounded: 144 x 8 KiB
+        sys.stdout.write('x' * 8192)
+    sys.stdout.flush()
+elif mode == 'file':
+    with open(out, 'w', encoding='utf-8') as handle:
+        handle.write('x' * (1024 * 1024 + 1))
+elif mode == 'symlink':
+    with open(out + '.target', 'w', encoding='utf-8') as handle:
+        handle.write('words through a link')
+    os.symlink(out + '.target', out)
+else:
+    raise SystemExit(64)
diff --git a/tests/tools/native_command_fixtures/tree.py b/tests/tools/native_command_fixtures/tree.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb735af425875c59a4c57f7efd16bc9f94c9917b
--- /dev/null
+++ b/tests/tools/native_command_fixtures/tree.py
@@ -0,0 +1,28 @@
+"""Native runner fixture: a same-session process tree. ``tree.py PIDFILE stay|orphan``: starts one child copy of this
+interpreter in the SAME session and process group (no setsid), writes "PARENT CHILD" pids to PIDFILE, then either
+stays alive printing progress (stay) or exits at once leaving the child as an orphan that still holds the output
+pipe (orphan). The child prints progress for at most 20 s. Network-free; the only file written is PIDFILE."""
+import os
+import subprocess
+import sys
+import time
+
+
+def progress(seconds):
+    for _ in range(seconds * 10):  # bounded: at most SECONDS s of output, one line per 0.1 s
+        print('progress', flush=True)
+        time.sleep(0.1)  # health: allow HX013 -- the steady, never-idle output IS the behaviour under test
+
+
+if sys.argv[1] == '--child':
+    progress(20)
+    raise SystemExit(0)
+pidfile, mode = sys.argv[1], sys.argv[2]
+assert mode in ('stay', 'orphan')
+child = subprocess.Popen([sys.executable, os.path.abspath(__file__), '--child'], stdin=subprocess.DEVNULL)
+tmp = pidfile + '.tmp'
+with open(tmp, 'w', encoding='utf-8') as handle:
+    handle.write(f'{os.getpid()} {child.pid}')
+os.replace(tmp, pidfile)
+if mode == 'stay':
+    progress(20)
