+            result = await seam(path, cb)
+            assert (result.state, result.provider) == ('refused', 'not_started'), path
+        with pytest.raises(Exception, match='invalid_params'):
+            await transcribe_native_once(real, authorize=cb.authorize, before_send=cb.before_send, deadline_s=0)
+        with pytest.raises(Exception, match='invalid_params'):
+            await transcribe_native_once(real, authorize=None, before_send=cb.before_send, deadline_s=5)
