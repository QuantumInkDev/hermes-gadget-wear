+        assert (result.state, result.path, result.provider, wire.count) == ('failed', None, 'failed_after_send', 1), script[0]
+        assert cb.before_send_calls == 1 and os.listdir(out) == []
+    assert elevenlabs and all(k['httpx_client'].is_closed for k in elevenlabs)  # M4: no pool leaks per chunk
