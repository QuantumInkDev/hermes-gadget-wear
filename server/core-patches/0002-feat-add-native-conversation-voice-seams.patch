+"""Native voice seam: configured Mistral STT and TTS through the stock pipeline and the REAL pinned ``mistralai`` SDK.
+
+``mistralai==2.4.8`` (and its newly staged pure-Python dependencies) are the lock-pinned wheels of the owned offline
+overlay: hash-verified, extracted inert, never installed, imported under the unchanged guard. Only the network bytes
+are synthetic (the httpx transport), so the SDK's own request builder, retry/redirect/timeout handling and response
+parser run for every case here. Stand-ins for misbehaving SDKs live in ``test_native_voice_mistral_accounting``.
+"""
+import json
+import os
+import sys
+from pathlib import Path
+
+import httpx
+import pytest
+
+from tests.gateway import mistral_voice_support as mistral
+from tests.gateway import native_voice_support as support
+from tests.gateway.mistral_voice_support import hear, speak
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def sdk(monkeypatch):
+    return mistral.observe_sdk(monkeypatch)
+
+
+# --- speech to text ---------------------------------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_mistral_stt_sends_one_gated_request_through_the_injected_client(monkeypatch, clip, sdk):
+    mistral.stt_profile(model='voxtral-mini-2602', language='fr')
+    events = []
+    cb = support.Callbacks(events)
+    wire = mistral.MistralWire([('ok', {'text': 'bonjour le monde'})], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb, deadline_s=90)  # the request timeout is min(60 s policy, deadline)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'bonjour le monde', 'configured', 'completed')
+    assert wire.count == 1 and events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    (built,) = sdk
+    assert built['kwargs']['client'] is built['sender']  # the SDK sends through the very client that carries the hook
+    assert built['kwargs']['retry_config'] is None and built['kwargs']['timeout_ms'] == 60000
+    assert [(c['retries'], c['timeout_ms'], c['language']) for c in built['calls']] == [(None, 60000, 'fr')]
+    assert (built['sender'].follow_redirects, built['sender'].timeout.read) == (False, 60.0)  # the options it carries
+    assert built['kwargs']['client'].is_closed  # no pool leak per call
+    request = wire.requests[0]
+    body = request.read()
+    assert str(request.url) == mistral.TRANSCRIPTION_URL
+    assert request.headers['authorization'] == f'Bearer {mistral.KEY}'
+    assert request.headers['user-agent'].startswith('mistral-client-python/')
+    assert b'voxtral-mini-2602' in body and b'name="language"' in body and b'fr' in body  # profile model + language
+    assert {t['read'] for t in wire.timeouts()} == {60.0}
+
+
+@pytest.mark.asyncio
+async def test_mistral_stt_language_follows_the_stock_resolution_order(monkeypatch, clip, sdk):
+    support.write_config(mistral.get_hermes_home(), {'stt': {'provider': 'mistral', 'cloud_trim_silence': False,
+                                                             'language': 'de'}})
+    (mistral.get_hermes_home() / '.env').write_text(f'MISTRAL_API_KEY={mistral.KEY}\n')
+    wire = mistral.MistralWire([('ok', {})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, support.Callbacks())
+    assert (result.state, wire.count) == ('transcribed', 1)
+    assert b'name="language"' in wire.requests[0].read() and b'de' in wire.requests[0].read()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('script', [
+    [('status', 500)] * 3, [('status', 429)] * 3, [('raise', httpx.ReadTimeout('synthetic'))] * 3,
+    [('redirect', mistral.TRANSCRIPTION_URL + '?elsewhere')] + [('ok', {'text': 'followed'})] * 2],
+    ids=['5xx', '429', 'timeout', 'redirect'])
+async def test_mistral_stt_failures_are_never_resent(monkeypatch, clip, sdk, script):
+    mistral.stt_profile()
+    cb = support.Callbacks()
+    wire = mistral.MistralWire(script)
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1  # the SDK default is no retry; a redirect is an answer
+    assert sdk[0]['kwargs']['client'].is_closed
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('body', [
+    b'this is not json', b'{}', b'{"model":"m","text":5,"language":null,"usage":{}}', b'{"model":"m","text":"x"'],
+    ids=['not-json', 'empty-object', 'wrong-type', 'truncated'])
+async def test_mistral_stt_unparseable_paid_answer_is_a_failure_after_send_and_not_resent(monkeypatch, clip, sdk, body):
+    mistral.stt_profile()
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'content': body})] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1
+
+
+@pytest.mark.asyncio
+async def test_mistral_stt_silence_is_an_answer_and_a_known_failure_may_use_the_cached_local_fallback(
+        monkeypatch, clip, sdk):
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {'text': ''})])
+    with support.provider_wire(monkeypatch, wire):
+        silent = await hear(clip, support.Callbacks())
+    assert (silent.state, silent.transcript, silent.source, silent.provider) == ('empty', None, 'configured', 'completed')
+    fallback = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: fallback.append(path) or {'success': True, 'transcript': ' local words '})
+    wire = mistral.MistralWire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        failed = await hear(clip, support.Callbacks())
+    assert (failed.state, failed.transcript, failed.source, failed.provider) == (
+        'transcribed', 'local words', 'local_fallback', 'failed_after_send')
+    assert wire.count == 1 and len(fallback) == 1  # one cloud send, then only the installed local backend
+
+
+@pytest.mark.asyncio
+async def test_mistral_stt_response_bodies_are_bounded_even_without_a_declared_length(monkeypatch, clip, sdk):
+    mistral.stt_profile()
+    huge = b'{"model":"m","language":null,"usage":{},"text":"' + b'a' * (2 * 1024 * 1024) + b'"}'
+    chunked = [huge[i:i + 65536] for i in range(0, len(huge), 65536)]
+    for step in ({'content': huge}, {'chunks': chunked}):
+        cb = support.Callbacks()
+        wire = mistral.MistralWire([('ok', step)] * 3)
+        with support.provider_wire(monkeypatch, wire):
+            result = await hear(clip, cb)
+        assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+        assert wire.count == 1 and cb.before_send_calls == 1
+    long_text = 'a' * 4001
+    wire = mistral.MistralWire([('ok', {'text': long_text})])
+    with support.provider_wire(monkeypatch, wire):
+        over = await hear(clip, support.Callbacks())
+    assert (over.state, over.transcript, over.provider) == ('too_long', None, 'completed')  # the transcript bound stands
+
+
+@pytest.mark.asyncio
+async def test_mistral_stt_prompt_the_pinned_sdk_cannot_carry_is_refused_unsent(monkeypatch, clip, sdk):
+    mistral.stt_profile()
+    support.write_config(mistral.get_hermes_home(), {'stt': {'provider': 'mistral', 'cloud_trim_silence': False,
+                                                             'prompt': 'domain hint words'}})
