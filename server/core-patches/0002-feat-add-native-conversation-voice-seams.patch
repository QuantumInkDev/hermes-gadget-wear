+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['stop', 'deadline'])
+async def test_stop_or_the_deadline_while_the_join_is_held_leaves_no_late_result_send_callback_or_file(
+        monkeypatch, tmp_path, out, scratch, how):
+    support.ffmpeg_path()
+    try:
+        support.write_config(get_hermes_home(), openai_config())
+        state = support.joiner(monkeypatch, tmp_path, 'hold-join')
+        mp3, _ = real_chunks(tmp_path, chunk_total(LONG_TEXT, 60))
+        cb = support.Callbacks()
+        wire = support.Wire([('ok', {'audio': audio}) for audio in mp3])
+        clock = support.ReadinessClock(monkeypatch)
+        with support.provider_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb, deadline_s=300 if how == 'deadline' else 60))
+            await async_wait_until(lambda: state.exists(), timeout=30, what='the held join to start')
+            calls = (cb.authorize_calls, cb.before_send_calls, wire.count)
+            assert calls[1:] == (len(mp3), len(mp3))  # every chunk was paid for before the join began
+            if how == 'stop':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            else:
+                clock.advance()  # expiry only AFTER the held join is confirmed (the stand-in wrote its pid)
+                result = await task
+                assert (result.state, result.path, result.provider) == ('timeout', None, 'unknown')
+            await async_wait_until(lambda: support.pid_gone(state), timeout=15, what='the held join child to be ended')
+            await async_wait_until(lambda: not os.listdir(out) and not os.listdir(scratch), timeout=15,
+                                   what='the fenced worker to clean up')
+        assert wire.count == len(mp3) and cb.before_send_calls == len(mp3)  # no extra send, no late callback
+        assert os.listdir(out) == [] and os.listdir(scratch) == []
+    finally:
