+# --- no refresh or resend after an auth failure ---------------------------------------------------------------------
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('status', [401, 403])
+async def test_an_auth_failure_after_the_send_is_never_refreshed_or_resent(monkeypatch, out, status):
+    tts_profile()
+    rest.write_oauth_store(fresh_token())
+    oauth = rest.OAuthWire()
+    cb = support.Callbacks()
+    wire = rest.RestWire([('status', status)] * 3)
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count, cb.before_send_calls) == ('failed', 'failed_after_send', 1, 1)
+    assert oauth.requests == []  # no force_refresh, no second account, no different provider
+    # even when a refresh DID run before the send, an auth failure afterwards adds none
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    oauth = rest.OAuthWire()
+    wire = rest.RestWire([('status', status)] * 3)
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert (result.state, wire.count, len(oauth.posts)) == ('failed', 1, 1)
+
+
+# --- Stop / deadline / authority while the OAuth exchange is in flight ----------------------------------------------
+
+def start_held_refresh():
+    tts_profile()
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold=release)
+    wire = rest.RestWire([('audio', b'ID3late')])
+    return oauth, wire, release
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline', 'authority'])
+async def test_stop_deadline_or_lost_authority_while_refreshing_can_never_become_a_late_send(monkeypatch, out, how):
+    from gateway import session_native_voice_tts as tts_module
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    cb = support.Callbacks(refuse_authorize_at=4) if how == 'authority' else support.Callbacks()  # 4 = the paid gate
+    oauth, wire, release = start_held_refresh()
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+            deadline = rest.EventDeadline(monkeypatch)  # installed before the call starts waiting
+            task = asyncio.create_task(speak(out, cb, deadline_s=30))
+            assert await asyncio.to_thread(oauth.entered.wait, 10)  # the OAuth exchange is in flight, held
+            if how == 'deadline':
+                deadline.fire()
+                result = await task
+                assert (result.state, result.provider) == ('timeout', 'not_started')
+            else:
+                if how == 'cancel':
+                    task.cancel()
+                    with pytest.raises(asyncio.CancelledError):
+                        await task
+            release.set()  # the late refresh result arrives
+            if how == 'authority':
+                result = await task
+                assert (result.state, result.path, result.provider) == ('refused', None, 'not_started')
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert wire.count == 0 and cb.before_send_calls == 0 and os.listdir(out) == []  # no late gate, no late send, no file
+    assert len(oauth.posts) == 1
+
+
+@pytest.mark.asyncio
