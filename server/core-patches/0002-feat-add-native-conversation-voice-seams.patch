+async def test_an_ordinary_known_gated_failure_still_gets_the_single_installed_local_fallback(monkeypatch, clip, fallback, name):
+    """POSITIVE control (green before and after): a plain 5xx after a counted send keeps the documented single fallback."""
+    backend = next(p.values[0] for p in BACKENDS if p.values[0].name == name)
+    backend.profile()
+    wire = backend.answer(500, {}, b'{"error":{"message":"synthetic outage"}}')
