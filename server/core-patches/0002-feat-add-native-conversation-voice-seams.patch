+"""Stock Mistral STT/TTS behaviour that the native voice seam must not change.
+
+Measured on the REAL pinned ``mistralai`` SDK with only the network transport replaced
+(``tests/gateway/mistral_voice_support.py``). The native seam (``gateway.session_native_voice``) holds a Mistral call
+to exactly one gated request; these controls prove that none of that transport policy, nor the SDK-install
+suppression, leaks into the ordinary ``transcribe_audio`` / ``text_to_speech_tool`` paths when no native call is active.
+"""
+import json
+import logging
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from tests.gateway import mistral_voice_support as mistral
+from tests.gateway import native_voice_support as support
+
+
+def measured(label, **values):
+    print('NATIVE_VOICE_STOCK_MEASURE ' + json.dumps({'label': label, **values}, sort_keys=True))
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def sdk(monkeypatch):
+    return mistral.observe_sdk(monkeypatch)
+
+
+def test_stock_stt_builds_the_sdk_client_with_only_the_key_and_keeps_its_defaults(monkeypatch, clip, sdk):
+    from tools.transcription_tools import transcribe_audio
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {'text': 'hello from stock'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(clip)
+    assert result['success'] and result['transcript'] == 'hello from stock' and wire.count == 1
+    assert [built['kwargs'] for built in sdk] == [{'api_key': mistral.KEY}]  # no injected client, options or logger
+    assert {t['read'] for t in wire.timeouts()} == {60.0}  # the SDK's own default
+    measured('stock_mistral_stt_success', requests=wire.count, kwargs=sorted(sdk[0]['kwargs']))
+
+
+def test_stock_stt_follows_a_redirect_where_the_native_seam_refuses_it(monkeypatch, clip, sdk):
+    from tools.transcription_tools import transcribe_audio
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('redirect', 'https://api.mistral.example/elsewhere'), ('ok', {'text': 'followed'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(clip)
+    assert result['success'] and result['transcript'] == 'followed' and wire.count == 2
+    measured('stock_mistral_stt_redirect', requests=wire.count)
+
+
+def test_stock_stt_still_best_effort_installs_the_sdk_and_still_logs_a_failure(monkeypatch, clip, sdk, caplog):
+    from tools.transcription_tools import transcribe_audio
+    installs = []
+    monkeypatch.setattr('pm.ensure_import', lambda extra, *a, **k: installs.append(extra))
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('status', 500)])
+    with support.provider_wire(monkeypatch, wire), caplog.at_level(logging.ERROR):
+        result = transcribe_audio(clip)
+    assert not result['success'] and wire.count == 1 and installs == ['mistral']
+    assert [r for r in caplog.records if r.name == 'tools.transcription_tools' and r.levelno >= logging.ERROR]
+    measured('stock_mistral_stt_5xx', requests=wire.count)
+
+
+def test_stock_tts_builds_the_sdk_client_with_only_key_and_server_url(monkeypatch, sdk):
+    from tools.tts_tool import text_to_speech_tool
+    mistral.tts_profile(base_url='https://eu.mistral.example')
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3stock'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = json.loads(text_to_speech_tool('hello world'))
+    assert result['success'] and wire.count == 1
+    assert [built['kwargs'] for built in sdk] == [{'api_key': mistral.KEY, 'server_url': 'https://eu.mistral.example'}]
+    assert str(wire.requests[0].url) == 'https://eu.mistral.example/v1/audio/speech'
+    assert {t['read'] for t in wire.timeouts()} == {60.0}
+    measured('stock_mistral_tts_success', requests=wire.count, kwargs=sorted(sdk[0]['kwargs']))
+
+
+def test_stock_tts_follows_a_redirect_and_still_logs_a_failure(monkeypatch, sdk, caplog):
+    from tools.tts_tool import text_to_speech_tool
+    mistral.tts_profile()
+    wire = mistral.MistralWire([('redirect', mistral.SPEECH_URL + '?elsewhere'), ('ok', {'audio': b'ID3followed'})])
+    with support.provider_wire(monkeypatch, wire):
+        followed = json.loads(text_to_speech_tool('hello world'))
+    assert followed['success'] and wire.count == 2
+    wire = mistral.MistralWire([('status', 500)])
+    with support.provider_wire(monkeypatch, wire), caplog.at_level(logging.ERROR):
+        failed = json.loads(text_to_speech_tool('hello world'))
+    assert not failed['success'] and wire.count == 1
+    assert [r for r in caplog.records if r.name == 'tools.tts_tool' and r.levelno >= logging.ERROR]
+    measured('stock_mistral_tts_redirect_and_5xx', followed_requests=2, failed_requests=wire.count)
