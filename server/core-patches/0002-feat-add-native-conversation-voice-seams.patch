+class EventDeadline:
+    """An event-armed call deadline for the seam's bounded wait: it expires when the test calls :meth:`fire`, after the
+    test saw the worker reach the point it wants to fence, not after a wall-clock window that a loaded machine could
+    overrun before the worker is ready. Only the gate module's ``asyncio.wait_for`` is replaced; everything else it
+    uses of ``asyncio`` is the real module."""
+
+    def __init__(self, monkeypatch):
+        from gateway import session_native_voice_gate as gate
+        self.fired = asyncio.Event()
+        outer = self
+
+        class Shim:
+            def __getattr__(self, name):
+                return getattr(asyncio, name)
+
+            async def wait_for(self, awaitable, timeout):
+                work = asyncio.ensure_future(awaitable)
+                expiry = asyncio.ensure_future(outer.fired.wait())
+                try:
+                    done, _ = await asyncio.wait({work, expiry}, return_when=asyncio.FIRST_COMPLETED)
+                except asyncio.CancelledError:
+                    work.cancel()
+                    raise
+                finally:
+                    expiry.cancel()
+                if work in done:
+                    return work.result()
+                work.cancel()
+                raise TimeoutError
+        monkeypatch.setattr(gate, 'asyncio', Shim())
+
+    def fire(self):
+        self.fired.set()
+
+
+class HeldProbe:
+    """Holds the loop callback the worker enqueues for the consumer's AUTHORIZATION-ONLY credential probe (the
+    ``loop_probe`` closure of the gate module) until the test releases it. Paid-gate callbacks are not held."""
+
+    def __init__(self, monkeypatch, which=1):
+        self.loop = asyncio.get_running_loop()
+        self.enqueued = threading.Event()
+        self.held = None
+        self.which = which
+        self.seen = 0
+        self.real = self.loop.call_soon_threadsafe
+
+        def intercept(callback, *args, **kwargs):
+            if 'loop_probe' in getattr(callback, '__qualname__', ''):
+                self.seen += 1
+                if self.seen == self.which:
+                    self.held = callback
+                    self.enqueued.set()
+                    return None
+            return self.real(callback, *args, **kwargs)
+        monkeypatch.setattr(self.loop, 'call_soon_threadsafe', intercept)
+
+    async def wait_enqueued(self):
+        assert await asyncio.to_thread(self.enqueued.wait, 10)
+
+    async def release(self):
+        done = asyncio.Event()
+
+        def run():
+            self.held()
+            done.set()
+        self.real(run)
+        await done.wait()
+
+
+class ThreadedCallbacks(support.Callbacks):
+    """The consumer's callbacks, recording the thread each ran on (they must run on the consumer's own loop thread)."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.threads = []
+
+    def authorize(self):
+        self.threads.append(threading.get_ident())
+        super().authorize()
+
+    def before_send(self):
+        self.threads.append(threading.get_ident())
+        super().before_send()
