+class Converter:
+    """FAULT INJECTION at the converter's process boundary (``tools.tts_tool_delivery._ffmpeg_run``) and nowhere else.
+
+    The provider request, the answer parser, the WAV wrapper, the chunk bookkeeping and the cleanup are the real code; only the
+    ffmpeg process result is scripted, so a conversion failure is deterministic. The real ffmpeg success path is proved by
+    ``test_each_provider_sends_once_through_the_gate_with_the_stock_request[gemini]`` and the multi-chunk join tests."""
+
+    def __init__(self, monkeypatch, returncode, writes_empty_output=False):
+        import subprocess
+        self.calls = []
+        self.wav_paths = []
+
+        def run(ffmpeg, args, **kwargs):
+            self.calls.append(args)
+            self.wav_paths.append(args[args.index('-i') + 1])
+            if writes_empty_output:
+                open(args[-1], 'wb').close()
+            return subprocess.CompletedProcess([ffmpeg, *args], returncode, stdout=b'', stderr=b'synthetic ffmpeg failure')
+        monkeypatch.setattr('tools.tts_tool_delivery._ffmpeg_run', run)
+
