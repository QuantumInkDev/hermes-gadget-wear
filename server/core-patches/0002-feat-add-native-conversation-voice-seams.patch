+"""Native voice seam: configured speech-to-text sent once, truthful outcomes, no leaks.
+
+Real OpenAI SDK, real httpx client and real ``requests`` session over a synthetic network transport
+(``native_voice_support``); the profile's STT configuration is the real ``config.yaml`` read at call
+time. Counts below are requests that reached the transport. The stock-path counterparts (2 and 4
+requests for the same failures) are recorded in ``tests/tools/test_native_voice_stock_transport.py``.
+"""
+import asyncio
+import logging
+import threading
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-native-stt'
+
+
+def openai_config(**stt):
+    return {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                    'openai': {'api_key': KEY, 'model': 'whisper-1'}, **stt}}
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def configured():
+    support.write_config(get_hermes_home(), openai_config())
+
+
+async def seam(clip, callbacks, deadline_s=30):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                         deadline_s=deadline_s)
+
+
+def words(text='hello world'):
+    return ('ok', {'text': text, 'json': False})
+
+
+@pytest.mark.asyncio
+async def test_configured_success_sends_once_after_before_send(monkeypatch, clip, configured):
+    events = []
+    cb = support.Callbacks(events)
+    wire = support.Wire([words()], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'hello world', 'configured', 'completed')
+    assert wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    assert wire.requests[0].headers['authorization'] == f'Bearer {KEY}'
+
