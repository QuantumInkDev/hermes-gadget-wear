+async def test_the_sdks_unused_async_client_is_never_created_so_nothing_finalizes_on_the_consumers_loop(
+        monkeypatch, clip, sdk):
+    """M4: the pinned SDK builds an ``httpx.AsyncClient`` we never use and its finalizer schedules ``aclose`` on whatever
+    loop is running when the SDK object is collected (the gateway's, or a throwaway one per worker thread). The native
+    client supplies its own inert async client instead, so no async client exists to close, and no warning is raised."""
+    import asyncio
+    import gc
+    import warnings
+    import httpx
+    gc.collect()  # SDK objects left by earlier (stock) tests of this process finalize NOW, before the spy and not as our evidence
+    for _ in range(5):
+        await asyncio.sleep(0)
+    closes = []
+    real = httpx.AsyncClient.aclose
+
+    async def spy(self):
+        closes.append(self)
+        return await real(self)
+    monkeypatch.setattr(httpx.AsyncClient, 'aclose', spy)
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {'text': 'native words'})])
+    with warnings.catch_warnings():
+        warnings.simplefilter('error')  # any ResourceWarning / loop warning raised while collecting is a failure
+        with support.provider_wire(monkeypatch, wire):
+            heard = await hear(clip, support.Callbacks())
+        sdk.clear()
+        gc.collect()
+        for _ in range(5):
+            await asyncio.sleep(0)  # let anything the finalizers scheduled on THIS loop run
+    assert heard.state == 'transcribed' and closes == []
