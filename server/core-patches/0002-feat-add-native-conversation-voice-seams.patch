@@ -0,0 +1,198 @@
+"""Native voice seam, Mistral: Stop and deadline fences, no late callbacks or files, and no hidden SDK side channel.
+
+The REAL pinned ``mistralai`` SDK over a synthetic transport. Deterministic: the loop callback that runs the consumer's
+``authorize`` / ``before_send`` is held (or the transport is held) with events, never with sleeps.
+"""
+import asyncio
+import logging
+import os
+import threading
+
+import pytest
+
+from tests.gateway import mistral_voice_support as mistral
+from tests.gateway import native_voice_support as support
+from tests.gateway.mistral_voice_support import HeldGate, hear, speak, watch_worker
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def sdk(monkeypatch):
+    return mistral.observe_sdk(monkeypatch)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline'])
+async def test_stt_callbacks_never_run_after_stop_or_the_deadline_while_the_gate_is_held(monkeypatch, clip, sdk, how):
+    from gateway import session_native_voice_stt as stt_module
+    mistral.stt_profile()
+    finished = watch_worker(monkeypatch, stt_module, '_configured')
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {})])
+    held = HeldGate(monkeypatch)
+    with support.provider_wire(monkeypatch, wire):
+        if how == 'cancel':
+            task = asyncio.create_task(hear(clip, cb))
+            await held.wait_enqueued()
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            result = await hear(clip, cb, deadline_s=0.3)
+            assert (result.state, result.provider) == ('timeout', 'not_started')
+        await held.release()
+        assert await asyncio.to_thread(finished.wait, 10)
+    assert cb.authorize_calls == 1 and cb.before_send_calls == 0 and wire.count == 0  # only the pre-work check
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline'])
+async def test_tts_callbacks_never_run_after_stop_or_the_deadline_while_the_gate_is_held(monkeypatch, out, sdk, how):
+    from gateway import session_native_voice_tts as tts_module
+    mistral.tts_profile()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {})])
+    held = HeldGate(monkeypatch)
+    with support.provider_wire(monkeypatch, wire):
+        if how == 'cancel':
+            task = asyncio.create_task(speak(out, cb))
+            await held.wait_enqueued()
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            result = await speak(out, cb, deadline_s=0.3)
+            assert (result.state, result.provider) == ('timeout', 'not_started')
+        await held.release()
+        assert await asyncio.to_thread(finished.wait, 10)
+    assert cb.authorize_calls == 1 and cb.before_send_calls == 0 and wire.count == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_a_stalled_provider_ends_only_our_wait_and_the_late_worker_does_nothing(monkeypatch, clip, out, sdk):
+    from gateway import session_native_voice_stt as stt_module
+    from gateway import session_native_voice_tts as tts_module
+    mistral.stt_profile()
+    finished = watch_worker(monkeypatch, stt_module, '_configured')
+    release = threading.Event()
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {})], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            heard = await hear(clip, cb, deadline_s=0.5)
+            calls = (cb.authorize_calls, cb.before_send_calls)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert (heard.state, heard.transcript, heard.provider, wire.count) == ('timeout', None, 'unknown', 1)
+    assert {t['read'] for t in wire.timeouts()} == {0.5}  # the policy timeout never exceeds the deadline
+    assert calls == (2, 1) and (cb.authorize_calls, cb.before_send_calls) == calls  # nothing after the result
+
+    mistral.tts_profile()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    release = threading.Event()
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3late'})], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            spoken = await speak(out, cb, deadline_s=0.5)
+            calls = (cb.authorize_calls, cb.before_send_calls)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert (spoken.state, spoken.path, spoken.provider, wire.count) == ('timeout', None, 'unknown', 1)
+    assert (cb.authorize_calls, cb.before_send_calls) == calls and os.listdir(out) == []  # a fenced worker leaves no file
+
+
+@pytest.mark.asyncio
+async def test_stop_while_the_request_is_in_flight_leaves_no_file_and_no_late_callback(monkeypatch, out, sdk):
+    from gateway import session_native_voice_tts as tts_module
+    mistral.tts_profile()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    release = threading.Event()
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3late'})], hold=release)
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb))
+            assert await asyncio.to_thread(wire.entered.wait, 10)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            calls = (cb.authorize_calls, cb.before_send_calls)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert wire.count == 1 and calls == (2, 1) and (cb.authorize_calls, cb.before_send_calls) == calls
+    assert os.listdir(out) == []
+
+
+# --- no hidden side channel of the pinned SDK ------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_an_sdk_telemetry_opt_in_in_the_environment_cannot_add_a_hidden_export(monkeypatch, clip, out, sdk):
+    from mistralai.extra.observability import telemetry
+    loads = []
+
+    def load():
+        loads.append(1)
+        raise telemetry.TelemetryConfigurationError('exporter stand-in')
+    monkeypatch.setattr(telemetry, '_load_otel_sdk', load)
+    monkeypatch.setenv('MISTRAL_SDK_TELEMETRY', 'dedicated')
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {}), ('ok', {'audio': b'ID3t'})])
+    with support.provider_wire(monkeypatch, wire):
+        heard = await hear(clip, support.Callbacks())
+        mistral.tts_profile()
+        spoken = await speak(out, support.Callbacks())
+    assert (heard.state, spoken.state, wire.count) == ('transcribed', 'synthesized', 2)
+    assert loads == []  # the SDK's trace exporter (a second outbound path carrying the key) is never built
+
+
+@pytest.mark.asyncio
+async def test_sdk_debug_logging_in_the_environment_cannot_leak_keys_audio_or_transcripts(monkeypatch, clip, out, sdk, caplog):
+    monkeypatch.setenv('MISTRAL_DEBUG', '1')
+    caplog.set_level(logging.DEBUG)
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {'text': 'private transcript words'}), ('ok', {'audio': b'ID3private-audio'}),
+                                ('status', 500), ('status', 500)])
+    with support.provider_wire(monkeypatch, wire):
+        await hear(clip, support.Callbacks())
+        mistral.tts_profile()
+        await speak(out, support.Callbacks())
+        await speak(out, support.Callbacks())
+        mistral.stt_profile()
+        await hear(clip, support.Callbacks())
+    seen = '\n'.join(f'{r.name} {r.getMessage()}' for r in caplog.records)
+    for secret in (mistral.KEY, 'Bearer', 'private transcript words', 'private-audio', 'synthetic provider failure',
+                   'clip.wav', 'caller-output'):
+        assert secret not in seen, secret
+    assert not [r for r in caplog.records if r.name.startswith('mistralai')]
+
+
+@pytest.mark.asyncio
+async def test_a_native_call_never_installs_the_sdk(monkeypatch, clip, out, sdk):
+    installs = []
+    monkeypatch.setattr('pm.ensure_import', lambda extra, *a, **k: installs.append(extra))
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {}), ('ok', {'audio': b'ID3x'})])
+    with support.provider_wire(monkeypatch, wire):
