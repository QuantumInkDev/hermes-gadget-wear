+
+def _native_prep_ready(binary: Optional[str]) -> bool:
+    """Native call: may a preparation child be started? PURE capability check that records nothing. Stop or the deadline is
+    checked FIRST (it raises, it is never a capability skip); then the tool must be executable, the call must carry the
+    deadline and output cap the runner requires, and this host must have a qualified launcher."""
+    native_send_policy.check_alive()
+    policy = native_send_policy.current()
+    if policy is None or policy.deadline is None or policy.max_output_bytes is None or not binary or not os.access(binary, os.X_OK):
+        return False
+    from tools.native_local_launcher import qualified_prefix
+    return qualified_prefix() is not None
+
+
+def _run_native_prep(argv: list, *, output: Optional[str] = None, probe: bool = False) -> subprocess.CompletedProcess:
+    """One preparation child under the native bounds. ``output`` is watched while the child runs and checked after it; ``probe``
+    marks measurements and OPTIONAL work, which are not a local launch of the call (``False``: required work, like the managed
+    normalizer). The deadline expiring is a ``timeout`` refusal, never a retry with another candidate."""
+    from tools.tts_command_provider import run_native_argv
+    from tools.tts_tool_local import _ENGINE_STREAM_BYTES, _native_child_env, _remaining
+    policy = native_send_policy.current()
+
+    def watch() -> Optional[str]:
+        try:
+            return "too_long" if output is not None and os.path.getsize(output) > NATIVE_PREP_MAX_BYTES else None
+        except OSError:
+            return None
+    cwd = tempfile.mkdtemp(prefix="hermes-native-prep-") if output is None else os.path.dirname(output)
+    try:
+        result = run_native_argv(argv, timeout=_remaining(policy), env=_native_child_env(), cwd=cwd, watch=watch,
