+"""Native voice seam: an engine that RAISES after entering the provider invocation without a gated send.
+
+A hooked SDK that passes the injected-client identity proof and then sends through a path the gate never saw
+may also fail (a 500, a parse error). The consumer then has no durable in-flight record, so the result must be
+``failed`` with ``provider='unknown'`` (never ``unavailable``/``not_started``) and a configured-STT failure of
+that kind must not run the local fallback. Failures BEFORE the invocation is entered (missing key, an SDK that
+cannot be told "no retry", a refusal) stay truthful ``unavailable``/``not_started``.
+
+The diverging SDKs below are labelled stand-ins that misbehave on purpose; the first chunk of the later-chunk
+control and every pre-entry/known-failure control use the REAL pinned SDK or the real OpenAI client. Only the
+network bytes are synthetic.
+"""
+import os
+import types
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-exception-accounting'
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+async def speak(out, callbacks, text='Hello there, friend.', deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+def elevenlabs_profile(**section):
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs', 'elevenlabs': section}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+
+
+class DivergesThenRaises:
+    """Labelled stand-in: reports the injected client as its sender (the identity proof PASSES), then sends once
+    through ITS OWN client over the synthetic transport, receives the provider's answer and raises."""
+
+    def __init__(self, api_key=None, timeout=None, httpx_client=None, environment=None):
+        self.own = httpx.Client()
+        self.text_to_speech = self
+        self._client_wrapper = type('W', (), {'httpx_client': type('H', (), {'httpx_client': httpx_client})()})()
+
+    def convert(self, voice_id, *, text, model_id=None, output_format=None, request_options=None):
+        response = self.own.post('https://api.elevenlabs.io/v1/diverged', json={'text': text})
+        response.raise_for_status()
+        yield response.content
+
+
+class NoRequestOptions(DivergesThenRaises):
+    """Labelled stand-in: passes the identity proof but cannot be told "no retry" (no ``request_options``)."""
+
+    def convert(self, voice_id, *, text, model_id=None, output_format=None):
+        yield b'ID3never'
+
+
+@pytest.mark.asyncio
+async def test_a_diverging_tts_sdk_that_raises_after_its_own_send_is_failed_unknown(monkeypatch, out):
+    elevenlabs_profile()
+    monkeypatch.setattr('tools.tts_tool._import_elevenlabs', lambda: DivergesThenRaises)
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'unknown')
+    assert wire.count == 1 and cb.before_send_calls == 0 and os.listdir(out) == []
+    assert support.SECRET not in repr(result)
+
+
+@pytest.mark.asyncio
+async def test_a_later_chunk_that_diverges_and_raises_leaves_the_aggregate_unknown_and_cleans_up(monkeypatch, out):
+    pytest.importorskip('elevenlabs')
+    from elevenlabs.client import ElevenLabs
+    elevenlabs_profile(max_text_length=60)
+    built = []
+
+    def importer():
+        built.append(1)
+        # call 1 is the engine-availability probe, call 2 builds chunk 1 (real, gated), call 3 builds chunk 2 (diverges)
+        return ElevenLabs if len(built) <= 2 else DivergesThenRaises
+    monkeypatch.setattr('tools.tts_tool._import_elevenlabs', importer)
+    text = ('The first sentence is deliberately rather long. The second sentence is also fairly long here. '
+            'The third sentence closes out the whole text.')
+    cb = support.Callbacks()
+    wire = support.Wire([('ok', {'audio': b'ID3first'}), ('status', 500), ('ok', {'audio': b'ID3never'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=text)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'unknown')
+    assert len(built) == 3, 'no third chunk is attempted after the unaccounted one'
+    assert wire.count == 2 and cb.before_send_calls == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_a_diverging_stt_client_that_raises_is_failed_unknown_and_never_falls_back(monkeypatch, tmp_path):
+    import openai
+
+    class Diverging(openai.OpenAI):
+        """Labelled stand-in: ``_client`` IS the injected client (identity proof passes); the request goes elsewhere."""
+
+        def __init__(self, *args, http_client=None, **kwargs):
+            super().__init__(*args, http_client=http_client, **kwargs)
+            own = httpx.Client()
+
+            class Transcriptions:
+                def create(self, **kw):
+                    response = own.post('https://api.openai.com/v1/audio/transcriptions', content=b'x')
+                    response.raise_for_status()
+                    return response.text
+            self.audio = types.SimpleNamespace(transcriptions=Transcriptions())
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                                                     'openai': {'api_key': KEY, 'model': 'whisper-1'}}})
+    monkeypatch.setattr(openai, 'OpenAI', Diverging)
+    fallback = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: fallback.append(path) or {'success': True, 'transcript': 'local words'})
+    clip = support.write_wav(tmp_path / 'clip.wav')
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=30)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'unknown')
+    assert wire.count == 1 and cb.before_send_calls == 0 and fallback == []
+
+
+@pytest.mark.asyncio
+async def test_pre_entry_failures_stay_unsent(monkeypatch, out, tmp_path):
+    cb = support.Callbacks()
+    wire = support.Wire([('ok', {'audio': b'ID3x'})])
+    with support.provider_wire(monkeypatch, wire):
+        # no API key: raised before any client exists
+        support.write_config(get_hermes_home(), {'tts': {'provider': 'elevenlabs'}})
+        missing = await speak(out, cb)
+        # an SDK that passes the identity proof but cannot be told "no retry": refused before the invocation
+        elevenlabs_profile()
+        monkeypatch.setattr('tools.tts_tool._import_elevenlabs', lambda: NoRequestOptions)
+        options = await speak(out, cb)
+        # STT without a key
+        support.write_config(get_hermes_home(), {'stt': {'provider': 'openai', 'cloud_trim_silence': False}})
+        clip = support.write_wav(tmp_path / 'clip.wav')
+        heard = await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=30)
+    assert [(r.state, r.provider) for r in (missing, options)] == [('unavailable', 'not_started')] * 2
+    assert (heard.state, heard.provider) == ('unavailable', 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_known_gated_failures_keep_their_truthful_accounting_and_the_fallback(monkeypatch, tmp_path):
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                                                     'openai': {'api_key': KEY, 'model': 'whisper-1'}}})
+    fallback = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: fallback.append(path) or {'success': True, 'transcript': ' local words '})
+    clip = support.write_wav(tmp_path / 'clip.wav')
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=30)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'local words', 'local_fallback', 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1 and len(fallback) == 1
