index 0000000000000000000000000000000000000000..32d4685aac0932c8598b7b4c007e8f7f6f50fdcf
--- /dev/null
+++ b/tests/tools/test_native_send_policy_unit.py
@@ -0,0 +1,83 @@
+"""Direct ``SendPolicy`` pins, with no consumer, seam or provider in between.
+
+N2: a credential-phase refusal CLOSES the policy, and that close is sticky on its own: a later ``begin()`` and a later
+probe are refused ``closed`` without asking the gate or the probe again, whatever the consumer would now answer.
+Also pins the per-call custom-route admission and the command bounds a native call imposes.
+"""
+import time
+
+import pytest
+
+from tools import native_send_policy
+from tools.native_send_policy import NativeSendRefused, SendPolicy
+
+
+def _policy(**kw):
+    return SendPolicy(timeout_s=5.0, providers=frozenset({'openai'}), **kw)
+
+
+@pytest.mark.parametrize('reason', ['refused', 'cancelled', 'timeout', 'closed'])
+def test_a_probe_refusal_closes_the_policy_and_every_later_send_or_probe_is_refused_closed(reason):
+    policy = _policy()
+    gate_calls, probe_calls = [], []
+
+    def probe():
+        probe_calls.append(1)
+        if len(probe_calls) == 1:
+            raise NativeSendRefused(reason)
+    policy.set_gate(lambda: gate_calls.append(1))
+    policy.set_credential_probe(probe)
+
+    with pytest.raises(NativeSendRefused) as first:
+        policy.probe_credentials()
+    assert first.value.reason == reason
+    assert policy.closed is True and policy.refusal == reason
+
+    with pytest.raises(NativeSendRefused) as send:
+        policy.begin()
+    with pytest.raises(NativeSendRefused) as again:
+        policy.probe_credentials()
+    assert (send.value.reason, again.value.reason) == ('closed', 'closed')
+    assert gate_calls == [] and probe_calls == [1]  # the consumer is never asked again
+    assert policy.sends == 0 and policy.refusal == reason  # the first truthful reason is kept
+
+
+def test_the_credential_hook_converts_the_sticky_refusal_to_a_phase_stop():
+    policy = _policy()
+    policy.set_credential_probe(lambda: (_ for _ in ()).throw(NativeSendRefused('refused')))
+    with pytest.raises(native_send_policy.CredentialPhaseStopped):
+        policy.on_credential_request(None)
+    with pytest.raises(native_send_policy.CredentialPhaseStopped) as later:
+        policy.on_credential_request(None)
+    assert later.value.reason == 'closed'
+
+
+def test_admit_custom_adds_exactly_one_route_for_this_call_only():
+    policy, other = _policy(), _policy()
+    with pytest.raises(NativeSendRefused):
+        policy.require_provider('my-plugin')
+    policy.admit_custom('my-plugin')
+    policy.require_provider('my-plugin')
+    policy.require_provider('openai')
+    assert policy.custom == 'my-plugin' and policy.providers == frozenset({'openai'})
+    with pytest.raises(NativeSendRefused) as second:
+        policy.admit_custom('another-plugin')
+    assert second.value.reason == 'unsupported'
+    with pytest.raises(NativeSendRefused):
+        other.require_provider('my-plugin')  # never a global admission
+
+
+def test_command_bounds_exist_only_inside_a_native_call_with_a_deadline_and_a_cap():
+    assert native_send_policy.command_bounds() is None
+    deadline = time.monotonic() + 3
+    policy = _policy(max_output_bytes=4096, deadline=deadline)
+    with native_send_policy.activate(policy):
+        bounds = native_send_policy.command_bounds()
+    assert (bounds.deadline_monotonic, bounds.max_stream_bytes, bounds.argv_prefix) == (deadline, 4096, ())
+    assert bounds.closed() is False
+    policy.close()
+    assert bounds.closed() is True
+    for missing in (dict(max_output_bytes=4096), dict(deadline=deadline)):
+        with native_send_policy.activate(_policy(**missing)), pytest.raises(NativeSendRefused) as refused:
+            native_send_policy.command_bounds()
+        assert refused.value.reason == 'unsupported'
diff --git a/tests/tools/test_native_tts_engine_helper.py b/tests/tools/test_native_tts_engine_helper.py
