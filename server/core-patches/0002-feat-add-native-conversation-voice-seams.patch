@@ -0,0 +1,471 @@
+"""Native (Relay) local TTS engine helper: ONE chunk of Piper, KittenTTS or NeuTTS in a separate, launcher-wrapped child.
+
+Run only by ``tools.tts_tool_local.native_engine_chunk`` as ``[<launcher…>, sys.executable, -I, <this file>]`` (an
+isolated interpreter: no PYTHON* environment, no user site, no script-directory path entry) in a new session with a
+private empty cwd and an explicit minimal child env (offline flags set before any import). Site/.pth startup of the
+trusted interpreter still runs: isolation is not hostile-code containment. Protocol (api 1):
+
+* stdin: ONE JSON object (≤ 64 KiB) with exactly these top-level fields: ``api``, ``engine``, ``text``, ``wav_path``,
+  ``max_wav_bytes`` and the engine's option object (exact fields: :data:`OPTION_FIELDS`); anything else is refused.
+  Text travels only here: never argv, env, file names or logs.
+* stdout: ONE JSON line (≤ 4 KiB) on a private close-on-exec descriptor: ``api``, ``status`` (``ok`` | ``failed`` |
+  ``unavailable``), ``reason`` (a stable token), ``sample_rate``, ``wav_bytes``. Before anything else the helper points
+  file descriptors 1 and 2 at the null device, so vendor and native-library prints (KittenTTS prints the input text,
+  NeuTTS prints paths) never reach the parent; no traceback or text is reported.
+
+Order: request validation → runtime, then every module the engine imports at load present AND each source-backed
+distribution at its exact supported version (:data:`SUPPORTED_VERSIONS`, read from installed metadata, no import;
+missing → ``not_installed``, other version → ``unsupported_version``) → complete-cache preflight on the filesystem (no
+vendor model API is called to discover anything) → only then the vendor import and inference. Every missing
+prerequisite is ``unavailable`` before the engine runs; nothing is downloaded, installed or substituted. The global rows
+below are the 3.14 lock / KittenTTS set. NeuTTS 1.4.1 (Requires-Python <3.14; its own Requires-Dist
+``transformers==5.1.0`` and the normal ``phonemizer`` distribution) validates against its OWN engine-scoped rows
+(:data:`NEUTTS_ROWS`) instead. Source support for a <3.14 interpreter is not an installed, current or qualified runtime,
+and the managed 3.14 interpreter stays refused. The child's own ``RLIMIT_FSIZE`` bounds every file it writes while it
+runs. Trust: installed engine packages are trusted code; network denial is the launcher's job, not this file's.
+"""
+from __future__ import annotations
+
+import importlib.metadata
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+API = 1
+MAX_REQUEST_BYTES = 64 * 1024
+MAX_REPLY_BYTES = 4096
+MAX_TEXT_CHARS = 5000  # the largest stock per-engine cap (piper); the parent splits to the engine's own cap
+ENGINES = ('piper', 'kittentts', 'neutts')
+OPTION_FIELDS = {
+    'piper': {'model_path', 'config_path', 'use_cuda', 'speaker_id', 'knobs'},
+    'kittentts': {'repo_id', 'voice', 'speed', 'clean_text'},
+    'neutts': {'original_repo', 'device', 'ref_audio_path', 'ref_text_path', 'language'},
+}
+PIPER_PHONEME_TYPES = frozenset({'espeak', 'text', 'hebrew'})  # pinyin/japanese/thai: unsupported sub-configurations
+NEUCODEC_REPO = 'neuphonic/neucodec'  # the stock Hermes helper's codec, kept (no ONNX swap)
+NEUCODEC_FILES = ('pytorch_model.bin', 'meta.yaml', 'config.json')  # neucodec 0.0.4 model.py:69-92 + hub mixin config
+W2V_BERT_REPO = 'facebook/w2v-bert-2.0'  # NeuCodec.__init__ nested encoder + feature extractor (model.py:29-34)
+PERTH_FILES = ('hparams.yaml', 'id.txt', 'perth_net_250000.pth.tar')
+# The source-backed combination this helper's lower-level calls and cache conclusions were verified against (staged
+# inert sources and the locked dependency set). Any other installed version is refused, never guessed at. These GLOBAL rows
+# serve Piper and KittenTTS; NeuTTS's differing rows are the engine-scoped NEUTTS_ROWS below (its 'transformers' and
+# 'phonemizer' rows here are never consulted for it).
+SUPPORTED_VERSIONS = {'piper-tts': '1.8.0', 'kittentts': '0.8.1', 'neutts': '1.4.1', 'huggingface-hub': '1.24.0',
+                      'transformers': '5.17.0', 'neucodec': '0.0.4', 'resemble-perth': '1.0.1', 'misaki': '0.9.4',
+                      'phonemizer-fork': '3.3.2', 'espeakng-loader': '0.2.4', 'num2words': '0.5.14'}
+# Import name → the distribution that must provide it (metadata read only). Modules without a SUPPORTED_VERSIONS entry
+# are required present (metadata and module) at any version: the helper relies on no version-specific API of theirs.
+DISTRIBUTIONS = {'piper': 'piper-tts', 'kittentts': 'kittentts', 'neutts': 'neutts', 'huggingface_hub': 'huggingface-hub',
+                 'transformers': 'transformers', 'neucodec': 'neucodec', 'perth': 'resemble-perth', 'misaki': 'misaki',
+                 'phonemizer': 'phonemizer-fork', 'espeakng_loader': 'espeakng-loader', 'num2words': 'num2words',
+                 'onnxruntime': 'onnxruntime', 'numpy': 'numpy', 'soundfile': 'soundfile', 'spacy': 'spacy',
+                 'torch': 'torch', 'torchaudio': 'torchaudio', 'librosa': 'librosa', 'llama_cpp': 'llama-cpp-python',
+                 'einops': 'einops', 'local_attention': 'local-attention', 'torchtune': 'torchtune',
+                 'vector_quantize_pytorch': 'vector-quantize-pytorch'}
+# Every module the engine path imports at module load (vendor source lines in the docstrings of the preflights).
+CHAINS = {
+    'piper': ('piper', 'onnxruntime', 'numpy'),  # piper/voice.py:14-21
+    # kittentts/onnx_model.py:1-6 → misaki/en.py:4,10,12-13 (num2words, spacy, transformers, torch) + misaki.espeak
+    'kittentts': ('kittentts', 'misaki', 'num2words', 'spacy', 'transformers', 'torch', 'phonemizer', 'espeakng_loader',
+                  'onnxruntime', 'numpy', 'soundfile', 'huggingface_hub'),
+    # neutts/neutts.py (librosa, torch, transformers, phonemizer, neucodec, llama_cpp at the GGUF backbone) → neucodec
+    # model.py/modules (torchaudio, einops, local_attention, torchtune, vector_quantize_pytorch, huggingface_hub)
+    'neutts': ('neutts', 'llama_cpp', 'neucodec', 'transformers', 'torch', 'torchaudio', 'librosa', 'phonemizer',
+               'soundfile', 'numpy', 'huggingface_hub', 'einops', 'local_attention', 'torchtune',
+               'vector_quantize_pytorch'),
+}
+# NeuTTS 1.4.1's own METADATA (Requires-Dist transformers==5.1.0 and phonemizer>=3.0.0, the NORMAL distribution) differs
+# from the global rows above. Import name -> (distribution, accepted versions); an empty tuple is "present, any version".
+# Only the two normal phonemizer releases whose sources were read (3.3.0, 3.4.0: identical EspeakBackend /
+# EspeakWrapper.set_library / phonemize surface as NeuTTS calls it) are accepted; their phonemization of decimal numerals
+# differs upstream and neither release is forced.
+NEUTTS_ROWS = {'transformers': ('transformers', ('5.1.0',)), 'phonemizer': ('phonemizer', ('3.3.0', '3.4.0'))}
+# Modules NeuTTS's `from phonemizer.backend import EspeakBackend` imports at load, present at any version (no version is
+# guessed); used only through require_packages rows, chosen by neutts_load_modules.
+NEUTTS_LOAD_ROWS = {'joblib': ('joblib', ()), 'typing_extensions': ('typing-extensions', ()), 'dlinfo': ('dlinfo', ()),
+                    'segments': ('segments', ())}
+REQUEST_FIELDS = frozenset({'api', 'engine', 'text', 'wav_path', 'max_wav_bytes'})
+
+
+class Unavailable(Exception):
+    """A prerequisite is missing: refused before the engine runs (``reason`` is a stable token)."""
+
+    def __init__(self, reason: str):
+        super().__init__(reason)
+        self.reason = reason
+
+
+# ---------------------------------------------------------------- request ----
+def parse_request(raw: bytes) -> dict[str, Any]:
+    """The validated request, or ``Unavailable('invalid_request')``."""
+    if len(raw) > MAX_REQUEST_BYTES:
+        raise Unavailable('invalid_request')
+    try:
+        req = json.loads(raw.decode('utf-8'))
+    except (UnicodeDecodeError, ValueError):
+        raise Unavailable('invalid_request') from None
+    engine = req.get('engine') if isinstance(req, dict) else None
+    if engine not in ENGINES or req.get('api') != API or set(req) != REQUEST_FIELDS | {engine}:
+        raise Unavailable('invalid_request')
+    text, wav, cap, opts = req.get('text'), req.get('wav_path'), req.get('max_wav_bytes'), req.get(engine)
+    if (not isinstance(text, str) or not text.strip() or len(text) > MAX_TEXT_CHARS
+            or not isinstance(wav, str) or not os.path.isabs(wav) or not wav.endswith('.wav')
+            or not os.path.isdir(os.path.dirname(wav)) or os.path.lexists(wav)
+            or isinstance(cap, bool) or not isinstance(cap, int) or not 44 < cap <= 64 * 1024 * 1024
+            or not isinstance(opts, dict) or set(opts) != OPTION_FIELDS[engine]):
+        raise Unavailable('invalid_request')
+    return req
+
+
+# ------------------------------------------------------------- filesystem ----
+def regular_file(path: Any) -> Optional[str]:
+    """``path`` when it resolves to an existing regular non-empty file (a cache symlink to a blob is fine), else None."""
+    if not isinstance(path, str) or not path:
+        return None
+    real = os.path.realpath(path)
+    try:
+        return path if os.path.isfile(real) and os.path.getsize(real) > 0 else None
+    except OSError:
+        return None
+
+
+def package_dir(name: str) -> Optional[Path]:
+    """The installed top-level package directory, found WITHOUT importing it; None when absent."""
+    try:
+        spec = importlib.util.find_spec(name)
+    except (ImportError, ValueError):
+        return None
+    locations = list(spec.submodule_search_locations or []) if spec is not None else []
+    return Path(locations[0]) if locations else None
+
+
+def _version_of(distribution: str) -> str:
+    """The installed distribution's version from its metadata: no import of the package."""
+    return importlib.metadata.version(distribution)
+
+
+def require_packages(names: tuple[str, ...], find: Callable[[str], bool],
+                     version_of: Optional[Callable[[str], str]] = None,
+                     rows: Optional[dict[str, tuple[str, tuple[str, ...]]]] = None) -> None:
+    """Every module present (spec found, no import) with its distribution's metadata, at the supported version when
+    one is pinned. Missing → ``not_installed``; other version → ``unsupported_version``. ``rows`` (engine-scoped, import
+    name → (distribution, accepted versions)) replace the global row for that name only; without them the global tables
+    rule."""
+    version_of = version_of or _version_of
+    rows = rows or {}
+    for name in names:
+        if name in rows:
+            distribution, wanted = rows[name]
+        else:
+            distribution = DISTRIBUTIONS[name]
+            wanted = (SUPPORTED_VERSIONS[distribution],) if distribution in SUPPORTED_VERSIONS else ()
+        try:
+            installed = version_of(distribution)
+        except importlib.metadata.PackageNotFoundError:
+            raise Unavailable('not_installed') from None
+        if not find(name):
+            raise Unavailable('not_installed')
+        if wanted and installed not in wanted:
+            raise Unavailable('unsupported_version')
+
+
+def neutts_load_modules(phonemizer_version: str, platform: str = sys.platform) -> tuple[str, ...]:
+    """The extra modules NeuTTS's ``from phonemizer.backend import EspeakBackend`` (neutts/phonemizers.py:2) imports at
+    load, from the staged phonemizer sources: ``joblib`` (backend/base.py:23) and ``typing_extensions``
+    (backend/espeak/language_switch.py:41) in every accepted release; ``dlinfo`` except on Windows
+    (backend/espeak/api.py:30-32, ``if sys.platform != 'win32'``); ``segments`` only in 3.3.0, which imports it eagerly
+    (backend/__init__.py:22; 3.4.0 imports it lazily, so it is NOT required there). ``platform`` is data: the Windows arm
+    is a pure function, not a faked host."""
+    return ('joblib', 'typing_extensions', *(() if platform == 'win32' else ('dlinfo',)),
+            *(('segments',) if phonemizer_version == '3.3.0' else ()))
+
+
+def require_neutts_packages(find: Callable[[str], bool], version_of: Optional[Callable[[str], str]] = None,
+                            platform: str = sys.platform) -> None:
+    """NeuTTS's prerequisites, before any vendor, cache or inference call: the chain against :data:`NEUTTS_ROWS`; then
+    BOTH ``phonemizer`` and ``phonemizer-fork`` metadata present is ambiguous (they share the ``phonemizer`` package
+    directory, so metadata cannot say whose code an import loads) and is refused as ``unsupported_version`` (fork-only is
+    already ``not_installed``); then the known load-time modules of the installed phonemizer release. Metadata and spec
+    probes only: nothing is imported."""
+    version_of = version_of or _version_of
+    require_packages(CHAINS['neutts'], find, version_of, rows=NEUTTS_ROWS)
+    try:
+        version_of('phonemizer-fork')
+    except importlib.metadata.PackageNotFoundError:
+        pass
+    else:
+        raise Unavailable('unsupported_version')
+    modules = neutts_load_modules(version_of(NEUTTS_ROWS['phonemizer'][0]), platform)
+    require_packages(modules, find, version_of, rows=NEUTTS_LOAD_ROWS)
+
+
+def optional_perth(pkg: Optional[Path], version_of: Optional[Callable[[str], str]] = None) -> Optional[Path]:
+    """The optional watermarker: absent keeps stock semantics (None); an installed one must be the supported version
+    with its metadata, or the call is refused — it can never silently lose watermarking."""
+    if pkg is None:
+        return None
+    version_of = version_of or _version_of
+    try:
+        installed = version_of(DISTRIBUTIONS['perth'])
+    except importlib.metadata.PackageNotFoundError:
+        raise Unavailable('unsupported_version') from None
+    if installed != SUPPORTED_VERSIONS['resemble-perth']:
+        raise Unavailable('unsupported_version')
+    return pkg
+
+
+def _installed(name: str) -> bool:
+    try:
+        return importlib.util.find_spec(name) is not None
+    except (ImportError, ValueError):
+        return False
+
+
+class HubCache:
+    """Read-only view of the Hugging Face cache through the installed hub's own ``try_to_load_from_cache`` (a pure
+    filesystem lookup in huggingface_hub 1.24.0, file_download.py:1469-1559) — no HTTP, no download, no global scan."""
+
+    def __init__(self, cache_dir: Optional[str] = None):
+        from huggingface_hub import try_to_load_from_cache
+        from huggingface_hub import constants
+        self._lookup = try_to_load_from_cache
+        self.cache_dir = cache_dir or constants.HF_HUB_CACHE
+
+    def file(self, repo_id: str, filename: str) -> Optional[str]:
+        found = self._lookup(repo_id, filename, cache_dir=self.cache_dir)
+        return regular_file(found) if isinstance(found, str) else None
+
+    def snapshot_dir(self, repo_id: str) -> Optional[Path]:
+        """``<cache>/models--org--name/snapshots/<refs/main>``, resolved exactly as ``try_to_load_from_cache`` does."""
+        repo = Path(self.cache_dir) / ('models--' + repo_id.replace('/', '--'))
+        try:
+            revision = (repo / 'refs' / 'main').read_text().strip()
+        except OSError:
+            return None
+        snap = repo / 'snapshots' / revision
+        return snap if revision and snap.is_dir() else None
+
+
+# ---------------------------------------------------------------- preflight ----
+def preflight_piper(opts: dict[str, Any], pkg: Optional[Path]) -> dict[str, Any]:
+    """Complete local voice + the phoneme resources its type needs (piper 1.8.0 voice.py:202-300)."""
+    if pkg is None:
+        raise Unavailable('not_installed')
+    model, config_path = regular_file(opts['model_path']), regular_file(opts['config_path'])
+    if model is None or not model.endswith('.onnx') or config_path is None:
+        raise Unavailable('model_not_cached')
+    try:
+        config = json.loads(Path(config_path).read_text(encoding='utf-8'))
+        phoneme_type = config.get('phoneme_type', 'espeak')
+        espeak_voice = config['espeak']['voice']
+    except (OSError, ValueError, KeyError, TypeError, AttributeError):
+        raise Unavailable('invalid_voice_config') from None
+    if phoneme_type not in PIPER_PHONEME_TYPES:
+        raise Unavailable('unsupported_phoneme_type')
+    needed: list[Path] = []
+    if phoneme_type == 'espeak':
+        if not list(pkg.glob('espeakbridge*.so')) or not (pkg / 'espeak-ng-data').is_dir():
+            raise Unavailable('espeak_missing')
+        if espeak_voice == 'ar':  # Arabic runs the bundled Tashkeel diacritizer first (voice.py:284-291)
+            needed += [pkg / 'tashkeel' / n for n in ('model.onnx', 'input_id_map.json', 'target_id_map.json',
+                                                      'hint_id_map.json')]
+    if phoneme_type == 'hebrew':
+        needed.append(pkg / 'hebrew' / 'nakdimon.onnx')
+    if any(regular_file(str(path)) is None for path in needed):
+        raise Unavailable('bundled_resource_missing')
+    return {'model_path': model, 'config_path': config_path}
+
+
+def preflight_kittentts(opts: dict[str, Any], hub: Any, loader: Optional[Path]) -> dict[str, Any]:
+    """config.json → model/voices from the cache (KittenTTS 0.8.1 get_model.py:68-96) + the espeak library/data that
+    ``misaki.espeak`` loads at import (espeakng_loader 0.2.4 __init__.py:6-15)."""
+    if loader is None or regular_file(str(loader / {'darwin': 'libespeak-ng.dylib', 'win32': 'espeak-ng.dll'}.get(
+            sys.platform, 'libespeak-ng.so'))) is None or not (loader / 'espeak-ng-data').is_dir():
+        raise Unavailable('espeak_missing')
+    repo = opts['repo_id']
+    config_path = hub.file(repo, 'config.json')
+    if config_path is None:
+        raise Unavailable('model_not_cached')
+    try:
+        config = json.loads(Path(config_path).read_text(encoding='utf-8'))
+        model_file, voices_file = config['model_file'], config['voices']
+    except (OSError, ValueError, KeyError, TypeError):
+        raise Unavailable('invalid_model_config') from None
+    if config.get('type') not in ('ONNX1', 'ONNX2') or not all(isinstance(x, str) for x in (model_file, voices_file)):
+        raise Unavailable('invalid_model_config')
+    model_path, voices_path = hub.file(repo, model_file), hub.file(repo, voices_file)
+    if model_path is None or voices_path is None:
+        raise Unavailable('model_not_cached')
+    return {'model_path': model_path, 'voices_path': voices_path,
+            'speed_priors': config.get('speed_priors', {}), 'voice_aliases': config.get('voice_aliases', {})}
+
+
+def _no_remote_code(path: Optional[str]) -> bool:
+    try:
+        return path is not None and 'auto_map' not in json.loads(Path(path).read_text(encoding='utf-8'))
+    except (OSError, ValueError, TypeError):
+        return False
+
+
+def transformers_weights(hub: Any, repo: str) -> Optional[list[str]]:
+    """The weight files transformers selects for a hub repo, all present; None otherwise. The order is the one NeuTTS
+    1.4.1's own pin (transformers 5.1.0) uses, modeling_utils.py:580-663 with shard names
+    ``sorted(set(weight_map.values()))`` at utils/hub.py:857: safetensors, safetensors index + every shard (an index
+    whose shard is missing is final: no fall back to the bin), pytorch bin, bin index + every shard. transformers 5.17.0
+    (the global row, modeling_utils.py:638-709) selects in the same order."""
+    for single, index in (('model.safetensors', 'model.safetensors.index.json'),
+                          ('pytorch_model.bin', 'pytorch_model.bin.index.json')):
+        found = hub.file(repo, single)
+        if found is not None:
+            return [found]
+        index_path = hub.file(repo, index)
+        if index_path is not None:
+            try:
+                shards = sorted(set(json.loads(Path(index_path).read_text(encoding='utf-8'))['weight_map'].values()))
+            except (OSError, ValueError, KeyError, TypeError, AttributeError):
+                return None
+            files = [hub.file(repo, shard) for shard in shards if isinstance(shard, str)]
+            return [index_path, *files] if shards and len(files) == len(shards) and all(files) else None
+    return None
+
+
+def preflight_neutts(opts: dict[str, Any], hub: Any, pkg: Optional[Path], perth: Optional[Path],
+                     version: tuple = sys.version_info[:2]) -> dict[str, Any]:
+    """NeuTTS 1.4.1 (Requires-Python <3.14; transformers 5.1.0 loads its nested encoder): a local GGUF backbone
+    (neutts.py:227-228, never ``from_pretrained``), the stock Torch codec with its nested w2v-bert encoder and feature
+    extractor, the bundled espeak, the reference files and — when Perth is installed — its complete bundled checkpoint
+    (it would otherwise write into the package)."""
+    if version >= (3, 14):
+        raise Unavailable('runtime_unsupported')
+    if pkg is None:
+        raise Unavailable('not_installed')
+    original = opts['original_repo']
+    if not isinstance(original, str) or not original:
+        raise Unavailable('invalid_request')
+    if os.path.isfile(original):
+        if not original.endswith('.gguf') or opts['language'] is None:
+            raise Unavailable('language_required' if original.endswith('.gguf') else 'unsupported_backbone')
+        backbone = regular_file(original)
+    elif original.lower().endswith('gguf'):
+        snap = hub.snapshot_dir(original)
+        ggufs = sorted(p for p in snap.glob('*.gguf') if regular_file(str(p))) if snap is not None else []
+        if len(ggufs) != 1:
+            raise Unavailable('model_not_cached' if not ggufs else 'ambiguous_backbone')
+        backbone = str(ggufs[0])
+    else:
+        raise Unavailable('unsupported_backbone')  # transformers backbones: not a source-backed cache-only path here
+    if backbone is None:
+        raise Unavailable('model_not_cached')
+    if any(hub.file(NEUCODEC_REPO, name) is None for name in NEUCODEC_FILES):
+        raise Unavailable('codec_not_cached')
+    config, extractor = hub.file(W2V_BERT_REPO, 'config.json'), hub.file(W2V_BERT_REPO, 'preprocessor_config.json')
+    if not (_no_remote_code(config) and _no_remote_code(extractor)) or transformers_weights(hub, W2V_BERT_REPO) is None:
+        raise Unavailable('codec_encoder_not_cached')
+    lib = {'darwin': 'libespeak-ng*.dylib', 'win32': 'espeak-ng*.dll'}.get(sys.platform, 'libespeak-ng*.so*')
+    if not list(pkg.glob(lib)) or not (pkg / 'espeak-ng-data').is_dir():
+        raise Unavailable('espeak_missing')
+    if perth is not None and any(regular_file(str(perth / 'perth_net' / 'pretrained' / 'implicit' / n)) is None
+                                 for n in PERTH_FILES):
+        raise Unavailable('watermarker_incomplete')
+    ref_audio, ref_text = regular_file(opts['ref_audio_path']), regular_file(opts['ref_text_path'])
+    if ref_audio is None or ref_text is None:
+        raise Unavailable('reference_missing')
+    return {'backbone_path': backbone, 'ref_audio': ref_audio, 'ref_text': ref_text}
+
+
+# ------------------------------------------------------------------ engines ----
+def _synthesize_piper(req: dict[str, Any], resolved: dict[str, Any]) -> int:
+    import wave
+    from piper import PiperVoice, SynthesisConfig
+    opts = req['piper']
+    voice = PiperVoice.load(resolved['model_path'], config_path=resolved['config_path'], use_cuda=bool(opts['use_cuda']),
+                            download_dir=os.getcwd())  # the private empty cwd: nothing may be fetched elsewhere
+    knobs = opts['knobs']
+    syn = None if knobs is None else SynthesisConfig(speaker_id=opts['speaker_id'], **knobs)
+    with wave.open(req['wav_path'], 'wb') as wav:
+        if syn is None:
+            voice.synthesize_wav(req['text'], wav)
+        else:
+            voice.synthesize_wav(req['text'], wav, syn_config=syn)
+    return int(voice.config.sample_rate)
+
+
+def _synthesize_kittentts(req: dict[str, Any], resolved: dict[str, Any]) -> int:
+    import soundfile
+    from kittentts.onnx_model import KittenTTS_1_Onnx
+    opts = req['kittentts']
+    model = KittenTTS_1_Onnx(model_path=resolved['model_path'], voices_path=resolved['voices_path'],
+                             speed_priors=resolved['speed_priors'], voice_aliases=resolved['voice_aliases'])
+    audio = model.generate(req['text'], voice=opts['voice'], speed=opts['speed'], clean_text=opts['clean_text'])
+    soundfile.write(req['wav_path'], audio, 24000)
+    return 24000
+
+
+def _synthesize_neutts(req: dict[str, Any], resolved: dict[str, Any]) -> int:
+    import soundfile
+    from neutts.neutts import BACKBONE_LANGUAGE_MAP, NeuTTS
+    opts = req['neutts']
+    original = opts['original_repo']
+    # an explicit language ONLY for an actual local GGUF; a repo backbone keeps its ORIGINAL repo id's mapping (stock)
+    language = opts['language'] if os.path.isfile(original) else BACKBONE_LANGUAGE_MAP.get(original)
+    if language is None:
+        raise Unavailable('language_required')
+    device = opts['device']
+    tts = NeuTTS(backbone_repo=resolved['backbone_path'], backbone_device='gpu' if device == 'cuda' else device,
+                 codec_repo=NEUCODEC_REPO, codec_device=device, language=language)
+    ref_text = Path(resolved['ref_text']).read_text(encoding='utf-8-sig').strip()
+    wav = tts.infer(req['text'], tts.encode_reference(resolved['ref_audio']), ref_text)
+    soundfile.write(req['wav_path'], wav, 24000)
+    return 24000
+
+
+def run(req: dict[str, Any]) -> dict[str, Any]:
+    engine = req['engine']
+    if engine == 'piper':
+        require_packages(CHAINS['piper'], _installed)
+        resolved = preflight_piper(req['piper'], package_dir('piper'))
+        rate = _synthesize_piper(req, resolved)
+    elif engine == 'kittentts':
+        require_packages(CHAINS['kittentts'], _installed)
+        resolved = preflight_kittentts(req['kittentts'], HubCache(), package_dir('espeakng_loader'))
+        rate = _synthesize_kittentts(req, resolved)
+    else:
+        if sys.version_info[:2] >= (3, 14):
+            raise Unavailable('runtime_unsupported')  # before ANY engine import (NeuTTS 1.4.1 Requires-Python <3.14)
+        require_neutts_packages(_installed)
+        resolved = preflight_neutts(req['neutts'], HubCache(), package_dir('neutts'), optional_perth(package_dir('perth')))
+        rate = _synthesize_neutts(req, resolved)
+    size = os.path.getsize(req['wav_path']) if os.path.isfile(req['wav_path']) else 0
+    if size <= 44:
+        return reply('failed', 'empty_output')
+    return reply('ok', 'ok', rate, size)
+
+
+def reply(status: str, reason: str, sample_rate: int = 0, wav_bytes: int = 0) -> dict[str, Any]:
+    return {'api': API, 'status': status, 'reason': reason, 'sample_rate': sample_rate, 'wav_bytes': wav_bytes}
+
+
+def main() -> None:
+    result_fd = os.dup(1)  # private, close-on-exec (PEP 446): the only channel for the bounded reply
+    sink = os.open(os.devnull, os.O_WRONLY)
+    os.dup2(sink, 1)
+    os.dup2(sink, 2)
+    os.close(sink)
+    try:
+        req = parse_request(sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1))
+        import resource
+        resource.setrlimit(resource.RLIMIT_FSIZE, (req['max_wav_bytes'], req['max_wav_bytes']))
+        answer = run(req)
+    except Unavailable as exc:
+        answer = reply('unavailable', exc.reason)
+    except Exception:  # health: allow BLE001 -- an engine failure is a stable token; no traceback or text leaves
+        answer = reply('failed', 'engine_error')
+    os.write(result_fd, (json.dumps(answer) + '\n').encode('utf-8')[:MAX_REPLY_BYTES])
+    os.close(result_fd)
+
+
+if __name__ == '__main__':
+    main()
