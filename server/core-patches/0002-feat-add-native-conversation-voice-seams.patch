+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'authority'])
+async def test_an_admitted_refresh_post_persists_its_rotated_token_and_no_audio_follows(monkeypatch, out, clip, how):
+    call = Call(monkeypatch, 'tts', out, clip, **(dict(refuse_authorize_at=4) if how == 'authority' else {}))  # 4 = the paid gate
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold=release)
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.audio):
+            task = asyncio.create_task(call.start())
+            assert await asyncio.to_thread(oauth.entered.wait, 10)  # the POST passed its probe and is in flight
+            if how == 'cancel':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            seen = call.cb.authorize_calls
+            release.set()
+            if how == 'authority':
+                result = await task
+                assert (result.state, result.provider) == ('refused', 'not_started')
+            assert await asyncio.to_thread(call.finished.wait, 10)
+    finally:
+        release.set()
+    tokens = rest.read_oauth_store()['providers']['xai-oauth']['tokens']
+    assert tokens['refresh_token'] == 'rt-rotated' and tokens['access_token'] != call.access  # rotation persisted, not discarded
+    assert len(oauth.posts) == 1 and call.audio.count == 0 and call.cb.before_send_calls == 0
+    if how == 'cancel':
+        assert call.cb.authorize_calls == seen
