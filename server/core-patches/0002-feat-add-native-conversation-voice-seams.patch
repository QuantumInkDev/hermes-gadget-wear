+def format_chunks(tmp_path, count, fmt, extra, last=0.05):
+    """``count`` real MP3 files in one format: distinct tones, lengths 0.5, 0.7, ... and a deliberately TINY last chunk."""
+    spans = [round(0.5 + 0.2 * i, 1) for i in range(count - 1)] + [last]
+    paths = [tmp_path / f'c{i}.mp3' for i in range(count)]
+    audio = [support.synth_mp3(path, seconds=span, frequency=440 * (i + 1), extra=extra, **fmt)
+             for i, (path, span) in enumerate(zip(paths, spans))]
+    return audio, paths, spans
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('fmt, extra', FORMATS)
+async def test_a_legitimate_mp3_format_is_joined_with_every_audio_packet_in_order(
+        monkeypatch, tmp_path, out, scratch, launcher, fmt, extra):
+    """NI-1: the fix1 byte-budget rule rejected correct joins of several ordinary formats after payment. The completeness
+    proof is now the compressed-audio PACKET count (tags and the Info/Xing frame are not packets): the joined file holds exactly
+    the packets of the inputs, whatever the bitrate, sample rate, tag size or Info frame. NM-2: that includes the tiny last chunk."""
+    support.ffmpeg_path()
+    support.ffprobe_path()
+    support.write_config(get_hermes_home(), openai_config())
+    count = chunk_total(LONG_TEXT, 60)
+    audio, paths, spans = format_chunks(tmp_path, count, fmt, extra)
+    wire = support.Wire([('ok', {'audio': a}) for a in audio])
+    cb = support.Callbacks()
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider) == ('synthesized', 'completed') and wire.count == count == cb.before_send_calls
+    assert support.packets(result.path) == sum(support.packets(path) for path in paths)  # no audio packet lost at any boundary
+    expected = [440 * (i + 1) for i in range(count)]
+    heard = support.tone_sequence(result.path, spans[:-1])  # the tiny last chunk is too short for a stable frequency estimate
+    assert [abs(f - e) < 40 for f, e in zip(heard, expected)] == [True] * (count - 1)
+    assert os.listdir(out) == [os.path.basename(result.path)] and os.listdir(scratch) == []
+
