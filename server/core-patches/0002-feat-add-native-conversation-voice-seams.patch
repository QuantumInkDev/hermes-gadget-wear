+# --- counting streamed bodies: what did the client actually pull? (Task4 response bounds) ---
+CHUNK = 64 * 1024
+
+
+class CountingStream(httpx.SyncByteStream):
+    """A response body the transport hands out in chunks of its own, counting what the client actually pulled."""
+
+    def __init__(self, body):
+        self.chunks = [body[i:i + CHUNK] for i in range(0, len(body), CHUNK)] or [b'']
+        self.pulled = 0
+        self.started = False
+        self.closed = False
+
+    def __iter__(self):
+        self.started = True
+        for chunk in self.chunks:
+            self.pulled += len(chunk)
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+
+class BodyWire(Wire):
+    """Answers every request with one scripted raw answer delivered through a ``CountingStream``."""
+
+    def __init__(self, status, headers, body):
+        super().__init__([('ok', {})] * 3)
+        self.body = CountingStream(body)
+        self.status, self.headers = status, headers
+
+    def respond(self, request, value):
+        return httpx.Response(self.status, headers=self.headers, stream=self.body, request=request)
+
+
+class CountingBytes(io.BytesIO):
+    """The raw body of a urllib3 response, counting what ``requests``/urllib3 actually pulled from it."""
+
+    def __init__(self, body):
+        super().__init__(body)
+        self.pulled = 0
+
+    def read(self, size=-1):
+        data = super().read(size)
+        self.pulled += len(data)
+        return data
+
+    def read1(self, size=-1):
+        data = super().read1(size)
+        self.pulled += len(data)
+        return data
+
+
+class RawWire:
+    """The ``requests`` adapter that would open the socket, replaced by one scripted raw answer over a REAL urllib3
+    response (so iter_content, decoding and content-length handling are the libraries' own)."""
+
+    def __init__(self, status, headers, body):
+        self.status, self.headers = status, headers
+        self.body = body if hasattr(body, 'read') else CountingBytes(body)  # bytes, or a ready-made (held) raw body
+        self.requests = []
+
+    @property
+    def count(self):
+        return len(self.requests)
+
+    def adapter(self):
+        import requests
+        from urllib3.response import HTTPResponse
+        wire = self
+
+        class Adapter(requests.adapters.HTTPAdapter):
+            def send(self, request, **kwargs):
+                wire.requests.append((request, kwargs))
+                raw = HTTPResponse(body=wire.body, headers=dict(wire.headers), status=wire.status, preload_content=False,
+                                   decode_content=True, request_url=request.url, enforce_content_length=False)
+                return self.build_response(request, raw)
+
+            def close(self):
+                pass
+        return Adapter()
+
+
+class HeldStream(httpx.SyncByteStream):
+    """LABELLED STAND-IN for a peer that sends the first chunk and then stalls: after chunk 1 it sets ``entered`` (the
+    readiness signal: the client is blocked INSIDE the body read) and waits (bounded 30 s) for ``release``; the rest follows."""
+
+    def __init__(self, chunks, release):
+        self.chunks, self.release = list(chunks), release
+        self.entered = threading.Event()
+        self.pulled = 0
+        self.started = False
+        self.closed = False
+
+    def __iter__(self):
+        self.started = True
+        for index, chunk in enumerate(self.chunks):
+            if index == 1:
+                self.entered.set()
+                assert self.release.wait(30), 'the test never released the stalled body'
+            self.pulled += len(chunk)
+            yield chunk
+
+    def close(self):
+        self.closed = True
+
+
+class HeldBodyWire(Wire):
+    """Every request is answered 200 with a ``HeldStream`` body."""
+
+    def __init__(self, headers, chunks, release):
+        super().__init__([('ok', {})] * 3)
+        self.body = HeldStream(chunks, release)
+        self.headers = headers
+
+    def respond(self, request, value):
+        return httpx.Response(200, headers=self.headers, stream=self.body, request=request)
+
+
+class HeldBytes(CountingBytes):
+    """The raw urllib3 body of a stalling peer: the first ``read`` returns ``first`` bytes, the next one sets ``entered`` and
+    waits (bounded 30 s) for ``release``. LABELLED STAND-IN."""
+
+    def __init__(self, body, release, first=CHUNK):
+        super().__init__(body)
+        self.release, self.first, self.entered, self.reads = release, first, threading.Event(), 0
+
+    def read(self, size=-1):
+        self.reads += 1
+        if self.reads == 2:
+            self.entered.set()
+            assert self.release.wait(30), 'the test never released the stalled body'
+        return super().read(min(size, self.first) if size and size > 0 else self.first)
+
+
+class ReadinessClock:
+    """CONTROLLED CLOCK for deadline controls (I3/M7): ``time.monotonic`` is real until the test calls ``advance`` AFTER it has
+    confirmed readiness (a hold, a first body chunk, a stall pid), so expiry cannot happen before the hold is reached and no
+    sleep or wide wait is involved. A call is made with a long deadline; ``advance`` then makes every pending deadline,
+    asyncio timer and runner check see it as expired."""
+
+    def __init__(self, monkeypatch):
+        import time
+        real = time.monotonic
+        self.offset = 0.0
+        monkeypatch.setattr(time, 'monotonic', lambda: real() + self.offset)
+
+    def advance(self, seconds=1000.0):
+        self.offset += seconds
+
+
+async def await_hold(task, state, what, timeout=30):
+    """READINESS for a stalled-child control (AUX-audio): return once the owned stand-in wrote its pid to ``state`` (the hold was entered), OR
+    fail at once with an explicit assertion if the call finished first. A tree that never starts the intended child (the matched BASE) therefore
+    fails promptly instead of waiting out ``timeout`` for a pid that cannot appear; the ``timeout`` is only the bound for a genuinely stuck run."""
+    from tests.waiting import async_wait_until
+    await async_wait_until(lambda: state.exists() or task.done(), timeout=timeout, what=what)
+    if state.exists():
+        return
+    try:
+        outcome = repr(getattr(task.result(), 'state', None))
+    except BaseException as exc:  # a cancelled or raising call: report its type only (no message, path or secret)
+        outcome = type(exc).__name__
+    pytest.fail(f'{what}: the call finished ({outcome}) without entering the intended hold')
