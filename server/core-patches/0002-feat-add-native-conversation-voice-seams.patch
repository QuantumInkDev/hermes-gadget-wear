+        policy = native_send_policy.SendPolicy(timeout_s=5.0, providers=frozenset({'openai'}), deadline=time.monotonic() + 60)
+        policy.refusal, policy.sends = refusal, sends
+        if launched:
+            policy.mark_local_launch()
+        return policy
+    attempt = _Attempt(None, 'openai', True)
+    assert _failure_state(attempt, policy_with('too_long')) == 'failed'  # zero sends, nothing launched: was "unavailable"
+    assert _failure_state(attempt, policy_with('too_long', sends=1)) == 'failed'  # the post-send bound is unchanged
+    assert _failure_state(attempt, policy_with('unsupported')) == 'unavailable'
+    assert _failure_state(attempt, policy_with('unsupported', sends=1)) == 'unavailable'  # pre-existing ordering, untouched here
+    assert _failure_state(attempt, policy_with()) == 'unavailable'
+    assert _failure_state(attempt, policy_with(launched=True)) == 'failed'
+    assert _failure_state(attempt, policy_with('timeout')) == 'timeout'
