+@pytest.mark.asyncio
+async def test_task_cancellation_propagates_and_fences_the_worker(monkeypatch, clip, configured):
+    release = threading.Event()
+    wire = support.Wire([words()], hold=release)
+    task = asyncio.create_task(seam(clip, support.Callbacks()))
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            assert await asyncio.to_thread(wire.entered.wait, 10)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
