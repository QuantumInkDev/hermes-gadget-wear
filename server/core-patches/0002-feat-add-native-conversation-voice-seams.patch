+class WhisperStandIn:
+    """Stands in for the faster-whisper CONSTRUCTOR only (the stock creation path runs for real)."""
+    calls = []
+    cached = False
+
+    def __init__(self, name, **kwargs):
+        type(self).calls.append(dict(kwargs, name=name))
+        if kwargs.get('local_files_only') and not type(self).cached:
+            raise OSError('synthetic cache miss')
+
+    def transcribe(self, path, **kwargs):
+        segment = types.SimpleNamespace(text=' cached words ', no_speech_prob=0.0, avg_logprob=0.0)
+        return [segment], types.SimpleNamespace(language='en', duration=1.0)
+
