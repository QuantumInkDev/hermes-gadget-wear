+@pytest.mark.parametrize('phonemizer,backbone', [('3.3.0', 'repo'), ('3.4.0', 'repo'), ('3.4.0', 'local')])
+def test_run_reaches_the_engine_boundary_for_a_neutts_consistent_set(monkeypatch, tmp_path, hub, phonemizer, backbone):
+    world = World({**ORDINARY_NEUTTS, 'phonemizer': phonemizer})
+    options = {}
+    if backbone == 'local':
+        local = tmp_path / 'custom.gguf'
+        local.write_bytes(b'gguf')
+        options = {'original_repo': str(local), 'language': 'de'}
+    req = neutts_boundary(monkeypatch, tmp_path, hub, world, **options)
+    answer = helper.run(req)
+    assert answer == {'api': 1, 'status': 'ok', 'reason': 'ok', 'sample_rate': 24000, 'wav_bytes': 104}
+    assert [e[0] for e in world.events if e[0] in ('hub', 'preflight', 'synth')] == ['hub', 'preflight', 'synth']
+    assert probes_then_stages(world.events)
+    synth = next(e for e in world.events if e[0] == 'synth')
+    assert synth[1] == req['neutts']  # options, language and reference paths reach the engine boundary untouched
+    assert synth[2]['ref_text'] == req['neutts']['ref_text_path']
+    assert synth[2]['backbone_path'].endswith('.gguf')
+    if backbone == 'local':
+        assert synth[2]['backbone_path'] == options['original_repo']
+    probed = {e[1] for e in world.events if e[0] == 'metadata'}
+    assert {'transformers', 'phonemizer', 'phonemizer-fork'} <= probed  # NeuTTS's own rows, then the ambiguity probe
