+"""Native voice seam: the STT answer is bounded BEFORE the SDK or the JSON layer buffers it (Task4 A).
+
+The REAL pinned OpenAI SDK over a real httpx client (OpenAI, Groq, DeepInfra) and the REAL ``requests`` session over a real
+urllib3 response (xAI, ElevenLabs); only the network bytes are synthetic. Every body below is handed out chunk by chunk
+by a COUNTING stream, so what each assertion pins is how much of the answer the client actually pulled, not what a
+parser later made of it. The cap is the seam's 1 MiB; the bound is chunk-granular (the underlying stream chunk that
+crosses the cap is read) and is NOT an allocation-hard heap limit.
+
+Native requests ask for ``Accept-Encoding: identity`` and REFUSE a nonidentity answer before any decoder or parser sees
+it (a peer that ignores the request is unusable as a bounded native response; its send is already counted, so it is
+``failed_after_send``). The stock ``transcribe_audio`` path is unchanged and still decodes such an answer.
+"""
+import asyncio
+import gzip
+import threading
+
+import pytest
+
+from gateway.session_native_voice import MAX_STT_RESPONSE_BYTES as CAP
+from gateway.session_native_voice import transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway.native_voice_support import BodyWire, CHUNK, HeldBodyWire, HeldBytes, RawWire, ReadinessClock
+
+KEY = 'sk-synthetic-stt-bounds'
+
+
+def text_body(size):
+    return b'a' * size
+
+
+def json_body(size):
+    return b'{"text":"' + b'a' * size + b'"}'
+
+
+def openai_profile(**section):
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                                                     'openai': {'api_key': KEY, **section}}})
+
+
+def groq_profile():
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'groq', 'cloud_trim_silence': False, 'groq': {}}})
+    (get_hermes_home() / '.env').write_text('GROQ_API_KEY=gsk-synthetic\n')
+
+
+def deepinfra_profile():
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'deepinfra', 'cloud_trim_silence': False,
+                                                     'deepinfra': {'model': 'openai/whisper-large-v3'}}})
+    (get_hermes_home() / '.env').write_text('DEEPINFRA_API_KEY=di-synthetic\n')
+
+
+def xai_profile():
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'xai', 'cloud_trim_silence': False}})
+    (get_hermes_home() / '.env').write_text('XAI_API_KEY=xai-synthetic\n')
+    invalidate_env_cache()
+
+
+def elevenlabs_profile():
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'elevenlabs', 'cloud_trim_silence': False}})
+    (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic\n')
+    invalidate_env_cache()
+
+
+class Backend:
+    """One named STT backend: its profile, the way a body of N filler bytes is shaped, a small valid answer with its
+    content type, and which synthetic transport family reaches it."""
+
+    def __init__(self, name, profile, shape, small, kind, family):
+        self.name, self.profile, self.shape, self.small, self.kind, self.family = name, profile, shape, small, kind, family
+        self.wire_class = BodyWire if family == 'sdk' else RawWire
+
+    def context(self, monkeypatch, wire):
+        if self.family == 'sdk':
+            return support.provider_wire(monkeypatch, wire)
+        import requests
+        from contextlib import nullcontext
+        adapter = wire.adapter()
+        monkeypatch.setattr(requests.Session, 'get_adapter', lambda session, url: adapter)
+        return nullcontext(wire)
+
+    def pulled(self, wire):
+        return wire.body.pulled
+
+    def closed(self, wire):
+        return wire.body.closed
+
+    def started(self, wire):
+        return wire.body.started if self.family == 'sdk' else wire.body.pulled > 0
+
+    def request(self, wire):
+        return wire.requests[0] if self.family == 'sdk' else wire.requests[0][0]
+
+    def answer(self, status, headers, body):
+        return self.wire_class(status, {'Content-Type': self.kind, **headers}, body)
+
+
+JSON, TEXT = 'application/json', 'text/plain'
+BACKENDS = [pytest.param(backend, id=backend.name) for backend in (
+    Backend('openai-text', lambda: openai_profile(model='whisper-1'), text_body, b'hello world', TEXT, 'sdk'),
+    Backend('openai-json', lambda: openai_profile(model='gpt-4o-mini-transcribe'), json_body, b'{"text":"hello world"}', JSON, 'sdk'),
+    Backend('groq', groq_profile, text_body, b'hello world', TEXT, 'sdk'),
+    Backend('deepinfra', deepinfra_profile, json_body, b'{"text":"hello world"}', JSON, 'sdk'),
+    Backend('xai', xai_profile, json_body, b'{"text":"hello world"}', JSON, 'requests'),
+    Backend('elevenlabs', elevenlabs_profile, json_body, b'{"text":"hello world"}', JSON, 'requests'))]
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+async def hear(clip, cb=None):
+    cb = cb or support.Callbacks()
+    return await transcribe_native_once(clip, authorize=cb.authorize, before_send=cb.before_send, deadline_s=30), cb
+
+
+CASES = [
+    # (id, status, extra headers, body size)
+    ('declared-oversize', 200, {'Content-Length': str(CAP + 1)}, CAP + 1),
+    ('absent-length', 200, {}, 2 * CAP),
+    ('false-length', 200, {'Content-Length': '10'}, 2 * CAP),
+    ('error-status-absent-length', 500, {}, 2 * CAP),
+    ('error-status-declared-oversize', 500, {'Content-Length': str(CAP + 1)}, CAP + 1),
+]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('backend', BACKENDS)
+@pytest.mark.parametrize('case', CASES, ids=[c[0] for c in CASES])
+async def test_an_oversize_answer_is_bounded_before_the_sdk_or_json_layer_buffers_it(monkeypatch, clip, backend, case):
+    _, status, extra, size = case
+    declared = extra.get('Content-Length') == str(CAP + 1)
+    backend.profile()
+    body = backend.shape(size - len(backend.shape(0)) if declared else size)
+    wire = backend.answer(status, extra, body)
+    with backend.context(monkeypatch, wire):
+        result, cb = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('failed', None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1  # one send, never resent
+    assert backend.closed(wire)  # the answer was closed on this exit
+    if declared:
+        assert not backend.started(wire)  # an advertised oversize body is refused with ZERO body reads
+    else:
+        assert backend.pulled(wire) <= CAP + CHUNK < len(body)  # reading stopped at the crossing (one chunk allowance)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('backend', BACKENDS)
+async def test_a_valid_answer_inside_the_cap_is_read_whole_and_closed(monkeypatch, clip, backend):
+    """Pin (green before and after): the bound does not change a normal answer."""
+    backend.profile()
+    wire = backend.answer(200, {}, backend.small)
+    with backend.context(monkeypatch, wire):
+        result, _ = await hear(clip)
+    assert (result.state, result.transcript, result.provider) == ('transcribed', 'hello world', 'completed')
+    assert backend.pulled(wire) == len(backend.small) and backend.closed(wire)
