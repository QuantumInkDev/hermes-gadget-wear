+def supported(missing=(), wrong=(), absent_modules=()):
+    """``(find, version_of)`` for a synthetic installation: every distribution at its supported version (others at an
+    arbitrary one) except ``missing`` (no metadata) and ``wrong`` (another version); ``absent_modules`` have metadata
+    but no module."""
+    import importlib.metadata
+
+    def version_of(distribution):
+        if distribution in missing:
+            raise importlib.metadata.PackageNotFoundError(distribution)
+        return '0.0.0-other' if distribution in wrong else VERSIONS.get(distribution, '9.9.9')
+    return (lambda name: name not in absent_modules), version_of
+
+
+def test_the_helper_pins_exactly_these_versions_chains_and_distributions():
+    assert (helper.SUPPORTED_VERSIONS, helper.CHAINS, helper.DISTRIBUTIONS) == (VERSIONS, CHAINS, DISTS)
