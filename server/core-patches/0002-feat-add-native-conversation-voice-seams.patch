+@pytest.mark.asyncio
+async def test_authority_lost_while_a_single_chunk_answer_is_held_withholds_the_audio(
+        home_rig, monkeypatch, out, tmp_path, real_elevenlabs, caplog):
+    """One chunk: the revoked grant withholds the answered audio; a second send cannot occur here (see the two-chunk controls). The
+    exact event order is a structural fence of this seam's contract and will change with a benign restructuring."""
+    from gateway import session_native_voice_tts as tts_module
+    caplog.set_level(logging.DEBUG)
+    configure_rig_home(tmp_path)
