+    out = tmp_path / 'out.m4a'
+
+    def runner(argv, **kw):
+        out.write_bytes(b'\0' * written)
+        raise subprocess.CalledProcessError(1, argv)
+    monkeypatch.setattr(tts_command_provider, 'run_native_argv', runner)
+    policy = bounded_policy()
+    with native_send_policy.activate(policy):
+        if terminal:
+            with pytest.raises(native_send_policy.NativeSendRefused) as refused:
+                transcription_audio._run_native_prep(['/x/ffmpeg'], output=str(out))
+            assert refused.value.reason == 'too_long' and policy.refusal == 'too_long'
+        else:
