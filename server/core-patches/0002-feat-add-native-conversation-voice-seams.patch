+
+def _profile(provider, env_var, **section):
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'tts': {'provider': provider, provider: section}})
+    (get_hermes_home() / '.env').write_text(f'{env_var}={KEY}\n')
+    invalidate_env_cache()
+
+
+def xai_profile(**section):
+    _profile('xai', 'XAI_API_KEY', **section)
+
+
+def minimax_profile(**section):
+    _profile('minimax', 'MINIMAX_API_KEY', **section)
+
+
+def gemini_profile(**section):
+    _profile('gemini', 'GEMINI_API_KEY', **section)
+
+
+CASES = {
+    'xai': dict(profile=xai_profile, ok=('audio', b'ID3xai-audio'), host='api.x.ai', path='/v1/tts',
+                audio=b'ID3xai-audio', bad_body=[('raw', 200, {'Content-Type': 'audio/mpeg'}, b'ID3short', 5000)]),
+    'minimax': dict(profile=minimax_profile, ok=rest.minimax_answer(b'ID3mm-audio'), host='api.minimax.io',
+                    path='/v1/t2a_v2', audio=b'ID3mm-audio',
+                    bad_body=[('raw', 200, {'Content-Type': 'application/json'}, b'{"data":', 5000),
+                              ('raw', 200, {'Content-Type': 'application/json'}, b'{"data": {"audio": "zz-not-hex"}', None),
+                              ('json', {'base_resp': {'status_code': 1004, 'status_msg': 'synthetic'}}),
+                              ('json', {'base_resp': {'status_code': 0}, 'data': {'audio': ''}})]),
+    'gemini': dict(profile=gemini_profile, ok=rest.gemini_answer(rest.pcm_bytes(1.0)),
+                   host='generativelanguage.googleapis.com',
+                   path='/v1beta/models/gemini-2.5-flash-preview-tts:generateContent', audio=None,
+                   bad_body=[('raw', 200, {'Content-Type': 'application/json'}, b'{"candidates":', 5000),
+                             ('json', {'candidates': []}),
+                             ('json', {'candidates': [{'content': {'parts': [{'text': 'no audio here'}]}}]}),
+                             ('json', {'candidates': [{'content': {'parts': [{'inlineData': {'data': ''}}]}}]}),
+                             ('json', {'candidates': [{'content': {'parts': [{'inlineData': {'data': '%%%not-base64'}}]}}]})]),
+}
+PROVIDERS = sorted(CASES)
