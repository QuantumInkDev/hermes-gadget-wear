+@pytest.mark.asyncio
+async def test_stop_while_a_single_chunk_answer_is_held_keeps_no_output_and_runs_no_callback(
+        monkeypatch, out, tmp_path, real_elevenlabs, caplog):
+    """One chunk: a second send cannot occur here, so this control carries NO 'no additional send' claim (see the two-chunk controls).
+    The callback counts are a structural fence of this seam's contract, not a universal SDK property."""
+    from gateway import session_native_voice_tts as tts_module
+    caplog.set_level(logging.DEBUG)
+    monkeypatch.setenv('HERMES_HOME', str(make_home(tmp_path, 'A', tts=elevenlabs_tts('A'),
+                                                    env={'ELEVENLABS_API_KEY': PROFILES['A']['key']})))
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    release = threading.Event()
+    wire = support.Wire([('ok', {'audio': PROFILES['A']['audio']})], hold=release)
+    cb = support.Callbacks()
+    try:
+        with support.provider_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb))
+            assert await asyncio.to_thread(wire.entered.wait, 10)  # the one send left and is held at the provider
+            at_stop = (cb.authorize_calls, cb.before_send_calls)
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)  # the abandoned worker has fully returned
+    finally:
+        release.set()
+    assert wire.count == 1 and at_stop == (2, 1)  # coupled to this seam's callback structure on purpose
+    assert (cb.authorize_calls, cb.before_send_calls) == at_stop  # no callback after Stop
+    assert os.listdir(out) == [] and all(client['httpx_client'].is_closed for client in real_elevenlabs)
+    for secret in (PROFILES['A']['key'], TEXT):
+        assert secret not in caplog.text
+
+
+class AuthorityCallbacks:
+    """The consumer's callbacks over the REGISTERED authority: ``authorize`` is the real ``SessionAuthority.authorize``."""
+
+    def __init__(self, authority, ref, actor, events):
+        self.authority, self.ref, self.actor, self.events = authority, ref, actor, events
+        self.before_send_calls = 0
+
+    def authorize(self):
+        self.events.append('authorize')
+        self.authority.authorize(self.actor, self.ref, 'session:read')
+
+    def before_send(self):
+        self.before_send_calls += 1
+        self.events.append('before_send')
+
+
+async def registered_route(rig):
+    ref = await rig.authority.register_native_route(rig.event().source)
+    viewer = Principal('viewer', rig.authority.profile_id, frozenset({'session:read'}), 'test')
+    return ref, viewer
+
