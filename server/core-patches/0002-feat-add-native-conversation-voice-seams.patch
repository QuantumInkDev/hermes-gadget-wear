+    assert [(c['retries'], c['timeout_ms']) for c in built['calls']] == [(None, 60000)]  # zero retries, explicit timeout
+    assert (built['sender'].follow_redirects, built['sender'].timeout.read) == (False, 60.0)
+    assert built['kwargs']['server_url'] == 'https://eu.mistral.example/'  # tts.mistral.base_url -> SDK server_url
