+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            calls = (cb.authorize_calls, cb.before_send_calls)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert wire.count == 1 and calls == (2 + PREFLIGHT_PROBES.get(name, 0), 1) and (cb.authorize_calls, cb.before_send_calls) == calls
