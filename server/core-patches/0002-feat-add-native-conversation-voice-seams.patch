+    assert result.state == 'synthesized' and oauth.refresh_tokens_sent() == ['rt-A'] and bearer(wire) != f'Bearer {expired_a}'
+
+
+# --- no refresh or resend after an auth failure ---------------------------------------------------------------------
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('status', [401, 403])
+async def test_an_auth_failure_after_the_send_is_never_refreshed_or_resent(monkeypatch, out, status):
+    tts_profile()
+    rest.write_oauth_store(fresh_token())
+    oauth = rest.OAuthWire()
+    cb = support.Callbacks()
+    wire = rest.RestWire([('status', status)] * 3)
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count, cb.before_send_calls) == ('failed', 'failed_after_send', 1, 1)
+    assert oauth.requests == []  # no force_refresh, no second account, no different provider
+    # even when a refresh DID run before the send, an auth failure afterwards adds none
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    oauth = rest.OAuthWire()
+    wire = rest.RestWire([('status', status)] * 3)
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert (result.state, wire.count, len(oauth.posts)) == ('failed', 1, 1)
+
+
+# --- Stop / deadline / authority while the OAuth exchange is in flight ----------------------------------------------
+
+def start_held_refresh():
+    tts_profile()
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold=release)
+    wire = rest.RestWire([('audio', b'ID3late')])
+    return oauth, wire, release
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline', 'authority'])
+async def test_stop_deadline_or_lost_authority_while_refreshing_can_never_become_a_late_send(monkeypatch, out, how):
+    from gateway import session_native_voice_tts as tts_module
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    cb = support.Callbacks(refuse_authorize_at=4) if how == 'authority' else support.Callbacks()  # 4 = the paid gate
+    oauth, wire, release = start_held_refresh()
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+            deadline = rest.EventDeadline(monkeypatch)  # installed before the call starts waiting
+            task = asyncio.create_task(speak(out, cb, deadline_s=30))
+            assert await asyncio.to_thread(oauth.entered.wait, 10)  # the OAuth exchange is in flight, held
+            if how == 'deadline':
+                deadline.fire()
+                result = await task
+                assert (result.state, result.provider) == ('timeout', 'not_started')
+            else:
+                if how == 'cancel':
+                    task.cancel()
+                    with pytest.raises(asyncio.CancelledError):
+                        await task
+            release.set()  # the late refresh result arrives
+            if how == 'authority':
+                result = await task
+                assert (result.state, result.path, result.provider) == ('refused', None, 'not_started')
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert wire.count == 0 and cb.before_send_calls == 0 and os.listdir(out) == []  # no late gate, no late send, no file
+    assert len(oauth.posts) == 1
+
+
+@pytest.mark.asyncio
+async def test_a_policy_closed_before_the_exchange_starts_never_starts_one(monkeypatch, out):
+    from tools import native_send_policy
+    from tools.tts_tool_providers import _generate_xai_tts
+    tts_profile()
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    oauth = rest.OAuthWire()
+    policy = native_send_policy.SendPolicy(timeout_s=60.0, providers=frozenset({'xai'}), gate=lambda: None)
+    policy.close()
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, rest.RestWire()):
+        with native_send_policy.activate(policy), pytest.raises(native_send_policy.NativeSendRefused) as refused:
+            _generate_xai_tts(TEXT, os.path.join(out, 'x.mp3'), {})
+    assert refused.value.reason == 'closed' and oauth.requests == [] and policy.sends == 0
+
+
+# --- xAI STT shares the resolver: same freshness, begin_send adjacency kept ------------------------------------------
+
+@pytest.mark.asyncio
+async def test_stt_refreshes_before_its_one_send_and_keeps_the_begin_send_adjacency(monkeypatch, clip):
+    stt_profile()
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    events = []
+    oauth = rest.OAuthWire(events=events)
+    cb = support.Callbacks(events)
+    wire = rest.RestWire([('json', {'text': 'hello world'})], tap=lambda request: events.append('request'))
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.provider, wire.count) == ('transcribed', 'hello world', 'completed', 1)
+    assert events == ['authorize', 'authorize', 'oauth-discovery', 'authorize', 'oauth-refresh', 'authorize', 'before_send',
+                      'request', 'authorize']  # a credential probe precedes each OAuth request (test_native_voice_xai_credential_phase)
+    assert cb.before_send_calls == 1 and wire.requests[0][0].url == 'https://api.x.ai/v1/stt'
+
+
+@pytest.mark.asyncio
+async def test_stt_refuses_unsent_without_fresh_credentials_and_only_the_cached_local_fallback_runs(monkeypatch, clip):
+    fallback = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: fallback.append(path) or {'success': True, 'transcript': ' local words '})
+    for store, steps in ((rest.jwt(time.time() - 60, 'expired'), [('status', 500)] * 3), ('opaque-bearer', [])):
+        stt_profile()
+        rest.write_oauth_store(store)
+        oauth = rest.OAuthWire(steps)
+        cb = support.Callbacks()
+        wire = rest.RestWire([('json', {'text': 'must not be sent'})])
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+            result = await hear(clip, cb)
+        assert (result.state, result.transcript, result.source, result.provider) == (
+            'transcribed', 'local words', 'local_fallback', 'not_started')
+        assert wire.count == 0 and cb.before_send_calls == 0
+    assert len(fallback) == 2
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('status', [401, 403])
+async def test_stt_never_refreshes_and_resends_after_an_auth_failure(monkeypatch, clip, status):
+    stt_profile()
+    rest.write_oauth_store(fresh_token())
