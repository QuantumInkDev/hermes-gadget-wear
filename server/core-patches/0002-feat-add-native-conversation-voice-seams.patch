+    assert (result.state, result.provider) == ('synthesized', 'completed') and wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']  # the authority gates before and after
+    assert request_facts(wire.requests[0]) == dict(voice=PROFILES['A']['voice'], model=PROFILES['A']['model'], text=TEXT,
+                                                   key=PROFILES['A']['key'], output_format='mp3_44100_128')
+    assert PROFILES['A']['key'] not in caplog.text and TEXT not in caplog.text
+
+    for name, actor in (('no capability', replace(viewer, capabilities=frozenset())),
+                        ('another profile', replace(viewer, profile_id='another-profile'))):
+        refused_events = []
+        refused = AuthorityCallbacks(home_rig.authority, ref, actor, refused_events)
+        wire = support.Wire([('ok', {'audio': b'ID3never'})])
+        with support.provider_wire(monkeypatch, wire):
+            result = await speak(out, refused)
+        assert (result.state, result.path, result.provider) == ('refused', None, 'not_started'), name
+        assert wire.count == 0 and refused.before_send_calls == 0, name
+    with pytest.raises(RuntimeStoreError, match='profile_mismatch'):
+        home_rig.authority.authorize(replace(viewer, profile_id='another-profile'), ref, 'session:read')
