+    with support.provider_wire(monkeypatch, wire):
+        result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == (
+        'transcribed', 'hello world', 'configured', 'completed')
+    assert wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
