+"""Native voice seam: local engines, launcher-wrapped command adapters and managed whisper.cpp ``local_command``.
+
+HARNESS, stated plainly: no engine package, model or host sandbox exists or runs here. The qualification table is
+pointed at a hashed pass-through stand-in for the launcher, and engine chunks run a hashed protocol stand-in for the
+helper (``native_command_fixtures/``). What runs for real: the seam, the policy, the real runner/process group/pipes,
+the real child interpreter, the real ffmpeg (WAV -> MP3) and the real cleanup. This proves process IO, bounds,
+accounting and cleanup, never engine, library, network-denial or audio-quality behaviour.
+"""
+import asyncio
+import hashlib
+import os
+import platform
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+FIXTURES = Path(__file__).resolve().parents[1] / 'tools' / 'native_command_fixtures'
+STAND_IN = FIXTURES / 'launcher_passthrough.py'
+
+
+@pytest.fixture
+def launcher(monkeypatch):
+    try:
+        from tools import native_local_launcher as qualification
+    except ImportError:  # a tree without the launcher (Phase1A BASE): the seam's own behaviour is then what is measured
+        from types import SimpleNamespace
+        return SimpleNamespace(PROFILE='(version 1) (allow default) (deny network*)', QUALIFIED=())
+    monkeypatch.setattr(qualification, 'QUALIFIED', (qualification.LauncherQualification(
+        sys.platform, platform.machine(), os.uname().release, str(STAND_IN),
+        hashlib.sha256(STAND_IN.read_bytes()).hexdigest(), (sys.executable, str(STAND_IN), '-p', qualification.PROFILE)),))
+    return qualification
+
+
+@pytest.fixture
+def spawns(monkeypatch):
+    """Records every Popen argv/env/cwd (then really spawns)."""
+    seen = []
+    real = subprocess.Popen
+
+    class Recording(real):
+        def __init__(self, args, *a, **k):
+            seen.append({'args': list(args) if isinstance(args, (list, tuple)) else args, 'env': k.get('env'),
+                         'cwd': k.get('cwd'), 'stdin': k.get('stdin')})
+            super().__init__(args, *a, **k)
+    monkeypatch.setattr(subprocess, 'Popen', Recording)
+    return seen
+
+
+@pytest.fixture
+def engine(monkeypatch, tmp_path):
+    """HARNESS: the engine stand-in replaces the helper path, and the parent's package probe sees a cached voice."""
+    from tools import tts_tool_local
+    model = tmp_path / 'voice.onnx'
+    model.write_bytes(b'onnx')
+    monkeypatch.setattr(tts_tool_local, 'NATIVE_ENGINE_HELPER', str(FIXTURES / 'engine_fixture.py'))
+    monkeypatch.setattr(tts_tool_local, 'native_engine_options', lambda engine, config: {
+        'model_path': str(model), 'config_path': f'{model}.json', 'use_cuda': False, 'speaker_id': 0, 'knobs': None})
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'piper'}})
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+async def speak(text, out, cb=None, deadline_s=30):
+    cb = cb or support.Callbacks()
+    return await synthesize_native_once(text, output_dir=out, authorize=cb.authorize, before_send=cb.before_send,
+                                        deadline_s=deadline_s)
