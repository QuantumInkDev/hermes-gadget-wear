+@pytest.mark.asyncio
+@pytest.mark.parametrize('backend', BACKENDS)
+@pytest.mark.parametrize('case', TERMINAL_CASES, ids=[c[0] for c in TERMINAL_CASES])
+async def test_a_response_safety_refusal_never_reaches_the_installed_local_fallback(monkeypatch, clip, fallback, backend, case):
+    """The sealed 'never substituted': an answer refused for its encoding or for crossing the response bound is a failure
+    with source None and provider failed_after_send, and the available installed fallback is NOT invoked."""
+    _, headers, size = case
+    backend.profile()
+    body = gzip.compress(backend.small) if size is None else backend.shape(size)
+    wire = backend.answer(200, headers, body)
+    with backend.context(monkeypatch, wire):
+        result, cb = await hear(clip)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'failed_after_send')
+    assert fallback == [] and wire.count == 1 and cb.before_send_calls == 1
+
