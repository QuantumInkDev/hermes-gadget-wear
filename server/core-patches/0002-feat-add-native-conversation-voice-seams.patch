+                'compaction': lambda: tone_wav(tmp_path / 'fourteen.wav')}[shape]()
+        spawns = support.record_spawns(monkeypatch)
+        fallback = []
+        monkeypatch.setattr('tools.transcription_tools.transcribe_audio_local_fallback',
+                            lambda path, model=None: fallback.append(path) or {'success': True, 'transcript': 'never'})
+        from gateway import session_native_voice_stt as stt_module
+        finished = watch_worker(monkeypatch, stt_module, '_checked')  # set when the STT worker has fully returned
+        cb = support.Callbacks()
+        wire = support.Wire([words()])
+        clock = support.ReadinessClock(monkeypatch)
+        with support.provider_wire(monkeypatch, wire):
+            task = asyncio.create_task(hear(clip, cb, deadline_s=300))
+            await support.await_hold(task, state, 'the held preparation child to start')  # readiness
+            held_at = len(children(spawns, support.FAULTY))
+            if how == 'stop':
+                task.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await task
+            else:
+                clock.advance()  # expiry only AFTER the held child is confirmed (the stand-in wrote its pid)
+                result = await task
+                assert (result.state, result.transcript, result.source, result.provider) == ('timeout', None, None, 'not_started')
+            await async_wait_until(lambda: support.pid_gone(state), timeout=15, what='the held child to be ended')
+            assert await asyncio.to_thread(finished.wait, 15)  # the abandoned worker itself has RETURNED: only now is "no late child" a fact
+            await async_wait_until(lambda: not os.listdir(scratch), timeout=15, what='the fenced worker to clean up')
+        assert len(children(spawns, support.FAULTY)) == held_at  # no next child (no second CAF candidate, no later probe)
+        assert (wire.count, cb.before_send_calls, fallback) == (0, 0, [])  # no upload, no callback, no local fallback
+        assert os.listdir(scratch) == []
+    finally:
