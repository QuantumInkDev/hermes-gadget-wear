+async def test_real_elevenlabs_refuses_an_ignored_identity_answer_before_decoding_it(monkeypatch, out, elevenlabs):
+    """Task4 A: the same identity enforcement reaches the real ElevenLabs SDK's httpx client (a counting streamed body)."""
+    import gzip
+    wire = support.BodyWire(200, {'Content-Type': 'audio/mpeg', 'Content-Encoding': 'gzip'}, gzip.compress(b'ID3compressed'))
+    cb = support.Callbacks()
+    with support.provider_wire(monkeypatch, wire):
