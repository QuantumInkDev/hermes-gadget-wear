@@ -0,0 +1,103 @@
+"""Native voice seam: direct OpenAI / DeepInfra TTS that RAISES after entering the provider invocation.
+
+Carried V1 minor m2. A labelled stand-in OpenAI client passes the injected-client identity proof (its ``_client`` IS the
+injected httpx client), then sends once through ITS OWN client over the synthetic transport, receives the provider's
+answer and raises. The consumer has no durable in-flight record (``before_send`` never ran), so the result is
+``failed`` with ``provider='unknown'`` and there is no fallback. These are exception-entry controls; they are distinct
+from the real-SDK proofs in ``test_native_voice_sdk_boundaries`` and from the real-client control below, where the same
+failure through the gated client is a truthful ``failed_after_send``.
+"""
+import os
+import types
+
+import httpx
+import openai
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-exception-entry'
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+async def speak(out, callbacks, text='Hello there, friend.'):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=60)
+
+
+def profile(provider):
+    if provider == 'openai':
+        config = {'tts': {'provider': 'openai', 'openai': {'api_key': KEY, 'model': 'gpt-4o-mini-tts', 'voice': 'nova'}}}
+    else:
+        config = {'tts': {'provider': 'deepinfra', 'deepinfra': {'model': 'hexgrad/Kokoro-82M', 'voice': 'af_bella'}}}
+        (get_hermes_home() / '.env').write_text('DEEPINFRA_API_KEY=di-synthetic-key\n')
+    support.write_config(get_hermes_home(), config)
+
+
+class DivergesThenRaises(openai.OpenAI):
+    """Labelled stand-in: ``_client`` IS the injected client (the identity proof PASSES), but the speech request goes out
+    through a client of its own, is answered, and the stand-in then raises."""
+
+    def __init__(self, *args, http_client=None, **kwargs):
+        super().__init__(*args, http_client=http_client, **kwargs)
+        own = httpx.Client()
+
+        class Streaming:
+            def create(self, **kw):
+                try:
+                    response = own.post('https://api.openai.com/v1/audio/speech', content=b'x')
+                    response.raise_for_status()
+                finally:
+                    own.close()
+                raise RuntimeError('stand-in failed after its own send')
+        self.audio = types.SimpleNamespace(speech=types.SimpleNamespace(with_streaming_response=Streaming(), create=Streaming().create))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('provider', ['openai', 'deepinfra'])
+async def test_a_diverging_client_that_raises_after_entry_is_failed_unknown_with_no_callback(monkeypatch, out, provider):
+    profile(provider)
+    monkeypatch.setattr('tools.tts_tool._import_openai_client', lambda: DivergesThenRaises)
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'unknown')
+    assert wire.count == 1 and cb.before_send_calls == 0 and os.listdir(out) == []  # request 1, callback 0
+    assert support.SECRET not in repr(result) and KEY not in repr(result)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('provider', ['openai', 'deepinfra'])
+async def test_the_same_failure_through_the_gated_client_is_a_truthful_failed_after_send(monkeypatch, out, provider):
+    profile(provider)  # the REAL OpenAI SDK and httpx client: the gate saw the send, so it is not "unknown"
+    cb = support.Callbacks()
+    wire = support.Wire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'failed_after_send')
+    assert wire.count == 1 and cb.before_send_calls == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('provider', ['openai', 'deepinfra'])
+async def test_a_pre_entry_failure_stays_unsent_and_a_policy_refusal_is_not_unknown(monkeypatch, out, provider):
+    profile(provider)
+    cb = support.Callbacks(refuse_before_send=True)  # a refusal AFTER the identity proof: nothing left, nothing unknown
+    wire = support.Wire([('ok', {'audio': b'ID3x'})])
+    with support.provider_wire(monkeypatch, wire):
+        refused = await speak(out, cb)
+    assert (refused.state, refused.provider, wire.count) == ('refused', 'not_started', 0)
+    support.write_config(get_hermes_home(), {'tts': {'provider': provider}})
+    (get_hermes_home() / '.env').write_text('')
+    with support.provider_wire(monkeypatch, wire):
+        missing = await speak(out, support.Callbacks())
+    assert (missing.state, missing.provider, wire.count) == ('unavailable', 'not_started', 0)
