+@pytest.mark.asyncio
+async def test_each_send_is_bounded_by_the_call_deadline(monkeypatch, out):
+    xai_profile()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.rest_wire(monkeypatch, wire):
+        await speak(out, support.Callbacks(), deadline_s=40)
+    assert wire.timeouts() == [40.0]  # min(stock 60, the call's request bound)
