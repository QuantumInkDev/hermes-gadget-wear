+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=LONG_TEXT)
+    assert (result.state, result.provider, wire.count, cb.before_send_calls) == ('synthesized', 'completed', expected, expected)
+    sends = [e for e in events if e in ('before_send', 'request')]
+    assert sends == ['before_send', 'request'] * expected  # each chunk is gated immediately before its own wire
+    assert os.listdir(out) == [os.path.basename(result.path)]
+
+
+@pytest.mark.asyncio
+async def test_results_and_logs_carry_no_key_text_provider_body_or_path(monkeypatch, out, caplog):
+    caplog.set_level(logging.DEBUG)
+    for name in PROVIDERS:
+        CASES[name]['profile']()
+        for script in ([CASES[name]['ok']], [('status', 500, b'PROVIDER-BODY-TEXT')], [CASES[name]['ok']]):
+            cb = support.Callbacks()
+            wire = rest.RestWire(script)
+            with rest.rest_wire(monkeypatch, wire):
+                result = await speak(out, cb, text='Private words to speak.')
+            assert KEY not in repr(result) and 'PROVIDER-BODY-TEXT' not in repr(result)
+    leaks = [line for line in caplog.text.splitlines()
+             if KEY in line or out in line or 'Private words' in line or 'PROVIDER-BODY-TEXT' in line]
+    assert not leaks, leaks
+    assert not [r for r in caplog.records if r.name.startswith(('gateway.session_native_voice', 'tools.native_send'))]
