+"""Existing-source analogs of the native display seam, on the real source authority.
+
+A messaging-source session (a Telegram conversation) is readable by a Gadget device principal that
+the registered adapter actually owns (``source_owner``) and that holds ``session:read``; the analogs
+reuse that proof, the existing target and its readability rules, and add nothing else. The SDK's
+8,192/65,536 response-bound regression of the existing-history path is NOT exercised or fixed here.
+"""
+from dataclasses import replace
+
+import pytest
+
+from gateway.session_contract import Principal
+from gateway.session_existing import ExistingTarget
+from gateway.session_native_admission import native_principal
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway import native_display_support as support
+from tests.gateway import relay_native_support
+
+rig = relay_native_support.rig
+
+
+def device(rig_, name='phone', capabilities=('session:read',)):
+    source = rig_.adapter.build_source(chat_id=name, chat_type='dm', user_id=name)
+    return Principal(native_principal(source), rig_.authority.profile_id, frozenset(capabilities), 'relay-existing-' + name), source
+
+
+def telegram(rig_, session_id='tg-1'):
+    db = rig_.authority.db
+    db.create_session(session_id, source='telegram')
+    return ExistingTarget('a', session_id, 'telegram')
+
+
+async def existing_fragments(rig_, actor, source, target):
+    """The fragments of the existing reader's rows, via the identity-addressed seam only (rows come
+    from ``read_existing_history``, the existing source reader, as the oracle for identity and text)."""
+    page = await rig_.authority.read_existing_history(actor, target, adapter=rig_.adapter, source=source,
+                                                      authorize=lambda: None)
+    return page.rows
+
+
+@pytest.mark.asyncio
+async def test_existing_identity_read_equals_the_existing_history_rows(rig):
+    actor, source = device(rig)
+    target = telegram(rig)
+    db = rig.authority.db
+    db.append_message('tg-1', 'user', 'telegram question')
+    db.append_message('tg-1', 'assistant', 'multi ' + 'é' * 6000)
+    db.append_message('tg-1', 'assistant', '😀' * 3000)
+    rows = await existing_fragments(rig, actor, source, target)
+    assert len(rows) == 3
+    for row in rows:
+        parts, segment = [], 0
+        while True:
+            fragment = await rig.authority.read_existing_display(
+                actor, target, adapter=rig.adapter, source=source, authorize=lambda: None, row_id=row.row_id,
+                segment=segment)
+            parts.append(fragment)
+            segment += 1
+            if segment == fragment.segment_count:
+                break
+        assert ''.join(p.text for p in parts) == row.text and {p.row_id for p in parts} == {row.row_id}
+        assert parts[0].role == row.role and parts[0].created_at_ms == int(row.created_at * 1000)
+    assert max(p.segment_count for p in parts) >= 1
+
+
+@pytest.mark.asyncio
+async def test_existing_locate_is_newest_first_bounded_and_distinguishes_budget_from_absence(rig):
+    actor, source = device(rig)
+    target = telegram(rig)
+    ids = support.bulk_rows(rig.authority.db, 'tg-1', 12)
+    visited = []
+    found = await rig.authority.locate_existing_display(
+        actor, target, adapter=rig.adapter, source=source, authorize=lambda: None,
+        matches=lambda identity: visited.append(identity) or identity == ids[8])
+    assert visited == [ids[11], ids[10], ids[9], ids[8]] and found.identity == ids[8]
+    other = await rig.authority.locate_existing_display(
+        actor, target, adapter=rig.adapter, source=source, authorize=lambda: None,
+        matches=lambda identity: identity == ids[3])
+    assert other.physical_id != found.physical_id and isinstance(other.physical_id, int)
+    with pytest.raises(RuntimeStoreError) as stopped:
+        await rig.authority.locate_existing_display(
+            actor, target, adapter=rig.adapter, source=source, authorize=lambda: None,
+            matches=lambda identity: identity == ids[0], max_rows=11)
+    assert (stopped.value.reason, stopped.value.field) == ('read_budget', 'locate_rows')
+    assert await rig.authority.locate_existing_display(
+        actor, target, adapter=rig.adapter, source=source, authorize=lambda: None,
+        matches=lambda identity: False, max_rows=12) is None
+
+
+@pytest.mark.asyncio
+async def test_existing_target_and_source_authority_are_kept(rig):
+    actor, source = device(rig)
+    target = telegram(rig)
+    rig.authority.db.append_message('tg-1', 'assistant', 'private telegram answer')
+    rig.authority.db.create_session('api-1', source='api_server')
+    rig.authority.db.append_message('api-1', 'assistant', 'API_PRIVATE')
+    (row,) = await existing_fragments(rig, actor, source, target)
+    call = dict(adapter=rig.adapter, authorize=lambda: None)
+    refused = (
+        # not a readable existing source (API server) or a source that does not match the declared one
+        (actor, ExistingTarget('b', 'api-1', 'api_server'), source, 'not_found'),
+        (actor, ExistingTarget('c', 'tg-1', 'discord'), source, 'not_found'),
+        (actor, ExistingTarget('d', 'tg-missing', 'telegram'), source, 'not_found'),
+        # the right principal through another device's source, and a principal without session:read
+        (actor, target, device(rig, 'watch')[1], 'permission_denied'),
+        (device(rig, 'phone', ('session:submit',))[0], target, source, 'permission_denied'),
+        (replace(actor, profile_id='another'), target, source, 'profile_mismatch'),
+    )
+    for who, where, via, reason in refused:
+        with pytest.raises(RuntimeStoreError, match=reason):
+            await rig.authority.read_existing_display(who, where, source=via, row_id=row.row_id, **call)
+        with pytest.raises(RuntimeStoreError, match=reason):
+            await rig.authority.locate_existing_display(who, where, source=via, matches=lambda i: True, **call)
+
+
+@pytest.mark.asyncio
+async def test_existing_reads_prove_authority_first_and_again_after(rig, monkeypatch):
+    actor, source = device(rig)
+    target = telegram(rig)
+    rig.authority.db.append_message('tg-1', 'assistant', 'answer')
+    (row,) = await existing_fragments(rig, actor, source, target)
+
+    def forbidden():
+        raise AssertionError('canonical read must not start')
+    blind = replace(actor, capabilities=frozenset())
+    real = rig.authority.db._read_ctx
+    monkeypatch.setattr(rig.authority.db, '_read_ctx', forbidden)
+    with pytest.raises(RuntimeStoreError, match='permission_denied'):
+        await rig.authority.read_existing_display(blind, target, adapter=rig.adapter, source=source,
+                                                  authorize=lambda: None, row_id=row.row_id)
+    monkeypatch.setattr(rig.authority.db, '_read_ctx', real)
+    calls = []
+
+    def revoke_after():
+        calls.append(1)
+        if len(calls) > 1:
+            raise RuntimeStoreError('permission_denied')
+    with pytest.raises(RuntimeStoreError, match='permission_denied'):
+        await rig.authority.read_existing_display(actor, target, adapter=rig.adapter, source=source,
+                                                  authorize=revoke_after, row_id=row.row_id)
+    assert len(calls) == 2  # once to prove the caller, again by the post-read fence
+
+
+@pytest.mark.asyncio
+async def test_existing_fence_is_scalar_and_detects_an_edit(rig):
+    actor, source = device(rig)
+    target = telegram(rig)
+    db = rig.authority.db
+    row_id = db.append_message('tg-1', 'user', 'old prompt')
+    (row,) = await existing_fragments(rig, actor, source, target)
+    call = dict(adapter=rig.adapter, source=source, authorize=lambda: None, row_id=row.row_id)
+    taken = rig.authority.check_existing_display(actor, target, **call)
+    statements = []
+    with support.traced_reads(db, statements):
+        assert rig.authority.check_existing_display(actor, target, **call) == taken
+    assert support.hydrated_ids(statements) == set()
+    assert db.set_user_message_content('tg-1', row_id, 'new prompt') == 1
+    assert rig.authority.check_existing_display(actor, target, **call) != taken
+    for who, where, via, reason in ((replace(actor, capabilities=frozenset()), target, source, 'permission_denied'),
+                                    (actor, ExistingTarget('b', 'tg-1', 'discord'), source, 'not_found'),
+                                    (actor, target, device(rig, 'watch')[1], 'permission_denied')):
+        with pytest.raises(RuntimeStoreError, match=reason):
+            rig.authority.check_existing_display(who, where, adapter=rig.adapter, source=via,
+                                                 authorize=lambda: None, row_id=row.row_id)
+    with pytest.raises(RuntimeStoreError, match='not_found'):
+        rig.authority.check_existing_display(actor, target, **{**call, 'row_id': 'no-such-identity'})
