+"""HARNESS stand-in for tools/native_tts_engine_helper.py's protocol (NOT an engine, NOT library proof). Reads the one
+JSON request from stdin and acts on the mode in its synthetic text (``MODE:<mode> …``): ok, unavailable, failed,
+noreply, badwav, noise (stderr chatter + ok), flood (stdout past the cap), big (a WAV that grows past the cap), hang,
+late (finishes after 1.5 s). Writes only the request's ``wav_path``; every loop is bounded; network-free."""
+import json
+import struct
+import sys
+import time
+
+req = json.loads(sys.stdin.buffer.read(65537).decode('utf-8'))
+mode = req['text'].split()[0].removeprefix('MODE:')
+wav_path, cap = req['wav_path'], req['max_wav_bytes']
+
+
+def wav(path, frames=4800):
+    data = b'\x00\x00' * frames
+    header = b'RIFF' + struct.pack('<I', 36 + len(data)) + b'WAVEfmt ' + struct.pack('<IHHIIHH', 16, 1, 1, 24000, 48000, 2, 16)
+    with open(path, 'wb') as handle:
+        handle.write(header + b'data' + struct.pack('<I', len(data)) + data)
+
+
+def reply(status, reason='ok'):
+    size = 0
+    if status == 'ok':
+        with open(wav_path, 'rb') as handle:
+            size = len(handle.read())
+    print(json.dumps({'api': 1, 'status': status, 'reason': reason, 'sample_rate': 24000, 'wav_bytes': size}), flush=True)
+
+
+def wait(seconds):
+    for _ in range(int(seconds * 10)):  # bounded
+        time.sleep(0.1)  # health: allow HX013 -- the stall IS the behaviour under test
+
+
+def finish():
+    if mode == 'noise':
+        print('engine chatter that must never be reported', file=sys.stderr, flush=True)
+    if mode == 'late':
+        wait(1.5)
+    wav(wav_path)
+    reply('ok')
+
+
+def badwav():
+    with open(wav_path, 'wb') as handle:
+        handle.write(b'not a wav file at all' * 10)
+    reply('ok')
+
+
+def flood():
+    for _ in range(64):  # bounded: 64 x 8 KiB
+        sys.stdout.write('x' * 8192)
+    sys.stdout.flush()
+    wait(10)
+
+
+def big():
+    wav(wav_path)
+    with open(wav_path, 'ab') as handle:
+        for _ in range((cap // 65536) + 64):  # bounded: just past the cap
+            handle.write(b'\x00' * 65536)
+            handle.flush()
+    wait(10)
+
+
+MODES = {'ok': finish, 'noise': finish, 'late': finish, 'unavailable': lambda: reply('unavailable', 'fixture'),
+         'failed': lambda: reply('failed', 'fixture'), 'badwav': badwav, 'flood': flood, 'big': big,
+         'hang': lambda: wait(20), 'noreply': lambda: None}
+MODES[mode]()
