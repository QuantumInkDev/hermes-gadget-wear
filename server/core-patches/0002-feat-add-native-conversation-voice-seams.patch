+class Auxiliary:
+    """Counts REAL calls of the auxiliary client entry the tag rewrite imports at call time (and answers it)."""
+
+    def __init__(self, monkeypatch, reply):
+        self.calls = []
+        self.reply = reply
+        monkeypatch.setattr('agent.auxiliary_client.call_llm', self)
+
+    def __call__(self, **kwargs):
+        self.calls.append(kwargs)
+        message = type('M', (), {'content': self.reply})()
+        return type('R', (), {'choices': [type('C', (), {'message': message})()]})()
