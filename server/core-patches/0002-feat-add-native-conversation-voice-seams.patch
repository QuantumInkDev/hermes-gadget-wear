+def wrapped_programs(spawns):
+    """Program name of every child behind the pass-through stand-in launcher, in spawn order (ffmpeg, then the command's /bin/sh)."""
+    return [os.path.basename(support.program_of(s)) for s in spawns
+            if isinstance(s['args'], list) and len(s['args']) > 5 and str(support.PASSTHROUGH) in s['args'][:2]]
+
