index 0000000000000000000000000000000000000000..1497926000b4b87af56a0cbbc5fd5905fa998c4b
--- /dev/null
+++ b/tools/native_response_bounds.py
@@ -0,0 +1,86 @@
+"""Response bounds of a native (Relay) voice call, applied BEFORE an SDK or a JSON layer buffers an answer.
+
+Native requests ask for ``Accept-Encoding: identity``, but a peer may ignore that, so the request header is never the
+enforcement. The enforcement is here: a nonidentity ``Content-Encoding`` is refused on the headers, before any decoder
+or parser can see the body, and a body is read in bounded steps that stop at the cap or when Stop/the deadline closed the call.
+
+* ``refuse_nonidentity`` - the encoding rule, shared by the httpx response hooks and the Requests hook.
+* ``requests_response_hook`` - the Requests (urllib3) seam. Requests dispatches its ``response`` hooks BEFORE
+  ``Session.send`` runs ``resolve_redirects``, and that evaluates ``response.content`` (a whole, DECODED read) for any 3xx
+  with ``Location`` even when ``allow_redirects=False``; so the bound and the identity rule must run in the hook, not after
+  ``requests.post`` returns. The multipart STT backends (xAI, ElevenLabs) BUFFER there: the body is read from
+  ``response.raw`` UNDECODED, ``read(64 KiB)`` at a time, stopping at the crossing, and handed back through the attributes
+  Requests itself fills, so the unchanged stock parser (and Requests' own redirect step) reads the bounded bytes and cannot
+  read the raw stream a second time. The REST TTS backends (xAI, MiniMax, Gemini) stream their body later, so their hook
+  checks the headers and refuses a redirect-class answer without reading it.
+
+Honest limits: the bound is chunk-granular. The data kept is at most the cap plus the one read (httpx: the underlying stream
+chunk; Requests: 64 KiB) that crosses it. It is NOT an allocation-hard heap cap, and a ``Content-Length`` is only an
+early-rejection aid, never trusted proof. Stop/the deadline are checked BETWEEN reads: a vendor read that is already blocked in
+the socket or stream is not preempted (it ends when the peer sends, or at the client's own IO timeout), after which the reader
+stops at once and produces nothing. A peer that ignores identity is unusable as a bounded native response: its send is already
+counted, so the call is ``failed_after_send``; it is never retried, replaced or silently accepted, and for STT it is a TERMINAL
+refusal (no installed local fallback). Outside a native call nothing here runs and every stock path is unchanged.
+"""
+from __future__ import annotations
+
+from typing import Any, Callable, Optional
+
+from tools import native_send_policy
+
+READ_STEP_BYTES = 64 * 1024
+UNSUPPORTED_ENCODING = "unsupported_encoding"  # internal policy token (never provider text, never a wire value)
+
+
+def refuse_nonidentity(content_encoding: Optional[str]) -> None:
+    """Raise the native refusal unless ``content_encoding`` is absent, empty or ``identity`` (any other token, alone or in a
+    list, would hand the body to a decoder)."""
+    tokens = [token.strip().lower() for token in (content_encoding or "").split(",")]
+    if any(token not in ("", "identity") for token in tokens):
+        raise native_send_policy.refuse(UNSUPPORTED_ENCODING)
+
+
+def _declared_length(headers: Any) -> int:
+    declared = str(headers.get("Content-Length", "")).strip()
+    return int(declared) if declared.isdigit() else 0
+
+
+def _buffer_answer(response: Any, limit: int) -> None:
+    """Read ``response.raw`` undecoded under ``limit`` (Stop/deadline checked between reads) and fill ``response``'s content."""
+    chunks: list[bytes] = []
+    total = 0
+    try:
+        while True:
+            native_send_policy.check_alive()
+            chunk = response.raw.read(READ_STEP_BYTES, decode_content=False)
+            if not chunk:
+                break
+            total += len(chunk)
+            if total > limit:
+                raise native_send_policy.refuse("too_long")
+            chunks.append(chunk)
+    finally:
+        response.close()
+    response._content = b"".join(chunks)  # the attributes Requests itself fills after its own eager read
+    response._content_consumed = True
+
+
+def requests_response_hook(limit: int, *, buffer: bool) -> Callable[..., Any]:
+    """The native ``requests`` response hook: liveness, nonidentity encoding, an advertised length over ``limit``; then either
+    buffer the bounded body (``buffer=True``, the STT upload) or refuse a redirect-class answer unread (``buffer=False``, REST
+    TTS, whose body is streamed by the caller). The response is closed on every refusal."""
+    def hook(response: Any, **_kwargs: Any) -> Any:
+        try:
+            native_send_policy.check_alive()
+            refuse_nonidentity(response.headers.get("Content-Encoding"))
+            if _declared_length(response.headers) > limit:
+                raise native_send_policy.refuse("too_long")
+            if buffer:
+                _buffer_answer(response, limit)
+            elif response.is_redirect:
+                raise RuntimeError("TTS provider answered with a redirect")  # counted send, unusable answer; never followed
+        except BaseException:
+            response.close()
+            raise
+        return response
+    return hook
