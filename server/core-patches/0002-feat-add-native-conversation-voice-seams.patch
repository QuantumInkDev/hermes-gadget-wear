+"""Native voice seam: callback fences, cached-only local fallback, provider boundaries, real local audio tools.
+
+Deterministic where it matters: the loop callback that runs the consumer's ``authorize`` /
+``before_send`` is HELD between "enqueued by the worker" and "executed by the loop", so the order
+"closed first, callback later" is forced without any sleep.
+"""
+import asyncio
+import logging
+import os
+import sys
+import threading
+import types
+
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-fence'
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def configured():
+    support.write_config(get_hermes_home(), {
+        'stt': {'provider': 'openai', 'cloud_trim_silence': False, 'openai': {'api_key': KEY, 'model': 'whisper-1'}},
+        'tts': {'provider': 'openai', 'openai': {'api_key': KEY}}})
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+def words(text='hello world'):
+    return ('ok', {'text': text, 'json': False})
+
+
+async def hear(clip, callbacks, deadline_s=30):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+async def speak(out, callbacks, text='Hello there, friend.', deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+class HeldGate:
+    """Holds the loop callback the worker enqueues for the consumer's callbacks until the test releases it."""
+
+    def __init__(self, monkeypatch):
+        self.loop = asyncio.get_running_loop()
+        self.enqueued = threading.Event()
+        self.held = None
+        self.real = self.loop.call_soon_threadsafe
+
+        def intercept(callback, *args, **kwargs):
+            if 'loop_gate' in getattr(callback, '__qualname__', ''):
+                self.held = callback
+                self.enqueued.set()
+                return None
+            return self.real(callback, *args, **kwargs)
+        monkeypatch.setattr(self.loop, 'call_soon_threadsafe', intercept)
+
+    async def wait_enqueued(self):
+        assert await asyncio.to_thread(self.enqueued.wait, 10)
+
+    async def release(self):
+        done = asyncio.Event()
+
+        def run():
+            self.held()
+            done.set()
+        self.real(run)
+        await done.wait()
+
+
+def watch_worker(monkeypatch, module, name):
+    """An Event set when the worker function has fully returned (the late path has finished)."""
+    finished = threading.Event()
+    original = getattr(module, name)
+
+    def watched(*args, **kwargs):
+        try:
+            return original(*args, **kwargs)
+        finally:
+            finished.set()
+    monkeypatch.setattr(module, name, watched)
+    return finished
+
+
+@pytest.mark.asyncio
+async def test_stt_callbacks_never_run_after_the_task_was_cancelled(monkeypatch, clip, configured):
+    from gateway import session_native_voice_stt as stt_module
+    finished = watch_worker(monkeypatch, stt_module, '_configured')
+    cb = support.Callbacks()
+    wire = support.Wire([words()])
+    held = HeldGate(monkeypatch)
+    task = asyncio.create_task(hear(clip, cb))
+    with support.provider_wire(monkeypatch, wire):
+        await held.wait_enqueued()
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        await held.release()
+        assert await asyncio.to_thread(finished.wait, 10)
+    assert cb.authorize_calls == 1 and cb.before_send_calls == 0  # only the pre-work check; nothing late
+    assert wire.count == 0
+
+
+@pytest.mark.asyncio
+async def test_stt_callbacks_never_run_after_the_deadline_returned(monkeypatch, clip, configured):
+    from gateway import session_native_voice_stt as stt_module
