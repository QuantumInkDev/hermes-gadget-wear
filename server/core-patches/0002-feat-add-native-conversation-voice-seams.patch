+    assert (result.state, result.provider, wire.count, catalog) == ('transcribed', 'completed', 1, [])
+    assert wire.requests[0].url.host == 'api.deepinfra.com'
+
+
+@pytest.mark.asyncio
+async def test_a_failing_configured_local_backend_is_failed_not_unavailable_and_not_retried(monkeypatch, clip):
+    calls = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: calls.append(path) or {'success': False, 'transcript': '', 'error': 'x'})
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'local'}})
+    cb = support.Callbacks()
+    result = await seam(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'not_started')
+    assert len(calls) == 1 and cb.before_send_calls == 0
