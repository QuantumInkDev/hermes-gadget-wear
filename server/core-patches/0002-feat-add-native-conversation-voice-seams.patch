+            calls.append(1)
+            if len(calls) > 1:
+                raise RuntimeStoreError('permission_denied')
+        with pytest.raises(RuntimeStoreError, match='permission_denied'):
+            if operation == 'read':
+                await rig.authority.read_native_display(reader(), ref, authorize=revoke_after_the_read, identity=first.row_id)
+            else:
+                await rig.authority.locate_native_display(reader(), ref, authorize=revoke_after_the_read,
+                                                          matches=lambda identity: identity == first.row_id)
+        assert len(calls) == 2
