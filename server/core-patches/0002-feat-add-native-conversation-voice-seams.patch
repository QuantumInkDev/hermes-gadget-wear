+TEXT = 'Qualification sentence for the profile controls.'
+# A two-sentence speech that the stock chunker splits into EXACTLY two chunks under the configured per-chunk cap (the premise is
+# asserted by ``chunks_of`` and proved by a successful control); EXPECTED_CHUNKS are literal expectations, not read back.
+MULTI_TEXT = 'First qualification sentence is here. Second qualification sentence follows now.'
+MULTI_CAP = 45
+EXPECTED_CHUNKS = ['First qualification sentence is here.', 'Second qualification sentence follows now.']
+# Independent expected values: the configs below are written FROM these, the assertions compare the REQUESTS to these.
+PROFILES = {
+    'A': dict(voice='QualVoiceAlpha001', model='qual_model_alpha', key='el-qual-key-alpha', audio=b'ID3qual-alpha'),
+    'B': dict(voice='QualVoiceBravo002', model='qual_model_bravo', key='el-qual-key-bravo', audio=b'ID3qual-bravo'),
+}
+GROQ_KEY = 'gsk-qual-key-bravo'
