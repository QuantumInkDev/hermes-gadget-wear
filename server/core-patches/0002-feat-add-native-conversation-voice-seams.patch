@@ -0,0 +1,258 @@
+"""Native voice seam, Mistral: client identity, SDK options and accounting after an entered invocation.
+
+A hooked SDK that passes the identity proof and then sends outside the gate may also fail. The consumer then has no
+durable in-flight record: the result must be ``failed`` with ``provider='unknown'`` and a configured-STT failure of
+that kind must NOT run the local fallback (a conservative trade-off: when the true failure was local the fallback
+is lost too). Failures BEFORE the invocation is entered stay truthful ``unavailable`` / ``not_started``.
+
+The diverging and option-less SDKs below are LABELLED STAND-INS that misbehave on purpose; they are distinct from the
+real-SDK proof in ``test_native_voice_mistral``. The per-arm and pre-entry controls use the real pinned SDK for the
+chunk that is gated, and fail on a plain, non-refusal pre-entry error so policy refusal cannot mask them.
+"""
+import os
+import types
+
+import httpx
+import pytest
+
+from tests.gateway import mistral_voice_support as mistral
+from tests.gateway import native_voice_support as support
+from tests.gateway.mistral_voice_support import hear, speak
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def fallback(monkeypatch):
+    """A cached local STT backend that would answer if the seam ever fell back to it."""
+    calls = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: calls.append(path) or {'success': True, 'transcript': 'local words'})
+    return calls
+
+
+class Diverging:
+    """Labelled stand-in: reports the injected client as its sender (the identity proof PASSES), accepts the zero-retry
+    options, then sends once through ITS OWN client over the synthetic transport and fails or answers on its own."""
+
+    answer = 'raise'
+
+    def __init__(self, api_key=None, client=None, timeout_ms=None, retry_config=None, debug_logger=None, server_url=None):
+        self.sdk_configuration = types.SimpleNamespace(client=client)
+        self.own = httpx.Client()
+        self.audio = types.SimpleNamespace(
+            transcriptions=types.SimpleNamespace(complete=self.transcribe), speech=types.SimpleNamespace(complete=self.speak))
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.own.close()
+
+    def transcribe(self, *, model, file, language=None, retries=None, timeout_ms=None):
+        response = self.own.post(mistral.TRANSCRIPTION_URL, content=b'x')
+        response.raise_for_status()
+        return types.SimpleNamespace(text=None, error='stand-in failure result')  # no text: the stock failure result
+
+    def speak(self, *, input, model=None, voice_id=None, response_format=None, retries=None, timeout_ms=None):
+        response = self.own.post(mistral.SPEECH_URL, content=b'x')
+        if type(self).answer == 'raise':
+            response.raise_for_status()
+        return types.SimpleNamespace(audio_data='SUQzZGl2ZXJnZWQ=')  # valid base64 audio nobody gated
+
+
+class IgnoresInjectedClient(Diverging):
+    """Labelled stand-in: builds and uses its OWN client whatever it is handed (the identity proof must FAIL)."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.sdk_configuration = types.SimpleNamespace(client=self.own)
+
+
+class WithoutRetryOption(Diverging):
+    """Labelled stand-in: passes the identity proof but its endpoints cannot be told "no retry"."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.audio = types.SimpleNamespace(
+            transcriptions=types.SimpleNamespace(complete=lambda *, model, file, language=None: self.never()),
+            speech=types.SimpleNamespace(complete=lambda *, input, model=None, voice_id=None, response_format=None: self.never()))
+
+    def never(self):
+        raise AssertionError('the seam must refuse before invoking an SDK it cannot hold to zero retries')
+
+
+def use_stt_sdk(monkeypatch, sdk):
+    monkeypatch.setattr('mistralai.client.Mistral', sdk)
+
+
+def use_tts_sdk(monkeypatch, sdk):
+    monkeypatch.setattr('tools.tts_tool._import_mistral_client', lambda: sdk)
+
+
+# --- divergent clients after the identity proof -------------------------------------------------------------
+
+@pytest.mark.asyncio
+async def test_a_diverging_stt_sdk_that_raises_after_its_own_send_is_failed_unknown_and_never_falls_back(
+        monkeypatch, clip, fallback):
+    mistral.stt_profile()
+    use_stt_sdk(monkeypatch, Diverging)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'unknown')
+    assert wire.count == 1 and cb.before_send_calls == 0 and fallback == []
+    assert support.SECRET not in repr(result)
+
+
+@pytest.mark.asyncio
+async def test_a_diverging_stt_sdk_that_returns_a_failure_result_is_failed_unknown_and_never_falls_back(
+        monkeypatch, clip, fallback):
+    mistral.stt_profile()
+
+    class ReturnsFailure(Diverging):
+        def transcribe(self, *, model, file, language=None, retries=None, timeout_ms=None):
+            self.own.post(mistral.TRANSCRIPTION_URL, content=b'x')
+            return types.SimpleNamespace(text=None, error='stand-in failure result')
+    use_stt_sdk(monkeypatch, ReturnsFailure)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {})] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await hear(clip, cb)
+    assert (result.state, result.transcript, result.source, result.provider) == ('failed', None, None, 'unknown')
+    assert wire.count == 1 and cb.before_send_calls == 0 and fallback == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('answer, state, provider', [('raise', 'failed', 'unknown'), ('answer', 'failed', 'unknown')],
+                         ids=['raises', 'returns-audio-nobody-gated'])
+async def test_a_diverging_tts_sdk_is_failed_unknown_and_leaves_no_file(monkeypatch, out, answer, state, provider):
+    mistral.tts_profile()
+    use_tts_sdk(monkeypatch, type('Diverged', (Diverging,), {'answer': answer}))
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('status', 500)] * 3)
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == (state, None, provider)
+    assert wire.count == 1 and cb.before_send_calls == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_a_later_chunk_that_diverges_leaves_the_aggregate_unknown_and_cleans_up(monkeypatch, out):
+    from mistralai.client import Mistral
+    mistral.tts_profile(max_text_length=60)
+    built = []
+
+    def importer():
+        built.append(1)
+        # call 1 is the engine-availability probe, call 2 builds chunk 1 (real, gated), call 3 builds chunk 2 (diverges)
+        return Mistral if len(built) <= 2 else Diverging
+    monkeypatch.setattr('tools.tts_tool._import_mistral_client', importer)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3first'}), ('status', 500), ('ok', {'audio': b'ID3never'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=mistral.LONG_TEXT)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'unknown')
+    assert len(built) == 3, 'no third chunk is attempted after the unaccounted one'
+    assert wire.count == 2 and cb.before_send_calls == 1 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_an_sdk_that_retries_by_itself_through_the_injected_client_is_held_to_one_send(monkeypatch, clip, out):
+    """Labelled stand-in: honest about identity and options, but its endpoint posts twice through the injected client
+    (what a retrying SDK would do). The second attempt is refused at the gate, before anything leaves."""
+    class Retries(Diverging):
+        def transcribe(self, *, model, file, language=None, retries=None, timeout_ms=None):
+            for _ in range(2):
+                self.sdk_configuration.client.post(mistral.TRANSCRIPTION_URL, content=b'x')
+            return types.SimpleNamespace(text='never', error=None)
+
+        def speak(self, *, input, model=None, voice_id=None, response_format=None, retries=None, timeout_ms=None):
+            for _ in range(2):
+                self.sdk_configuration.client.post(mistral.SPEECH_URL, content=b'x')
+            return types.SimpleNamespace(audio_data='SUQzbmV2ZXI=')
+    use_stt_sdk(monkeypatch, Retries)
+    use_tts_sdk(monkeypatch, Retries)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('status', 500)] * 4)
+    with support.provider_wire(monkeypatch, wire):
+        mistral.stt_profile()
+        text = await hear(clip, cb)
+        mistral.tts_profile()
+        speech = await speak(out, cb)
+    assert (text.state, text.provider, speech.state, speech.provider) == ('failed', 'failed_after_send') * 2
+    assert wire.count == 2 and cb.before_send_calls == 2 and os.listdir(out) == []  # one send per call, never two
+
+
+# --- before the invocation is entered: truthful unavailable / not_started ------------------------------------
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('sdk', [IgnoresInjectedClient, WithoutRetryOption], ids=['ignores-injected', 'no-retry-option'])
+async def test_an_sdk_that_ignores_the_injected_client_or_cannot_be_told_no_retry_is_refused_unsent(
+        monkeypatch, clip, out, sdk):
+    use_stt_sdk(monkeypatch, sdk)
+    use_tts_sdk(monkeypatch, sdk)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3x'}), ('ok', {})])
+    with support.provider_wire(monkeypatch, wire):
+        mistral.tts_profile()
+        speech = await speak(out, cb)
+        mistral.stt_profile()
+        text = await hear(clip, cb)
+    assert (speech.state, speech.provider) == ('unavailable', 'not_started')
+    assert (text.state, text.provider) == ('unavailable', 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+async def test_a_plain_non_refusal_failure_before_entry_is_not_unknown_for_stt_or_a_later_tts_chunk(
+        monkeypatch, clip, out, fallback):
+    """The SDK cannot even be constructed: no policy refusal explains it, no invocation was entered, nothing left."""
+    class Unbuildable:
+        def __init__(self, *args, **kwargs):
+            raise RuntimeError('synthetic construction failure')
+    mistral.stt_profile()
+    use_stt_sdk(monkeypatch, Unbuildable)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {})])
+    with support.provider_wire(monkeypatch, wire):
+        heard = await hear(clip, cb)
+    assert (heard.state, heard.transcript, heard.source, heard.provider) == (
+        'transcribed', 'local words', 'local_fallback', 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0 and len(fallback) == 1
+
+
+@pytest.mark.asyncio
+async def test_each_tts_chunk_starts_a_fresh_entry_scope_so_a_later_pre_entry_failure_stays_known(monkeypatch, out):
+    """Chunk 1 is entered and gated; chunk 2 fails with a plain error BEFORE its invocation. Entry state carried over
+    from chunk 1 would turn that known failure into ``unknown``; a per-arm reset keeps it ``completed``."""
+    from mistralai.client import Mistral
+
+    class Unbuildable:
+        def __init__(self, *args, **kwargs):
+            raise RuntimeError('synthetic construction failure')
+    mistral.tts_profile(max_text_length=60)
+    built = []
+
+    def importer():
+        built.append(1)
+        return Mistral if len(built) <= 2 else Unbuildable  # probe, chunk 1 real, chunk 2 unbuildable
+    monkeypatch.setattr('tools.tts_tool._import_mistral_client', importer)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': b'ID3first'}), ('ok', {'audio': b'ID3never'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=mistral.LONG_TEXT)
+    assert (result.state, result.path, result.provider) == ('failed', None, 'completed')
+    assert wire.count == 1 and cb.before_send_calls == 1 and len(built) == 3 and os.listdir(out) == []
