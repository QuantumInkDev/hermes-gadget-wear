+    A separate isolated child (``python -I`` :mod:`tools.native_tts_engine_helper`) in a new session, inside the
+    qualified network-deny launcher, private empty cwd, an explicit minimal env with offline flags set before its
+    imports; the text travels on stdin only. The WAV sidecar is tracked BEFORE the spawn (the caller removes it on any
+    failure, cancel or late completion) and watched while the child runs; the reply is one bounded JSON line; the WAV is
+    validated and converted to MP3 by the real ffmpeg as another launcher-wrapped, Stop-aware child bounded by the exact
+    deadline (no extension rename). ``unavailable`` from the helper is an unsent refusal; anything else after the launch
+    is a failure after a local invocation. No gated send exists: the seam accounts it local (``not_started``)."""
+    import shutil
+    import tempfile
+    from tools import native_send_policy
+    from tools.tts_command_provider import run_native_argv
+    from tools.tts_tool_delivery import _remove_quietly
+    policy = native_send_policy.current()
+    if policy is None or policy.deadline is None or policy.max_output_bytes is None:
+        raise _refuse_unsupported()
+    limit, wav_path = policy.max_output_bytes, str(Path(mp3_path).with_suffix(".wav"))
+    request = json.dumps({"api": 1, "engine": engine, "text": text, "wav_path": wav_path, "max_wav_bytes": limit,
+                          engine: native_engine_options(engine, tts_config)}).encode("utf-8")
+    track(wav_path)
