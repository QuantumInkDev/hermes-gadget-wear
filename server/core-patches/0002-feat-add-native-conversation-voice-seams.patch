+"""Stock STT/TTS provider transport behaviour that the native voice seam must not share.
+
+Measured on the real OpenAI SDK + httpx client with only the network transport replaced
+(``tests/gateway/native_voice_support.py``). The numbers are observations of the retained stock
+paths: the native seam (``gateway.session_native_voice``) is held to exactly one request, and
+these controls prove that its transport policy never leaks into the ordinary ``transcribe_audio``
+/ ``text_to_speech_tool`` paths when no native call is active.
+"""
+import asyncio
+import json
+import threading
+
+import httpx
+import pytest
+
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+STT_CONFIG = {'stt': {'provider': 'openai', 'cloud_trim_silence': False,
+                      'openai': {'api_key': 'sk-synthetic-stt', 'model': 'whisper-1'}}}
+TTS_CONFIG = {'tts': {'provider': 'openai', 'openai': {'api_key': 'sk-synthetic-tts'}}}
+
+
+def measured(label, **values):
+    print('NATIVE_VOICE_STOCK_MEASURE ' + json.dumps({'label': label, **values}, sort_keys=True))
+
+
+@pytest.fixture
+def stt(monkeypatch, tmp_path):
+    support.write_config(get_hermes_home(), STT_CONFIG)
+    monkeypatch.setattr('tools.transcription_cloud._transcode_audio_for_stt',
+                        lambda path, work: (None, 'transcode unavailable'))
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+def test_stock_stt_success_sends_one_request(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('ok', {'text': 'hello world', 'json': False})])
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert result['success'] and result['transcript'] == 'hello world'
+    assert wire.count == 1
+    measured('stock_stt_success', requests=wire.count, timeouts=[str(t) for t in wire.timeouts()])
+
+
+def test_stock_stt_resends_after_provider_5xx(monkeypatch, stt):
+    from tools.transcription_tools import transcribe_audio
+    wire = support.Wire([('status', 500)] * 8)
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(stt)
+    assert not result['success']
+    assert wire.count >= 2, 'the stock path re-sends a request the provider may already have accepted'
+    measured('stock_stt_5xx_without_transcode', requests=wire.count)
+
+
+def test_stock_stt_resends_after_5xx_and_a_successful_transcode(monkeypatch, tmp_path, stt):
+    import shutil
+    from tools.transcription_tools import transcribe_audio
+
+    def transcode(path, work):
+        out = f'{work}/clip.m4a'
+        shutil.copyfile(path, out)
