+def real_chunks(tmp_path, count):
+    """``count`` real MP3 chunks (distinct tone and length each) and their spans in seconds."""
+    spans = [round(0.5 + 0.2 * i, 1) for i in range(count)]
+    mp3 = [support.synth_mp3(tmp_path / f'c{i}.mp3', seconds=span, frequency=440 * (i + 1)) for i, span in enumerate(spans)]
+    return mp3, spans
