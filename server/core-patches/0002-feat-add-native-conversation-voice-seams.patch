+
+
+# --- logs: provider-controlled OAuth text stays out of a native call, stock logging is unchanged ----------------------
+
+@pytest.mark.asyncio
+async def test_refresh_failure_text_is_not_logged_in_a_native_call_but_stock_logging_is_unchanged(monkeypatch, out, caplog):
+    from tools.xai_http import resolve_xai_http_credentials
