+@pytest.mark.asyncio
+async def test_the_bearer_sent_is_the_issuing_accounts_and_no_other_refresh_token_is_spent(monkeypatch, out):
+    expired_a, token_b = rest.jwt(time.time() - 60, 'a-expired'), fresh_token('account-b')
+    tts_profile()
+    rest.write_oauth_store(None, pool=[('acct-a', expired_a, 'rt-A'), ('acct-b', token_b, 'rt-B')])
+    oauth = rest.OAuthWire([('ok', {'refresh_token': 'rt-A2'})])
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert (result.state, wire.count) == ('synthesized', 1)
+    assert bearer(wire) == f'Bearer {token_b}'  # the account that is fresh serves; the expired one is not resurrected
+    assert oauth.refresh_tokens_sent() == ['rt-A']  # only the expired account's own token, never rt-B
+    # a lone expired account is refreshed under its own refresh token and its refreshed bearer is the one sent
+    rest.write_oauth_store(None, pool=[('acct-a', expired_a, 'rt-A')])
+    oauth = rest.OAuthWire([('ok', {'refresh_token': 'rt-A3'})])
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert result.state == 'synthesized' and oauth.refresh_tokens_sent() == ['rt-A'] and bearer(wire) != f'Bearer {expired_a}'
+
