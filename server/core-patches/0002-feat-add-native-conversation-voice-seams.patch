+@pytest.fixture
+def joined(monkeypatch):
+    """LABELLED STAND-IN (routing and accounting only, never join proof): a byte-wise MP3 join for the multi-chunk step and
+    a join-capability probe that always passes. The real converter/concat proofs are in ``test_native_voice_pipeline`` and
+    ``test_native_voice_sdk_boundaries``; the stock join is replaced too, so a tree without the native pipeline module
+    measures the same routing."""
+    def concat(paths, output, voice_compatible=False):
+        with open(output, 'wb') as joined_file:
+            for path in paths:
+                with open(path, 'rb') as part:
