index 0000000000000000000000000000000000000000..4a50873b4687df7be0406461314484d04dec661f
--- /dev/null
+++ b/tests/tools/test_native_tts_engine_helper.py
@@ -0,0 +1,298 @@
+"""Native local-engine helper: request validation and complete-cache preflight (unit), plus the REAL helper as a
+launcher-wrapped child on this runtime.
+
+Preflight cases use synthetic package/cache trees and a test cache view that mirrors the staged huggingface_hub
+1.24.0 ``try_to_load_from_cache`` layout (refs/main -> snapshots/<rev>/<file>); this proves the helper's own decisions,
+never engine or library behaviour. No engine package is installed here, so the real child stops at ``not_installed``
+or ``runtime_unsupported`` before any vendor import.
+"""
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from tools import native_tts_engine_helper as helper
+
+FIXTURES = Path(__file__).resolve().parent / 'native_command_fixtures'
+
+
+class SyntheticHub:
+    """Test cache view with the hub's on-disk layout."""
+
+    def __init__(self, root):
+        self.cache_dir = str(root)
+
+    def _snap(self, repo, create=False):
+        repo_dir = Path(self.cache_dir) / ('models--' + repo.replace('/', '--'))
+        if create:
+            (repo_dir / 'refs').mkdir(parents=True, exist_ok=True)
+            (repo_dir / 'refs' / 'main').write_text('rev1')
+            (repo_dir / 'snapshots' / 'rev1').mkdir(parents=True, exist_ok=True)
+        return repo_dir / 'snapshots' / 'rev1'
+
+    def put(self, repo, name, data=b'x'):
+        path = self._snap(repo, create=True) / name
+        path.write_bytes(data if isinstance(data, bytes) else json.dumps(data).encode())
+        return path
+
+    def file(self, repo, name):
+        return helper.regular_file(str(self._snap(repo) / name))
+
+    def snapshot_dir(self, repo):
+        snap = self._snap(repo)
+        return snap if snap.is_dir() else None
+
+
+@pytest.fixture
+def hub(tmp_path):
+    return SyntheticHub(tmp_path / 'hub')
+
+
+def request(tmp_path, engine='piper', **over):
+    opts = {'piper': {'model_path': '', 'config_path': '', 'use_cuda': False, 'speaker_id': 0, 'knobs': None},
+            'kittentts': {'repo_id': 'KittenML/x', 'voice': 'Jasper', 'speed': 1.0, 'clean_text': True},
+            'neutts': {'original_repo': 'neuphonic/neutts-air-q4-gguf', 'device': 'cpu', 'ref_audio_path': '',
+                       'ref_text_path': '', 'language': None}}[engine]
+    req = {'api': 1, 'engine': over.pop('engine_name', engine), 'text': 'synthetic words',
+           'wav_path': str(tmp_path / 'out.wav'), 'max_wav_bytes': 1 << 20, engine: opts, **over}
+    return json.dumps(req).encode()
+
+
+# ---- request ---------------------------------------------------------------------------------------------------------
+def test_a_valid_request_parses(tmp_path):
+    assert helper.parse_request(request(tmp_path))['engine'] == 'piper'
+
+
+@pytest.mark.parametrize('bad', [
+    {'api': 2}, {'engine_name': 'other'}, {'text': ''}, {'text': 'x' * 5001}, {'wav_path': 'relative.wav'},
+    {'wav_path': '/nonexistent-dir/out.wav'}, {'max_wav_bytes': 10}, {'max_wav_bytes': True}, {'piper': {'extra': 1}}])
+def test_an_invalid_request_is_refused(tmp_path, bad):
+    with pytest.raises(helper.Unavailable) as refused:
+        helper.parse_request(request(tmp_path, **bad))
+    assert refused.value.reason == 'invalid_request'
+
+
+def test_an_existing_output_or_oversized_request_is_refused(tmp_path):
+    (tmp_path / 'out.wav').write_bytes(b'old')
+    for raw in (request(tmp_path), b'{' + b' ' * (64 * 1024) + b'}'):
+        with pytest.raises(helper.Unavailable):
+            helper.parse_request(raw)
+
+
+# ---- piper -----------------------------------------------------------------------------------------------------------
+def piper_tree(tmp_path, phoneme_type='espeak', voice='en-us', espeak=True, tashkeel=False, hebrew=False):
+    pkg = tmp_path / 'piper'
+    pkg.mkdir()
+    if espeak:
+        (pkg / 'espeakbridge.so').write_bytes(b'x')
+        (pkg / 'espeak-ng-data').mkdir()
+    if tashkeel:
+        (pkg / 'tashkeel').mkdir()
+        for name in ('model.onnx', 'input_id_map.json', 'target_id_map.json', 'hint_id_map.json'):
+            (pkg / 'tashkeel' / name).write_bytes(b'x')
+    if hebrew:
+        (pkg / 'hebrew').mkdir()
+        (pkg / 'hebrew' / 'nakdimon.onnx').write_bytes(b'x')
+    model = tmp_path / 'voice.onnx'
+    model.write_bytes(b'onnx')
+    Path(f'{model}.json').write_text(json.dumps({'phoneme_type': phoneme_type, 'espeak': {'voice': voice}}))
+    return pkg, {'model_path': str(model), 'config_path': f'{model}.json', 'use_cuda': False, 'speaker_id': 0,
+                 'knobs': None}
+
+
+@pytest.mark.parametrize('case,reason', [
+    (dict(), None), (dict(phoneme_type='text', espeak=False), None), (dict(phoneme_type='hebrew', espeak=False, hebrew=True), None),
+    (dict(voice='ar', tashkeel=True), None), (dict(voice='ar'), 'bundled_resource_missing'),
+    (dict(phoneme_type='hebrew', espeak=False), 'bundled_resource_missing'), (dict(espeak=False), 'espeak_missing'),
+    (dict(phoneme_type='pinyin'), 'unsupported_phoneme_type'), (dict(phoneme_type='japanese'), 'unsupported_phoneme_type'),
+    (dict(phoneme_type='thai'), 'unsupported_phoneme_type')])
+def test_piper_preflight(tmp_path, case, reason):
+    pkg, opts = piper_tree(tmp_path, **case)
+    if reason is None:
+        assert helper.preflight_piper(opts, pkg) == {'model_path': opts['model_path'], 'config_path': opts['config_path']}
+    else:
+        with pytest.raises(helper.Unavailable) as refused:
+            helper.preflight_piper(opts, pkg)
+        assert refused.value.reason == reason
+
+
+def test_piper_preflight_refuses_missing_model_config_or_package(tmp_path):
+    pkg, opts = piper_tree(tmp_path)
+    for broken, reason in (({**opts, 'model_path': str(tmp_path / 'absent.onnx')}, 'model_not_cached'),
+                           ({**opts, 'config_path': str(tmp_path / 'absent.json')}, 'model_not_cached')):
+        with pytest.raises(helper.Unavailable) as refused:
+            helper.preflight_piper(broken, pkg)
+        assert refused.value.reason == reason
+    Path(opts['config_path']).write_text('{not json')
+    with pytest.raises(helper.Unavailable) as refused:
+        helper.preflight_piper(opts, pkg)
+    assert refused.value.reason == 'invalid_voice_config'
+    with pytest.raises(helper.Unavailable) as refused:
+        helper.preflight_piper(opts, None)
+    assert refused.value.reason == 'not_installed'
+
+
+# ---- kittentts -------------------------------------------------------------------------------------------------------
+def kitten_loader(tmp_path, complete=True):
+    loader = tmp_path / 'espeakng_loader'
+    loader.mkdir()
+    if complete:
+        lib = {'darwin': 'libespeak-ng.dylib', 'win32': 'espeak-ng.dll'}.get(sys.platform, 'libespeak-ng.so')
+        (loader / lib).write_bytes(b'x')
+        (loader / 'espeak-ng-data').mkdir()
+    return loader
+
+
+def test_kittentts_preflight_resolves_explicit_local_files_and_config_priors(tmp_path, hub):
+    repo = 'KittenML/kitten-tts-nano-0.8-int8'
+    hub.put(repo, 'config.json', {'type': 'ONNX1', 'model_file': 'm.onnx', 'voices': 'v.npz',
+                                  'speed_priors': {'expr-voice-2-m': 1.1}, 'voice_aliases': {'Jasper': 'expr-voice-2-m'}})
+    model, voices = hub.put(repo, 'm.onnx'), hub.put(repo, 'v.npz')
+    resolved = helper.preflight_kittentts({'repo_id': repo}, hub, kitten_loader(tmp_path))
+    assert resolved == {'model_path': str(model), 'voices_path': str(voices), 'speed_priors': {'expr-voice-2-m': 1.1},
+                        'voice_aliases': {'Jasper': 'expr-voice-2-m'}}
+
+
+@pytest.mark.parametrize('state,reason', [('no-config', 'model_not_cached'), ('bad-type', 'invalid_model_config'),
+                                          ('no-model', 'model_not_cached'), ('no-voices', 'model_not_cached'),
+                                          ('no-espeak', 'espeak_missing')])
+def test_kittentts_preflight_refuses_incomplete_caches(tmp_path, hub, state, reason):
+    repo = 'KittenML/x'
+    if state != 'no-config':
+        hub.put(repo, 'config.json', {'type': 'ONNX9' if state == 'bad-type' else 'ONNX2', 'model_file': 'm.onnx',
+                                      'voices': 'v.npz'})
+    if state != 'no-model':
+        hub.put(repo, 'm.onnx')
+    if state != 'no-voices':
+        hub.put(repo, 'v.npz')
+    with pytest.raises(helper.Unavailable) as refused:
+        helper.preflight_kittentts({'repo_id': repo}, hub, kitten_loader(tmp_path, complete=state != 'no-espeak'))
+    assert refused.value.reason == reason
+
+
+# ---- neutts ----------------------------------------------------------------------------------------------------------
+def neutts_world(tmp_path, hub, *, ggufs=1, codec=True, encoder='safetensors', remote_code=False, perth=None, espeak=True):
+    pkg = tmp_path / 'neutts'
+    pkg.mkdir()
+    if espeak:
+        lib = {'darwin': 'libespeak-ng.1.dylib', 'win32': 'espeak-ng.dll'}.get(sys.platform, 'libespeak-ng.so.1')
+        (pkg / lib).write_bytes(b'x')
+        (pkg / 'espeak-ng-data').mkdir()
+    for index in range(ggufs):
+        hub.put('neuphonic/neutts-air-q4-gguf', f'model-{index}.gguf')
+    if codec:
+        for name in helper.NEUCODEC_FILES:
+            hub.put(helper.NEUCODEC_REPO, name)
+    config = {'model_type': 'wav2vec2-bert', **({'auto_map': {'AutoModel': 'x.Y'}} if remote_code else {})}
