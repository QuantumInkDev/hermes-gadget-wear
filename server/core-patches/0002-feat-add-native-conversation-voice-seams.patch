+    assert wire.count == cb.before_send_calls == len(sdk) >= 3  # one client, one send per chunk
+    assert all(built['kwargs']['client'].is_closed for built in sdk)
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert abs(support.media_seconds(result.path) - wire.count) < 0.6
+
+
+@pytest.mark.asyncio
+async def test_mistral_tts_stops_at_the_first_failed_chunk_and_removes_every_owned_file(monkeypatch, out, sdk, tmp_path):
+    mistral.tts_profile(max_text_length=60)
+    mp3 = support.synth_mp3(tmp_path / 'sine.mp3', seconds=1.0)
+    cb = support.Callbacks()
+    wire = mistral.MistralWire([('ok', {'audio': mp3}), ('status', 500), ('ok', {'audio': mp3})])
+    with support.provider_wire(monkeypatch, wire):
+        result = await speak(out, cb, text=mistral.LONG_TEXT)
+    assert (result.state, result.path) == ('failed', None)
+    assert wire.count == 2 and cb.before_send_calls == 2 and os.listdir(out) == []  # the third chunk never left
