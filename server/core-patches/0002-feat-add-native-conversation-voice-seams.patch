+"""Synthetic REST transports for the native REST TTS / xAI OAuth tests.
+
+Only network bytes are replaced, and only at the lowest layer that still lets the real library run:
+
+* ``RestWire`` replaces the ``requests`` transport adapter (what would open the socket). The REAL ``requests``
+  session builds the request, applies ``allow_redirects``/``timeout``/headers, follows (or not) redirects and streams
+  the body through a real ``urllib3`` response, so ``iter_content``, ``raise_for_status``, content-length enforcement and
+  content decoding are the library's own.
+* ``OAuthWire`` replaces ``httpx.HTTPTransport.handle_request``. The REAL stock xAI discovery, refresh POST, credential
+  pool, token store and JWT handling run above it.
+
+A count recorded here is the number of requests that would have left the process.
+
+Scope of the REST proof (review m6): ``RestWire`` replaces ``HTTPAdapter.send``, so the adapter's own urllib3 ``Retry`` configuration
+never runs here. That ``requests`` adds no retry of its own to a bare ``post`` rests on the library default (``max_retries=0``), not on
+these transports; redirects, a second POST in the same session and the gate's refusal of a second send are tested behaviourally.
+"""
+from __future__ import annotations
+
+import asyncio
+import base64
+import gzip
+import io
+import json
+import threading
+import time
+from contextlib import contextmanager
+from urllib.parse import parse_qs
+
+import httpx
+
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+
+class RestWire:
+    """Scripted ``requests`` provider. Steps: ``('audio', bytes)``, ``('json', obj)``, ``('raw', status, headers, body)``,
+    ``('status', code[, body])``, ``('redirect', url)``, ``('raise', exc)``. ``declared`` overrides Content-Length (a
+    truncated or lying body); ``hold`` stalls a request after it was recorded until the test releases it."""
+
+    def __init__(self, script=None, tap=None, hold=None):
+        self.script = list(script or [])
+        self.requests = []
+        self.tap = tap
+        self.hold = hold
+        self.entered = threading.Event()
+
+    @property
+    def count(self):
+        return len(self.requests)
+
+    def adapter(self):
+        import requests
+        from urllib3.response import HTTPResponse
+        wire = self
+
+        class Adapter(requests.adapters.HTTPAdapter):
+            def send(self, request, **kwargs):
+                wire.requests.append((request, kwargs))
+                wire.entered.set()
+                if wire.tap is not None:
+                    wire.tap(request)
+                if wire.hold is not None:
+                    assert wire.hold.wait(30), 'the test never released the stalled provider'
+                step = wire.script.pop(0) if wire.script else ('audio', b'ID3synthetic-audio')
+                kind = step[0]
+                if kind == 'raise':
+                    raise step[1]
+                status, headers, body, declared = wire.shape(step)
+                headers = dict(headers)
+                if declared is not False:  # False: no Content-Length at all (a body of unknown length)
+                    headers['Content-Length'] = str(len(body) if declared is None else declared)
+                raw = HTTPResponse(body=io.BytesIO(body), headers=headers, status=status, preload_content=False,
+                                   decode_content=True, request_url=request.url, enforce_content_length=True)
+                return self.build_response(request, raw)
+
+            def close(self):
+                pass
+        return Adapter()
+
+    @staticmethod
+    def shape(step):
+        kind = step[0]
+        declared = None
+        if kind == 'audio':
+            return 200, {'Content-Type': 'audio/mpeg'}, step[1], declared
+        if kind == 'json':
+            return 200, {'Content-Type': 'application/json'}, json.dumps(step[1]).encode(), declared
+        if kind == 'status':
+            return step[1], {'Content-Type': 'text/plain'}, step[2] if len(step) > 2 else b'synthetic provider failure', declared
+        if kind == 'redirect':
+            return 307, {'Location': step[1]}, b'', declared
+        assert kind == 'raw', kind
+        status, headers, body = step[1:4]
+        return status, headers, body, step[4] if len(step) > 4 else None
+
+    def body_json(self, index=0):
+        return json.loads(self.requests[index][0].body)
+
+    def timeouts(self):
+        return [kwargs.get('timeout') for _, kwargs in self.requests]
+
+
+@contextmanager
+def rest_wire(monkeypatch, wire):
+    import requests
+    adapter = wire.adapter()
+    monkeypatch.setattr(requests.Session, 'get_adapter', lambda self, url: adapter)
+    yield wire
+
+
+def pcm_bytes(seconds=1.0, rate=24000):
+    """Real 24 kHz mono 16-bit little-endian PCM (a sine), the Gemini TTS answer format."""
+    import math
+    import struct
+    return b''.join(struct.pack('<h', int(6000 * math.sin(2 * math.pi * 440 * i / rate))) for i in range(int(seconds * rate)))
+
+
+def gemini_answer(pcm):
+    return ('json', {'candidates': [{'content': {'parts': [{'inlineData': {'mimeType': 'audio/L16;rate=24000',
+                                                                           'data': base64.b64encode(pcm).decode()}}]}}]})
+
+
+def minimax_answer(audio):
+    return ('json', {'base_resp': {'status_code': 0, 'status_msg': 'success'}, 'data': {'audio': audio.hex()}})
+
+
+def gzipped(body):
+    return gzip.compress(body)
+
+
+# --- xAI OAuth: synthetic auth data and a synthetic OAuth authority below the real httpx client ---------------------
+
+def jwt(exp, tag='t'):
+    """A JWT-shaped bearer with an ``exp`` claim (None = no claim)."""
+    def part(data):
+        return base64.urlsafe_b64encode(json.dumps(data).encode()).rstrip(b'=').decode()
+    claims = {'tag': tag} if exp is None else {'exp': exp, 'tag': tag}
+    return f'{part({"alg": "none"})}.{part(claims)}.synthetic-signature'
+
+
+def write_oauth_store(access, refresh='rt-singleton', pool=()):
+    """The profile's real ``auth.json``: the xAI OAuth singleton and/or pool-only multi-account rows."""
+    store = {'version': 1, 'providers': {}}
+    if access is not None:
+        store['providers']['xai-oauth'] = {'tokens': {'access_token': access, 'refresh_token': refresh},
+                                           'auth_mode': 'oauth_device_code'}
+    if pool:
+        store['credential_pool'] = {'xai-oauth': [
+            {'id': ident, 'label': ident, 'auth_type': 'oauth', 'priority': index, 'source': 'manual:synthetic',
+             'access_token': token, 'refresh_token': refresh_token}
+            for index, (ident, token, refresh_token) in enumerate(pool)]}
+    (get_hermes_home() / 'auth.json').write_text(json.dumps(store))
+
+
+def read_oauth_store():
+    return json.loads((get_hermes_home() / 'auth.json').read_text())
+
+
+class OAuthWire:
+    """Synthetic xAI OAuth authority. ``token_script`` steps: ``('ok', {access_token, refresh_token})``,
+    ``('status', n)``, ``('redirect', url)``, ``('badjson',)``, ``('raise', exc)``. ``hold`` stalls the token POST."""
+
+    def __init__(self, token_script=None, hold=None, events=None, hold_discovery=None):
+        self.token_script = list(token_script or [])
+        self.requests = []
+        self.hold = hold
+        self.hold_discovery = hold_discovery
+        self.events = events
+        self.entered = threading.Event()
+        self.discovery_entered = threading.Event()
+
+    @property
+    def posts(self):
+        return [r for r in self.requests if r.method == 'POST']
+
+    @property
+    def gets(self):
+        return [r for r in self.requests if r.method == 'GET']
+
+    def refresh_tokens_sent(self):
+        return [parse_qs(r.content.decode())['refresh_token'][0] for r in self.posts]
+
+    def __call__(self, request):
+        self.requests.append(request)
+        if self.events is not None:
+            self.events.append('oauth-discovery' if request.method == 'GET' else 'oauth-refresh')
+        if request.method == 'GET':
+            self.discovery_entered.set()
+            if self.hold_discovery is not None:
+                assert self.hold_discovery.wait(30), 'the test never released the stalled OAuth discovery'
+            return httpx.Response(200, request=request, json={'authorization_endpoint': 'https://auth.x.ai/oauth2/authorize',
+                                                              'token_endpoint': 'https://auth.x.ai/oauth2/token'})
+        self.entered.set()
+        if self.hold is not None:
+            assert self.hold.wait(30), 'the test never released the stalled OAuth authority'
+        kind, *rest = self.token_script.pop(0) if self.token_script else ('ok', {})
+        if kind == 'raise':
+            raise rest[0]
+        if kind == 'status':
+            return httpx.Response(rest[0], request=request, text='synthetic oauth failure')
+        if kind == 'redirect':
+            return httpx.Response(307, request=request, headers={'location': rest[0]})
+        if kind == 'badjson':
+            return httpx.Response(200, request=request, text='<html>not json</html>')
+        body = {'access_token': jwt(time.time() + 3 * 3600, 'refreshed'), 'refresh_token': 'rt-rotated',
+                'expires_in': 10800, **rest[0]}
+        return httpx.Response(200, request=request, json=body)
+
+
+@contextmanager
+def oauth_wire(monkeypatch, wire):
+    monkeypatch.setattr(httpx.HTTPTransport, 'handle_request', lambda self, request: wire(request))
+    yield wire
+
+
+class EventDeadline:
+    """An event-armed call deadline for the seam's bounded wait: it expires when the test calls :meth:`fire`, after the
+    test saw the worker reach the point it wants to fence, not after a wall-clock window that a loaded machine could
+    overrun before the worker is ready. Only the gate module's ``asyncio.wait_for`` is replaced; everything else it
+    uses of ``asyncio`` is the real module."""
+
+    def __init__(self, monkeypatch):
+        from gateway import session_native_voice_gate as gate
+        self.fired = asyncio.Event()
+        outer = self
+
+        class Shim:
+            def __getattr__(self, name):
+                return getattr(asyncio, name)
+
+            async def wait_for(self, awaitable, timeout):
+                work = asyncio.ensure_future(awaitable)
+                expiry = asyncio.ensure_future(outer.fired.wait())
+                try:
+                    done, _ = await asyncio.wait({work, expiry}, return_when=asyncio.FIRST_COMPLETED)
+                except asyncio.CancelledError:
+                    work.cancel()
+                    raise
+                finally:
+                    expiry.cancel()
+                if work in done:
+                    return work.result()
+                work.cancel()
+                raise TimeoutError
+        monkeypatch.setattr(gate, 'asyncio', Shim())
+
+    def fire(self):
+        self.fired.set()
+
+
+class HeldProbe:
+    """Holds the loop callback the worker enqueues for the consumer's AUTHORIZATION-ONLY credential probe (the
+    ``loop_probe`` closure of the gate module) until the test releases it. Paid-gate callbacks are not held."""
+
+    def __init__(self, monkeypatch, which=1):
+        self.loop = asyncio.get_running_loop()
+        self.enqueued = threading.Event()
+        self.held = None
+        self.which = which
+        self.seen = 0
+        self.real = self.loop.call_soon_threadsafe
+
+        def intercept(callback, *args, **kwargs):
+            if 'loop_probe' in getattr(callback, '__qualname__', ''):
+                self.seen += 1
+                if self.seen == self.which:
+                    self.held = callback
+                    self.enqueued.set()
+                    return None
+            return self.real(callback, *args, **kwargs)
+        monkeypatch.setattr(self.loop, 'call_soon_threadsafe', intercept)
+
+    async def wait_enqueued(self):
+        assert await asyncio.to_thread(self.enqueued.wait, 10)
+
+    async def release(self):
+        done = asyncio.Event()
+
+        def run():
+            self.held()
+            done.set()
+        self.real(run)
+        await done.wait()
+
+
+class ThreadedCallbacks(support.Callbacks):
+    """The consumer's callbacks, recording the thread each ran on (they must run on the consumer's own loop thread)."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.threads = []
+
+    def authorize(self):
+        self.threads.append(threading.get_ident())
+        super().authorize()
+
+    def before_send(self):
+        self.threads.append(threading.get_ident())
+        super().before_send()
