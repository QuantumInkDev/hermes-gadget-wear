+    assert bounds.closed() is True
+    for missing in (dict(max_output_bytes=4096), dict(deadline=deadline)):
+        with native_send_policy.activate(_policy(**missing)), pytest.raises(NativeSendRefused) as refused:
+            native_send_policy.command_bounds()
+        assert refused.value.reason == 'unsupported'
