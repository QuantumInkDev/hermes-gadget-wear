+    def watch() -> Optional[str]:
+        try:
+            return "too_long" if os.path.getsize(wav_path) > limit else None
+        except OSError:
+            return None
+
+    cwd = tempfile.mkdtemp(prefix="hermes-native-engine-")
+    try:
+        result = run_native_argv([sys.executable, "-I", NATIVE_ENGINE_HELPER], timeout=_remaining(policy),
+                                 env=_native_child_env(), cwd=cwd, stdin_bytes=request, watch=watch,
+                                 max_stream_bytes=_ENGINE_STREAM_BYTES)
+        answer = _parse_engine_reply(result.stdout)
+        if answer["status"] == "unavailable":
+            declined = _refuse_unsupported()
+            declined.engine_declined = True  # the helper itself reports a missing prerequisite for THIS chunk (the seam decides whether earlier chunks completed)
+            raise declined
+        if answer["status"] != "ok":
