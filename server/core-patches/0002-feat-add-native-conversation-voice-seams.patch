+@pytest.mark.asyncio
+@pytest.mark.parametrize('which', [1, 2])
+async def test_a_policy_closed_while_a_probe_is_queued_runs_nothing_and_sends_nothing(monkeypatch, out, clip, which):
+    call = Call(monkeypatch, 'tts', out, clip)
+    release = threading.Event()
+    oauth = rest.OAuthWire(hold_discovery=release)
+    held = rest.HeldProbe(monkeypatch, which=which)
+    try:
+        with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.audio):
+            task = asyncio.create_task(call.start())
+            if which == 2:
+                assert await asyncio.to_thread(oauth.discovery_entered.wait, 10)
+                release.set()
+            await held.wait_enqueued()  # the worker is parked on the loop callback of the probe
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            seen = call.cb.authorize_calls
+            await held.release()  # the callback finally runs, after Stop closed the policy
+            assert await asyncio.to_thread(call.finished.wait, 10)
+    finally:
+        release.set()
+    assert call.cb.authorize_calls == seen  # the queued callback did NOTHING: no consumer callback after Stop
+    assert call.audio.count == 0 and call.cb.before_send_calls == 0
+    assert len(oauth.posts) == 0 and len(oauth.gets) == (0 if which == 1 else 1)
