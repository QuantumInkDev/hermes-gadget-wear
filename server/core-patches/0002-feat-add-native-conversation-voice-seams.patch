@@ -0,0 +1,11 @@
+"""Native runner fixture: writes COUNT (<= 1,000,000) bytes of 'x' to STREAM (stdout|stderr) in 8 KiB pieces, then
+exits 0. Network-free; no file writes; no child process."""
+import sys
+
+stream = {'stdout': sys.stdout, 'stderr': sys.stderr}[sys.argv[1]]
+count = min(int(sys.argv[2]), 1_000_000)
+while count > 0:
+    piece = min(count, 8192)
+    stream.write('x' * piece)
+    count -= piece
+stream.flush()
diff --git a/tests/tools/native_command_fixtures/launcher_faulty.py b/tests/tools/native_command_fixtures/launcher_faulty.py
new file mode 100755
index 0000000000000000000000000000000000000000..e0b2eff01884fc63533b7cbe9d594d999185319a
--- /dev/null
+++ b/tests/tools/native_command_fixtures/launcher_faulty.py
@@ -0,0 +1,137 @@
+"""HARNESS stand-in for the qualified network-deny launcher (NOT a sandbox, NOT launcher proof) that misbehaves on purpose
+for audio-tool children only. Usage: ``launcher_faulty.py MODE STATE -p PROFILE PROGRAM [ARGS...]`` (the product's wrapping
+argv ``-p <fixed profile> <program> <args...>`` behind two harness words). A concat child is an ffmpeg child with
+``concat`` in ARGS; the first one is the product's capability probe, the second its real join; any other ffmpeg child is a
+conversion.
+
+``MODE``: ``hold-convert`` (first conversion), ``hold-probe`` (first concat child), ``hold-join`` (second concat child),
+``hold-any`` (first ffmpeg child of any kind): write this process id to STATE (the readiness signal) and wait at most 20 s
+for STATE + '.release' instead of running PROGRAM; a product that ends the child kills it here.
+``head-concat`` / ``head-join``: every / only the second concat child copies ONLY its first listed input to the output and
+exits 0 (a truncated join). ``grow-convert`` / ``grow-join``: the first conversion / the second concat child writes 64 KiB
+blocks to its output (the last argument) until it holds 8 MiB, writes its pid to STATE (readiness: the growth is under way),
+then waits at most 20 s for STATE + '.release' and ONLY THEN writes STATE + '.finished'; a product that ends it earlier
+(the size watch) never sees the marker. ``droplast-concat`` / ``droplast-join``: every / only the second concat child runs the REAL ffmpeg on a copy of its list with
+the LAST listed input removed (a valid MP3 that lost the final, short chunk). ``fail-probe`` / ``junk-probe``: every ffprobe child
+exits 1 / prints junk and exits 0. ``fail-concat`` / ``silent-concat`` / ``junk-concat``: EVERY concat child exits 1 / exits 0 writing nothing / writes junk to
+its output (the last argument) and exits 0. ``fail-join``: only the second concat child exits 1. ``junk-convert``: every
+conversion child writes junk to its output (the last argument) and exits 0. Every other child is
+exec'd unchanged. Network-free; bounded; writes only STATE, STATE + '.concat' (a counter) and the concat output it was handed.
+
+AUX-audio modes (recorded prospectively in the AUX evidence before use): ``hold-ffprobe-N`` (N >= 1: the N-th ffprobe child of the call, counted
+in STATE + '.probe', writes its pid to STATE and waits like the other holds); ``fail-convert`` (EVERY conversion child, ffmpeg that is not a
+concat or a child named ``afconvert``, exits 1); ``empty-convert`` (every non-concat ffmpeg child writes an EMPTY file to its last argument
+and exits 0); ``afconvert-stand-in`` (every non-concat ffmpeg child exits 1, and a child named ``afconvert`` runs the REAL ffmpeg
+``-y -i ARGS[0] ARGS[1]`` instead: a labelled stand-in, the host afconvert is never executed); ``hold-afconvert`` (non-concat ffmpeg children
+exit 1, an ``afconvert`` child holds like the other holds). A ``-2`` suffix on ``hold-convert``, ``fail-convert``, ``junk-convert``,
+``empty-convert`` or ``grow-convert`` applies it to ONLY the 2nd non-concat ffmpeg child (counted in STATE + '.convert'): the 1st is the
+converter-capability preflight, the 2nd the real conversion of a paid answer."""
+import os
+import shutil
+import sys
+import time
+
+PROFILE = '(version 1) (allow default) (deny network*)'
+mode, state = sys.argv[1], sys.argv[2]
+if sys.argv[3:5] != ['-p', PROFILE] or len(sys.argv) < 6:
+    raise SystemExit(64)
+program, args = sys.argv[5], sys.argv[6:]
+is_ffmpeg = os.path.basename(program) == 'ffmpeg'
+is_ffprobe = os.path.basename(program) == 'ffprobe'
+is_afconvert = os.path.basename(program) == 'afconvert'
+concat = is_ffmpeg and 'concat' in args
+nth = 0
+if concat:
+    counter = state + '.concat'
+    nth = int(open(counter).read()) + 1 if os.path.exists(counter) else 1
+    with open(counter, 'w') as handle:
+        handle.write(str(nth))
+probe_nth = 0
+if is_ffprobe:
+    probe_counter = state + '.probe'
+    probe_nth = int(open(probe_counter).read()) + 1 if os.path.exists(probe_counter) else 1
+    with open(probe_counter, 'w') as handle:
+        handle.write(str(probe_nth))
+plain_convert = is_ffmpeg and not concat
+convert_nth = 0
+if plain_convert:
+    convert_counter = state + '.convert'
+    convert_nth = int(open(convert_counter).read()) + 1 if os.path.exists(convert_counter) else 1
+    with open(convert_counter, 'w') as handle:
+        handle.write(str(convert_nth))
+second_only = mode.endswith('-2') and not mode.startswith('hold-ffprobe-')
+hold_probe_n = int(mode.rsplit('-', 1)[1]) if mode.startswith('hold-ffprobe-') else 0
+hit = {'hold-ffprobe': probe_nth == hold_probe_n,
+       'afconvert-stand-in': plain_convert or is_afconvert, 'hold-afconvert': plain_convert or is_afconvert,
+       'fail-convert': plain_convert or is_afconvert, 'empty-convert': plain_convert,
+       'hold-convert': is_ffmpeg and not concat, 'hold-probe': concat and nth == 1, 'hold-join': concat and nth == 2,
+       'hold-any': is_ffmpeg, 'fail-concat': concat, 'silent-concat': concat, 'junk-concat': concat,
+       'fail-join': concat and nth == 2, 'junk-convert': is_ffmpeg and not concat, 'head-concat': concat,
+       'head-join': concat and nth == 2, 'droplast-concat': concat, 'droplast-join': concat and nth == 2,
+       'fail-probe': is_ffprobe, 'junk-probe': is_ffprobe, 'grow-convert': is_ffmpeg and not concat and not os.path.exists(state + '.grew'),
+       'grow-join': concat and nth == 2}[mode[:-2] if second_only else 'hold-ffprobe' if hold_probe_n else mode]
+if second_only:
+    hit = hit and convert_nth == 2
+    mode = mode[:-2]
+if hit and mode in ('afconvert-stand-in', 'hold-afconvert') and is_ffmpeg:
+    print('harness: ffmpeg conversion refused', file=sys.stderr)
+    raise SystemExit(1)
+if hit and mode == 'afconvert-stand-in':
+    real_ffmpeg = shutil.which('ffmpeg')
+    os.execv(real_ffmpeg, [real_ffmpeg, '-y', '-i', args[0], args[1]])
+if hit and mode == 'fail-convert':
+    print('harness: conversion refused', file=sys.stderr)
+    raise SystemExit(1)
+if hit and mode == 'empty-convert':
+    open(args[-1], 'wb').close()
+    raise SystemExit(0)
+if hit and (mode.startswith('hold') or hold_probe_n):
+    with open(state, 'w') as handle:
+        handle.write(str(os.getpid()))
+    for _ in range(200):  # bounded: 20 s
+        if os.path.exists(state + '.release'):
+            break
+        time.sleep(0.1)  # health: allow HX013 -- the stall IS the behaviour under test
+elif hit and mode in ('fail-concat', 'fail-join'):
+    print('harness: concat refused', file=sys.stderr)
+    raise SystemExit(1)
+elif hit and mode == 'silent-concat':
+    raise SystemExit(0)
+elif hit and mode in ('droplast-concat', 'droplast-join'):
+    list_path = args[args.index('-i') + 1]
+    lines = open(list_path).read().splitlines()
+    shortened = list_path + '.droplast'
+    with open(shortened, 'w') as handle:
+        handle.write('\n'.join(lines[:-1]) + '\n')
+    args[args.index('-i') + 1] = shortened
+elif hit and mode == 'fail-probe':
+    print('harness: ffprobe refused', file=sys.stderr)
+    raise SystemExit(1)
+elif hit and mode == 'junk-probe':
+    print('not a packet count at all')
+    raise SystemExit(0)
+elif hit and mode in ('head-concat', 'head-join'):
+    listed = open(args[args.index('-i') + 1]).read().splitlines()[0].split("'")[1]
+    with open(listed, 'rb') as source, open(args[-1], 'wb') as target:
+        target.write(source.read())
+    raise SystemExit(0)
+elif hit and mode in ('grow-convert', 'grow-join'):
+    open(state + '.grew', 'w').close()
+    with open(args[-1], 'wb') as target:
+        for block in range(128):  # bounded: 8 MiB
+            target.write(b'\0' * 65536)
+            target.flush()
+            if block == 1:
+                with open(state, 'w') as handle:
+                    handle.write(str(os.getpid()))
+    for _ in range(200):  # bounded: 20 s
+        if os.path.exists(state + '.release'):
+            break
+        time.sleep(0.1)  # health: allow HX013 -- the stall IS the behaviour under test
+    open(state + '.finished', 'w').close()
+    raise SystemExit(0)
+elif hit and mode in ('junk-concat', 'junk-convert'):
+    with open(args[-1], 'wb') as handle:
+        handle.write(b'not an mp3 at all' * 20)
+    raise SystemExit(0)
+os.execv(program, [program, *args])
