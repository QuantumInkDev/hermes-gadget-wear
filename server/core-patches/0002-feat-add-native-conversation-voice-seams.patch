+def test_command_bounds_exist_only_inside_a_native_call_with_a_deadline_and_a_cap():
+    assert native_send_policy.command_bounds() is None
+    deadline = time.monotonic() + 3
+    policy = _policy(max_output_bytes=4096, deadline=deadline)
+    with native_send_policy.activate(policy):
+        bounds = native_send_policy.command_bounds()
+    assert (bounds.deadline_monotonic, bounds.max_stream_bytes, bounds.argv_prefix) == (deadline, 4096, ())
+    assert bounds.closed() is False
