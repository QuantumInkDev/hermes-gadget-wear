+# --- review I1: a credential refusal is terminal when xAI is probed by the stock STT auto-detect -----------------------------
+
+class AutoDetectCall:
+    """Native STT with NO ``stt.provider`` in config.yaml: the stock auto-detect probes xAI (expired OAuth) before the usable
+    ElevenLabs key. The consumer refuses ONE callback and would authorize every other one."""
+
+    def __init__(self, monkeypatch, clip, **callbacks):
+        from hermes_cli.config import invalidate_env_cache
+        from tools import transcription_tools as stt
+        support.write_config(get_hermes_home(), {'stt': {'cloud_trim_silence': False}})
+        (get_hermes_home() / '.env').write_text('ELEVENLABS_API_KEY=el-synthetic-key\n')
+        invalidate_env_cache()
+        assert stt._detect_local_backend() is None  # fixture precondition: no local backend is detected
+        self.clip = clip
+        self.access = rest.jwt(time.time() - 60, 'expired')
+        rest.write_oauth_store(self.access, refresh='rt-singleton')
+        self.cb = rest.ThreadedCallbacks(**callbacks)
+        self.cloud = rest.RestWire([('json', {'text': 'paid cloud words'})] * 3)  # xAI and ElevenLabs both answer here
+        self.local = []
+        monkeypatch.setattr('tools.transcription_tools.transcribe_audio_local_fallback',
+                            lambda path, *a, **k: self.local.append(path) or {'success': True, 'transcript': 'local words'})
+        from gateway import session_native_voice_stt as stt_module
+        self.finished = watch_worker(monkeypatch, stt_module, '_configured')
+
+    def start(self):
+        return transcribe_native_once(self.clip, authorize=self.cb.authorize, before_send=self.cb.before_send, deadline_s=60)
+
+    def assert_terminal(self, result, oauth, expected_oauth, authorize_calls):
+        assert (result.state, result.transcript, result.source, result.provider) == ('refused', None, None, 'not_started')
+        assert (len(oauth.gets), len(oauth.posts)) == expected_oauth
+        assert self.cloud.count == 0 and self.cb.before_send_calls == 0 and self.local == []  # no provider substituted, no fallback
+        assert self.cb.authorize_calls == authorize_calls  # exact: nothing asked the consumer again
+        assert rest.read_oauth_store()['providers']['xai-oauth']['tokens']['access_token'] == self.access
+        assert support.SECRET not in repr(result)
+
+
+@pytest.mark.asyncio
+async def test_auto_detect_refusal_before_discovery_is_terminal_and_substitutes_no_provider(monkeypatch, clip):
+    call = AutoDetectCall(monkeypatch, clip, refuse_authorize_at=2)  # the probe before discovery
+    oauth = rest.OAuthWire()
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, call.cloud):
+        result = await call.start()
+        assert await asyncio.to_thread(call.finished.wait, 10)
