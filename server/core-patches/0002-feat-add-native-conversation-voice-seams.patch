+    policy.admit_custom('my-plugin')
+    policy.require_provider('my-plugin')
+    policy.require_provider('openai')
+    assert policy.custom == 'my-plugin' and policy.providers == frozenset({'openai'})
+    with pytest.raises(NativeSendRefused) as second:
