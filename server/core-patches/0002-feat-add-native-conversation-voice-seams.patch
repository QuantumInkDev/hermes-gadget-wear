+    support.faulty_launcher(monkeypatch, 'hold-convert', state)
+    cb = support.Callbacks()
+    clock = support.ReadinessClock(monkeypatch)
+    try:
+        task = asyncio.create_task(hear(mp3_clip, cb, deadline_s=60 if how == 'stop' else 300))
+        await async_wait_until(lambda: state.exists(), timeout=30, what='the held normalization to start')  # readiness
+        if how == 'stop':
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            clock.advance()  # expiry only AFTER the hold is confirmed (controlled clock)
+            result = await task
+            assert (result.state, result.transcript, result.provider) == ('timeout', None, 'not_started')
+        await async_wait_until(lambda: support.pid_gone(state) and not os.listdir(scratch), timeout=15,
+                               what='the held converter to be ended and its directory removed')
+    finally:
+        Path(str(state) + '.release').write_text('')
+    assert whisper_spawns(spawns) == [] and cb.before_send_calls == 0 and managed[1] == []
