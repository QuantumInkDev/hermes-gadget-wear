+# --- the audio pipeline: harness launcher stand-ins, spawn records and decoded-tone evidence (Task4) ---
+import hashlib
+import itertools
+import os
+import platform
+import sys
+
+FIXTURES = Path(__file__).resolve().parents[1] / 'tools' / 'native_command_fixtures'
+PASSTHROUGH = FIXTURES / 'launcher_passthrough.py'
+FAULTY = FIXTURES / 'launcher_faulty.py'
+
+
+def qualify(monkeypatch, script=PASSTHROUGH, *words):
+    """HARNESS: point the qualification table at a hashed stand-in launcher (NOT a sandbox) whose wrapping argv is
+    ``python script *words -p <fixed profile>``. Returns the launcher module."""
+    from tools import native_local_launcher as qualification
+    monkeypatch.setattr(qualification, 'QUALIFIED', (qualification.LauncherQualification(
+        sys.platform, platform.machine(), os.uname().release, str(script), hashlib.sha256(Path(script).read_bytes()).hexdigest(),
+        (sys.executable, str(script), *words, '-p', qualification.PROFILE)),))
+    return qualification
+
+
+def faulty_launcher(monkeypatch, mode, state):
+    """The stand-in launcher that holds / breaks the audio-tool children of ``mode`` (see ``launcher_faulty.py``)."""
+    return qualify(monkeypatch, FAULTY, mode, str(state))
+
+
+def record_spawns(monkeypatch, events=None):
+    """Every ``subprocess.Popen`` argv/env/cwd (then really spawns). A concat list file is read AT SPAWN TIME (it is
+    removed with its work directory), and ``events`` (if given) receives ``'spawn'`` in order with the other events."""
+    seen = []
+    real = subprocess.Popen
+
+    class Recording(real):
+        def __init__(self, args, *a, **k):
+            record = {'args': list(args) if isinstance(args, (list, tuple)) else args, 'env': k.get('env'), 'cwd': k.get('cwd'),
+                      'stdin': k.get('stdin'), 'concat_list': None}
+            argv = record['args'] if isinstance(record['args'], list) else []
+            if 'concat' in argv and '-i' in argv:
+                try:
+                    record['concat_list'] = Path(argv[argv.index('-i') + 1]).read_text()
+                except OSError:
+                    pass
+            seen.append(record)
+            if events is not None:
+                events.append('spawn')
+            super().__init__(args, *a, **k)
+    monkeypatch.setattr(subprocess, 'Popen', Recording)
+    return seen
+
+
+def audio_spawns(spawns, stand_in=PASSTHROUGH):
+    """Launcher-wrapped ffmpeg/ffprobe children, in spawn order (their argv after the harness launcher words)."""
+    wrapped = [s for s in spawns if isinstance(s['args'], list) and len(s['args']) > 5 and str(stand_in) in s['args'][:2]]
+    return [s for s in wrapped if os.path.basename(next((a for a in s['args'] if os.path.basename(a) in ('ffmpeg', 'ffprobe')), '')) in ('ffmpeg', 'ffprobe')]
+
+
+def program_of(spawn):
+    """The audio program of a wrapped child (the first word after the launcher's fixed profile)."""
+    args = spawn['args']
+    return args[args.index('-p') + 2]
+
+
+def pcm_of(path, rate=8000):
+    """Mono s16 samples of an audio file as decoded by the real ffmpeg."""
+    raw = subprocess.run([ffmpeg_path(), '-loglevel', 'error', '-i', str(path), '-f', 's16le', '-ac', '1', '-ar', str(rate),
+                          'pipe:1'], capture_output=True, check=True, timeout=60, stdin=subprocess.DEVNULL).stdout
+    return struct.unpack(f'<{len(raw) // 2}h', raw), rate
+
+
+def tone_sequence(path, seconds):
+    """Estimated frequency (Hz, zero crossings of the middle 60 % of each span) of consecutive spans of a decoded file."""
+    samples, rate = pcm_of(path)
+    heard, start = [], 0.0
+    for span in seconds:
+        a, b = int((start + span * 0.2) * rate), int((start + span * 0.8) * rate)
+        window = samples[a:b]
+        crossings = sum(1 for x, y in itertools.pairwise(window) if (x < 0) != (y < 0))
+        heard.append(round(crossings / 2 / ((b - a) / rate)))
+        start += span
+    return heard
+
+
+def pid_gone(state):
+    """True once the stall stand-in process that wrote its pid to ``state`` no longer exists."""
+    try:
+        pid = int(Path(state).read_text())
+        os.kill(pid, 0)
+    except (OSError, ValueError):
+        return True
+    return False
+
+
+FAULTY_STATES = frozenset({
+    'fail-concat', 'silent-concat', 'junk-concat', 'fail-join', 'hold-join', 'hold-probe', 'hold-convert', 'hold-any', 'head-concat',
+    'head-join', 'grow-join', 'grow-convert', 'junk-convert', 'droplast-concat', 'droplast-join', 'fail-probe', 'junk-probe',
+    'hold-ffprobe-1', 'hold-ffprobe-2', 'hold-ffprobe-3', 'hold-ffprobe-4', 'fail-convert', 'empty-convert', 'afconvert-stand-in',
+    'hold-afconvert', 'hold-convert-2', 'fail-convert-2', 'junk-convert-2', 'empty-convert-2', 'grow-convert-2'})
+# state -> (the tool name ``shutil.which`` is asked for, what it answers): None = absent; a callable = a present-but-wrong binary
+WHICH_STATES = {
+    'missing': ('ffmpeg', lambda: None),
+    'broken': ('ffmpeg', lambda: str(Path(ffmpeg_path()).with_name('ffprobe'))),  # executable, cannot convert or concat
+    'missing-ffprobe': ('ffprobe', lambda: None),  # the joiner proper is fine; the packet-count tool is absent
+    'broken-ffprobe': ('ffprobe', lambda: shutil.which('ffmpeg')),  # executable, but it is ffmpeg: it cannot count packets
+}
+
+
+def joiner(monkeypatch, tmp_path, how):
+    """Put the owned tools in the state ``how``; returns the stall/readiness state path."""
+    state = tmp_path / 'launcher-state'
+    if how in FAULTY_STATES:
+        faulty_launcher(monkeypatch, how, state)
+        return state
+    qualify(monkeypatch)
+    real_which = shutil.which
+    if how in WHICH_STATES:
+        tool, answer = WHICH_STATES[how]
+        replacement = answer()
+        monkeypatch.setattr(shutil, 'which', lambda name, *a, **k: replacement if name == tool else real_which(name, *a, **k))
+    elif how == 'no-launcher':
+        from tools import native_local_launcher
+        monkeypatch.setattr(native_local_launcher, 'QUALIFIED', ())
+    return state
