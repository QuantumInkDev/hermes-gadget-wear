+"""Synthetic provider transport for the native voice seam tests.
+
+Only the network bytes are replaced: the real OpenAI SDK, real httpx client (with whatever timeout,
+retry and event hooks the code under test configures) and real ``requests`` session run unchanged on
+top of these transports. Nothing here knows what a seam promises, so a count recorded here is the
+number of requests that would have left the process.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from pathlib import Path
+import struct
+import threading
+import wave
+
+import httpx
+
+
+def write_wav(path, seconds=1.0, rate=16000):
+    """A real 16 kHz mono PCM WAV (silence), the container the SDK bridge hands the seam."""
+    frames = int(seconds * rate)
+    with wave.open(str(path), 'wb') as out:
+        out.setnchannels(1)
+        out.setsampwidth(2)
+        out.setframerate(rate)
+        out.writeframes(struct.pack('<h', 0) * frames)
+    return str(path)
+
+
+def write_config(home, config):
+    """The profile's real ``config.yaml`` (what ``load_config`` reads at call time)."""
+    import yaml
+    Path(home).mkdir(parents=True, exist_ok=True)
+    (Path(home) / 'config.yaml').write_text(yaml.safe_dump(config))
+
+
+class Wire:
+    """Scripted provider behaviour plus a record of every request that reached the transport.
+
+    ``tap`` sees each request first (to order it against caller callbacks); ``hold`` makes a request
+    wait, after it was recorded, until the test releases it (a provider that stalls)."""
+
+    def __init__(self, script=None, tap=None, hold=None):
+        self.script = list(script or [])
+        self.requests = []
+        self.tap = tap
+        self.hold = hold
+        self.entered = threading.Event()
+
+    def __call__(self, request):
+        self.requests.append(request)
+        self.entered.set()
+        if self.tap is not None:
+            self.tap(request)
+        if self.hold is not None:
+            assert self.hold.wait(30), 'the test never released the stalled provider'
+        step = self.script.pop(0) if self.script else ('ok', {})
+        kind, value = step
+        if kind == 'raise':
+            raise value
+        if kind == 'status':
+            return httpx.Response(value, text='synthetic provider failure', request=request)
+        if kind == 'redirect':
+            return httpx.Response(307, headers={'location': value}, request=request)
+        return self.respond(request, value)
+
+    def respond(self, request, value):
+        if 'speech' in request.url.path:
+            return httpx.Response(200, content=value.get('audio', b'ID3synthetic-audio'),
+                                  headers={'content-type': 'audio/mpeg'}, request=request)
+        text = value.get('text', 'hello world')
+        if value.get('json', True):
+            return httpx.Response(200, json={'text': text}, request=request)
+        return httpx.Response(200, text=text, request=request)
+
+    @property
+    def count(self):
+        return len(self.requests)
+
+    def timeouts(self):
+        return [r.extensions.get('timeout') for r in self.requests]
+
+
+@contextmanager
+def provider_wire(monkeypatch, wire):
+    """Replace only the httpx network transport (every client built while active, SDK defaults included)."""
+    import httpx._client as client
+    monkeypatch.setattr(client, 'HTTPTransport', lambda **_: httpx.MockTransport(wire))
+    yield wire
+
+
+class RequestsWire:
+    """The same idea for ``requests``: the adapter that would open the socket, replaced."""
+
+    def __init__(self, script=None):
+        self.script = list(script or [])
+        self.requests = []
+
+    @property
+    def count(self):
+        return len(self.requests)
+
+    def adapter(self):
+        import requests
+        wire = self
+
+        class Adapter(requests.adapters.BaseAdapter):
+            def send(self, request, **kwargs):
+                wire.requests.append((request, kwargs))
+                kind, value = wire.script.pop(0) if wire.script else ('ok', {})
+                if kind == 'raise':
+                    raise value
+                response = requests.Response()
+                response.status_code = 200 if kind == 'ok' else 307 if kind == 'redirect' else value
+                if kind == 'redirect':
+                    response.headers['location'] = value
+                response.request = request
+                response.url = request.url
+                body = b'{"text":"hello world"}' if kind == 'ok' else b'{"error":{"message":"synthetic"}}'
+                response.raw = __import__('io').BytesIO(body)
+                response._content = body
+                response.headers['content-type'] = 'application/json'
+                return response
+
+            def close(self):
+                pass
+        return Adapter()
+
+
+@contextmanager
+def requests_wire(monkeypatch, wire):
+    import requests
+    adapter = wire.adapter()
+    monkeypatch.setattr(requests.Session, 'get_adapter', lambda self, url: adapter)
+    yield wire
+
+
+SECRET = 'SECRET-CALLBACK-TEXT /private/secret/path'
+
+
+class Callbacks:
+    """The consumer's ``authorize`` / ``before_send``, recording the order they ran in.
+
+    ``refuse_authorize_at`` is the 1-based call that raises; ``refuse_before_send`` makes every
+    ``before_send`` raise. Their messages carry ``SECRET`` so a leak into any result or log shows."""
+
+    def __init__(self, events=None, refuse_authorize_at=None, refuse_before_send=False, authorize_error=None,
+                 refuse_before_send_at=None):
+        self.events = [] if events is None else events
+        self.refuse_authorize_at = refuse_authorize_at
+        self.refuse_before_send = refuse_before_send
+        self.refuse_before_send_at = refuse_before_send_at
+        self.authorize_error = authorize_error or PermissionError(SECRET)
+        self.authorize_calls = 0
+        self.before_send_calls = 0
+
+    def authorize(self):
+        self.authorize_calls += 1
+        self.events.append('authorize')
+        if self.refuse_authorize_at == self.authorize_calls:
+            raise self.authorize_error
+
+    def before_send(self):
+        self.before_send_calls += 1
+        self.events.append('before_send')
+        if self.refuse_before_send or self.refuse_before_send_at == self.before_send_calls:
+            raise OSError(SECRET)
+
+
+# --- real local audio tools and the synthetic Edge service boundary (correction round 1) ---
+import asyncio
+import math
+import shutil
+import socket
+import subprocess
+
+import pytest
+
+
+def ffmpeg_path():
+    """The ffmpeg on PATH (the owned fixture puts its own copy first); skip when the host has none."""
+    path = shutil.which('ffmpeg')
+    if path is None:
+        pytest.skip('ffmpeg is not available on PATH')
+    return path
+
+
+def synth_mp3(path, seconds=1.0, frequency=440):
+    """A real MP3 made by the real ffmpeg from a local synthetic sine (no URL, no network)."""
+    subprocess.run([ffmpeg_path(), '-loglevel', 'error', '-y', '-f', 'lavfi', '-i',
+                    f'sine=frequency={frequency}:duration={seconds}', '-ac', '1', '-ar', '24000', '-b:a', '48k', str(path)],
+                   check=True, capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
+    return Path(path).read_bytes()
+
+
+def tone_and_silence_wav(path, tone_s=2.0, silence_s=12.0, rate=16000):
+    """16 kHz mono PCM: a tone then a long silence (long enough for the stock cloud silence trim to engage)."""
+    frames = b''.join(struct.pack('<h', int(8000 * math.sin(2 * math.pi * 440 * i / rate))) for i in range(int(tone_s * rate)))
+    frames += struct.pack('<h', 0) * int(silence_s * rate)
+    with wave.open(str(path), 'wb') as out:
+        out.setnchannels(1)
+        out.setsampwidth(2)
+        out.setframerate(rate)
+        out.writeframes(frames)
+    return str(path)
+
+
+class EdgeBoundary:
+    """A synthetic Edge service behind the REAL ``edge_tts`` and aiohttp client stack.
+
+    Only the socket is replaced: the connector's ``_create_direct_connection`` returns one end of a
+    ``socketpair`` whose other end is served by a real aiohttp WebSocket server on the test's loop.
+    No DNS, no TLS, no service connection. ``script`` steps: 'ok' or 403 (a handshake refusal the
+    stock library answers with its own second handshake)."""
+
+    def __init__(self, script=None, audio=b'ID3edge-audio'):
+        self.script = list(script or [])
+        self.audio = audio
+        self.handshakes = 0
+        self.texts = []
+        self.loop = None
+        self.runner = None
+
+    async def handler(self, request):
+        from aiohttp import web
+        self.handshakes += 1
+        step = self.script.pop(0) if self.script else 'ok'
+        if step == 403:
+            return web.Response(status=403, text='synthetic refusal')
+        websocket = web.WebSocketResponse()
+        await websocket.prepare(request)
+        await websocket.receive()  # speech.config
+        ssml = await websocket.receive()
+        self.texts.append(ssml.data)
+        await websocket.send_str('X-Timestamp:t\r\nPath:turn.start\r\n\r\n{}')
+        header = b'X-RequestId:r\r\nContent-Type:audio/mpeg\r\nPath:audio\r\n'
+        await websocket.send_bytes(len(header).to_bytes(2, 'big') + header + self.audio)
+        await websocket.send_str('X-Timestamp:t\r\nPath:turn.end\r\n\r\n{}')
+        await websocket.close()
+        return websocket
+
+    async def attach(self, server_socket):
+        await self.loop.connect_accepted_socket(self.runner.server, sock=server_socket)
+
+    async def start(self, monkeypatch):
+        from aiohttp import web
+        from aiohttp.connector import TCPConnector
+        self.loop = asyncio.get_running_loop()
+        self.runner = web.ServerRunner(web.Server(self.handler))
+        await self.runner.setup()
+        boundary = self
+
+        async def direct(connector, req, traces, timeout, *, client_error=None):
+            client_end, server_end = socket.socketpair()
+            client_end.setblocking(False)
+            server_end.setblocking(False)
+            asyncio.run_coroutine_threadsafe(boundary.attach(server_end), boundary.loop).result(10)
+            return await asyncio.get_running_loop().create_connection(connector._factory, sock=client_end)
+        monkeypatch.setattr(TCPConnector, '_create_direct_connection', direct)
+        return self
+
+    async def stop(self):
+        await self.runner.cleanup()
+
+
+def media_seconds(path):
+    """Duration of an audio file as the real ffmpeg reports it (``Duration: HH:MM:SS.ss``)."""
+    import re
+    probe = subprocess.run([ffmpeg_path(), '-hide_banner', '-i', str(path)], capture_output=True, text=True,
+                           timeout=60, stdin=subprocess.DEVNULL, check=False)
+    h, m, sec = re.search(r'Duration: (\d+):(\d+):([\d.]+)', probe.stderr).groups()
+    return int(h) * 3600 + int(m) * 60 + float(sec)
