index 0000000000000000000000000000000000000000..783bd98b6e2bbbf664d13f6311d8a47abfeddef4
--- /dev/null
+++ b/gateway/session_native_voice_stt.py
@@ -0,0 +1,210 @@
+"""Configured-once speech-to-text for the native voice seam (see ``session_native_voice``).
+
+The profile's own STT configuration is read at call time through the stock resolvers, the audio is
+handed to the stock ``transcribe_audio`` pipeline (validation, pre-send preparation, provider
+dispatch) with a one-send transport policy active, and the outcome is mapped to stable tokens.
+Local fallback is the stock installed-only ``transcribe_audio_local_fallback``: it never installs a
+backend and never reaches another cloud provider.
+"""
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+import os
+import stat
+import time
+
+from gateway import session_native_voice_gate as gate
+from tools import native_send_policy
+
+# Built-in providers whose transport the seam can hold to one request. A plugin provider is reached only when it opted
+# in to native-once v1 (``agent.native_once``) and then only through the gated transport. A command provider configured
+# ``native: local-sandboxed`` and the managed whisper.cpp ``local_command`` run only as launcher-wrapped local children.
+# Everything else (other commands, the env/PATH ``local_command`` templates, plugins that did not opt in) is refused
+# UNSENT, never replaced by another provider.
+STT_PROVIDERS = frozenset({'local', 'openai', 'groq', 'deepinfra', 'xai', 'elevenlabs', 'mistral'})
+LOCAL_PROVIDERS = frozenset({'local', 'local_command'})  # no remote request: never a fallback to themselves
+SOURCE_LABEL = 'relay'
+# A recorded refusal that ends the call: never followed by the local fallback or any re-selection. The response-safety
+# refusals ``unsupported_encoding`` (a nonidentity answer) and ``too_long`` (the answer crossed the response bound) are terminal
+# too: the sealed contract is that such a response is never substituted. That is the difference from an ORDINARY known gated
+# failure (e.g. a 5xx after a counted send), which keeps the single documented installed-only fallback. ``unsupported_hook``:
+# the served profile has an ordinary ``pre_transcription`` callback, which has no native-once contract; the whole call
+# is refused unsent instead of running it or silently dropping it (and the local fallback would bypass it too).
+TERMINAL_REFUSALS = frozenset({'closed', 'timeout', 'refused', 'cancelled', 'unsupported_hook', 'unsupported_encoding', 'too_long'})
+
+
+@dataclass
+class _Attempt:
+    result: dict | None  # the stock envelope; None when the worker raised
+    provider: str  # the resolved configured provider ('none' when STT is disabled)
+    enabled: bool
+    invalid: bool = False  # the input was not an acceptable audio file; nothing was attempted
+
+
+def _configured(path, policy):
+    """Worker thread: the stock pipeline under the one-send policy."""
+    from tools import transcription_tools as stt
+    from tools.transcription_command import _native_pre_transcription_hooks_registered
+    try:
+        with native_send_policy.activate(policy):
+            config = stt._load_stt_config()
+            enabled = stt.is_stt_enabled(config)
+            if enabled and _native_pre_transcription_hooks_registered():
+                policy.refusal_for('unsupported_hook')  # before provider selection, credentials or any callback
+                return _Attempt(None, 'unresolved', True)
+            try:
+                provider = stt._get_provider(config) if enabled else 'none'
+            except native_send_policy.NativeSendRefused:
+                # Provider selection probes a remote provider's credentials (xAI may refresh OAuth): a refusal there
+                # is an unsent refusal, never an escape to the consumer. The policy recorded why.
+                return _Attempt(None, 'unresolved', True)
+            if policy.refusal is not None:
+                # Auto-detect probes remote providers through a QUIET availability function that swallows exceptions, so a
+                # credential-phase refusal can be absorbed there and selection can fall through to another cloud provider.
+                # A recorded refusal is terminal (it also closed the policy): no substitute provider, no transcription.
+                return _Attempt(None, 'unresolved', True)
+            if not enabled:
+                return _Attempt(None, provider, False)
+            try:
+                return _Attempt(stt.transcribe_audio(path, None, SOURCE_LABEL), provider, True)
+            except native_send_policy.NativeSendRefused:
+                return _Attempt(None, provider, True)  # the policy recorded why
+            except Exception:  # health: allow BLE001 -- provider/library failure becomes the stable 'failed' token; its text must not leave
+                return _Attempt(None, provider, True)
+    finally:
+        policy.close_clients()  # the pools of every client this call built, whatever the provider's SDK did
+
+
+def _fallback(path, policy):
+    """Worker thread: the stock installed-only local backend under the native context, so it is cached-only
+    (a model cache miss is a failure, never a download) and runs no user command; it can send nothing remote."""
+    from tools import transcription_tools as stt
+    try:
+        with native_send_policy.activate(policy):
+            return stt.transcribe_audio_local_fallback(path)
+    except Exception:  # health: allow BLE001 -- local backend failure becomes the stable 'failed' token; its text must not leave
+        return {'success': False, 'transcript': ''}
+
+
+def _text_state(text):
+    text = (text or '').strip()
+    if not text:
+        return 'empty', None
+    from gateway.session_native_voice import MAX_TRANSCRIPT_BYTES, MAX_TRANSCRIPT_CODE_POINTS
+    if len(text) > MAX_TRANSCRIPT_CODE_POINTS or len(text.encode('utf-8')) > MAX_TRANSCRIPT_BYTES:
+        return 'too_long', None
+    return 'transcribed', text
+
+
+def _is_local(provider, policy):
+    """A local route of this call: a built-in local backend, or the one admitted launcher-wrapped local route."""
+    return provider in LOCAL_PROVIDERS or (
+        policy.local_route is not None and (provider or '').lower().strip() == policy.local_route)
+
+
+def _failure_state(attempt, policy):
+    if policy.refusal in ('refused', 'cancelled', 'timeout'):
+        return policy.refusal
+    if policy.refusal == 'closed':  # closed by the deadline fence, else by Stop/cancellation
+        return 'timeout' if policy.deadline is not None and time.monotonic() >= policy.deadline else 'cancelled'
+    if policy.refusal == 'too_long':
+        return 'failed'  # an output bound (a preparation child's file, a response) ended the call: failed, never "nothing tried"
+    if policy.local_launched:
+        return 'failed'  # a local child really started (cap, transcript or read failure after it): never "nothing tried"
+    if policy.refusal in ('unsupported', 'unsupported_hook'):
+        return 'unavailable'
+    local_attempt = _is_local(attempt.provider, policy) and attempt.result is not None
+    return 'failed' if policy.sends or local_attempt else 'unavailable'  # nothing was tried otherwise
+
+
+def _configured_outcome(attempt, policy):
+    """``(state, transcript, answered)`` for the configured attempt."""
+    result = attempt.result
+    if not attempt.enabled:
+        return 'unavailable', None, False
+    if result is not None and result.get('success'):
+        if not _is_local(attempt.provider, policy) and not policy.sends:
+            return 'unaccounted', None, False  # remote success nobody gated: never "not_started"
+        state, text = _text_state(result.get('transcript'))
+        return state, text, True
+    if result is not None and result.get('no_speech') and policy.sends:
+        return 'empty', None, True  # HTTP 200 with no words: silence is an answer
+    if not _is_local(attempt.provider, policy) and policy.silent_after_entry():
+        return 'unaccounted', None, False  # failed after entry with no gated send: it may have sent unseen
+    return _failure_state(attempt, policy), None, False
+
+
+def _make(state, transcript, source, provider):
+    from gateway.session_native_voice import NativeTranscription
+    return NativeTranscription(state, transcript, source, provider)
+
+
+def _may_fall_back(attempt, state, policy):
+    """The installed-only local fallback keeps its existing built-in semantics, but never runs after a terminal
+    refusal, nor after a configured custom (plugin or command) provider, which no other provider replaces. ``none``
+    (an explicit built-in that resolved unusable) and ``unresolved`` (selection refused) are not custom names."""
+    from tools.transcription_common import BUILTIN_STT_PROVIDERS
+    custom = attempt.provider not in BUILTIN_STT_PROVIDERS and attempt.provider not in ('none', 'unresolved')
+    return (attempt.enabled and state in ('unavailable', 'failed')
+            and attempt.provider not in LOCAL_PROVIDERS and policy.refusal not in TERMINAL_REFUSALS and not custom)
+
+
+async def transcribe_once(path, *, authorize, before_send, deadline_s):
+    from gateway.session_native_voice import MAX_AUDIO_BYTES, MAX_STT_RESPONSE_BYTES, STT_REQUEST_TIMEOUT_S
+    gate.validate_call(authorize, before_send, deadline_s)
+    if not isinstance(path, str) or not path or '\0' in path:
+        return _make('refused', None, None, gate.PROVIDER_NOT_STARTED)
+    deadline = time.monotonic() + deadline_s
+    policy = gate.new_policy(asyncio.get_running_loop(), authorize, before_send, deadline,
+                             timeout_s=min(STT_REQUEST_TIMEOUT_S, float(deadline_s)), providers=STT_PROVIDERS,
+                             max_output_bytes=MAX_STT_RESPONSE_BYTES)
+    refusal = gate.check(authorize)
+    if refusal:
+        return _make(refusal, None, None, gate.PROVIDER_NOT_STARTED)
+    attempt, maybe_sent = await gate.bounded(lambda: _checked(path, policy, MAX_AUDIO_BYTES), deadline, policy.close)
+    if attempt is gate.TIMED_OUT:
+        return _make('timeout', None, None, gate.PROVIDER_UNKNOWN if maybe_sent else gate.PROVIDER_NOT_STARTED)
+    if attempt.invalid:
+        return _make('refused', None, None, gate.PROVIDER_NOT_STARTED)
+    state, transcript, answered = _configured_outcome(attempt, policy)
+    unaccounted = state == 'unaccounted'
+    provider = gate.PROVIDER_UNKNOWN if unaccounted else gate.provider_state(policy, answered)
+    state = 'failed' if unaccounted else state
+    refusal = gate.check(authorize)
+    if refusal:  # authority lost during the await: the result is withheld
+        return _make(refusal, None, None, provider)
+    if state in ('transcribed', 'empty', 'too_long'):
+        return _make(state, transcript, 'configured', provider)
+    if unaccounted or not _may_fall_back(attempt, state, policy):
+        return _make(state, None, None, provider)
+    return await _recover(path, state, provider, authorize, deadline)
+
+
+def _checked(path, policy, limit):
+    """Worker thread: refuse a non-file or oversized input before any provider work."""
+    try:
+        info = os.lstat(path)
+    except OSError:
+        return _Attempt(None, 'none', False, invalid=True)
+    if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= limit:  # a symlink is not a regular file here
+        return _Attempt(None, 'none', False, invalid=True)
+    return _configured(path, policy)
+
+
+async def _recover(path, configured_state, provider, authorize, deadline):
+    """The single installed-only local fallback after a configured failure."""
+    refusal = gate.check(authorize)
+    if refusal:
+        return _make(refusal, None, None, provider)
+    local = native_send_policy.SendPolicy(timeout_s=1.0, providers=frozenset({'local'}))  # cannot send: no gate
+    result, _ = await gate.bounded(lambda: _fallback(path, local), deadline, local.close)
+    if result is gate.TIMED_OUT:
+        return _make('timeout', None, None, provider)
+    refusal = gate.check(authorize)
+    if refusal:
+        return _make(refusal, None, None, provider)
+    if result.get('success'):
+        state, text = _text_state(result.get('transcript'))
+        return _make(state, text, 'local_fallback', provider)
+    return _make(configured_state, None, None, provider)
diff --git a/gateway/session_native_voice_tts.py b/gateway/session_native_voice_tts.py
new file mode 100644
index 0000000000000000000000000000000000000000..3256fca458ac35ccea53b4c2fef15cd37fda2f17
--- /dev/null
+++ b/gateway/session_native_voice_tts.py
@@ -0,0 +1,333 @@
+"""Configured one-request-per-chunk text-to-speech for the native voice seam (``session_native_voice``).
+
+The profile's own TTS configuration (provider, voice, model) is read at call time through the stock
+resolvers; the stock chunker splits the normalized text; each chunk is synthesized by the stock
+provider generator under a one-send transport policy. There is no retry and no other provider: the
+first failed chunk ends the call and every audio file written for it is removed.
+"""
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass, field
+import os
+import shutil
+import time
+import uuid
+
+from gateway import session_native_voice_gate as gate
+from tools import native_send_policy
+
+# Built-in voices whose transport the seam can hold to one request per chunk. A plugin provider is reached only when it
+# opted in to native-once v1 (``agent.native_once``) and then only through the gated transport. The local engines
+# (Piper, KittenTTS, NeuTTS) and a command provider configured ``native: local-sandboxed`` run only as launcher-wrapped
+# local children (no gated send: ``not_started``). Anything else is refused UNSENT, never replaced by another provider.
+TTS_PROVIDERS = frozenset({'edge', 'elevenlabs', 'openai', 'deepinfra', 'mistral', 'xai', 'minimax', 'gemini'})
+# Every covered SDK engine sends through a client the seam hooks (httpx for the SDKs, the aiohttp connector for
+# Edge): its identity is proven before the call and exactly one gated send is required after it. xAI, MiniMax and
+# Gemini have no SDK: their one ``requests.post`` (``tts_tool_providers._post_json``) is preceded immediately by the gate.
+HOOKED_PROVIDERS = TTS_PROVIDERS
+EDGE_CHUNK_CODE_POINTS = 600  # one Edge websocket message set per chunk (the library splits at 4,096 escaped bytes)
+MAX_NORMALIZED_CODE_POINTS = 2 * 4096
+FILE_PREFIX = 'native-speech-'
+
+
+@dataclass
+class _Synth:
+    state: str
+    path: str | None = None
+    code_points: int = 0
+    answered: bool = False  # every request that was sent got a usable answer
+    unaccounted: bool = False  # audio was produced (or a send happened) outside the gate: accounting is unknown
+    declined: bool = False  # the local engine helper itself reported a missing prerequisite (a launch that produced nothing)
+
+
+def _make(state, path, code_points, source, provider):
+    from gateway.session_native_voice import NativeSpeech
+    return NativeSpeech(state, path, code_points, source, provider)
+
+
+def _utf16_units(text):
+    return len(text.encode('utf-16-le')) // 2
+
+
+def _owned_dir(output_dir):
+    return isinstance(output_dir, str) and os.path.isabs(output_dir) and os.path.isdir(output_dir)
+
+
+def _remove(paths):
+    for path in paths:
+        try:
+            os.remove(path)
+        except OSError:
+            continue  # already gone or never created: the goal of the cleanup is met
+
+
+@dataclass
+class _Run:
+    """One synthesis call inside its worker thread."""
+    policy: native_send_policy.SendPolicy
+    output_dir: str
+    run_id: str
+    paths: list  # every file this call owns and must remove (chunks, engine sidecars, the join's staging file)
+    chunks: list = field(default_factory=list)  # the chunk audio files, in order: exactly what the join concatenates
+    done: int = 0  # chunks whose request was answered and whose audio was kept
+    unaccounted: bool = False  # an engine produced audio without exactly one gated send
+
+    @property
+    def answered(self):
+        """Every request that was sent got an answer (a refused send or an early stop leaves none open)."""
+        return self.policy.sends == self.done
+
+
+def _route_kind(engine):
+    """``plugin`` (key, held instance), ``local`` (engine name), ``command`` (name, config) or ``builtin``."""
+    return engine[0] if isinstance(engine, tuple) else 'builtin'
+
+
+def _invoke(run, engine, config, chunk, path):
+    """Synthesize one chunk into ``path`` through the route's own boundary."""
+    from tools import tts_tool as tts
+    kind = _route_kind(engine)
+    if kind == 'plugin':
+        from tools.tts_tool_plugins import _synthesize_native_plugin
+        _synthesize_native_plugin(engine[1:], chunk, path, config)
+    elif kind == 'local':
+        from tools.tts_tool_local import native_engine_chunk
+        native_engine_chunk(engine[1], chunk, path, config, run.paths.append)
+    elif kind == 'command':
+        from tools.tts_command_provider import _generate_command_tts
+        _generate_command_tts(chunk, path, engine[1], engine[2], config)
+    else:
+        tts._synthesize_builtin(engine, chunk, path, config, None)
+
+
+def _chunk_audio(run, engine, config, chunk, path):
+    """One request (or one local child): arm a fresh one-send scope, synthesize, bound the file. Returns an error
+    state or None. A local route must leave the gate untouched (zero sends); a remote one must pass it exactly once."""
+    from gateway.session_native_voice import MAX_CHUNK_AUDIO_BYTES
+    run.policy.arm()
+    try:
+        _invoke(run, engine, config, chunk, path)
+    except native_send_policy.NativeSendRefused:
+        raise  # a gate or policy refusal: the policy knows exactly what was and was not sent
+    except Exception:
+        if run.policy.silent_after_entry():
+            run.unaccounted = True  # the engine failed after entry with no gated send: it may have sent unseen
+        raise
+    finally:
+        run.policy.close_clients()
+    if run.policy.scope_sends != (0 if _route_kind(engine) in ('local', 'command') else 1):
+        run.unaccounted = True  # audio came back through a path the gate never saw
+        return 'failed'
+    run.done += 1
+    try:
+        size = os.path.getsize(path)
+    except OSError:
+        return 'failed'
+    if size <= 0:
+        return 'failed'
+    return 'too_long' if size > MAX_CHUNK_AUDIO_BYTES else None
+
+
+def _synthesize_chunks(run, engine, config, chunks):
+    """Stop at the first failed chunk; returns its failure state or None."""
+    from gateway.session_native_voice import MAX_SPEECH_AUDIO_BYTES
+    total = 0
+    for index, chunk in enumerate(chunks, start=1):
+        path = os.path.join(run.output_dir, f'.{FILE_PREFIX}{run.run_id}.chunk{index:03d}.mp3')
+        run.paths.append(path)
+        run.chunks.append(path)
+        failure = _chunk_audio(run, engine, config, chunk, path)
+        if failure:
+            return failure
+        total += os.path.getsize(path)
+        if total > MAX_SPEECH_AUDIO_BYTES:
+            return 'too_long'
+    return None
+
+
+def _final_path(output_dir, run_id):
+    return os.path.join(output_dir, f'{FILE_PREFIX}{run_id}.mp3')
+
+
+def _join(run):
+    """One audio file from the chunk files: a rename for a single chunk, otherwise the native join (the launcher-wrapped,
+    Stop-aware, exactly-bounded concat of ``tools.native_audio_pipeline``; never the stock shared concat)."""
+    final = _final_path(run.output_dir, run.run_id)
+    if len(run.chunks) == 1:
+        os.replace(run.chunks[0], final)
+        return final
+    from gateway.session_native_voice import MAX_SPEECH_AUDIO_BYTES
+    from tools.native_audio_pipeline import native_concat
+    return native_concat(list(run.chunks), final, run.paths.append, limit=MAX_SPEECH_AUDIO_BYTES)
+
+
+def _route(provider, config):
+    """The route for the configured provider with the stock precedence (built-in > command > plugin), or None."""
+    from tools import tts_tool as tts
+    from tools.tts_tool_local import NATIVE_LOCAL_ENGINES
+    if provider in TTS_PROVIDERS:
+        engine, unavailable = tts._select_builtin_engine(provider)
+        return provider if not unavailable and engine == provider else None  # never the stock fallback engine
+    if provider in NATIVE_LOCAL_ENGINES:
+        return ('local', provider)
+    command = tts._resolve_command_provider_config(provider, config)
+    if command is not None:
+        if command.get('native') != 'local-sandboxed':
+            return None  # a command provider runs natively only when the operator opted it in as local-sandboxed
+        native_send_policy.admit_local(provider.lower().strip())
+        return ('command', provider, command)
+    from tools.tts_tool_plugins import _native_plugin_route
+    route = _native_plugin_route(provider, config)  # refuses a plugin that did not opt in (unsent)
+    return None if route is None else ('plugin', *route)
+
+
+def _local_preflight(engine, config):
+    """Before any engine child or paid request: the engine's parent-visible prerequisites, a qualified launcher, then a
+    converter that actually turns a tiny synthetic WAV into MP3 under that launcher (Q5; a broken one refuses unsent). A local
+    engine needs it for its WAV chunks and Gemini for its paid PCM answers, single chunk included (a multi-chunk call also
+    proves the join separately). ``None`` when ready, else the unsent state."""
+    from tools.native_local_launcher import qualified_prefix
+    kind = _route_kind(engine)
+    if kind == 'local':
+        ffmpeg = shutil.which('ffmpeg')
+        if ffmpeg is None or not os.access(ffmpeg, os.X_OK):
+            return 'unavailable'
+        from tools.tts_tool_local import native_engine_options
+        native_engine_options(engine[1], config)  # refuses unsent (package, interpreter, cached voice)
+    if kind in ('local', 'command') and qualified_prefix() is None:
+        return 'unavailable'
+    if kind == 'local' or engine == 'gemini':
+        from tools.tts_tool_local import native_converter_preflight
+        if engine == 'gemini' and qualified_prefix() is None:
+            return 'unavailable'  # Gemini's paid PCM can only become MP3 through the qualified converter
+        native_converter_preflight()
+    return None
+
+
+def _plan(text, config):
+    """``(engine, chunks)``; ``engine`` is None when the configured voice cannot be used, a built-in engine name, or
+    ``(key, held instance)`` for an opted-in plugin route (stock precedence: built-in > command > plugin)."""
+    from gateway.session_native_voice import speakable_text
+    from tools import tts_tool as tts
+    from tools.tts_tool_delivery import _resolve_max_text_length, _split_text_for_tts
+    provider = tts._get_provider(config)
+    engine = _route(provider, config)
+    if engine is None:
+        return None, []
+    spoken = speakable_text(text)
+    cap = _resolve_max_text_length(provider, config)
+    if provider == 'edge':
+        cap = min(cap, EDGE_CHUNK_CODE_POINTS)
+    chunks = _split_text_for_tts(spoken, cap) if spoken.strip() else []
+    return engine, chunks
+
+
+def _run_chunks(run, text):
+    """The synthesis proper, inside the policy; returns the worker's verdict."""
+    from tools import tts_tool as tts
+    if not _owned_dir(run.output_dir):
+        return _Synth('refused')
+    config = tts._load_tts_config()
+    engine, chunks = _plan(text, config)
+    if engine is None:
+        return _Synth('unavailable')
+    if not chunks:
+        return _Synth('empty')
+    code_points = sum(len(chunk) for chunk in chunks)
+    if code_points > MAX_NORMALIZED_CODE_POINTS:
+        return _Synth('too_long')
+    if unready := _local_preflight(engine, config):
+        return _Synth(unready)
+    if len(chunks) > 1:
+        # Never pay for (or run) chunks that cannot be joined: prove the REAL join first, for every route including local,
+        # and that the caller's output directory can ever be listed by the join (deterministic, so refused before payment).
+        from tools.native_audio_pipeline import native_concat_preflight
+        native_concat_preflight(run.output_dir)
+    failure = _synthesize_chunks(run, engine, config, chunks)
+    if failure:
+        return _Synth(failure, code_points=code_points)
+    final = _join(run)
+    if not final:
+        return _Synth('failed', code_points=code_points)  # chunks that were paid for but cannot be joined
+    return _Synth('synthesized', final, code_points)
+
+
+def _synthesize(text, output_dir, policy, run_id):
+    """Worker thread. A fenced (deadline-abandoned) worker leaves no file behind."""
+    run = _Run(policy, output_dir, run_id, [])
+    try:
+        with native_send_policy.activate(policy):
+            verdict = _run_chunks(run, text)
+    except native_send_policy.NativeSendRefused as exc:
+        # the policy recorded why. A helper decline is an unsent refusal only when NO chunk was completed before it: ``run.done``
+        # (completed, answered chunks), never the attempted-path count, is the accounting boundary
+        verdict = _Synth('failed', declined=getattr(exc, 'engine_declined', False) and run.done == 0)
+    except Exception:  # health: allow BLE001 -- provider/library failure becomes the stable 'failed' token; its text must not leave
+        verdict = _Synth('failed')
+    finally:
+        _remove(run.paths)  # chunk files; the joined file is a different path and survives
+        if policy.closed and isinstance(output_dir, str):
+            _remove([_final_path(output_dir, run_id)])
+    verdict.answered = run.answered
+    verdict.unaccounted = run.unaccounted
+    return verdict
+
+
+def _discard_run(output_dir, run_id):
+    """The abandoned worker removes its own files once fenced; this covers a finish that beat the fence."""
+    if isinstance(output_dir, str):
+        _remove([_final_path(output_dir, run_id)])
+
+
+def _failure_state(synth, policy):
+    if synth.state in ('refused', 'unavailable', 'empty', 'too_long'):
+        return synth.state
+    if synth.unaccounted:
+        return 'failed'
+    if policy.refusal in ('refused', 'cancelled', 'too_long', 'timeout'):
+        return policy.refusal
+    if policy.refusal == 'closed':  # closed by the deadline fence, else by Stop/cancellation (N-2: a probe may notice first)
+        return 'timeout' if policy.deadline is not None and time.monotonic() >= policy.deadline else 'cancelled'
+    if policy.refusal == 'unsupported':
+        # nothing is "unavailable" once a chunk was paid OR a local child really started (a vanished joiner or converter, a lost
+        # launcher); a prelaunch refusal, and a helper that itself reports a missing prerequisite, still are
+        return 'unavailable' if synth.declined or not (policy.sends or policy.local_launched) else 'failed'
+    if policy.local_launched:
+        return 'failed'  # a local child really started: a failure after a local invocation, never "nothing was tried"
+    return 'unavailable' if not policy.sends else 'failed'
+
+
+async def synthesize_once(text, *, output_dir, authorize, before_send, deadline_s):
+    from gateway.session_native_voice import MAX_CHUNK_AUDIO_BYTES, TTS_REQUEST_TIMEOUT_S
+    gate.validate_call(authorize, before_send, deadline_s)
+    if not isinstance(text, str) or not text.strip():
+        return _make('empty', None, 0, None, gate.PROVIDER_NOT_STARTED)
+    from gateway.session_native_voice import MAX_SPEECH_UTF16_UNITS
+    if _utf16_units(text) > MAX_SPEECH_UTF16_UNITS:
+        return _make('too_long', None, 0, None, gate.PROVIDER_NOT_STARTED)
+    deadline = time.monotonic() + deadline_s
+    policy = gate.new_policy(asyncio.get_running_loop(), authorize, before_send, deadline,
+                             timeout_s=min(TTS_REQUEST_TIMEOUT_S, float(deadline_s)), providers=TTS_PROVIDERS,
+                             max_output_bytes=MAX_CHUNK_AUDIO_BYTES)
+    refusal = gate.check(authorize)
+    if refusal:
+        return _make(refusal, None, 0, None, gate.PROVIDER_NOT_STARTED)
+    run_id = uuid.uuid4().hex
+    try:
+        synth, maybe_sent = await gate.bounded(
+            lambda: _synthesize(text, output_dir, policy, run_id), deadline, policy.close)
+    except asyncio.CancelledError:
+        _discard_run(output_dir, run_id)
+        raise
+    if synth is gate.TIMED_OUT:
+        _discard_run(output_dir, run_id)
+        return _make('timeout', None, 0, None, gate.PROVIDER_UNKNOWN if maybe_sent else gate.PROVIDER_NOT_STARTED)
+    provider = gate.PROVIDER_UNKNOWN if synth.unaccounted else gate.provider_state(policy, synth.answered)
+    refusal = gate.check(authorize)
+    if refusal or synth.state != 'synthesized':
+        _remove([synth.path] if synth.path else [])
+        state = refusal or _failure_state(synth, policy)
+        return _make(state, None, synth.code_points if state in ('failed', 'too_long') else 0,
+                     'configured' if policy.sends or synth.unaccounted else None, provider)
+    return _make('synthesized', synth.path, synth.code_points, 'configured', provider)
