+"""Native voice seam, xAI OAuth pre-send freshness (M2) against the REAL resolver, pool and token store.
+
+Nothing credential-related is stubbed: ``resolve_xai_http_credentials`` / ``CredentialPool.select`` read a synthetic
+``auth.json`` in the test profile and the stock discovery + refresh POST run over a synthetic OAuth authority below the
+real ``httpx`` client (``OAuthWire``). The audio request goes through the real ``requests`` stack over ``RestWire``.
+
+The contract under test: the single paid send carries a bearer that is provably fresh; the OAuth exchange is never a paid
+attempt (no ``before_send``, no accounting); a Stop/deadline/authority change while refreshing can never become a late
+send; a bearer whose freshness cannot be established is refused UNSENT; and nothing is refreshed or resent after an
+auth failure.
+"""
+import asyncio
+import logging
+import os
+import threading
+import time
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import synthesize_native_once, transcribe_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+from tests.gateway.mistral_voice_support import watch_worker
+
+TEXT = 'Hello there, friend.'
+HOUR = 3600
+
+
+def tts_profile(api_key=None, **section):
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'tts': {'provider': 'xai', 'xai': section}})
+    (get_hermes_home() / '.env').write_text(f'XAI_API_KEY={api_key}\n' if api_key else '')
+    invalidate_env_cache()
+
+
+def stt_profile():
+    from hermes_cli.config import invalidate_env_cache
+    support.write_config(get_hermes_home(), {'stt': {'provider': 'xai', 'cloud_trim_silence': False}})
+    (get_hermes_home() / '.env').write_text('')
+    invalidate_env_cache()
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+async def speak(out, callbacks, text=TEXT, deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+async def hear(clip, callbacks, deadline_s=60):
+    return await transcribe_native_once(clip, authorize=callbacks.authorize, before_send=callbacks.before_send,
+                                        deadline_s=deadline_s)
+
+
+def bearer(wire, index=0):
+    return wire.requests[index][0].headers['Authorization']
+
+
+def fresh_token(tag='fresh'):
+    return rest.jwt(time.time() + 3 * HOUR, tag)
+
+
+# --- freshness before the first paid send: real resolver, real pool, real refresh -------------------------------------
+
+@pytest.mark.asyncio
+async def test_a_fresh_bearer_is_sent_once_with_no_oauth_traffic(monkeypatch, out):
+    token = fresh_token()
+    tts_profile()
+    rest.write_oauth_store(token)
+    oauth = rest.OAuthWire()
+    events = []
+    cb = support.Callbacks(events)
+    wire = rest.RestWire([('audio', b'ID3x')], tap=lambda request: events.append('request'))
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count, oauth.requests) == ('synthesized', 'completed', 1, [])
+    assert bearer(wire) == f'Bearer {token}' and wire.requests[0][0].url == 'https://api.x.ai/v1/tts'
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('exp_offset', [90, -60], ids=['inside-the-refresh-window', 'expired'])
+async def test_an_expiring_or_expired_bearer_is_refreshed_before_the_one_paid_send(monkeypatch, out, exp_offset):
+    stale = rest.jwt(time.time() + exp_offset, 'stale')
+    tts_profile()
+    rest.write_oauth_store(stale, refresh='rt-singleton')
+    events = []
+    oauth = rest.OAuthWire(events=events)
+    cb = support.Callbacks(events)
+    wire = rest.RestWire([('audio', b'ID3x')], tap=lambda request: events.append('request'))
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count) == ('synthesized', 'completed', 1)
+    assert events == ['authorize', 'authorize', 'oauth-discovery', 'authorize', 'oauth-refresh', 'authorize', 'before_send',
+                      'request', 'authorize']  # a credential probe precedes each OAuth request (test_native_voice_xai_credential_phase)
+    assert oauth.refresh_tokens_sent() == ['rt-singleton'] and bearer(wire) != f'Bearer {stale}'
+    assert cb.before_send_calls == 1  # the credential exchange is not a paid attempt: one before_send, for the audio
+    assert all(r.extensions['timeout']['read'] >= 5 for r in oauth.posts)  # the stock refresh timeout is finite
+    assert rest.read_oauth_store()['providers']['xai-oauth']['tokens']['refresh_token'] == 'rt-rotated'  # rotation persisted
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('step', [('status', 400), ('status', 401), ('status', 403), ('status', 500), ('badjson',),
+                                  ('redirect', 'https://evil.example/token'),
+                                  ('raise', httpx.ReadTimeout('synthetic'))], ids=str)
+async def test_a_failed_refresh_refuses_unsent_and_never_retries_or_sends(monkeypatch, out, step):
+    tts_profile()
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired'))
+    oauth = rest.OAuthWire([step] * 3)
+    cb = support.Callbacks()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('unavailable', None, 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0 and len(oauth.posts) == 1  # one refresh try, no resend, no loop
+    assert os.listdir(out) == []
+    assert all('evil.example' not in str(r.url) for r in oauth.requests)  # a redirect is not followed
+
+
+@pytest.mark.asyncio
+async def test_missing_oauth_credentials_are_refused_unsent_without_oauth_traffic(monkeypatch, out):
+    tts_profile()
+    oauth = rest.OAuthWire()
+    cb = support.Callbacks()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.provider, wire.count, oauth.requests, cb.before_send_calls) == ('unavailable', 'not_started', 0, [], 0)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('access', [rest.jwt(None, 'no-exp'), 'opaque-bearer-without-expiry'], ids=['jwt-without-exp', 'opaque'])
+async def test_a_bearer_whose_freshness_cannot_be_established_is_refused_unsent(monkeypatch, out, access):
+    tts_profile()
+    rest.write_oauth_store(access)
+    oauth = rest.OAuthWire()
+    cb = support.Callbacks()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, cb)
+    assert (result.state, result.path, result.provider) == ('unavailable', None, 'not_started')
+    assert wire.count == 0 and cb.before_send_calls == 0 and oauth.requests == []  # honest existing tokens: not refreshed, not bypassed
+    assert rest.read_oauth_store()['providers']['xai-oauth']['tokens']['access_token'] == access
+
+
+def test_the_freshness_check_requires_the_whole_request_window_and_ignores_api_keys():
+    from tools import native_send_policy
+    from tools.xai_http import require_native_fresh_bearer
+    policy = native_send_policy.SendPolicy(timeout_s=60.0, providers=frozenset())
+    oauth = lambda exp: {'provider': 'xai-oauth', 'api_key': rest.jwt(exp)}
+    require_native_fresh_bearer(oauth(None))  # outside a native call: stock, nothing is checked
+    with native_send_policy.activate(policy):
+        require_native_fresh_bearer(oauth(time.time() + HOUR))
+        require_native_fresh_bearer({'provider': 'xai', 'api_key': 'xai-explicit-key'})  # an API key has no expiry
+        for exp in (time.time() + 30, time.time() - 1, None):
+            with pytest.raises(native_send_policy.NativeSendRefused) as refused:
+                require_native_fresh_bearer(oauth(exp))
+            assert refused.value.reason == 'credentials'
+        policy.close()
+        with pytest.raises(native_send_policy.NativeSendRefused) as closed:
+            require_native_fresh_bearer(oauth(time.time() + HOUR))
+        assert closed.value.reason == 'closed'
+
