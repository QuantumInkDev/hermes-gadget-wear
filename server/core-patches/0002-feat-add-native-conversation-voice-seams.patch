+    invalidate_env_cache()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, rest.OAuthWire()), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert result.state == 'synthesized'
+    assert wire.requests[0][0].url == 'https://api.x.ai/v1/tts' and bearer(wire) == f'Bearer {token}'
+    # the explicit API-key path keeps its stock behaviour: the operator's own tts.xai.base_url applies, env override pinned
+    tts_profile(api_key='xai-explicit-key', base_url='https://proxy.example/v1')
+    (get_hermes_home() / '.env').write_text('XAI_API_KEY=xai-explicit-key\nHERMES_XAI_BASE_URL=https://evil.example/v1\n')
+    invalidate_env_cache()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert result.state == 'synthesized' and wire.requests[0][0].url == 'https://proxy.example/v1/tts'
