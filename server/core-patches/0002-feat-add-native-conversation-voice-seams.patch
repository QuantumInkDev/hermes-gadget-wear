+    for label, target, rows in (('newest', ids[-1], 1), ('oldest', ids[0], 65536), ('miss-complete', 'absent', 65536)):
+        hydrations.clear()
+        visited = []
+        started = time.monotonic()
+        found = await rig.authority.locate_native_display(
+            reader(), ref, authorize=lambda: None,
+            matches=lambda identity, wanted=target: visited.append(1) or identity == wanted)
+        timings[label] = round(time.monotonic() - started, 3)
+        assert (found is None) == (target == 'absent')
+        assert len(visited) == rows and len(hydrations) == (0 if found is None else 1)
+    support.measured('locate_65536_rows', seconds=timings, rows=65536, budget_s=2.0, deadline_override_s=60.0)
+    monkeypatch.undo()  # the real 2 s budget: the same worst case completes inside it on this rig
+    started = time.monotonic()
+    assert await rig.authority.locate_native_display(
+        reader(), ref, authorize=lambda: None, matches=lambda identity: False) is None
+    support.measured('locate_65536_rows_default_budget', seconds=round(time.monotonic() - started, 3))
+
+
+@pytest.mark.asyncio
+async def test_locate_cost_when_most_of_the_lineage_is_not_display_rows(rig, monkeypatch):
+    """65,536 display rows hidden among 131,072 tool/model-only rows: the shape of a long agent session."""
+    ref = await route(rig)
+    db = rig.authority.db
+    stamp = time.time() - 300000
+    noise = [(ref.session_id, 'tool', 'tool output ' + 'x' * 300, stamp + i, f'tool-{i}', f'call-{i}')
+             for i in range(131072)]
+    db._execute_write(lambda conn: conn.executemany(
+        'INSERT INTO messages (session_id, role, content, timestamp, active, message_uid, tool_call_id) '
+        'VALUES (?,?,?,?,1,?,?)', noise))
+    ids = support.bulk_rows(db, ref.session_id, 65536, text=lambda i: f'row {i} ' + 'x' * 400)
+    monkeypatch.setattr(voice, 'LOCATE_DEADLINE_S', 60.0)
+    started = time.monotonic()
+    found = await rig.authority.locate_native_display(
+        reader(), ref, authorize=lambda: None, matches=lambda identity: identity == ids[0])
+    elapsed = round(time.monotonic() - started, 3)
+    assert found.identity == ids[0]
+    support.measured('locate_65536_display_rows_among_131072_tool_rows', seconds=elapsed, budget_s=2.0)
+
+
+# --- I1: the scalar revision fence (P2) -------------------------------------------------------------
+
+def fence(rig_, ref, identity):
+    return rig_.authority.check_native_display(reader(), ref, authorize=lambda: None, identity=identity)
+
+
+@pytest.mark.asyncio
+async def test_an_edit_after_the_read_is_detected_by_the_scalar_fence(rig):
+    ref = await route(rig)
+    db = rig.authority.db
+    row_id = db.append_message(ref.session_id, 'user', 'old prompt')
+    (frag,) = await support.fragments(rig.authority, reader(), ref)
+    taken = fence(rig, ref, frag.row_id)
+    assert fence(rig, ref, frag.row_id) == taken  # stable while nothing changes
+    assert db.set_user_message_content(ref.session_id, row_id, 'new prompt') == 1
+    assert fence(rig, ref, frag.row_id) != taken
+    assert db.set_user_message_content(ref.session_id, row_id, 'old prompt') == 1
+    assert fence(rig, ref, frag.row_id) != taken  # A-B-A is still a revision
+
+
+@pytest.mark.asyncio
+async def test_the_fence_reads_no_content_at_all(rig):
+    ref = await route(rig)
+    db = rig.authority.db
+    db.append_message(ref.session_id, 'assistant', 'x' * 70000)  # larger than any hydration budget
+    (frag, *_) = await support.fragments(rig.authority, reader(), ref)
+    statements = []
+    with support.traced_reads(db, statements):
+        fence(rig, ref, frag.row_id)
+    assert support.hydrated_ids(statements) == set()
+    assert not [s for s in statements if 'substr(CAST(content' in s or 'SELECT role,content' in s]
+
+
+@pytest.mark.asyncio
+async def test_v3_brackets_the_canonical_read_with_the_token_and_refuses_edits_during_or_after(rig):
+    """The consumer protocol of design 5.2 P1D/P2: token before the first segment, token after the last,
+    token again at P2. Equal tokens = the text read is the text now."""
+    ref = await route(rig)
+    db = rig.authority.db
+    row_id = db.append_message(ref.session_id, 'user', 'u' * 20000)
+    (first, *_) = await support.fragments(rig.authority, reader(), ref)
+    identity = first.row_id
+
+    async def read_all(edit_after_segment=None):
+        before = fence(rig, ref, identity)
+        parts = []
+        for segment in range(first.segment_count):
+            parts.append(await rig.authority.read_native_display(
+                reader(), ref, authorize=lambda: None, identity=identity, segment=segment))
+            if edit_after_segment == segment:
+                db.set_user_message_content(ref.session_id, row_id, 'v' * 20000)
+        return before, fence(rig, ref, identity), ''.join(p.text for p in parts)
+    start, end, text = await read_all()
+    assert start == end and text == 'u' * 20000
+    during_start, during_end, torn = await read_all(edit_after_segment=0)
+    assert during_start != during_end and torn != 'v' * 20000 and torn != 'u' * 20000  # a torn read is refused
+    settled_start, settled_end, settled = await read_all()
+    assert settled_start == settled_end and settled == 'v' * 20000
+    db.set_user_message_content(ref.session_id, row_id, 'w' * 20000)  # after the read, before P2
+    assert fence(rig, ref, identity) != settled_end
