+async def test_stop_or_the_deadline_while_a_preparation_child_is_held_ends_the_call_with_no_next_child_upload_callback_or_file(
+        monkeypatch, tmp_path, scratch, stock_runner, mode, shape, how):
+    try:
+        support.write_config(get_hermes_home(), config(cloud_trim_silence=shape == 'tone'))
