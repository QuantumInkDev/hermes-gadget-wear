+async def test_empty_and_too_long_transcripts_are_stable_outcomes(monkeypatch, clip, configured):
+    for body, state in (('   ', 'empty'), ('x' * 4001, 'too_long'), ('😀' * 4001, 'too_long')):
+        wire = support.Wire([words(body)])
+        with support.provider_wire(monkeypatch, wire):
