+def pcm_bytes(seconds=1.0, rate=24000):
+    """Real 24 kHz mono 16-bit little-endian PCM (a sine), the Gemini TTS answer format."""
+    import math
+    import struct
+    return b''.join(struct.pack('<h', int(6000 * math.sin(2 * math.pi * 440 * i / rate))) for i in range(int(seconds * rate)))
+
+
+def gemini_answer(pcm):
+    return ('json', {'candidates': [{'content': {'parts': [{'inlineData': {'mimeType': 'audio/L16;rate=24000',
+                                                                           'data': base64.b64encode(pcm).decode()}}]}}]})
+
+
+def minimax_answer(audio):
+    return ('json', {'base_resp': {'status_code': 0, 'status_msg': 'success'}, 'data': {'audio': audio.hex()}})
+
+
+def gzipped(body):
+    return gzip.compress(body)
