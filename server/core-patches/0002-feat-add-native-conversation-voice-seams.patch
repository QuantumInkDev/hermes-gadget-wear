+@pytest.mark.asyncio
+async def test_the_explicit_api_key_is_preferred_and_oauth_is_never_touched(monkeypatch, out):
+    tts_profile(api_key='xai-explicit-key')
+    rest.write_oauth_store(rest.jwt(time.time() - 60, 'expired-oauth'))  # would need a refresh if it were used
+    oauth = rest.OAuthWire()
+    wire = rest.RestWire([('audio', b'ID3x')])
+    with rest.oauth_wire(monkeypatch, oauth), rest.rest_wire(monkeypatch, wire):
+        result = await speak(out, support.Callbacks())
+    assert (result.state, wire.count, oauth.requests) == ('synthesized', 1, [])
+    assert bearer(wire) == 'Bearer xai-explicit-key'
