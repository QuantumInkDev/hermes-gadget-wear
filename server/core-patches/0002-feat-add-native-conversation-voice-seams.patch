+"""Native voice seam, REST TTS: Stop and deadline fences, held gates, stalled providers, no late callback or file.
+
+Deterministic: the loop callback that runs the consumer's ``authorize`` / ``before_send`` is held (or the synthetic
+transport is held) with events, never with sleeps. Same shape as the Mistral fences.
+"""
+import asyncio
+import os
+import threading
+
+import pytest
+
+from tests.gateway import native_voice_support as support
+from tests.gateway import rest_voice_support as rest
+from tests.gateway.mistral_voice_support import HeldGate, speak, watch_worker
+from tests.gateway.test_native_voice_rest_tts import CASES, PROVIDERS
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture(autouse=True)
+def qualified_launcher(monkeypatch):
+    """AUX-audio: native Gemini proves its converter under the qualified launcher before the first request, so the Gemini cases run behind
+    the HARNESS pass-through stand-in (NOT a sandbox); the held gate below is still the PAID send gate (the preflight probes are not held)."""
+    return support.qualify(monkeypatch)
+
+
+# authorization-only probes asked right before a converter-preflight child (not sends): Gemini's one capability preflight child
+PREFLIGHT_PROBES = {'gemini': 1}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('how', ['cancel', 'deadline'])
+@pytest.mark.parametrize('name', PROVIDERS)
+async def test_callbacks_never_run_after_stop_or_the_deadline_while_the_gate_is_held(monkeypatch, out, name, how):
+    from gateway import session_native_voice_tts as tts_module
+    CASES[name]['profile']()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    cb = support.Callbacks()
+    wire = rest.RestWire([CASES[name]['ok']])
+    held = HeldGate(monkeypatch)
+    deadline = rest.EventDeadline(monkeypatch)
+    with rest.rest_wire(monkeypatch, wire):
+        if how == 'cancel':
+            task = asyncio.create_task(speak(out, cb))
+            await held.wait_enqueued()
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        else:
+            task = asyncio.create_task(speak(out, cb, deadline_s=30))
+            await held.wait_enqueued()  # the worker is AT the gate: only now does the deadline pass
+            deadline.fire()
+            result = await task
+            assert (result.state, result.provider) == ('timeout', 'not_started')
+        await held.release()
+        assert await asyncio.to_thread(finished.wait, 10)
+    assert cb.authorize_calls == 1 + PREFLIGHT_PROBES.get(name, 0) and cb.before_send_calls == 0 and wire.count == 0 and os.listdir(out) == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('name', PROVIDERS)
+async def test_a_stalled_provider_ends_only_our_wait_and_the_late_worker_does_nothing(monkeypatch, out, name):
+    from gateway import session_native_voice_tts as tts_module
+    CASES[name]['profile']()
+    finished = watch_worker(monkeypatch, tts_module, '_synthesize')
+    release = threading.Event()
+    cb = support.Callbacks()
+    wire = rest.RestWire([CASES[name]['ok']], hold=release)
+    deadline = rest.EventDeadline(monkeypatch)
+    try:
+        with rest.rest_wire(monkeypatch, wire):
+            task = asyncio.create_task(speak(out, cb, deadline_s=30))
+            assert await asyncio.to_thread(wire.entered.wait, 10)  # the request is on the wire and stalled
+            deadline.fire()
+            spoken = await task
+            calls = (cb.authorize_calls, cb.before_send_calls)
+            release.set()
+            assert await asyncio.to_thread(finished.wait, 10)
+    finally:
+        release.set()
+    assert (spoken.state, spoken.path, spoken.provider, wire.count) == ('timeout', None, 'unknown', 1)
+    assert (cb.authorize_calls, cb.before_send_calls) == calls and os.listdir(out) == []  # a fenced worker leaves no file
