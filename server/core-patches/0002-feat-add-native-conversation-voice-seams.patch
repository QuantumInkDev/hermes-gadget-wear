+"""Native voice seam: configured text-to-speech, one request per chunk, stop at the first failed chunk.
+
+Real OpenAI SDK, real httpx client over a synthetic network transport; the profile's TTS
+configuration is the real ``config.yaml`` read at call time. The ElevenLabs and Edge engines run against
+the REAL pinned SDKs in ``test_native_voice_sdk_boundaries``.
+"""
+import asyncio
+import logging
+import os
+import threading
+from pathlib import Path
+
+import httpx
+import pytest
+
+from gateway.session_native_voice import speakable_text, synthesize_native_once
+from hermes_constants import get_hermes_home
+from tests.gateway import native_voice_support as support
+
+KEY = 'sk-synthetic-native-tts'
+SENTENCES = ('The first sentence is deliberately rather long. ', 'The second sentence is also fairly long here. ',
+             'The third sentence closes out the whole text.')
+LONG_TEXT = ''.join(SENTENCES)
+
+
+def openai_config(max_text_length=None, **openai):
+    section = {'api_key': KEY, 'model': 'gpt-4o-mini-tts', 'voice': 'nova', **openai}
+    if max_text_length:
+        section['max_text_length'] = max_text_length
+    return {'tts': {'provider': 'openai', 'openai': section}}
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def configured():
+    support.write_config(get_hermes_home(), openai_config())
+
+
+@pytest.fixture
+def joined(monkeypatch):
+    """Byte-wise MP3 join for the ffmpeg concat step (a subprocess the offline guard forbids)."""
+    def concat(paths, output, voice_compatible=False):
+        with open(output, 'wb') as joined_file:
+            for path in paths:
+                with open(path, 'rb') as part:
+                    joined_file.write(part.read())
+        return output
+    monkeypatch.setattr('tools.tts_tool_delivery._concat_audio_files', concat)
+
+
+async def seam(text, out, callbacks, deadline_s=60):
+    return await synthesize_native_once(text, output_dir=out, authorize=callbacks.authorize,
+                                        before_send=callbacks.before_send, deadline_s=deadline_s)
+
+
+def chunk_count(text, cap):
+    from tools.tts_tool_delivery import _split_text_for_tts
+    return len(_split_text_for_tts(speakable_text(text), cap))
+
+
+def audio(tag):
+    return ('ok', {'audio': f'ID3{tag}'.encode()})
+
+
+@pytest.mark.asyncio
+async def test_single_chunk_success_writes_one_file_in_the_caller_directory(monkeypatch, out, configured):
+    events = []
+    cb = support.Callbacks(events)
+    wire = support.Wire([audio('one')], tap=lambda request: events.append('request'))
+    with support.provider_wire(monkeypatch, wire):
+        result = await seam('Hello there, friend.', out, cb)
+    assert (result.state, result.source, result.provider) == ('synthesized', 'configured', 'completed')
+    assert result.code_points == len('Hello there, friend.')
+    assert os.path.dirname(result.path) == out and Path(result.path).read_bytes() == b'ID3one'
+    assert os.listdir(out) == [os.path.basename(result.path)]
+    assert wire.count == 1
+    assert events == ['authorize', 'authorize', 'before_send', 'request', 'authorize']
+    body = wire.requests[0].read()
+    assert b'"voice":"nova"' in body.replace(b' ', b'') and b'gpt-4o-mini-tts' in body
+    assert not (get_hermes_home() / 'cache' / 'audio').exists() or not list((get_hermes_home() / 'cache' / 'audio').iterdir())
+
