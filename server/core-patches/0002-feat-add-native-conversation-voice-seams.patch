+def request(tmp_path, engine='piper', **over):
+    opts = {'piper': {'model_path': '', 'config_path': '', 'use_cuda': False, 'speaker_id': 0, 'knobs': None},
+            'kittentts': {'repo_id': 'KittenML/x', 'voice': 'Jasper', 'speed': 1.0, 'clean_text': True},
+            'neutts': {'original_repo': 'neuphonic/neutts-air-q4-gguf', 'device': 'cpu', 'ref_audio_path': '',
+                       'ref_text_path': '', 'language': None}}[engine]
+    req = {'api': 1, 'engine': over.pop('engine_name', engine), 'text': 'synthetic words',
+           'wav_path': str(tmp_path / 'out.wav'), 'max_wav_bytes': 1 << 20, engine: opts, **over}
+    return json.dumps(req).encode()
+
