+"""Native voice seam, Mistral: carried review obligations M10 (consumer gate refusal) and M3 (provider log text).
+
+The REAL pinned ``mistralai`` SDK over a synthetic transport. M10: a real consumer ``authorize`` / ``before_send``
+refusal leaves the wire untouched, is a truthful ``not_started`` and never runs the STT fallback. M3: the SDK's
+deprecation WARNING carries provider-controlled text and must not be logged during a native call, while the same call
+outside a native call still logs it.
+"""
+import json
+import logging
+import os
+
+import pytest
+
+from tests.gateway import mistral_voice_support as mistral
+from tests.gateway import native_voice_support as support
+from tests.gateway.mistral_voice_support import hear, speak
+
+
+@pytest.fixture
+def clip(tmp_path):
+    return support.write_wav(tmp_path / 'clip.wav')
+
+
+@pytest.fixture
+def out(tmp_path):
+    path = tmp_path / 'caller-output'
+    path.mkdir()
+    return str(path)
+
+
+@pytest.fixture
+def sdk(monkeypatch):
+    return mistral.observe_sdk(monkeypatch)
+
+
+@pytest.fixture
+def local_fallback(monkeypatch):
+    calls = []
+    monkeypatch.setattr('tools.transcription_tools._HAS_FASTER_WHISPER', True)
+    monkeypatch.setattr('tools.transcription_tools._transcribe_local',
+                        lambda path, model, **kw: calls.append(path) or {'success': True, 'transcript': 'local words'})
+    return calls
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('refusal', [dict(refuse_before_send=True), dict(refuse_authorize_at=2), dict(refuse_authorize_at=1)],
+                         ids=['before_send', 'authorize-at-the-gate', 'authorize-first'])
+async def test_a_consumer_gate_refusal_sends_nothing_and_never_falls_back(monkeypatch, clip, out, sdk, local_fallback, refusal):
+    mistral.stt_profile()
+    cb = support.Callbacks(**refusal)
+    wire = mistral.MistralWire([('ok', {})])
+    with support.provider_wire(monkeypatch, wire):
+        heard = await hear(clip, cb)
+        mistral.tts_profile()
+        cb_tts = support.Callbacks(**refusal)
+        spoken = await speak(out, cb_tts)
+    assert (heard.state, heard.transcript, heard.source, heard.provider) == ('refused', None, None, 'not_started')
+    assert (spoken.state, spoken.path, spoken.provider) == ('refused', None, 'not_started')
+    assert wire.count == 0 and local_fallback == [] and os.listdir(out) == []  # wire 0, no STT fallback, no file
+    assert support.SECRET not in repr(heard) + repr(spoken)
+
+
+class DeprecatedWire(mistral.MistralWire):
+    """A Mistral answer that carries the provider's model-deprecation header (provider-controlled text)."""
+
+    def respond(self, request, value):
+        response = super().respond(request, value)
+        response.headers['x-model-deprecation-timestamp'] = 'PROVIDER-TEXT-2099-01-01'
+        return response
+
+
+@pytest.mark.asyncio
+async def test_the_sdk_deprecation_warning_is_not_logged_in_a_native_call_but_stock_still_logs_it(monkeypatch, clip, sdk, caplog):
+    from tools.transcription_tools import transcribe_audio
+    caplog.set_level(logging.DEBUG)
+    mistral.stt_profile()
+    wire = DeprecatedWire([('ok', {'text': 'native words'})])
+    with support.provider_wire(monkeypatch, wire):
+        heard = await hear(clip, support.Callbacks())
+    assert (heard.state, heard.transcript) == ('transcribed', 'native words')
+    assert 'PROVIDER-TEXT-2099' not in caplog.text and not [r for r in caplog.records if r.name.startswith('mistralai')]
+    caplog.clear()
+    wire = DeprecatedWire([('ok', {'text': 'stock words'})])
+    with support.provider_wire(monkeypatch, wire):
+        result = transcribe_audio(clip)
+    assert result['success'] and result['transcript'] == 'stock words'
+    assert [r for r in caplog.records if r.name == 'mistralai.client._hooks.deprecation_warning' and 'PROVIDER-TEXT-2099' in r.getMessage()]
+
+
+@pytest.mark.asyncio
+async def test_native_mistral_requests_ask_for_an_uncompressed_answer_and_stock_requests_do_not(monkeypatch, clip, out, sdk):
+    """M5 proportional hardening: the per-chunk wire bound is not an allocation cap, so no inflating encoding is requested."""
+    from tools.transcription_tools import transcribe_audio
+    mistral.stt_profile()
+    wire = mistral.MistralWire([('ok', {}), ('ok', {'audio': b'ID3x'}), ('ok', {})])
+    with support.provider_wire(monkeypatch, wire):
+        await hear(clip, support.Callbacks())
+        mistral.tts_profile()
+        await speak(out, support.Callbacks())
+        mistral.stt_profile()
+        transcribe_audio(clip)
+    assert wire.requests[2].headers['accept-encoding'] != 'identity'  # the stock call keeps the SDK/httpx default
+    assert wire.requests[0].headers['accept-encoding'] == wire.requests[1].headers['accept-encoding'] == 'identity'
