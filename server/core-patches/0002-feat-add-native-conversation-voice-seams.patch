+"""One-send transport policy for a native (Relay) voice call.
+
+``gateway.session_native_voice`` activates a :class:`SendPolicy` around exactly one configured
+provider request (per STT call, per TTS chunk). The provider modules ask this module at their
+transport boundary, and only there, so an ordinary ``transcribe_audio`` / ``text_to_speech_tool``
+call, where no policy is active, keeps its SDK retries, timeouts, redirects, transcode retry and
+log lines untouched.
+
+The policy never trusts a client library to honour "no retry" or "I use the client you gave me":
+``begin()`` runs immediately before every transport send and refuses a second send in the same
+scope; the seam additionally proves, BEFORE a hooked SDK is invoked, that the SDK sends through the
+very client that carries the hook, and requires, AFTER it, exactly one gated send. A send nobody
+gated is reported as ``unknown`` accounting, never ``not_started``. Refusals carry stable tokens,
+never provider text.
+"""
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import inspect
+import logging
+import threading
+from typing import Any, Callable, Iterable, Iterator, Optional
+
+
+class NativeSendRefused(RuntimeError):
+    """A transport send the policy refused; ``reason`` is a stable token, never provider text."""
+
+    def __init__(self, reason: str):
+        super().__init__(reason)
+        self.reason = reason
+
+
+class CredentialPhaseStopped(BaseException):
+    """An actual OAuth discovery/refresh request of the credential phase was refused (``reason`` is a stable token).
+
+    A ``BaseException`` ON PURPOSE, like ``asyncio.CancelledError``: the stock credential pool treats any ``Exception`` from a
+    refresh as a failed account (it benches the account for a cooldown or clears its stored tokens) and the stock resolver
+    swallows ``Exception`` and falls through to another credential. A Stop, deadline or lost authority is not an account
+    fault and must not fall through, so this passes both untouched; ``tools.xai_http`` converts it to
+    :class:`NativeSendRefused` at the resolver boundary."""
+
+    def __init__(self, reason: str):
+        super().__init__(reason)
+        self.reason = reason
+
+
+class SendPolicy:
+    """Counts and gates transport sends for one native call.
+
+    ``gate`` (set once, before the worker starts) runs the caller's ``authorize`` + ``before_send`` on the
+    owning event loop and raises :class:`NativeSendRefused` to refuse; it calls :meth:`commit` once the
+    consumer's ``before_send`` returned. ``providers`` is the closed set of provider names the call may reach.
+    """
+
+    def __init__(self, *, timeout_s: float, providers: frozenset[str], gate: Optional[Callable[[], None]] = None,
+                 max_output_bytes: Optional[int] = None):
+        self.timeout_s = timeout_s
+        self.providers = providers
+        self.max_output_bytes = max_output_bytes
+        self._gate = gate
+        self._credential_probe: Optional[Callable[[], None]] = None
+        self._lock = threading.Lock()
+        self._scope_sends = 0
+        self._entered = False
+        self._committed = False
+        self._clients: list[Any] = []
+        self.sends = 0
+        self.refusal: Optional[str] = None
+        self.closed = False
+
+    def set_gate(self, gate: Callable[[], None]) -> None:
+        self._gate = gate
+
+    def set_credential_probe(self, probe: Callable[[], None]) -> None:
+        """The authorization-only check of the credential phase (runs the consumer's ``authorize`` on its own loop)."""
+        self._credential_probe = probe
+
+    @property
+    def scope_sends(self) -> int:
+        """Gated sends admitted since the last :meth:`arm`."""
+        return self._scope_sends
+
+    @property
+    def entered(self) -> bool:
+        """The provider invocation of the current scope was entered (the injected client was proven, or the
+        Edge connector built, and the SDK is about to be called)."""
+        return self._entered
+
+    def mark_entered(self) -> None:
+        with self._lock:
+            self._entered = True
+
+    def silent_after_entry(self) -> bool:
+        """True when an invocation was entered, no send passed the gate in this scope and no policy refusal
+        explains it: whatever happened next (an exception, a failure answer) may have left through a path the
+        gate never saw, so the accounting is ambiguous (``unknown``), never ``not_started``."""
+        with self._lock:
+            return self._entered and not self._scope_sends and self.refusal is None
+
+    def refusal_for(self, reason: str) -> NativeSendRefused:
+        """The exception to raise for ``reason``, remembering the first reason for the caller's report."""
+        with self._lock:
+            return self._refusal_locked(reason)
+
+    def _refusal_locked(self, reason: str) -> NativeSendRefused:
+        self.refusal = self.refusal or reason
+        return NativeSendRefused(reason)
+
+    def arm(self) -> None:
+        """Open a fresh one-send scope (one TTS chunk); cumulative ``sends`` keeps counting."""
+        with self._lock:
+            self._scope_sends = 0
+            self._entered = False
+
+    def is_closed(self) -> bool:
+        with self._lock:
+            return self.closed
+
+    def commit(self) -> None:
+        """Loop side: the consumer's ``before_send`` returned for a send that has not left yet."""
+        with self._lock:
+            self._committed = True
+
+    def begin(self) -> None:
+        """Called immediately before a transport send: refuse a closed policy or a second send,
+        then let the caller's gate authorize and durably record the send before it happens."""
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+            if self._scope_sends:
+                raise self._refusal_locked('second')
+        try:
+            if self._gate is None:
+                raise NativeSendRefused('refused')
+            self._gate()
+        except NativeSendRefused as exc:
+            raise self.refusal_for(exc.reason) from None
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+            self._scope_sends = 1
+            self.sends += 1
+            self._committed = False
+
+    def on_request(self, _request) -> None:
+        """httpx ``request`` event hook: the actual transport boundary of SDK and httpx clients."""
+        self.begin()
+
+    def probe_credentials(self) -> None:
+        """Called immediately before an OAuth discovery/refresh HTTP request: refuse a closed policy, else ask the
+        consumer whether the call is still authorized. This is NOT a send: it never runs ``before_send``, never commits,
+        never counts a send nor opens a scope, and a policy with no probe fails closed."""
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+        try:
+            if self._credential_probe is None:
+                raise NativeSendRefused('refused')
+            self._credential_probe()
+        except NativeSendRefused as exc:
+            raise self.refusal_for(exc.reason) from None
+        with self._lock:
+            if self.closed:
+                raise self._refusal_locked('closed')
+
+    def on_credential_request(self, _request) -> None:
+        """httpx ``request`` event hook of the OAuth clients: the actual lowest OAuth boundary under the credential phase."""
+        try:
+            self.probe_credentials()
+        except NativeSendRefused as exc:
+            raise CredentialPhaseStopped(exc.reason) from None
+
+    def require_provider(self, provider: str) -> None:
+        if provider not in self.providers:
+            raise self.refusal_for('unsupported')
+
+    def track(self, client: Any) -> Any:
+        """Remember a client this call built so :meth:`close_clients` can release its pool."""
+        with self._lock:
+            self._clients.append(client)
+        return client
+
+    def close_clients(self) -> None:
+        with self._lock:
+            clients, self._clients = self._clients, []
+        for client in clients:
+            with contextlib.suppress(Exception):
+                client.close()
+
+    def close(self) -> bool:
+        """Stop admitting sends; True when a request may have left, or the consumer already recorded one."""
+        with self._lock:
+            self.closed = True
+            return self.sends > 0 or self._committed
+
+
+_current: contextvars.ContextVar[Optional[SendPolicy]] = contextvars.ContextVar('native_send_policy', default=None)
+
+
+class _QuietInNativeCalls(logging.Filter):
+    """Drops the stock provider helpers' log records while a native call is active in THIS context:
+    their lines carry provider messages, tracebacks and audio basenames (design 8.1, 10.3). Other
+    threads and ordinary stock calls are untouched. A dropped record is dropped for EVERY handler
+    (a logger filter runs before any handler), so during a native call it is not available in an
+    operator's local log either."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        return _current.get() is None
+
+
+# Python applies a logger's filters only to records created on THAT logger, so each logger that can print
+# provider-controlled text is named exactly: the stock STT/TTS helpers, the credential pool (an OAuth refresh
+# failure logs the authority's response body) and the pinned Mistral SDK's hook loggers (the deprecation
+# WARNING carries a provider-supplied date).
+_QUIET_LOGGERS = (
+    'tools.transcription_tools', 'tools.tts_tool', 'agent.credential_pool', 'mistralai.client',
+    'mistralai.client._hooks.deprecation_warning', 'mistralai.client._hooks.tracing',
+    'mistralai.client._hooks.workflow_encoding_hook')
+
+
+def _install_quiet_filter() -> None:
+    for name in _QUIET_LOGGERS:
+        logger = logging.getLogger(name)
+        if not any(isinstance(f, _QuietInNativeCalls) for f in logger.filters):
+            logger.addFilter(_QuietInNativeCalls())
+
+
+_install_quiet_filter()
+
+
+def current() -> Optional[SendPolicy]:
+    return _current.get()
+
+
+@contextlib.contextmanager
+def activate(policy: SendPolicy) -> Iterator[SendPolicy]:
+    token = _current.set(policy)
+    try:
+        yield policy
+    finally:
+        _current.reset(token)
+
+
+def installs_allowed() -> bool:
+    """False inside a native call: it uses only what is already installed and cached, never a lazy
+    SDK install nor a model download."""
+    return _current.get() is None
+
+
+def auxiliary_llm_allowed() -> bool:
+    """False inside a native call: it makes no auxiliary-model request (a hidden second paid request on an
+    unrelated provider, outside the send gate), so optional speech-tag rewrites keep their stock fallback text."""
+    return _current.get() is None
+
+
+def require_open() -> None:
+    """Inside a native call: refuse UNSENT once Stop or the deadline closed the policy, before any credential work."""
+    policy = _current.get()
+    if policy is not None and policy.is_closed():
+        raise policy.refusal_for('closed')
+
+
+def credential_client_kwargs() -> dict:
+    """Extra ``httpx.Client(...)`` kwargs of an OAuth discovery/refresh client: the credential-phase probe on every request
+    it sends. Outside a native call: nothing (the stock clients are built exactly as before)."""
+    policy = _current.get()
+    return {} if policy is None else {'event_hooks': {'request': [policy.on_credential_request]}}
+
+
+def credential_timeout(seconds: float) -> float:
+    """An OAuth request timeout bounded by the native call's budget (``min(stock, the call's bound)``); stock outside one."""
+    policy = _current.get()
+    return seconds if policy is None else min(seconds, policy.timeout_s)
+
+
+def no_resend() -> bool:
+    """True inside a native call: no post-send retry of any kind (transcode retry, OAuth refresh, redirect)."""
+    return _current.get() is not None
+
+
+def refuse(reason: str) -> NativeSendRefused:
+    """The refusal to raise for ``reason``, recorded on the active policy so the caller can report it."""
+    policy = _current.get()
+    return policy.refusal_for(reason) if policy is not None else NativeSendRefused(reason)
+
+
+def mark_entered() -> None:
+    """Immediately before an SDK/engine invocation whose gate is proven: from here a zero-send exception or
+    failure is ambiguous, not "nothing was sent"."""
+    policy = _current.get()
+    if policy is not None:
+        policy.mark_entered()
+
+
+def begin_send() -> None:
+    """Transport-boundary hook for providers that do not go through an httpx client."""
+    policy = _current.get()
+    if policy is not None:
+        policy.begin()
+
+
+def require_provider(provider: str) -> None:
+    policy = _current.get()
+    if policy is not None:
+        policy.require_provider(provider)
+
+
+def request_timeout(default: float) -> float:
+    policy = _current.get()
+    return default if policy is None else min(default, policy.timeout_s)
+
+
+def requests_kwargs() -> dict:
+    """Extra ``requests.post`` kwargs: a 307/308 is an answer, never a second POST the policy cannot see."""
+    return {} if _current.get() is None else {'allow_redirects': False}
+
+
+def rest_headers(headers: dict) -> dict:
+    """Request headers for a native REST send: the body is requested uncompressed, so a decoded read is never larger
+    than the bytes on the wire. Outside a native call the headers are returned untouched."""
+    return headers if _current.get() is None else {**headers, 'Accept-Encoding': 'identity'}
+
+
+def response_limit(default: int) -> int:
+    """Body cap for a REST answer: the stock limit, never above the native output cap. The read is chunk-granular
+    (64 KiB reads), so this bounds what is kept to the limit plus one chunk; it is not an allocation-hard heap cap."""
+    policy = _current.get()
+    cap = None if policy is None else policy.max_output_bytes
+    return default if cap is None else min(default, cap)
+
+
+def bounded_stream(chunks: Iterable[bytes]) -> Iterator[bytes]:
+    """Pass audio chunks through; inside a native call, refuse a body over the policy's byte cap."""
+    policy = _current.get()
+    limit = None if policy is None else policy.max_output_bytes
+    written = 0
+    for chunk in chunks:
+        written += len(chunk)
+        if limit is not None and written > limit:
+            raise refuse('too_long')
+        yield chunk
+
+
+def prove_injected(sender: Any, injected: Any) -> None:
+    """Inside a native call: refuse UNSENT unless the SDK sends through exactly the instance that carries
+    the hook. Outside one: nothing to prove."""
+    if _current.get() is not None and (injected is None or sender is not injected):
+        raise refuse('unsupported')
+
+
+def openai_client_kwargs(configured_timeout: Optional[float] = None) -> dict:
+    """Extra ``OpenAI(...)`` kwargs: explicit timeout, zero SDK retries, no redirects, the send hook on the real client."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    from openai import DefaultHttpxClient
+    timeout = policy.timeout_s if configured_timeout is None else min(configured_timeout, policy.timeout_s)
+    http_client = policy.track(DefaultHttpxClient(timeout=timeout, follow_redirects=False,
+                                                  event_hooks={'request': [policy.on_request]}))
+    return {'timeout': timeout, 'max_retries': 0, 'http_client': http_client}
+
+
+def elevenlabs_client_kwargs() -> dict:
+    """Extra ``ElevenLabs(...)`` kwargs: explicit timeout and the send hook on the httpx client it must use."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import httpx
+    http_client = policy.track(httpx.Client(timeout=policy.timeout_s, follow_redirects=False,
+                                            event_hooks={'request': [policy.on_request]}))
+    return {'timeout': policy.timeout_s, 'httpx_client': http_client}
+
+
+def elevenlabs_request_options() -> Optional[dict]:
+    policy = _current.get()
+    return None if policy is None else {'max_retries': 0, 'timeout_in_seconds': policy.timeout_s}
+
+
+_JSON_ENVELOPE_BYTES = 4096  # a base64 audio body is wrapped in a small JSON object
+
+
+def _bounded_answer(limit: int) -> Callable[[Any], None]:
+    """httpx ``response`` event hook: a body is refused once it exceeds ``limit`` DECODED bytes, whether or not
+    its length was declared (the SDK reads it whole, so nothing else bounds it).
+
+    The check runs per decoded chunk: a chunk that inflates is allocated before it is counted (a compressed answer
+    can transiently exceed the limit by the inflation of one chunk). This is NOT an allocation-hard heap cap. The
+    clients built here ask for ``Accept-Encoding: identity`` so a conforming provider sends no inflating encoding."""
+    def hook(response) -> None:
+        declared = response.headers.get('content-length', '')
+        if declared.isdigit() and int(declared) > limit:
+            raise refuse('too_long')
+        iter_bytes = response.iter_bytes
+
+        def bounded(chunk_size=None):
+            total = 0
+            for chunk in iter_bytes(chunk_size):
+                total += len(chunk)
+                if total > limit:
+                    raise refuse('too_long')
+                yield chunk
+        response.iter_bytes = bounded
+    return hook
+
+
+def mistral_client_kwargs(*, base64_audio: bool = False) -> dict:
+    """Extra ``Mistral(...)`` kwargs: explicit timeout, zero SDK retries, no redirects, the send hook on the very
+    client it must use, the answer bounded on the wire and no SDK debug log (which would print keys and bodies).
+
+    ``base64_audio``: the answer is JSON carrying the base64 audio, so the cap is that of the audio, encoded."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import httpx
+    from mistralai.client.utils.logger import NoOpLogger
+    timeout_ms = max(1, round(policy.timeout_s * 1000))
+    hooks: dict = {'request': [policy.on_request]}
+    if policy.max_output_bytes is not None:
+        limit = policy.max_output_bytes
+        hooks['response'] = [_bounded_answer((limit + 2) // 3 * 4 + _JSON_ENVELOPE_BYTES if base64_audio else limit)]
+    http_client = policy.track(httpx.Client(timeout=timeout_ms / 1000, follow_redirects=False, event_hooks=hooks,
+                                            headers={'Accept-Encoding': 'identity'}))
+    return {'client': http_client, 'timeout_ms': timeout_ms, 'retry_config': None, 'debug_logger': NoOpLogger()}
+
+
+def mistral_request_options(client: Any, injected: dict, *endpoints: Callable, needs: Iterable[str] = ()) -> dict:
+    """Per-call options for the pinned Mistral SDK; refuses UNSENT, before the invocation is entered, unless the
+    installed SDK sends through the injected client and every endpoint can be told zero retries and an explicit
+    timeout (and takes every request field in ``needs``). Disables the SDK's opt-in trace exporter, a second
+    outbound path the gate would never see. Outside a native call: nothing.
+
+    The ``telemetry`` read-back below is NOT proof the SDK honours the switch (the pinned 2.4.8 configuration is a plain
+    object that reads back whatever was assigned). The proof is the SDK's own ``getattr`` of the attribute plus the
+    behavioural exporter test in ``tests/gateway/test_native_voice_mistral_fences.py``, which must run on any SDK change."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    config = getattr(client, 'sdk_configuration', None)
+    prove_injected(getattr(config, 'client', None), injected.get('client'))
+    required = {'retries', 'timeout_ms', *needs}
+    for endpoint in endpoints:
+        if not required <= inspect.signature(endpoint).parameters.keys():
+            raise refuse('unsupported')
+    config.telemetry = False
+    if getattr(config, 'telemetry', None) is not False:
+        raise refuse('unsupported')
+    return {'retries': None, 'timeout_ms': injected['timeout_ms']}
+
+
+def edge_communicate_kwargs() -> dict:
+    """Extra ``edge_tts.Communicate(...)`` kwargs: every websocket handshake passes the gate, so the
+    library's own 403 re-handshake (a second send) is refused, and the timeouts are explicit."""
+    policy = _current.get()
+    if policy is None:
+        return {}
+    import aiohttp
+
