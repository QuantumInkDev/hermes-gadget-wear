diff --git a/tests/gateway/test_adapter_final_delivery_context.py b/tests/gateway/test_adapter_final_delivery_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..4998d5f4dd5d73ed57eae3874dd0a8eb6c1d6740
--- /dev/null
+++ b/tests/gateway/test_adapter_final_delivery_context.py
@@ -0,0 +1,122 @@
+"""Optional adapter recovery identity; stock context-free marker semantics stay intact."""
+from contextlib import closing
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import delivery_ledger as ledger
+from gateway.config import GatewayConfig, Platform
+from gateway.session import SessionSource, SessionStore
+
+
+@pytest.fixture
+def store(tmp_path, monkeypatch):
+    monkeypatch.setattr(ledger, '_db_path', lambda: tmp_path / 'ledger.db')
+    result = SessionStore(sessions_dir=tmp_path / 'sessions', config=GatewayConfig())
+    result._db = None  # exact legacy JSON persistence boundary, independent of test home's DB
+    yield result
+    result.close_all_db_handles()
+
+
+def entry(store):
+    return store.get_or_create_session(SessionSource(platform=Platform.TELEGRAM,
+        chat_id='synthetic-chat', chat_type='dm', user_id='synthetic-user'))
+
+
+@pytest.mark.parametrize('context', [[], {}, {'kind': ''}, {'kind': 'x', 'payload': []},
+    {'kind': 'x', 'payload': {'nested': True}}, {'kind': 'x', 'payload': float('nan')},
+    {'kind': 'x', 'payload': 'x' * 1025}, {'kind': 'x', **{str(i): i for i in range(20)}}])
+def test_invalid_context_never_publishes_marker(store, context):
+    e = entry(store)
+    before = e.to_dict()
+    with pytest.raises(ValueError):
+        store.mark_turn_active(e.session_key, delivery_context=context)
+    assert e.to_dict() == before
+
+
+def test_atomic_identity_restart_and_compare_clear(store):
+    e = entry(store)
+    first = {'kind': 'synthetic-v1', 'identity': 'first', 'owner': 'one'}
+    token = store.mark_turn_active(e.session_key, delivery_context=first)
+    first['owner'] = 'mutated caller'
+    assert e.active_turn_delivery_context['owner'] == 'one'
+    loaded = SessionStore(sessions_dir=store.sessions_dir, config=GatewayConfig())
+    loaded._db = None
+    try:
+        loaded._ensure_loaded()
+        recovered = loaded._entries[e.session_key]
+        assert recovered.active_turn_token == token
+        assert loaded.recover_interrupted_turns() == 0
+        assert loaded.discard_active_turn_markers() == 0
+        with pytest.raises(RuntimeError, match='unresolved final'):
+            loaded.mark_turn_active(e.session_key, delivery_context={'kind': 'synthetic-v1', 'identity': 'next'})
+        assert not loaded.clear_turn_active_for_delivery(e.session_key, first)
+        assert loaded.clear_turn_active_for_delivery(e.session_key, recovered.active_turn_delivery_context)
+        assert recovered.active_turn_token is None
+        assert recovered.active_turn_delivery_context is None
+        # Stock re-mark/cas and interrupted replay semantics remain available.
+        previous = loaded.mark_turn_active(e.session_key)
+        current = loaded.mark_turn_active(e.session_key)
+        assert current != previous and not loaded.clear_turn_active(e.session_key, previous)
+        assert loaded.recover_interrupted_turns() == 1
+    finally:
+        loaded.close_all_db_handles()
+
+
+def test_distinct_same_text_crash_rows_use_context_identity(store):
+    args = dict(session_key='synthetic-session', platform='telegram', chat_id='chat',
+                thread_id=None, content='same answer', since=0)
+    first = {'kind': 'synthetic-v1', 'identity': 'one'}
+    second = {'kind': 'synthetic-v1', 'identity': 'two'}
+    ledger.record_crash_left_reply(obligation_id='one', delivery_context=first, **args)
+    ledger.record_crash_left_reply(obligation_id='two', delivery_context=second, **args)
+    ledger.record_crash_left_reply(obligation_id='retry', delivery_context=first, **args)
+    with closing(ledger._connect()) as db:
+        assert db.execute('SELECT count(*) FROM delivery_obligations').fetchone()[0] == 2
+    assert ledger.get_delivery_context('one') == first
+    assert ledger.get_delivery_context('two') == second
+
+
+def test_legacy_row_context_is_absent_and_context_is_bounded(store):
+    ledger.record_obligation(obligation_id='old', session_key='session', platform='telegram',
+                             chat_id='chat', thread_id=None, content='answer')
+    assert ledger.get_delivery_context('old') is None
+    with pytest.raises(ValueError):
+        ledger.encode_delivery_context({'kind': 'x', 'a': 'x' * 1024, 'b': 'x' * 1024})
+
+
+def test_terminal_context_handoff_requires_exact_owner_and_detaches(store):
+    e = entry(store)
+    original = {'kind': 'synthetic-v2', 'accepted_identity': 'A', 'identity': 'A'}
+    terminal = {'kind': 'synthetic-v2', 'accepted_identity': 'A', 'identity': 'B'}
+    token = store.mark_turn_active(e.session_key, delivery_context=original)
+    with pytest.raises(RuntimeError, match='lost marker ownership'):
+        store.replace_turn_delivery_context(e.session_key, 'stale-token', original, terminal)
+    with pytest.raises(RuntimeError, match='lost marker ownership'):
+        store.replace_turn_delivery_context(e.session_key, token, terminal, original)
+    assert e.active_turn_delivery_context == original
+    store.replace_turn_delivery_context(e.session_key, token, original, terminal)
+    terminal['accepted_identity'] = 'caller mutation'
+    assert e.active_turn_delivery_context == {'kind': 'synthetic-v2', 'accepted_identity': 'A', 'identity': 'B'}
+    assert not store.clear_turn_active_for_delivery(e.session_key, original)
+    assert store.clear_turn_active_for_delivery(e.session_key, e.active_turn_delivery_context)
+
+
+@pytest.mark.asyncio
+async def test_default_queued_hook_does_not_read_context_store():
+    from unittest.mock import AsyncMock
+    from gateway.config import PlatformConfig
+    from gateway.platforms.base import SendResult
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+    from gateway.run import GatewayRunner
+    adapter = TelegramAdapter(PlatformConfig(enabled=True))
+    adapter.send_final_ledgered = AsyncMock(return_value=(SendResult(success=True), adapter))
+    runner = GatewayRunner.__new__(GatewayRunner)
+    def forbidden(*args):
+        raise AssertionError('stock queued delivery must not read adapter context')
+    runner.session_store = SimpleNamespace(lookup_by_session_key=forbidden)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id='synthetic', user_id='stock', chat_type='dm')
+    assert (await runner._send_queued_final_text(adapter, source, 'answer', None, None, 'session', 'B')).success
+    event = adapter.send_final_ledgered.await_args.args[0]
+    assert event.message_id is None and event.ledger_message_id == 'B'
