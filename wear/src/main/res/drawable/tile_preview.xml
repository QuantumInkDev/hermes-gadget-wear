<?xml version="1.0" encoding="utf-8"?>
<!-- Tile picker preview for the single-profile tile. Built from the launcher icon's own pieces
     (brand background circle + the Courier foreground) so the preview always matches the app icon.
     The foreground box is the circle scaled by 108/72, the adaptive-icon safe-zone ratio. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp" android:height="200dp">
    <item>
        <shape android:shape="rectangle"><solid android:color="#000000" /></shape>
    </item>
    <item android:left="58dp" android:top="38dp" android:right="58dp" android:bottom="78dp">
        <shape android:shape="oval"><solid android:color="@color/quantumink_relay_background" /></shape>
    </item>
    <item android:left="37dp" android:top="17dp" android:right="37dp" android:bottom="57dp"
        android:drawable="@drawable/quantumink_relay_foreground" />
    <item android:left="72dp" android:top="135dp" android:right="72dp" android:bottom="60dp">
        <shape android:shape="rectangle"><solid android:color="#F1F5FC" /></shape>
    </item>
    <item android:left="84dp" android:top="148dp" android:right="84dp" android:bottom="48dp">
        <shape android:shape="rectangle"><solid android:color="#F1F5FC" /></shape>
    </item>
</layer-list>
